class LauncherError(RuntimeError):
    """A user-facing launcher error."""


def sha256_8(path: Path) -> str:
    """Return the first eight hexadecimal characters of a file SHA-256."""
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()[:8]


def launcher_path() -> Path:
    return Path(__file__).resolve()


def resolve_jpresto_path() -> Path:
    """Resolve the installed j_presto root directory.

    J_PRESTO_PATH is preferred.  Falling back to the launcher's own directory
    also permits direct execution from a source tree or an installed J_PRESTO
    directory before the environment variable is configured.
    """
    env_value = os.environ.get("J_PRESTO_PATH", "").strip()
    if env_value:
        env_path = Path(env_value).expanduser().resolve()
        if (env_path / "sp").is_dir():
            return env_path
        print(
            f"[WARN] J_PRESTO_PATH does not contain an sp directory: {env_path}",
            file=sys.stderr,
        )

    local_path = launcher_path().parent
    if (local_path / "sp").is_dir():
        return local_path

    raise LauncherError(
        "Cannot locate the j_presto installation directory.\n"
        "Set J_PRESTO_PATH to the directory containing the sp directory."
    )


def display_credits(jpresto_path: Path) -> None:
    """Display launcher version information in the current j_presto format."""
    print("*" * 50)
    print("*")
    print(f"*    {PROGRAM_NAME} (Version {PROGRAM_VERSION})")
    print("*")
    print(f"*        Author : {AUTHOR}")
    print(f"* First Release : {FIRST_RELEASE_DATE}")
    print(f"*  Current ver. : {CURRENT_VERSION_DATE}")
    print("*")
    print("*" * 50)
    print()

    # Current subprograms consult LICENSE.md but do not print its full contents
    # at every invocation.  Keep the same behavior here and warn only if the
    # installed file is missing.
    license_path = jpresto_path / "LICENSE.md"
    if not license_path.is_file():
        print(f"[WARN] License file not found: {license_path}", file=sys.stderr)


def display_runtime_header(jpresto_path: Path) -> None:
    """Display reproducibility and runtime information for the launcher."""
    display_credits(jpresto_path)
    try:
        launcher_sha = sha256_8(launcher_path())
    except OSError as exc:
        launcher_sha = f"unavailable ({exc})"

    print(f'{"Program SHA256_8 : ".rjust(20)}{launcher_sha}')
    print(
        f'{"Python : ".rjust(20)}{platform.python_version()} '
        f'({sys.executable})'
    )
    print(f'{"J_PRESTO_PATH : ".rjust(20)}{jpresto_path}')
    print(f'{"Working dir : ".rjust(20)}{Path.cwd()}')
    print()
    sys.stdout.flush()


def display_version() -> None:
    """Display the launcher version and source-file checksum."""
    try:
        launcher_sha = sha256_8(launcher_path())
    except OSError:
        launcher_sha = "unavailable"
    print(f"{PROGRAM_NAME} {PROGRAM_VERSION}")
    print(f"Release date: {CURRENT_VERSION_DATE}")
    print(f"Program SHA256_8: {launcher_sha}")


def display_help() -> None:
    """Display the public j_presto subprogram list."""
    all_public_names = [
        name
        for _, entries in PUBLIC_PROGRAM_GROUPS
        for name, _ in entries
    ]
    name_width = max(len(name) for name in all_public_names)

    print(f"{PROGRAM_NAME} {PROGRAM_VERSION}")
    print("Biomolecular molecular dynamics simulation and analysis suite.\n")
    print("Usage:")
    print("  j_presto <function> [arguments]")
    print("  j_presto -h | --help")
    print("  j_presto -v | --version\n")
    print("Public functions:")

    for group_name, entries in PUBLIC_PROGRAM_GROUPS:
        print(f"  {group_name}:")
        for name, description in entries:
            print(f"    {name:<{name_width}}  {description}")
        print()

    print("Run 'j_presto <function> -h' for function-specific help.")
    print(
        "For md_run, GEprep, and Ens_Ana input details, run "
        "'j_presto manual'."
    )


def normalize_returncode(returncode: int) -> int:
    """Convert a subprocess return code into a portable shell exit status."""
    return returncode if returncode >= 0 else 128 + abs(returncode)


def run_program(
    jpresto_path: Path,
    program_name: str,
    program_args: Sequence[str],
) -> int:
    """Run a j_presto subprogram and return its exit status."""
    # Help for stdin-driven Fortran programs is provided by the interactive
    # manual and remains available even before the compiled executable has
    # been installed into the sp directory.
    if program_name in FORTRAN_STDIN_PROGRAMS:
        if not program_args:
            raise LauncherError(
                f"{program_name} requires an input file.\n"
                f"Run 'j_presto manual' for {program_name} input details."
            )
        if program_args[0] in HELP_FLAGS:
            print(
                f"To check how to use '{program_name}', run "
                f"'j_presto manual'."
            )
            return 0

    program_path = jpresto_path / "sp" / program_name
    if not program_path.is_file():
        raise LauncherError(
            f"Unknown j_presto function: {program_name!r}\n"
            "Run 'j_presto -h' to list public functions."
        )
    if not os.access(program_path, os.X_OK):
        raise LauncherError(f"Subprogram is not executable: {program_path}")

    sys.stdout.flush()

    if program_name in FORTRAN_STDIN_PROGRAMS:
        input_path = Path(program_args[0]).expanduser()
        if not input_path.is_file():
            raise LauncherError(f"Input file does not exist: {input_path}")
        try:
            with input_path.open("r", encoding="utf-8", errors="replace") as input_file:
                completed = subprocess.run(
                    [str(program_path)],
                    stdin=input_file,
                    check=False,
                )
        except OSError as exc:
            raise LauncherError(
                f"Failed to run {program_name}: {exc}"
            ) from exc
        return normalize_returncode(completed.returncode)

    child_args = ["j_presto", *program_args]
    try:
        completed = subprocess.run(
            [str(program_path), *child_args],
            check=False,
        )
    except OSError as exc:
        raise LauncherError(f"Failed to run {program_name}: {exc}") from exc
    return normalize_returncode(completed.returncode)


def main(argv: Sequence[str] | None = None) -> int:
    raw_args = list(sys.argv[1:] if argv is None else argv)

    if not raw_args or raw_args[0] in HELP_FLAGS or raw_args[0] == "help":
        display_help()
        return 0
    if raw_args[0] in VERSION_FLAGS:
        display_version()
        return 0

    program_name = raw_args[0]
    program_args = raw_args[1:]

    try:
        jpresto_path = resolve_jpresto_path()
        display_runtime_header(jpresto_path)

        if program_name == "manual":
            program_args = [str(jpresto_path / "manual.txt"), *program_args]

        return run_program(jpresto_path, program_name, program_args)
    except LauncherError as exc:
        print(f"[ERROR] {exc}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("\n[ERROR] Interrupted by user.", file=sys.stderr)
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
