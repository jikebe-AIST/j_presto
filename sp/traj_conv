PROGRAM_VERSION = "1.0.0"
AUTHOR = "Jinzen Ikebe"
FIRST_RELEASE = "2026-07-27"
CURRENT_VERSION_DATE = "2026-07-27"
COD_HEADER_BYTES = 56
COD_FLOAT_BYTES = 4
COD_COORD_BYTES_PER_ATOM = 3 * COD_FLOAT_BYTES
SUPPORTED_PBC = ("none", "nojump", "unwrap")


class TrajConvError(RuntimeError):
    """A user-facing conversion error."""


@dataclasses.dataclass(frozen=True)
class PDBAtom:
    index: int
    serial: int
    atom_name: str
    residue_name: str
    residue_number: int
    chain_name: str
    chain_number: int
    coordinate: np.ndarray
    original_line: str


@dataclasses.dataclass(frozen=True)
class PDBReference:
    path: Path
    atoms: tuple[PDBAtom, ...]

    @property
    def coordinates(self) -> np.ndarray:
        return np.asarray([atom.coordinate for atom in self.atoms], dtype=np.float32)


@dataclasses.dataclass(frozen=True)
class CODHeader:
    step: int
    simulation_time_fs: float
    elapsed_seconds: float
    total_energy: float
    kinetic_energy: float
    temperature: float
    potential_energy: float
    lambda_value: float
    iyn15v: int
    iyn15h: int
    rmsd: float
    tepotcc1: float
    tepotcc2: float
    tepotcc3: float

    @classmethod
    def default_from_mda(cls, ts: object, source_frame_1based: int) -> "CODHeader":
        data = getattr(ts, "data", {}) or {}
        raw_step = data.get("step", source_frame_1based)
        try:
            step = int(raw_step)
        except (TypeError, ValueError, OverflowError):
            step = source_frame_1based
        raw_time = getattr(ts, "time", 0.0)
        try:
            time_ps = float(raw_time)
        except (TypeError, ValueError, OverflowError):
            time_ps = 0.0
        if not math.isfinite(time_ps):
            time_ps = 0.0
        return cls(
            step=step,
            simulation_time_fs=time_ps * 1000.0,
            elapsed_seconds=0.0,
            total_energy=0.0,
            kinetic_energy=0.0,
            temperature=0.0,
            potential_energy=0.0,
            lambda_value=1.0,
            iyn15v=0,
            iyn15h=0,
            rmsd=0.0,
            tepotcc1=0.0,
            tepotcc2=0.0,
            tepotcc3=0.0,
        )


@dataclasses.dataclass(frozen=True)
class CODFormat:
    stream: bool
    endian: str
    marker_bytes: int
    atom_count: int
    frame_count: int
    frame_bytes: int

    @property
    def label(self) -> str:
        if self.stream:
            return f"j_presto CODS stream ({'little' if self.endian == '<' else 'big'} endian)"
        return (
            "j_presto COD sequential "
            f"({self.marker_bytes}-byte record marker, "
            f"{'little' if self.endian == '<' else 'big'} endian)"
        )


@dataclasses.dataclass(frozen=True)
class FramePlan:
    begin: int
    end: int
    stride: int
    output_count: int

    def includes(self, frame_1based: int) -> bool:
        return self.begin <= frame_1based <= self.end and (
            (frame_1based - self.begin) % self.stride == 0
        )


@dataclasses.dataclass(frozen=True)
class ConversionSummary:
    input_format: str
    input_frames: int
    source_atoms: int
    selected_atoms: int
    frame_plan: FramePlan
    output_format: str
    output_pdb: Path | None
    periodic_box_present: bool
    estimated_cod_bytes: int | None


