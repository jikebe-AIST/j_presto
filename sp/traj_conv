        prog="j_presto traj_conv",
        formatter_class=argparse.RawTextHelpFormatter,
        description=(
            "Convert molecular structure and trajectory coordinate files.\n"
            "The input/output formats are inferred from their file extensions.\n"
            "j_presto COD/CODS is handled internally; other formats use MDAnalysis."
        ),
        epilog=(
            "Examples:\n"
            "  j_presto traj_conv -i md.xtc -r reference.pdb -o md.cod\n"
            "  j_presto traj_conv -i md.xtc -r reference.pdb -o md.cod \\\n"
            "      -b 1001 -e END -s 10 -as '1<300:*&!H*,h*'\n"
            "  j_presto traj_conv -i md.cod -r reference.pdb -o md.xtc\n\n"
            "Atom selection uses the common j_presto atom specifier.\n"
            "Quote an atom specifier with single quotes in the shell."
        ),
    )
    parser.add_argument("access_key", nargs="?", help=argparse.SUPPRESS)
    parser.add_argument("-i", "--input", required=True, help="Input structure or trajectory file.")
    parser.add_argument(
        "-r",
        "--reference_pdb",
        required=True,
        help="Reference PDB supplying atom identities and atom order.",
    )
    parser.add_argument("-o", "--output", required=True, help="Output structure or trajectory file.")
    parser.add_argument(
        "-b",
        "--begin",
        type=int,
        default=1,
        help="First source frame to output (1-based, inclusive; default: 1).",
    )
    parser.add_argument(
        "-e",
        "--end",
        default="END",
        help="Last source frame to output (1-based, inclusive; default: END).",
    )
    parser.add_argument(
        "-s",
        "--stride",
        type=int,
        default=1,
        help="Keep every Nth frame beginning at --begin (default: 1).",
    )
    parser.add_argument(
        "-as",
        "--atom_specifier",
        default="*",
        help="j_presto atom specifier for fixed atom selection (default: *).",
    )
    parser.add_argument(
        "-p",
        "--pbc",
        choices=SUPPORTED_PBC,
        default="none",
        help=(
            "Periodic-boundary treatment for non-COD input: none, nojump, or unwrap\n"
            "(default: none). 'unwrap' requires bond information in the reference PDB."
        ),
    )
    parser.add_argument(
        "-op",
        "--output_pdb",
        help=(
            "Companion PDB for the selected atoms. For COD/CODS output, the default\n"
            "is OUTPUT with its extension replaced by .pdb (or _reference.pdb when\n"
            "that name would overwrite an input file)."
        ),
    )
    parser.add_argument(
        "-c",
        "--check_only",
        action="store_true",
        help="Inspect and validate the requested conversion without writing output.",
    )
    parser.add_argument(
        "-f",
        "--force",
        action="store_true",
        help="Overwrite existing output files.",
    )
    parser.add_argument(
        "-v",
        "--version",
        action="version",
        version=f"{PROGRAM_NAME} {PROGRAM_VERSION}",
        help="Show the program version and exit.",
    )
    return parser


def normalize_access_key(argv: Sequence[str]) -> list[str]:
    """Permit direct execution while remaining compatible with the j_presto launcher."""
    args = list(argv)
    if args and args[0] == "j_presto":
        return args
    return ["direct"] + args


# ---------------------------------------------------------------------------
# PDB handling
# ---------------------------------------------------------------------------


def _parse_int_field(text: str, label: str, line_number: int, path: Path) -> int:
    try:
        return int(text.strip())
    except ValueError as exc:
        raise TrajConvError(
            f"Cannot parse {label} in reference PDB at line {line_number}: {path}\n"
            f"Field value: {text!r}"
        ) from exc


def read_reference_pdb(path: Path) -> PDBReference:
    if not path.is_file():
        raise TrajConvError(f"Reference PDB does not exist: {path}")
    atoms: list[PDBAtom] = []
    chain_number = 0
    previous_chain: str | None = None
    model_count = 0
    active_model = True
    saw_model = False

    with path.open("r", encoding="utf-8", errors="replace") as handle:
        for line_number, raw_line in enumerate(handle, start=1):
            line = raw_line.rstrip("\n\r")
            record = line[0:6] if len(line) >= 6 else line
            if record.startswith("MODEL"):
                saw_model = True
                model_count += 1
                active_model = model_count == 1
                continue
            if record.startswith("ENDMDL"):
                if active_model:
                    active_model = False
                continue
            if saw_model and not active_model:
                continue
            if record not in ("ATOM  ", "HETATM"):
                continue
            padded = line.ljust(80)
            serial = _parse_int_field(padded[6:12], "atom serial", line_number, path)
            atom_name = padded[12:16].strip()
            residue_name = padded[17:21].strip()
            chain_name = padded[21:22]
            residue_number = _parse_int_field(
                padded[22:30], "residue number", line_number, path
            )
            try:
                coordinate = np.asarray(
                    [float(padded[30:38]), float(padded[38:46]), float(padded[46:54])],
                    dtype=np.float32,
                )
            except ValueError as exc:
                raise TrajConvError(
                    f"Cannot parse coordinates in reference PDB at line {line_number}: {path}"
                ) from exc
            if previous_chain is None or chain_name != previous_chain:
                chain_number += 1
                previous_chain = chain_name
            atoms.append(
                PDBAtom(
                    index=len(atoms),
                    serial=serial,
                    atom_name=atom_name,
                    residue_name=residue_name,
                    residue_number=residue_number,
                    chain_name=chain_name,
                    chain_number=chain_number,
                    coordinate=coordinate,
                    original_line=line,
                )
            )

    if model_count > 1:
        raise TrajConvError(
            f"The reference PDB contains {model_count} MODEL records.\n"
            "Use a single-model PDB as the reference so that atom identities and order are unambiguous."
        )
    if not atoms:
        raise TrajConvError(f"No ATOM/HETATM records were found in reference PDB: {path}")
    return PDBReference(path=path, atoms=tuple(atoms))


def write_selected_pdb(path: Path, reference: PDBReference, indices: Sequence[int]) -> None:
    with path.open("w", encoding="utf-8", newline="\n") as handle:
        handle.write(f"REMARK Generated by j_presto {PROGRAM_NAME} {PROGRAM_VERSION}\n")
        handle.write(f"REMARK Atom specifier selection from {reference.path.name}\n")
        previous_chain_number: int | None = None
        for index in indices:
            atom = reference.atoms[index]
            if previous_chain_number is not None and atom.chain_number != previous_chain_number:
                handle.write("TER\n")
            handle.write(atom.original_line.rstrip("\n\r") + "\n")
            previous_chain_number = atom.chain_number
        handle.write("END\n")


# ---------------------------------------------------------------------------
# j_presto atom specifier
# ---------------------------------------------------------------------------


class AtomSpecifierParser:
    """Python implementation of the common j_presto atom-specifier syntax."""

    def __init__(self, reference: PDBReference):
        self.reference = reference
        self.natoms = len(reference.atoms)
        self.coords = reference.coordinates

    def select(self, specifier: str) -> list[int]:
        if not specifier:
            raise TrajConvError("The atom specifier is empty.")
        if any(char.isspace() for char in specifier):
            raise TrajConvError(
                "The atom specifier must not contain spaces. Quote the entire expression in the shell."
            )
        segments = self._split_underscore(specifier)
        combined: list[int] = []
        seen: set[int] = set()
        for segment in segments:
            mask = self._evaluate_expression(segment)
            selected = np.flatnonzero(mask).tolist()
            for index in selected:
                if index in seen:
                    atom = self.reference.atoms[index]
                    chain_display = atom.chain_name.strip() or "(blank)"
                    raise TrajConvError(
                        "The atom specifier selected the same atom more than once.\n"
                        f"Duplicate: serial={atom.serial}, chain={chain_display}, "
                        f"residue={atom.residue_number} {atom.residue_name}, atom={atom.atom_name}\n"
                        "Revise underscore-concatenated blocks or use '|' for a union."
                    )
                combined.append(index)
                seen.add(index)
        if not combined:
            raise TrajConvError(
                f"No atoms were selected by atom specifier: {specifier}"
            )
        return combined

    @staticmethod
    def _split_underscore(text: str) -> list[str]:
        parts = text.split("_")
        if any(part == "" for part in parts):
            raise TrajConvError(f"Invalid underscore concatenation in atom specifier: {text}")
        return parts

    def _evaluate_expression(self, text: str) -> np.ndarray:
        terms, operators = self._split_top_level_operators(text)
        result = self._evaluate_term(terms[0])
        for operator, term in zip(operators, terms[1:]):
            rhs = self._evaluate_term(term)
            if operator == "&":
                result = result & rhs
            else:
                result = result | rhs
        return result

    @staticmethod
    def _split_top_level_operators(text: str) -> tuple[list[str], list[str]]:
        terms: list[str] = []
        operators: list[str] = []
        start = 0
        paren_depth = 0
        bracket_depth = 0
        for i, char in enumerate(text):
            if char == "(":
                paren_depth += 1
            elif char == ")":
                paren_depth -= 1
                if paren_depth < 0:
                    raise TrajConvError(f"Unmatched ')' in atom specifier: {text}")
            elif char == "[":
                bracket_depth += 1
            elif char == "]":
                bracket_depth -= 1
                if bracket_depth < 0:
                    raise TrajConvError(f"Unmatched ']' in atom specifier: {text}")
            elif char in "&|" and paren_depth == 0 and bracket_depth == 0:
                term = text[start:i]
                if not term:
                    raise TrajConvError(f"Missing block near '{char}' in atom specifier: {text}")
                terms.append(term)
                operators.append(char)
                start = i + 1
        if paren_depth != 0:
            raise TrajConvError(f"Unmatched parentheses in atom specifier: {text}")
        if bracket_depth != 0:
            raise TrajConvError(f"Unmatched brackets in atom specifier: {text}")
        final = text[start:]
        if not final:
            raise TrajConvError(f"Atom specifier ends with an operator: {text}")
        terms.append(final)
        return terms, operators

    def _evaluate_term(self, text: str) -> np.ndarray:
        negate = text.startswith("!")
        if negate:
            text = text[1:]
            if not text:
                raise TrajConvError("'!' must be followed by an atom-specifier block.")
        if self._is_wrapped_parentheses(text):
            result = self._evaluate_expression(text[1:-1])
        else:
            result = self._evaluate_block(text)
        return ~result if negate else result

    @staticmethod
    def _is_wrapped_parentheses(text: str) -> bool:
        if not (text.startswith("(") and text.endswith(")")):
            return False
        depth = 0
        for i, char in enumerate(text):
            if char == "(":
                depth += 1
            elif char == ")":
                depth -= 1
                if depth == 0 and i != len(text) - 1:
                    return False
        return depth == 0

    def _evaluate_block(self, text: str) -> np.ndarray:
        if text.startswith("["):
            if not text.endswith("]"):
                raise TrajConvError(f"Coordinate-range block is not closed: {text}")
            return self._coordinate_selector(text[1:-1])
        if "(" in text or ")" in text or "[" in text or "]" in text:
            raise TrajConvError(f"Invalid atom-specifier block: {text}")
        return self._identity_selector(text)

    def _identity_selector(self, condition: str) -> np.ndarray:
        fields = condition.split(":")
        if len(fields) == 1:
            chains, residues, atoms = "*", "*", fields[0]
        elif len(fields) == 2:
            chains, residues, atoms = "*", fields[0], fields[1]
        elif len(fields) == 3:
            chains, residues, atoms = fields
        else:
            raise TrajConvError(
                f"Identity block must have at most two ':' separators: {condition}"
            )
        chains = chains or "*"
        residues = residues or "*"
        atoms = atoms or "*"
        chain_mask = self._field_mask(chains, "chain")
        residue_mask = self._field_mask(residues, "residue")
        atom_mask = self._field_mask(atoms, "atom")
        return chain_mask & residue_mask & atom_mask

    def _field_mask(self, text: str, kind: str) -> np.ndarray:
        if text == "*":
            return np.ones(self.natoms, dtype=bool)
        alternatives = text.split(",")
        if any(item == "" for item in alternatives):
            raise TrajConvError(f"Empty comma-separated condition in atom specifier: {text}")
        mask = np.zeros(self.natoms, dtype=bool)
        for item in alternatives:
            if all(char.isdigit() or char == "<" for char in item):
                mask |= self._numeric_field_mask(item, kind)
            else:
                mask |= self._name_field_mask(item, kind)
        return mask

    def _numeric_field_mask(self, text: str, kind: str) -> np.ndarray:
        pieces = text.split("<")
        if len(pieces) == 1:
            try:
                lower = upper = int(pieces[0])
            except ValueError as exc:
                raise TrajConvError(f"Invalid numeric atom-specifier condition: {text}") from exc
        elif len(pieces) == 2 and pieces[0] and pieces[1]:
            try:
                lower, upper = int(pieces[0]), int(pieces[1])
            except ValueError as exc:
                raise TrajConvError(f"Invalid numeric atom-specifier range: {text}") from exc
            if lower > upper:
                lower, upper = upper, lower
        else:
            raise TrajConvError(
                f"Numeric atom-specifier ranges must be written as N or N<M: {text}"
            )
        if kind == "chain":
            values = np.fromiter((a.chain_number for a in self.reference.atoms), dtype=int)
        elif kind == "residue":
            values = np.fromiter((a.residue_number for a in self.reference.atoms), dtype=int)
        else:
            values = np.fromiter((a.serial for a in self.reference.atoms), dtype=int)
        return (values >= lower) & (values <= upper)

    def _name_field_mask(self, text: str, kind: str) -> np.ndarray:
        if "*" in text[:-1]:
            raise TrajConvError(
                f"The wildcard '*' is allowed only at the end of a name: {text}"
            )
        prefix_mode = text.endswith("*")
        target = text[:-1] if prefix_mode else text
        if kind == "chain":
            values = [a.chain_name.strip() for a in self.reference.atoms]
        elif kind == "residue":
            values = [a.residue_name.strip() for a in self.reference.atoms]
        else:
            values = [a.atom_name.strip() for a in self.reference.atoms]
        if prefix_mode:
            if target == "":
                return np.ones(self.natoms, dtype=bool)
            return np.asarray([value.startswith(target) for value in values], dtype=bool)
        return np.asarray([value == target for value in values], dtype=bool)

    def _coordinate_selector(self, condition: str) -> np.ndarray:
        fields = condition.split(":")
        if len(fields) != 3:
            raise TrajConvError(
                f"Coordinate-range selector must be written as [x:y:z]: [{condition}]"
            )
        masks = [self._coordinate_dimension_mask(axis, field) for axis, field in enumerate(fields)]
        return masks[0] & masks[1] & masks[2]

    def _coordinate_dimension_mask(self, axis: int, text: str) -> np.ndarray:
        if text == "":
            return np.ones(self.natoms, dtype=bool)
        mask = np.zeros(self.natoms, dtype=bool)
        values = self.coords[:, axis]
        for interval in text.split(","):
            if interval.count("<") != 1:
                raise TrajConvError(
                    f"Coordinate ranges must contain one '<' separator: {interval}"
                )
            lower_text, upper_text = interval.split("<", 1)
            try:
                lower = float(lower_text) if lower_text else float(np.min(values))
                upper = float(upper_text) if upper_text else float(np.max(values))
            except ValueError as exc:
                raise TrajConvError(f"Invalid coordinate range: {interval}") from exc
            if lower > upper:
                lower, upper = upper, lower
            mask |= (values >= lower) & (values <= upper)
        return mask


# ---------------------------------------------------------------------------
# COD/CODS binary I/O
# ---------------------------------------------------------------------------


def _header_struct(endian: str) -> struct.Struct:
    # int32, seven float32, two int32, four float32
    return struct.Struct(endian + "i7f2i4f")


def pack_cod_header(header: CODHeader, endian: str) -> bytes:
    return _header_struct(endian).pack(
        int(header.step),
        float(header.simulation_time_fs),
        float(header.elapsed_seconds),
        float(header.total_energy),
        float(header.kinetic_energy),
        float(header.temperature),
        float(header.potential_energy),
        float(header.lambda_value),
        int(header.iyn15v),
        int(header.iyn15h),
        float(header.rmsd),
        float(header.tepotcc1),
        float(header.tepotcc2),
        float(header.tepotcc3),
    )


def unpack_cod_header(payload: bytes, endian: str) -> CODHeader:
    if len(payload) != COD_HEADER_BYTES:
        raise TrajConvError(
            f"COD header record has {len(payload)} bytes; expected {COD_HEADER_BYTES}."
        )
    values = _header_struct(endian).unpack(payload)
    return CODHeader(
        step=values[0],
        simulation_time_fs=values[1],
        elapsed_seconds=values[2],
        total_energy=values[3],
        kinetic_energy=values[4],
        temperature=values[5],
        potential_energy=values[6],
        lambda_value=values[7],
        iyn15v=values[8],
        iyn15h=values[9],
        rmsd=values[10],
        tepotcc1=values[11],
        tepotcc2=values[12],
        tepotcc3=values[13],
    )


def _read_marker(handle: BinaryIO, marker_bytes: int, endian: str) -> int:
    payload = handle.read(marker_bytes)
    if len(payload) != marker_bytes:
        raise TrajConvError("Unexpected end of COD file while reading a record marker.")
    fmt = endian + ("i" if marker_bytes == 4 else "q")
    return int(struct.unpack(fmt, payload)[0])


def _pack_marker(value: int, marker_bytes: int, endian: str) -> bytes:
    fmt = endian + ("i" if marker_bytes == 4 else "q")
    return struct.pack(fmt, value)


def detect_sequential_cod(path: Path, atom_count: int) -> CODFormat:
    file_size = path.stat().st_size
    coordinate_bytes = atom_count * COD_COORD_BYTES_PER_ATOM
    with path.open("rb") as handle:
        prefix = handle.read(8)
    candidates: list[tuple[str, int]] = []
    for endian in ("<", ">"):
        if len(prefix) >= 4 and struct.unpack(endian + "i", prefix[:4])[0] == COD_HEADER_BYTES:
            candidates.append((endian, 4))
        if len(prefix) >= 8 and struct.unpack(endian + "q", prefix[:8])[0] == COD_HEADER_BYTES:
            candidates.append((endian, 8))
    valid: list[CODFormat] = []
    for endian, marker_bytes in candidates:
        frame_bytes = (
            COD_HEADER_BYTES
            + coordinate_bytes
            + 4 * marker_bytes
        )
        if frame_bytes <= 0 or file_size == 0 or file_size % frame_bytes != 0:
            continue
        try:
            with path.open("rb") as handle:
                if _read_marker(handle, marker_bytes, endian) != COD_HEADER_BYTES:
                    continue
                header_payload = handle.read(COD_HEADER_BYTES)
                if len(header_payload) != COD_HEADER_BYTES:
                    continue
                if _read_marker(handle, marker_bytes, endian) != COD_HEADER_BYTES:
                    continue
                if _read_marker(handle, marker_bytes, endian) != coordinate_bytes:
                    continue
                coord_payload = handle.read(coordinate_bytes)
                if len(coord_payload) != coordinate_bytes:
                    continue
                if _read_marker(handle, marker_bytes, endian) != coordinate_bytes:
                    continue
                unpack_cod_header(header_payload, endian)
                coordinates = np.frombuffer(coord_payload, dtype=np.dtype(endian + "f4"))
                if coordinates.size != atom_count * 3 or not np.all(np.isfinite(coordinates)):
                    continue
        except (OSError, struct.error, TrajConvError):
            continue
        valid.append(
            CODFormat(
                stream=False,
                endian=endian,
                marker_bytes=marker_bytes,
                atom_count=atom_count,
                frame_count=file_size // frame_bytes,
                frame_bytes=frame_bytes,
            )
        )
    if len(valid) != 1:
        if not valid:
            raise TrajConvError(
                "The input .cod file is not a recognized j_presto single-precision\n"
                "Fortran sequential-unformatted trajectory for the atom count in the reference PDB."
            )
        raise TrajConvError(
            "The COD record format could not be determined unambiguously."
        )
    return valid[0]


def _stream_endian_score(
    coordinate_payload: bytes, endian: str, reference_coordinates: np.ndarray
) -> float:
    coordinates = np.frombuffer(coordinate_payload, dtype=np.dtype(endian + "f4"))
    if coordinates.size != reference_coordinates.size or not np.all(np.isfinite(coordinates)):
        return float("inf")
    coordinates = coordinates.reshape((-1, 3)).astype(np.float64, copy=False)
    coordinate_scale = float(np.std(coordinates))
    reference_scale = float(np.std(reference_coordinates.astype(np.float64)))
    if coordinate_scale <= 1e-12 or coordinate_scale > 1e6 or reference_scale <= 1e-12:
        return float("inf")
    scale_score = abs(math.log10(coordinate_scale / reference_scale))
    max_abs = float(np.max(np.abs(coordinates)))
    if max_abs > 1e6:
        return float("inf")
    return scale_score


def detect_stream_cod(path: Path, reference: PDBReference) -> CODFormat:
    atom_count = len(reference.atoms)
    coordinate_bytes = atom_count * COD_COORD_BYTES_PER_ATOM
    frame_bytes = COD_HEADER_BYTES + coordinate_bytes
    file_size = path.stat().st_size
    if file_size == 0 or file_size % frame_bytes != 0:
        raise TrajConvError(
            "The .cods file size is inconsistent with the atom count in the reference PDB."
        )
    with path.open("rb") as handle:
        header_payload = handle.read(COD_HEADER_BYTES)
        coordinate_payload = handle.read(coordinate_bytes)
    scores: list[tuple[float, str]] = []
    for endian in ("<", ">"):
        try:
            header = unpack_cod_header(header_payload, endian)
        except (struct.error, TrajConvError):
            continue
        header_values = (
            header.simulation_time_fs,
            header.elapsed_seconds,
            header.total_energy,
            header.kinetic_energy,
            header.temperature,
            header.potential_energy,
            header.lambda_value,
            header.rmsd,
            header.tepotcc1,
            header.tepotcc2,
            header.tepotcc3,
        )
        if not all(math.isfinite(value) for value in header_values):
            continue
        score = _stream_endian_score(coordinate_payload, endian, reference.coordinates)
        scores.append((score, endian))
    finite_scores = sorted(item for item in scores if math.isfinite(item[0]))
    if not finite_scores:
        raise TrajConvError("The byte order of the .cods stream file could not be determined.")
    endian = finite_scores[0][1]
    return CODFormat(
        stream=True,
        endian=endian,
        marker_bytes=0,
        atom_count=atom_count,
        frame_count=file_size // frame_bytes,
        frame_bytes=frame_bytes,
    )


def detect_cod_format(path: Path, reference: PDBReference) -> CODFormat:
    suffix = path.suffix.lower()
    if suffix == ".cod":
        return detect_sequential_cod(path, len(reference.atoms))
    if suffix == ".cods":
        return detect_stream_cod(path, reference)
    raise TrajConvError(f"Not a COD/CODS path: {path}")


class CODReader:
    def __init__(self, path: Path, fmt: CODFormat):
        self.path = path
        self.format = fmt

    def __enter__(self) -> "CODReader":
        self.handle = self.path.open("rb")
        return self

    def __exit__(self, exc_type: object, exc: object, traceback: object) -> None:
        self.handle.close()

    def frames(self) -> Iterator[tuple[int, CODHeader, np.ndarray]]:
        coordinate_bytes = self.format.atom_count * COD_COORD_BYTES_PER_ATOM
        dtype = np.dtype(self.format.endian + "f4")
        for frame_index in range(1, self.format.frame_count + 1):
            if self.format.stream:
                header_payload = self.handle.read(COD_HEADER_BYTES)
                coordinate_payload = self.handle.read(coordinate_bytes)
                if len(header_payload) != COD_HEADER_BYTES or len(coordinate_payload) != coordinate_bytes:
                    raise TrajConvError(
                        f"Unexpected end of CODS file at frame {frame_index}: {self.path}"
                    )
            else:
                leading_header = _read_marker(
                    self.handle, self.format.marker_bytes, self.format.endian
                )
                if leading_header != COD_HEADER_BYTES:
                    raise TrajConvError(
                        f"Invalid COD header record marker at frame {frame_index}: {leading_header}"
                    )
                header_payload = self.handle.read(COD_HEADER_BYTES)
                trailing_header = _read_marker(
                    self.handle, self.format.marker_bytes, self.format.endian
                )
                if trailing_header != COD_HEADER_BYTES:
                    raise TrajConvError(
                        f"Invalid trailing COD header marker at frame {frame_index}: {trailing_header}"
                    )
                leading_coordinates = _read_marker(
                    self.handle, self.format.marker_bytes, self.format.endian
                )
                if leading_coordinates != coordinate_bytes:
                    raise TrajConvError(
                        f"Invalid COD coordinate record size at frame {frame_index}: "
                        f"{leading_coordinates} (expected {coordinate_bytes})"
                    )
                coordinate_payload = self.handle.read(coordinate_bytes)
                trailing_coordinates = _read_marker(
                    self.handle, self.format.marker_bytes, self.format.endian
                )
                if trailing_coordinates != coordinate_bytes:
                    raise TrajConvError(
                        f"Invalid trailing COD coordinate marker at frame {frame_index}."
                    )
            header = unpack_cod_header(header_payload, self.format.endian)
            coordinates = np.frombuffer(coordinate_payload, dtype=dtype).reshape((-1, 3))
            coordinates = coordinates.astype(np.float32, copy=True)
            if not np.all(np.isfinite(coordinates)):
                raise TrajConvError(f"NaN or Inf coordinate found in COD frame {frame_index}.")
            yield frame_index, header, coordinates


class CODWriter:
    def __init__(self, path: Path, stream: bool):
        self.path = path
        self.stream = stream
        self.endian = "<"
        self.marker_bytes = 4

    def __enter__(self) -> "CODWriter":
        self.handle = self.path.open("wb")
        return self

    def __exit__(self, exc_type: object, exc: object, traceback: object) -> None:
        self.handle.close()

    def write(self, header: CODHeader, coordinates: np.ndarray) -> None:
        coordinates = np.asarray(coordinates, dtype=np.float32)
        if coordinates.ndim != 2 or coordinates.shape[1] != 3:
            raise TrajConvError(
                f"Internal error: coordinate array has shape {coordinates.shape}, expected (N, 3)."
            )
        if not np.all(np.isfinite(coordinates)):
            raise TrajConvError("NaN or Inf coordinate cannot be written to COD.")
        header_payload = pack_cod_header(header, self.endian)
        coordinate_payload = np.asarray(coordinates, dtype="<f4").tobytes(order="C")
        if self.stream:
            self.handle.write(header_payload)
            self.handle.write(coordinate_payload)
        else:
            self.handle.write(_pack_marker(len(header_payload), self.marker_bytes, self.endian))
            self.handle.write(header_payload)
            self.handle.write(_pack_marker(len(header_payload), self.marker_bytes, self.endian))
            self.handle.write(_pack_marker(len(coordinate_payload), self.marker_bytes, self.endian))
            self.handle.write(coordinate_payload)
            self.handle.write(_pack_marker(len(coordinate_payload), self.marker_bytes, self.endian))


