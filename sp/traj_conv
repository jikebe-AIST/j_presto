def inspect_mda_input(
    input_path: Path,
    reference_path: Path,
    reference: PDBReference,
    pbc: str,
) -> tuple[object, int, bool, str]:
    universe = create_mda_universe(reference_path, input_path, pbc)
    source_atoms = len(universe.atoms)
    if source_atoms != len(reference.atoms):
        raise TrajConvError(
            "Atom count mismatch between the input trajectory and reference PDB.\n"
            f"Trajectory : {source_atoms} atoms\n"
            f"Reference  : {len(reference.atoms)} atoms"
        )
    try:
        frame_count = len(universe.trajectory)
    except Exception as exc:
        raise TrajConvError(f"Could not determine the number of input frames: {exc}") from exc
    if frame_count < 1:
        raise TrajConvError("The input trajectory contains no frames.")
    try:
        first_ts = universe.trajectory[0]
    except Exception as exc:
        raise TrajConvError(f"Could not read the first input frame: {exc}") from exc
    if not np.all(np.isfinite(first_ts.positions)):
        raise TrajConvError("NaN or Inf coordinate found in the first input frame.")
    periodic = dimensions_present(first_ts)
    reader_name = type(universe.trajectory).__name__
    return universe, frame_count, periodic, f"{input_path.suffix.lower()} via MDAnalysis ({reader_name})"


def inspect_cod_input(
    input_path: Path, reference: PDBReference
) -> tuple[CODFormat, int, bool, str]:
    fmt = detect_cod_format(input_path, reference)
    with CODReader(input_path, fmt) as reader:
        try:
            _frame, _header, coords = next(reader.frames())
        except StopIteration as exc:
            raise TrajConvError("The COD input contains no frames.") from exc
    if coords.shape[0] != len(reference.atoms):
        raise TrajConvError("Internal COD atom count validation failed.")
    return fmt, fmt.frame_count, False, fmt.label


def _iter_mda_source_frames(
    universe: object, plan: FramePlan, pbc: str
) -> Iterator[tuple[int, object, np.ndarray]]:
    trajectory = universe.trajectory
    if pbc == "nojump":
        # NoJump is path-dependent; visit all preceding frames in sequence.
        for ts in trajectory[: plan.end]:
            source_frame = int(ts.frame) + 1
            if plan.includes(source_frame):
                yield source_frame, ts, np.asarray(ts.positions, dtype=np.float32)
    else:
        for zero_based in range(plan.begin - 1, plan.end, plan.stride):
            ts = trajectory[zero_based]
            yield zero_based + 1, ts, np.asarray(ts.positions, dtype=np.float32)


def convert_mda_to_cod(
    universe: object,
    output_path: Path,
    output_stream: bool,
    selected_indices: Sequence[int],
    plan: FramePlan,
    pbc: str,
) -> None:
    selected = np.asarray(selected_indices, dtype=int)
    last_percent = -5
    written = 0
    with CODWriter(output_path, stream=output_stream) as writer:
        for source_frame, ts, coordinates in _iter_mda_source_frames(universe, plan, pbc):
            selected_coordinates = coordinates[selected, :]
            header = CODHeader.default_from_mda(ts, source_frame)
            writer.write(header, selected_coordinates)
            written += 1
            last_percent = progress_update(written, plan.output_count, last_percent)
    if written != plan.output_count:
        raise TrajConvError(
            f"Only {written} frames were written; expected {plan.output_count}."
        )


def convert_mda_to_mda(
    universe: object,
    output_path: Path,
    selected_indices: Sequence[int],
    plan: FramePlan,
    pbc: str,
) -> None:
    atom_group = universe.atoms[np.asarray(selected_indices, dtype=int)]
    last_percent = -5
    written = 0
    with make_mda_writer(output_path, len(selected_indices), plan.output_count) as writer:
        for _source_frame, _ts, _coordinates in _iter_mda_source_frames(universe, plan, pbc):
            try:
                writer.write(atom_group)
            except Exception as exc:
                raise TrajConvError(
                    f"Failed while writing output frame {written + 1}:\n"
                    f"{type(exc).__name__}: {exc}"
                ) from exc
            written += 1
            last_percent = progress_update(written, plan.output_count, last_percent)
    if written != plan.output_count:
        raise TrajConvError(
            f"Only {written} frames were written; expected {plan.output_count}."
        )


def convert_cod_to_cod(
    input_path: Path,
    input_format: CODFormat,
    output_path: Path,
    output_stream: bool,
    selected_indices: Sequence[int],
    plan: FramePlan,
) -> None:
    selected = np.asarray(selected_indices, dtype=int)
    last_percent = -5
    written = 0
    with CODReader(input_path, input_format) as reader, CODWriter(
        output_path, stream=output_stream
    ) as writer:
        for source_frame, header, coordinates in reader.frames():
            if source_frame > plan.end:
                break
            if not plan.includes(source_frame):
                continue
            writer.write(header, coordinates[selected, :])
            written += 1
            last_percent = progress_update(written, plan.output_count, last_percent)
    if written != plan.output_count:
        raise TrajConvError(
            f"Only {written} frames were written; expected {plan.output_count}."
        )


def convert_cod_to_mda(
    input_path: Path,
    input_format: CODFormat,
    reference_path: Path,
    output_path: Path,
    selected_indices: Sequence[int],
    plan: FramePlan,
) -> None:
    mda = import_mdanalysis()
    try:
        universe = mda.Universe(str(reference_path))
    except Exception as exc:
        raise TrajConvError(
            f"MDAnalysis could not create a topology from reference PDB: {exc}"
        ) from exc
    if len(universe.atoms) != input_format.atom_count:
        raise TrajConvError(
            "MDAnalysis and the internal PDB parser obtained different atom counts from "
            f"the reference PDB ({len(universe.atoms)} vs {input_format.atom_count})."
        )
    atom_group = universe.atoms[np.asarray(selected_indices, dtype=int)]
    last_percent = -5
    written = 0
    with make_mda_writer(output_path, len(selected_indices), plan.output_count) as writer:
        with CODReader(input_path, input_format) as reader:
            for source_frame, header, coordinates in reader.frames():
                if source_frame > plan.end:
                    break
                if not plan.includes(source_frame):
                    continue
                atom_group.positions = coordinates[np.asarray(selected_indices, dtype=int), :]
                ts = universe.trajectory.ts
                with contextlib.suppress(Exception):
                    ts.time = float(header.simulation_time_fs) / 1000.0
                with contextlib.suppress(Exception):
                    ts.data["step"] = int(header.step)
                try:
                    writer.write(atom_group)
                except Exception as exc:
                    raise TrajConvError(
                        f"Failed while writing output frame {written + 1}:\n"
                        f"{type(exc).__name__}: {exc}"
                    ) from exc
                written += 1
                last_percent = progress_update(written, plan.output_count, last_percent)
    if written != plan.output_count:
        raise TrajConvError(
            f"Only {written} frames were written; expected {plan.output_count}."
        )


def validate_last_mda_frame(universe: object, frame_count: int, pbc: str) -> None:
    if pbc == "nojump":
        return
    try:
        ts = universe.trajectory[frame_count - 1]
    except Exception as exc:
        raise TrajConvError(f"Could not read the last input frame: {exc}") from exc
    if not np.all(np.isfinite(ts.positions)):
        raise TrajConvError("NaN or Inf coordinate found in the last input frame.")


def cleanup_partial_outputs(paths: Sequence[Path | None]) -> None:
    for path in paths:
        if path is None:
            continue
        with contextlib.suppress(OSError):
            if path.exists():
                path.unlink()


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------


def main(argv: Sequence[str] | None = None) -> int:
    parser = build_parser()
    raw_argv = sys.argv[1:] if argv is None else list(argv)
    args = parser.parse_args(normalize_access_key(raw_argv))

    display_credits()
    started = time.perf_counter()

    input_path = Path(args.input).expanduser().resolve()
    reference_path = Path(args.reference_pdb).expanduser().resolve()
    output_path = Path(args.output).expanduser().resolve()
    ensure_input_files(input_path, reference_path)
    reference = read_reference_pdb(reference_path)
    selected_indices = AtomSpecifierParser(reference).select(args.atom_specifier)
    in_kind = input_kind(input_path)
    out_kind = output_kind(output_path)
    companion_pdb = default_companion_pdb(
        output_path, args.output_pdb, input_path, reference_path
    )
    ensure_output_paths(
        input_path,
        reference_path,
        output_path,
        companion_pdb,
        args.force,
        args.check_only,
    )

    universe = None
    cod_format = None
    if in_kind == "cod":
        if args.pbc != "none":
            raise TrajConvError(
                "PBC correction cannot be applied to COD/CODS input because these formats do not "
                "store periodic box vectors."
            )
        cod_format, frame_count, periodic_box, input_format_label = inspect_cod_input(
            input_path, reference
        )
    else:
        universe, frame_count, periodic_box, input_format_label = inspect_mda_input(
            input_path, reference_path, reference, args.pbc
        )
        validate_last_mda_frame(universe, frame_count, args.pbc)

    plan = build_frame_plan(args.begin, args.end, args.stride, frame_count)
    output_format_label = (
        "j_presto COD sequential (single precision, 4-byte markers, little endian)"
        if out_kind == "cod"
        else "j_presto CODS stream (single precision, little endian)"
        if out_kind == "cods"
        else f"{output_path.suffix.lower()} via MDAnalysis"
    )
    summary = ConversionSummary(
        input_format=input_format_label,
        input_frames=frame_count,
        source_atoms=len(reference.atoms),
        selected_atoms=len(selected_indices),
        frame_plan=plan,
        output_format=output_format_label,
        output_pdb=companion_pdb,
        periodic_box_present=periodic_box,
        estimated_cod_bytes=estimate_cod_size(out_kind, plan.output_count, len(selected_indices)),
    )
    report_summary(
        input_path,
        reference_path,
        output_path,
        args.atom_specifier,
        summary,
    )
    report_selected_atoms(reference, selected_indices)
    print()

    if periodic_box and out_kind in ("cod", "cods") and args.pbc == "none":
        print("WARNING: The input trajectory contains periodic box information, but no PBC")
        print("         correction was requested. Broken molecules can generate artificial")
        print("         internal-distance differences in DISTIL.")
        print()

    if args.check_only:
        elapsed = time.perf_counter() - started
        print("Input and requested conversion passed the available checks.")
        print(f"Execution time : {elapsed:.2f} s")
        print(f"\n+++ Program j_presto {PROGRAM_NAME} normally ended +++")
        return 0

    temporary_outputs: list[Path | None] = [output_path, companion_pdb]
    try:
        if in_kind == "mda" and out_kind in ("cod", "cods"):
            assert universe is not None
            convert_mda_to_cod(
                universe,
                output_path,
                output_stream=(out_kind == "cods"),
                selected_indices=selected_indices,
                plan=plan,
                pbc=args.pbc,
            )
            print()
            print("Note: The input format did not provide j_presto energy and generalized-")
            print("      ensemble metadata. COD metadata fields were initialized for ordinary")
            print("      coordinate analysis (lambda=1; energies and related fields=0).")
        elif in_kind == "mda" and out_kind == "mda":
            assert universe is not None
            convert_mda_to_mda(
                universe,
                output_path,
                selected_indices,
                plan,
                args.pbc,
            )
        elif in_kind == "cod" and out_kind in ("cod", "cods"):
            assert cod_format is not None
            convert_cod_to_cod(
                input_path,
                cod_format,
                output_path,
                output_stream=(out_kind == "cods"),
                selected_indices=selected_indices,
                plan=plan,
            )
        else:
            assert cod_format is not None
            convert_cod_to_mda(
                input_path,
                cod_format,
                reference_path,
                output_path,
                selected_indices,
                plan,
            )
        if companion_pdb is not None:
            write_selected_pdb(companion_pdb, reference, selected_indices)
    except Exception:
        cleanup_partial_outputs(temporary_outputs)
        raise

    elapsed = time.perf_counter() - started
    print()
    print("Conversion completed successfully.")
    if companion_pdb is not None and out_kind in ("cod", "cods"):
        print("DISTIL-ready files:")
        print(f"  Trajectory : {output_path}")
        print(f"  Reference  : {companion_pdb}")
    print(f"Execution time : {elapsed:.2f} s")
    print(f"\n+++ Program j_presto {PROGRAM_NAME} normally ended +++")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except TrajConvError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        raise SystemExit(1)
    except KeyboardInterrupt:
        print("ERROR: Interrupted by user.", file=sys.stderr)
        raise SystemExit(130)
