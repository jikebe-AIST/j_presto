def import_mdanalysis() -> object:
    warnings.filterwarnings(
        "ignore",
        message="DCDReader currently makes independent timesteps.*",
        category=DeprecationWarning,
    )
    try:
        import MDAnalysis as mda
    except ImportError as exc:
        raise TrajConvError(
            "MDAnalysis is required for formats other than .cod/.cods.\n"
            "Install it in the Python environment used to execute j_presto."
        ) from exc
    return mda


def create_mda_universe(reference_pdb: Path, trajectory: Path, pbc: str) -> object:
    mda = import_mdanalysis()
    try:
        universe = mda.Universe(str(reference_pdb), str(trajectory))
    except Exception as exc:
        raise TrajConvError(
            f"MDAnalysis could not read input trajectory '{trajectory}' with reference PDB "
            f"'{reference_pdb}'.\n{type(exc).__name__}: {exc}"
        ) from exc
    if pbc == "nojump":
        try:
            from MDAnalysis.transformations.nojump import NoJump

            universe.trajectory.add_transformations(NoJump())
        except Exception as exc:
            raise TrajConvError(
                "Failed to configure PBC no-jump transformation. The trajectory must contain "
                f"valid periodic box information.\n{type(exc).__name__}: {exc}"
            ) from exc
    elif pbc == "unwrap":
        try:
            from MDAnalysis.transformations import unwrap

            universe.trajectory.add_transformations(unwrap(universe.atoms))
        except Exception as exc:
            raise TrajConvError(
                "Failed to configure PBC unwrap transformation. 'unwrap' requires molecular "
                "connectivity (usually CONECT records) in the reference PDB.\n"
                f"{type(exc).__name__}: {exc}"
            ) from exc
    return universe


def dimensions_present(ts: object) -> bool:
    dimensions = getattr(ts, "dimensions", None)
    if dimensions is None:
        return False
    array = np.asarray(dimensions, dtype=float)
    return array.size >= 3 and np.all(np.isfinite(array[:3])) and np.all(array[:3] > 0.0)


def make_mda_writer(output: Path, atom_count: int, frame_count: int) -> object:
    mda = import_mdanalysis()
    try:
        return mda.Writer(str(output), n_atoms=atom_count, multiframe=frame_count > 1)
    except Exception as exc:
        if frame_count == 1:
            try:
                return mda.Writer(str(output), n_atoms=atom_count)
            except Exception:
                pass
        raise TrajConvError(
            f"MDAnalysis could not create a writer for output file '{output}'.\n"
            f"The selected output format may not support {frame_count} frame(s).\n"
            f"{type(exc).__name__}: {exc}"
        ) from exc


