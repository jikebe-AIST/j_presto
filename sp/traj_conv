def parse_end(value: str, frame_count: int) -> int:
    if value.upper() == "END":
        return frame_count
    try:
        end = int(value)
    except ValueError as exc:
        raise TrajConvError("--end/-e must be an integer frame number or END.") from exc
    return end


def build_frame_plan(begin: int, end_text: str, stride: int, frame_count: int) -> FramePlan:
    if frame_count < 1:
        raise TrajConvError("The input contains no frames.")
    if begin < 1:
        raise TrajConvError("--begin/-b must be at least 1.")
    if stride < 1:
        raise TrajConvError("--stride/-s must be at least 1.")
    end = parse_end(end_text, frame_count)
    if end < begin:
        raise TrajConvError(
            f"The requested end frame ({end}) is smaller than the begin frame ({begin})."
        )
    if begin > frame_count:
        raise TrajConvError(
            f"The begin frame ({begin}) exceeds the number of input frames ({frame_count})."
        )
    if end > frame_count:
        raise TrajConvError(
            f"The end frame ({end}) exceeds the number of input frames ({frame_count})."
        )
    output_count = ((end - begin) // stride) + 1
    return FramePlan(begin=begin, end=end, stride=stride, output_count=output_count)


def output_kind(path: Path) -> str:
    suffix = path.suffix.lower()
    if not suffix:
        raise TrajConvError(f"Output file has no extension: {path}")
    if suffix == ".cod":
        return "cod"
    if suffix == ".cods":
        return "cods"
    return "mda"


def input_kind(path: Path) -> str:
    suffix = path.suffix.lower()
    if not suffix:
        raise TrajConvError(f"Input file has no extension: {path}")
    if suffix in (".cod", ".cods"):
        return "cod"
    return "mda"


def default_companion_pdb(
    output: Path, explicit: str | None, input_path: Path, reference_path: Path
) -> Path | None:
    if explicit:
        return Path(explicit).expanduser().resolve()
    if output.suffix.lower() not in (".cod", ".cods"):
        return None
    candidate = output.with_suffix(".pdb")
    source_paths = {input_path.resolve(), reference_path.resolve()}
    if candidate.resolve() in source_paths:
        candidate = output.with_name(output.stem + "_reference.pdb")
    return candidate


def ensure_input_files(input_path: Path, reference_path: Path) -> None:
    if not input_path.is_file():
        raise TrajConvError(f"Input file does not exist: {input_path}")
    if not reference_path.is_file():
        raise TrajConvError(f"Reference PDB does not exist: {reference_path}")


def ensure_output_paths(
    input_path: Path,
    reference_path: Path,
    output_path: Path,
    output_pdb: Path | None,
    force: bool,
    check_only: bool,
) -> None:
    if check_only:
        return
    destinations = [output_path] + ([output_pdb] if output_pdb is not None else [])
    resolved_destinations = [destination.resolve() for destination in destinations]
    if len(set(resolved_destinations)) != len(resolved_destinations):
        raise TrajConvError(
            "The trajectory output and companion PDB must use different paths."
        )
    resolved_sources = {input_path.resolve(), reference_path.resolve()}
    for destination in destinations:
        assert destination is not None
        if destination.resolve() in resolved_sources:
            raise TrajConvError(
                f"An output path would overwrite an input file: {destination}"
            )
        if destination.exists() and not force:
            raise TrajConvError(
                f"Output file already exists: {destination}\nUse --force/-f to overwrite it."
            )
        parent = destination.parent
        if not parent.exists():
            raise TrajConvError(f"Output directory does not exist: {parent}")
        if not os.access(parent, os.W_OK):
            raise TrajConvError(f"Output directory is not writable: {parent}")


def estimate_cod_size(kind: str, frames: int, atoms: int) -> int | None:
    if kind == "cod":
        return frames * (COD_HEADER_BYTES + atoms * COD_COORD_BYTES_PER_ATOM + 16)
    if kind == "cods":
        return frames * (COD_HEADER_BYTES + atoms * COD_COORD_BYTES_PER_ATOM)
    return None


def human_size(size_bytes: int | None) -> str:
    if size_bytes is None:
        return "format-dependent"
    value = float(size_bytes)
    units = ("B", "KiB", "MiB", "GiB", "TiB")
    unit = units[0]
    for unit in units:
        if value < 1024.0 or unit == units[-1]:
            break
        value /= 1024.0
    return f"{value:.2f} {unit}"


def report_selected_atoms(reference: PDBReference, indices: Sequence[int]) -> None:
    print(f"Selected atoms     : {len(indices)} / {len(reference.atoms)}")
    show: list[tuple[int, int]] = []
    if len(indices) <= 6:
        show = list(enumerate(indices, start=1))
    else:
        show.extend((i + 1, indices[i]) for i in range(3))
        show.extend((len(indices) - 2 + i, indices[-3 + i]) for i in range(3))
    for output_index, source_index in show:
        atom = reference.atoms[source_index]
        chain = atom.chain_name.strip() or "-"
        print(
            f"  {output_index:8d} : chain {atom.chain_number} {chain}  "
            f"residue {atom.residue_number} {atom.residue_name}  "
            f"atom {atom.serial} {atom.atom_name}"
        )
        if len(indices) > 6 and output_index == 3:
            print("              ...")


def report_summary(
    input_path: Path,
    reference_path: Path,
    output_path: Path,
    atom_specifier: str,
    summary: ConversionSummary,
) -> None:
    print(f"Input trajectory  : {input_path}")
    print(f"Input format      : {summary.input_format}")
    print(f"Reference PDB     : {reference_path}")
    print(f"Source atoms      : {summary.source_atoms}")
    print(f"Input frames      : {summary.input_frames}")
    print(f"Atom specifier    : {atom_specifier}")
    print(f"Selected atoms    : {summary.selected_atoms}")
    print("Frame extraction  :")
    print(f"  begin           : {summary.frame_plan.begin}")
    print(f"  end             : {summary.frame_plan.end}")
    print(f"  stride          : {summary.frame_plan.stride}")
    print(f"  output frames   : {summary.frame_plan.output_count}")
    print(f"PBC box in input  : {'present' if summary.periodic_box_present else 'not detected'}")
    print(f"Output trajectory : {output_path}")
    print(f"Output format     : {summary.output_format}")
    if summary.output_pdb is not None:
        print(f"Companion PDB     : {summary.output_pdb}")
    print(f"Estimated size    : {human_size(summary.estimated_cod_bytes)}")
    print()


def progress_update(done: int, total: int, last_percent: int) -> int:
    if total <= 0:
        return last_percent
    percent = int(done * 100 / total)
    if percent >= last_percent + 5 or done == total:
        print(f"  Converting ... {percent:3d}% ({done}/{total} frames)")
        return percent
    return last_percent


