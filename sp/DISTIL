        _save_stage_meta(stage1_meta_path, want)
        _write_stage_done_atomic(stage1_done_path, stage_name="Stage1", meta=want, outputs=[stage1_cache, pair_scores_csv, stage1_meta_path], counts={"rows": int(len(feats))})

        total = len(feats)
        n_pass_tv = sum(1 for fs in feats if bool(fs.passed_tv))
