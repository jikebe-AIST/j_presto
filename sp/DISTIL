def _read_top_pair_ids(path: Path, topk: int) -> list[int]:
    ranking = _read_pair_ranking(path)
    return [int(fid) for fid, _score in ranking[:max(1, int(topk))]]


def _stage5_pair_rank_key(item: tuple[int, Mapping[str, object]]) -> tuple[float, float, float, int]:
    """Stable descending ranking key for pair-level Stage5 output.

    ``stage5_score`` is mode-aware: contribution in standard mode,
    condition-effect score in CED mode, and significance strength in sig mode.
    """
    fid, pm = item
    def _finite_or(value: object, fallback: float = -1.0) -> float:
        try:
            x = float(value)
        except Exception:
            return float(fallback)
        return x if np.isfinite(x) else float(fallback)
    return (
        _finite_or(pm.get('stage5_score', 0.0), -1.0),
        _finite_or(pm.get('auc_single', float('nan')), -1.0),
        _finite_or(pm.get('tv_c', float('nan')), -1.0),
        -int(fid),
    )


def _ranking_map_from_pairs(ranking: list[tuple[int, float]]) -> tuple[dict[int, int], dict[int, float]]:
    rank_map: dict[int, int] = {}
    score_map: dict[int, float] = {}
    for rank, (fid, score) in enumerate(ranking, start=1):
        if int(fid) < 0:
            continue
        rank_map[int(fid)] = int(rank)
        score_map[int(fid)] = float(score)
    return rank_map, score_map


def _read_ranked_region_rows(path: Path, topm: int | None = None) -> list[dict[str, object]]:
    rows = []
    limit = None if topm is None else max(1, int(topm))
    with open(path, 'r', encoding='utf-8') as f:
        for row in csv.DictReader(f):
            try:
                rank = int(row.get('rank', '0') or 0)
            except Exception:
                rank = 0
            try:
                bid = int(row.get('bundle_id', '-1') or -1)
            except Exception:
                bid = -1
            try:
                score = float(row.get('rank_score', row.get('cross_contribution_sum', row.get('contribution_score', 'nan'))) or 'nan')
            except Exception:
                score = float('nan')
            rows.append({
                'rank': rank,
                'bundle_id': bid,
                'score': float(score),
                'regionA_nodes': _parse_node_set(row.get('regionA_nodes', '')),
                'regionB_nodes': _parse_node_set(row.get('regionB_nodes', '')),
            })
            if limit is not None and len(rows) >= limit:
                break
    return rows


def _ranking_map_from_bundles(rows: list[dict[str, object]]) -> tuple[dict[int, int], dict[int, float]]:
    rank_map: dict[int, int] = {}
    score_map: dict[int, float] = {}
    for row in rows:
        bid = int(row.get('bundle_id', -1))
        if bid < 0:
            continue
        rank = int(row.get('rank', 0))
        score = float(row.get('score', row.get('contribution_score', float('nan'))))
        rank_map[bid] = rank
        score_map[bid] = score
    return rank_map, score_map




def _direction_map_residue_atom_ids(res_idx: int, atoms_by_res, atoms_sel) -> list[int]:
    if not (0 <= int(res_idx) < len(atoms_by_res)):
        return []
    ids = [int(i) for i in atoms_by_res[int(res_idx)] if 0 <= int(i) < len(atoms_sel)]
    heavy = [int(i) for i in ids if str(getattr(atoms_sel[int(i)], 'elem', '')).strip().upper() != 'H']
    return heavy if heavy else ids


def _direction_map_centroid(atom_ids, atoms_sel) -> np.ndarray | None:
    if not atom_ids:
        return None
    xyz = []
    for idx in atom_ids:
        if 0 <= int(idx) < len(atoms_sel):
            a = atoms_sel[int(idx)]
            xyz.append((float(a.x), float(a.y), float(a.z)))
    if not xyz:
        return None
    return np.mean(np.asarray(xyz, dtype=np.float64), axis=0)


def _direction_map_write_arrow(fh, start: np.ndarray, end: np.ndarray) -> None:
    start = np.asarray(start, dtype=np.float64).reshape(3)
    end = np.asarray(end, dtype=np.float64).reshape(3)
    vec = end - start
    mag = float(np.linalg.norm(vec))
    if not np.isfinite(mag) or mag <= 0.0:
        return
    unit = vec / mag
    head_len = min(0.40, 0.8 * mag)
    shaft_end = end - unit * head_len
    fh.write(f".cylinder {start[0]:.3f} {start[1]:.3f} {start[2]:.3f} {shaft_end[0]:.3f} {shaft_end[1]:.3f} {shaft_end[2]:.3f} 0.100\n")
    fh.write(f".cone {shaft_end[0]:.3f} {shaft_end[1]:.3f} {shaft_end[2]:.3f} {end[0]:.3f} {end[1]:.3f} {end[2]:.3f} 0.240\n")


def _generate_ensemble_direction_map(
    *,
    outdir: Path,
    pair_meta: TopPairsMeta,
    feats: Sequence[FeatureStat],
    pair_metrics_by_fid: Mapping[int, Mapping[str, object]],
