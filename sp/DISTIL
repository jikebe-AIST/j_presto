        'corr_dense_max_pairs': int(corr_dense_max_pairs),
        'selected_features': int(F),
        'n_frames': int(n_frames_stage2),
        'seed': int(seed),
    }
    stage3matrix_ok, stage3matrix_state, stage3matrix_reasons = _cache_check_with_reasons(
        required_paths=[(stage3_z_npy, stage3_z_npy.name), (stage3_moments_npz, stage3_moments_npz.name)],
        meta_path=stage3_matrix_meta,
        done_path=stage3_matrix_done,
        want_meta=want3_matrix,
        stage_name='Stage3_selected_matrix',
        validators=[
            ('selected_matrix_npy', lambda: ((stage3_z_npy.exists() and tuple(np.load(stage3_z_npy, mmap_mode='r').shape) == tuple(stage3_z_shape)), f"ok: {stage3_z_npy.name}")),
            ('moments_npz', lambda: ((stage3_moments_npz.exists() and {'mu','inv_std','wa_scale','wb_scale'}.issubset(set(np.load(stage3_moments_npz, mmap_mode='r').files))), f"ok: {stage3_moments_npz.name}")),
        ],
    ) if not force else (False, 'miss', ['forced recompute'])
    if stage3matrix_ok:
        log_skip('Stage3: selected weighted standardized matrix', f'using cached {stage3_z_npy.name}')
        mom = np.load(stage3_moments_npz, mmap_mode='r')
        mu_full = np.asarray(mom['mu'], dtype=np.float64)
        inv_std_full = np.asarray(mom['inv_std'], dtype=np.float32)
        wa_scale = np.asarray(mom['wa_scale'], dtype=np.float32)
        wb_scale = np.asarray(mom['wb_scale'], dtype=np.float32)
    else:
        if not force and stage3matrix_state != 'first_run':
            kind = 'incomplete cache' if stage3matrix_state == 'incomplete' else 'cache miss'
            log_recalc('Stage3: selected weighted standardized matrix', kind)
            for msg in stage3matrix_reasons:
                log_why(msg)
        with SectionTimer('Stage3: materialize selected weighted standardized distances', enabled=True):
            mu_full, inv_std_full, _sw_full, wa_scale, wb_scale, z_shape_actual = _stage3_materialize_weighted_standardized_matrix(
                stage3_source, sel_fids, wA_s, wB_s,
                z_path=stage3_z_npy,
                moments_path=stage3_moments_npz,
                feature_block=block,
                row_idxA=row_idxA_stage3,
                row_idxB=row_idxB_stage3,
                progress_interval_sec=stage3_progress_interval_sec,
            )
            if tuple(z_shape_actual) != tuple(stage3_z_shape):
                raise RuntimeError(f'Stage3 materialized matrix shape mismatch: expected={stage3_z_shape} got={z_shape_actual}')
            _save_stage_meta(stage3_matrix_meta, want3_matrix)
            _write_stage_done_atomic(stage3_matrix_done, stage_name='Stage3_selected_matrix', meta=want3_matrix, outputs=[stage3_z_npy, stage3_moments_npz, stage3_matrix_meta], counts={'features': int(F), 'frames': int(n_frames_stage2)})
    log_info(f"Stage3 selected matrix: path={stage3_z_npy} shape={stage3_z_shape} size={_format_bytes(stage3_z_npy.stat().st_size if stage3_z_npy.exists() else 0)}")

    want3_exact = {
        'cache_version': _cache_version_sig(STAGE3_CACHE_VERSION),
        'stage': 'complete_corr_graph_v1',
        'stage1_scoring_meta': _content_sig(scoring_meta_path),
        'selected_feature_ids_final': _content_sig(sel_fids_path),
        'stage1_selected_feature_ids_all_auc': _content_sig(selected_feature_ids_path),
        'stage1_auc_frame_mode': str(stage1_auc_frame_mode),
        'stage1_auc_idxA_sig': _array_sig(stage1_auc_idxA),
        'stage1_auc_idxB_sig': _array_sig(stage1_auc_idxB),
        'selected_matrix_npy': _content_sig(stage3_z_npy),
        'moments_npz': _content_sig(stage3_moments_npz),
        'corr_tau_requested': _json_normalize(corr_tau_requested),
        'corr_tau_effective': float(tau_corr),
        'corr_block_requested': int(corr_block_requested),
        'corr_block_effective': int(block),
        'corr_method_requested': str(corr_method_requested),
        'corr_method_effective': str(corr_method_effective),
        'corr_exact_max_features': int(corr_exact_max_features),
        'corr_dense_max_pairs': int(corr_dense_max_pairs),
        'corr_sample_block': int(corr_sample_block),
        'corr_active_pair_batch': int(corr_active_pair_batch),
        'corr_active_switch_frac': float(corr_active_switch_frac),
        'corr_execution_profile': str(corr_execution_profile),
        'corr_dense_work_threshold': float(corr_dense_work_threshold),
        'corr_profile_probe_reject_threshold': float(corr_profile_probe_reject_threshold),
        'corr_profile_probe_units': int(corr_profile_probe_units),
        'corr_profile_probe_frames': int(corr_profile_probe_frames),
        'corr_profile_pruned_cost_ratio': float(corr_profile_pruned_cost_ratio),
        'corr_profile_dense_cost_ratio': float(corr_profile_dense_cost_ratio),
        'corr_profile_probe_seed': int(corr_profile_probe_seed),
        'edge_complete_for_threshold': True,
        'corr_graph_approximate': False,
        'selected_features': int(F),
        'n_frames': int(n_frames_stage2),
        'seed': int(seed),
    }
    stage3_corr_ok, stage3_corr_state, stage3_corr_reasons = _cache_check_with_reasons(
        required_paths=[(corr_csv, corr_csv.name)],
        meta_path=stage3_corr_meta,
        done_path=stage3_corr_done,
        want_meta=want3_exact,
        stage_name='Stage3_exact',
        validators=[('corr_csv', lambda: ((corr_csv.exists() and _csv_header_contains(corr_csv, ['f_id','g_id','corr'])), f"ok: {corr_csv.name}"))],
    ) if not force else (False, 'miss', ['forced recompute'])
    if stage3_corr_ok:
        log_skip('Stage3: complete corr graph', 'using cached feature_corr_edges.csv')
        corr_edges = []
        try:
            with open(corr_csv, 'r', encoding='utf-8') as f:
                for row in csv.DictReader(f):
                    corr_edges.append((int(row['f_id']), int(row['g_id']), float(row['corr'])))
        except Exception:
            corr_edges = []
    else:
        if not force and stage3_corr_state != 'first_run':
            kind = 'incomplete cache' if stage3_corr_state == 'incomplete' else 'cache miss'
            log_recalc('Stage3: complete corr graph', kind)
            for msg in stage3_corr_reasons:
                log_why(msg)
        with SectionTimer('Stage3: complete selected-feature distance correlation', enabled=True):
            if corr_method_effective == 'exact_blockwise':
                # Alternative exact blockwise path. The default path below uses exact_safe_reject
                # and may internally choose a dense-like profile for small jobs.
                corr_edges = _stage3_exact_corr_edges_from_z(
                    stage3_z_npy, stage3_z_shape, sel_fids,
                    tau_corr=tau_corr, block=block,
                    progress_interval_sec=stage3_progress_interval_sec,
                )
            elif corr_method_effective == 'exact_safe_reject':
                corr_edges = _stage3_exact_safe_reject_corr_edges_from_z(
                    stage3_z_npy, stage3_z_shape, sel_fids,
                    tau_corr=tau_corr, block=block, sample_block=corr_sample_block,
                    active_pair_batch=corr_active_pair_batch, active_switch_frac=corr_active_switch_frac,
                    execution_profile=corr_execution_profile,
                    dense_work_threshold=corr_dense_work_threshold,
                    probe_reject_threshold=corr_profile_probe_reject_threshold,
                    probe_units=corr_profile_probe_units,
                    probe_frames=corr_profile_probe_frames,
                    pruned_cost_ratio=corr_profile_pruned_cost_ratio,
                    dense_cost_ratio=corr_profile_dense_cost_ratio,
                    probe_seed=corr_profile_probe_seed,
                    matrix_bytes_est=matrix_bytes_est,
                    progress_interval_sec=stage3_progress_interval_sec,
                )
            else:
                raise RuntimeError(f'Unknown Stage3 corr method: {corr_method_effective}')
            def _write_stage3_corr(_fh):
                wcsv = csv.writer(_fh)
                wcsv.writerow(['f_id','g_id','corr'])
                for fi, gj, c in corr_edges:
                    wcsv.writerow([int(fi), int(gj), f"{float(c):.6f}"])
            _write_csv_atomic(corr_csv, _write_stage3_corr)
            _save_stage_meta(stage3_corr_meta, want3_exact)
            _write_stage_done_atomic(stage3_corr_done, stage_name='Stage3_exact', meta=want3_exact, outputs=[corr_csv, stage3_corr_meta], counts={'edges': int(len(corr_edges)), 'selected_features': int(F)})
    log_info(f"Stage3 complete correlation graph: method={corr_method_effective} edges={len(corr_edges)} edge_complete_for_threshold=yes")
    _pipeline_progress_emit(3, total_stages, "Stage3 complete", t0=pipeline_t0, extra=f"edges={len(corr_edges)}")

    # ============================================================
    # Stage 4: Bundling by community detection on feature corr graph
    # ============================================================
    bundles_csv = outdir / "bundles.csv"
    stage4_bundles_dir = cache_dir / "stage4_bundles"
    stage4_bundles_dir.mkdir(parents=True, exist_ok=True)
    stage4_meta = stage4_bundles_dir / "bundles_meta.json"
    stage4_done = stage4_bundles_dir / "bundles.done.json"

    # Stage4 cache signature (must be defined regardless of cache hit/miss)
    want4 = {
        "cache_version": _cache_version_sig(STAGE4_CACHE_VERSION),
        "corr_csv": _content_sig(corr_csv),
        "community_method": str(getattr(args, "community_method", "auto")),
        "community_backend_versions": _community_backend_versions(),
        "seed": int(seed),
    }

    bundles: list[dict] = []
    stage4_ok, stage4_state, stage4_reasons = _cache_check_with_reasons(
        required_paths=[(bundles_csv, bundles_csv.name)],
        meta_path=stage4_meta,
        done_path=stage4_done,
        want_meta=want4,
        stage_name='Stage4',
        validators=[('bundles_csv', lambda: ((_csv_row_count(bundles_csv) > 0), f"invalid_output: {bundles_csv.name} rows={_csv_row_count(bundles_csv)}"))],
    ) if not force else (False, 'miss', ['forced recompute'])
    if stage4_ok:
        log_skip("Stage4: bundles", "using cached bundles.csv")
        _stage4_cached_meta = _load_json(stage4_meta) if stage4_meta.exists() else {}
        log_info(f"Stage4 community backend (cached): requested={_stage4_cached_meta.get('community_method', getattr(args, 'community_method', 'auto'))} effective={_stage4_cached_meta.get('community_method_effective', 'unknown')}")
        with open(bundles_csv, "r", encoding="utf-8") as f:
            for row in csv.DictReader(f):
                bundles.append({
                    "bundle_id": int(row["bundle_id"]),
                    "members": [int(x) for x in str(row.get("member_fids", "") or "").split(";") if str(x).strip()],
                    "bundle_score": float(row.get("bundle_score", 0.0) or 0.0),
                    "bundle_size": int(row.get("bundle_size", 0) or 0),
                })
    elif not force and stage4_state != 'first_run':
        kind = 'incomplete cache' if stage4_state == 'incomplete' else 'cache miss'
        log_recalc('Stage4: bundles', kind)
        for msg in stage4_reasons:
            log_why(msg)

    if not bundles:
        with SectionTimer("Stage4: bundles", enabled=True):
            import networkx as nx
            stage4_progress_interval_sec = float(getattr(args, 'progress_interval_sec', 300.0) or 300.0)
            G = nx.Graph()
            # add nodes for all selected features
            for fid in sel_fids.tolist():
                G.add_node(int(fid))
            # add edges
            edge_rows_total = max(1, _csv_row_count(corr_csv))
            stage4_edge_logger = _progress_logger('Stage4/load_edges', total_units=edge_rows_total, min_interval_sec=stage4_progress_interval_sec)
            edge_rows_done = 0
            with open(corr_csv, "r", encoding="utf-8") as f:
                r = csv.DictReader(f)
                for row in r:
                    edge_rows_done += 1
                    fi = int(row["f_id"])
                    gj = int(row["g_id"])
                    c = float(row["corr"])
                    if c > 0:
                        G.add_edge(fi, gj, weight=c)
                    if _log_enabled('info'):
                        stage4_edge_logger(edge_rows_done)
            if _log_enabled('info'):
                stage4_edge_logger(edge_rows_done, force=True)
            log_info(f"Stage4 graph ready: nodes={G.number_of_nodes()} edges={G.number_of_edges()} method={str(getattr(args, 'community_method', 'auto'))}")
            log_info(f"Stage4 community detection start: method={str(getattr(args, 'community_method', 'auto'))} nodes={G.number_of_nodes()} edges={G.number_of_edges()}")
            _stage4_comm_t0 = time.perf_counter()
            comms, community_info = _community_detect_auto(G, seed=seed, method=str(getattr(args, "community_method", "auto")))
            log_info(f"Stage4 community detection end: requested={community_info.get('community_method_requested')} effective={community_info.get('community_method_effective')} communities={len(comms)} elapsed {time.perf_counter()-_stage4_comm_t0:.2f} s")
            if community_info.get('community_fallbacks'):
                log_warn("Stage4 community fallback details: " + " | ".join(str(x) for x in community_info.get('community_fallbacks', [])))
            # Split a community into spatially-separated parts by residue-level connected components.
            # near pairs are atom-level but are projected to residues using pair_meta.res_i/res_j (or fallback i/j).
            def _fid_res_endpoints(fid: int) -> tuple[int,int]:
                fid = int(fid)
                k = int(pair_meta.kind[fid]) if hasattr(pair_meta, "kind") else 0
                if k == 0:
                    ri = int(pair_meta.res_i[fid]) if int(pair_meta.res_i[fid]) >= 0 else int(pair_meta.i[fid])
                    rj = int(pair_meta.res_j[fid]) if int(pair_meta.res_j[fid]) >= 0 else int(pair_meta.j[fid])
                    return ri, rj
                # long
                return int(pair_meta.i[fid]), int(pair_meta.j[fid])

            def _split_members_by_res_cc(member_fids: list[int]) -> list[list[int]]:
                # Build residue graph
                adj: dict[int,set[int]] = {}
                residues: set[int] = set()
                for fid in member_fids:
                    ri, rj = _fid_res_endpoints(int(fid))
                    if ri < 0 or rj < 0:
                        continue
                    residues.add(ri); residues.add(rj)
                    adj.setdefault(ri,set())
                    adj.setdefault(rj,set())
                    if ri != rj:
                        adj[ri].add(rj); adj[rj].add(ri)
                if not residues:
                    return [member_fids]
                comp_of: dict[int,int] = {}
                comps: list[set[int]] = []
                for r0 in residues:
                    if r0 in comp_of:
                        continue
                    cid = len(comps)
                    stack=[r0]; comp=set([r0]); comp_of[r0]=cid
                    while stack:
                        r = stack.pop()
                        for nb in adj.get(r, ()):
                            if nb not in comp_of:
                                comp_of[nb]=cid
                                comp.add(nb)
                                stack.append(nb)
                    comps.append(comp)
                if len(comps) <= 1:
                    return [member_fids]
                parts = [[] for _ in range(len(comps))]
                for fid in member_fids:
                    ri, rj = _fid_res_endpoints(int(fid))
                    cid = comp_of.get(ri, comp_of.get(rj, 0))
                    parts[int(cid)].append(int(fid))
                parts = [p for p in parts if p]
                return parts if parts else [member_fids]

            # assign bundle ids (+ split by residue connected components)
            bundles = []
            n_comm = 0
            n_split = 0
            max_parts = 1
            for k, com in enumerate(comms):
                members0 = sorted(int(x) for x in com)
                if not members0:
                    continue
                n_comm += 1
                parts = _split_members_by_res_cc(members0)
                if len(parts) > 1:
                    n_split += 1
                    max_parts = max(max_parts, len(parts))
                for part in parts:
                    members = sorted(int(x) for x in part)
                    if not members:
                        continue
                    # bundle score: mean internal edge weight (0 if isolated)
                    if len(members) == 1:
                        bscore = 0.0
                    else:
                        sub = G.subgraph(members)
                        ws = [d.get("weight", 0.0) for _, _, d in sub.edges(data=True)]
                        bscore = float(np.mean(ws)) if ws else 0.0
                    bundles.append({"bundle_id": int(len(bundles)), "members": members, "bundle_score": bscore, "bundle_size": int(len(members))})
            log_info(f"[Stage4] bundle split by residue-CC: communities={n_comm}, bundles_after_split={len(bundles)}, split_communities={n_split}, max_parts={max_parts}")

            # deterministic ordering: largest bundle first then id
            bundles.sort(key=lambda b: (-int(b["bundle_size"]), int(b["bundle_id"])))

            # write
            def _write_stage4_bundles(_fh):
                wcsv = csv.writer(_fh)
                wcsv.writerow(["bundle_id","member_fids","bundle_score","bundle_size"])
                for b in bundles:
                    wcsv.writerow([b["bundle_id"], ";".join(map(str, b["members"])), f"{float(b['bundle_score']):.6f}", b["bundle_size"]])
            _write_csv_atomic(bundles_csv, _write_stage4_bundles)
            stage4_meta_payload = {**want4, **dict(community_info), 'communities_before_spatial_split': int(n_comm), 'bundles_after_spatial_split': int(len(bundles)), 'split_communities': int(n_split), 'max_spatial_parts': int(max_parts)}
            _save_stage_meta(stage4_meta, stage4_meta_payload)
            _write_stage_done_atomic(stage4_done, stage_name='Stage4', meta=stage4_meta_payload, outputs=[bundles_csv, stage4_meta], counts={'bundles': int(len(bundles))})


    _pipeline_progress_emit(4, total_stages, "Stage4 complete", t0=pipeline_t0, extra=f"bundles={len(bundles)}")

    # ============================================================
    # Stage 5: Region inference and ranking begins with contribution aggregation
    # ============================================================
    pair_contrib_csv = outdir / "pair_contrib.csv"
    pair_contrib_ranked_csv = outdir / "pair_contrib_ranked.csv"
    pair_contrib_ranked_pretty = outdir / "pair_contrib_ranked_pretty.txt"
    residue_contrib_csv = outdir / "residue_contrib.csv"
    region_contrib_csv = outdir / "region_contrib.csv"
    stage5_regions_dir = cache_dir / "stage5_regions"
    stage5_regions_dir.mkdir(parents=True, exist_ok=True)
    stage5_pair_meta = stage5_regions_dir / "aggregation_meta.json"
    stage5_pair_done = stage5_regions_dir / "aggregation.done.json"

    pair_metrics_by_fid: dict[int, dict[str, object]] = {}
    residue_contrib_map: dict[int, float] = {}
    multivar_auc = float('nan')
    multivar_auc_holdout = float('nan')
    multivar_auc_source = 'unavailable'

    def _stage5_pair_aux_metrics(fid: int, pm: Mapping[str, object] | None = None) -> dict[str, object]:
        pm = dict(pm or {})
        fs = fs_by_fid.get(int(fid))
        ced_score = float(getattr(fs, 'ced_effect_score', 0.0)) if fs is not None else float(pm.get('condition_effect_score', 0.0) or 0.0)
        sig_strength = float(getattr(fs, 'sig_strength', 0.0)) if fs is not None else float(pm.get('sig_strength', 0.0) or 0.0)
        ced_p_null = float(getattr(fs, 'ced_p_null', 1.0)) if fs is not None else float(pm.get('ced_p_null', 1.0) or 1.0)
        ced_q_null = float(getattr(fs, 'ced_q_null', 1.0)) if fs is not None else float(pm.get('ced_q_null', 1.0) or 1.0)
        transport_w1 = float(getattr(fs, 'transport_w1', 0.0)) if fs is not None else float(pm.get('transport_w1', 0.0) or 0.0)
        transport_signed = float(getattr(fs, 'transport_signed', 0.0)) if fs is not None else float(pm.get('transport_signed', 0.0) or 0.0)
        transport_ratio = float(getattr(fs, 'transport_ratio', 0.0)) if fs is not None else float(pm.get('transport_ratio', 0.0) or 0.0)
        if selection_mode_main == 'ced':
            stage5_score_name = 'condition_effect_score'
            stage5_score = ced_score
        elif selection_mode_main == 'sig':
            stage5_score_name = 'sig_strength'
            stage5_score = sig_strength
        else:
            stage5_score_name = 'contribution_multi'
            stage5_score = float(pm.get('contribution_multi', 0.0) or 0.0)
        return {
            'condition_effect_score': float(ced_score),
            'sig_strength': float(sig_strength),
            'ced_p_null': float(ced_p_null),
            'ced_q_null': float(ced_q_null),
            'transport_w1': float(transport_w1),
            'transport_signed': float(transport_signed),
            'transport_ratio': float(transport_ratio),
            'stage5_score': float(stage5_score),
            'stage5_score_name': str(stage5_score_name),
        }

    want5_pair = {
        'cache_version': int(STAGE5_PAIR_CACHE_VERSION),
        'cache_namespace': CACHE_NAMESPACE,
        'output_schema': 'pair_contrib_v1_active_stage5_metric',
        'selection_mode': str(selection_mode_main),
        'feature_contributions': _content_sig(feature_contrib_csv),
        'bundles_csv': _content_sig(bundles_csv),
        'pair_meta': _content_sig(pairs_csv),
        'stage1_feature_stats': _content_sig(stage1_cache),
        'stage_schema': 'distil_pipeline_v1',
    }
    stage5_pair_cache_ok, stage5_pair_state, stage5_pair_reasons = _cache_check_with_reasons(
        required_paths=[(pair_contrib_csv, pair_contrib_csv.name), (pair_contrib_ranked_csv, pair_contrib_ranked_csv.name), (pair_contrib_ranked_pretty, pair_contrib_ranked_pretty.name), (residue_contrib_csv, residue_contrib_csv.name)],
        meta_path=stage5_pair_meta,
        done_path=stage5_pair_done,
        want_meta=want5_pair,
        stage_name='Stage5_aggregation',
        validators=[
            ('pair_contrib_csv', lambda: ((
                _csv_row_count(pair_contrib_csv) == int(len(sel_fids))
                and _csv_header_contains(pair_contrib_csv, ['fid','pair_type','stage5_score','stage5_score_name','bundle_id'])
            ), f"invalid_output: {pair_contrib_csv.name} rows={_csv_row_count(pair_contrib_csv)} expected={int(len(sel_fids))}")),
            ('residue_contrib_csv', lambda: ((
                _csv_header_contains(residue_contrib_csv, ['res_idx','contribution','near_contribution','long_contribution'])
            ), f"invalid_output: {residue_contrib_csv.name} missing required header")),
        ],
    ) if not force else (False, 'miss', ['forced recompute'])
    if stage5_pair_cache_ok:
        log_skip("Stage5: contribution aggregation", "using cached pair_contrib.csv/residue_contrib.csv")
        with open(pair_contrib_csv, 'r', encoding='utf-8') as f:
            for row in csv.DictReader(f):
                fid = int(row['fid'])
                pair_metrics_by_fid[fid] = {
                    'tv_c': float(row.get('tv', 'nan')),
                    'auc_single': float(row.get('auc_single', 'nan')),
                    'contribution_multi': float(row.get('contribution_multi', '0') or 0.0),
                    'coef_multi': float(row.get('coef_multi', '0') or 0.0),
                    'feature_std': float(row.get('feature_std', '0') or 0.0),
                    'pair_type': row.get('pair_type', ''),
                    'bundle_id': int(row.get('bundle_id', '-1') or -1),
                    'multivar_selected': int(row.get('multivar_selected', '0') or 0),
                    'condition_effect_score': float(row.get('condition_effect_score', '0') or 0.0),
                    'sig_strength': float(row.get('sig_strength', '0') or 0.0),
                    'ced_p_null': float(row.get('ced_p_null', '1') or 1.0),
                    'ced_q_null': float(row.get('ced_q_null', '1') or 1.0),
                    'transport_w1': float(row.get('transport_w1', '0') or 0.0),
                    'transport_signed': float(row.get('transport_signed', '0') or 0.0),
                    'transport_ratio': float(row.get('transport_ratio', '0') or 0.0),
                    'stage5_score': float(row.get('stage5_score', '0') or 0.0),
                    'stage5_score_name': str(row.get('stage5_score_name', '') or ''),
                }
                pair_metrics_by_fid[fid].update(_stage5_pair_aux_metrics(fid, pair_metrics_by_fid[fid]))
                if 'multivar_auc' in row:
                    try:
                        multivar_auc = float(row.get('multivar_auc', 'nan'))
                        multivar_auc_source = 'pair_contrib.csv'
                    except Exception:
                        pass
        with open(residue_contrib_csv, 'r', encoding='utf-8') as f:
            for row in csv.DictReader(f):
                residue_contrib_map[int(row['res_idx'])] = float(row.get('contribution', '0'))
    else:
        if not force and stage5_pair_state != 'first_run':
            kind = 'incomplete cache' if stage5_pair_state == 'incomplete' else 'cache miss'
            log_recalc('Stage5: contribution aggregation', kind)
            for msg in stage5_pair_reasons:
                log_why(msg)
        with SectionTimer("Stage5: contribution aggregation", enabled=True):
            bundle_members = {}
            fid_to_bundle = {}
            with open(bundles_csv, 'r', encoding='utf-8') as f:
                for row in csv.DictReader(f):
                    bid = int(row['bundle_id'])
                    mem = [int(x) for x in str(row.get('member_fids','') or '').split(';') if str(x).strip()]
                    bundle_members[bid] = mem
                    for fid in mem:
                        fid_to_bundle[int(fid)] = bid
            with open(feature_contrib_csv, 'r', encoding='utf-8') as f:
                for row in csv.DictReader(f):
                    fid = int(row['fid'])
                    pair_metrics_by_fid[fid] = {
                        'pair_type': row.get('pair_type', ''),
                        'tv_c': float(row.get('tv', 'nan')),
                        'auc_single': float(row.get('auc_single', 'nan')),
                        'coef_multi': float(row.get('coef_multi', '0') or 0.0),
                        'feature_std': float(row.get('feature_std', '0') or 0.0),
                        'contribution_multi': float(row.get('contribution', '0') or 0.0),
                        'multivar_selected': int(row.get('selected_by_model', '0') or 0),
                        'bundle_id': int(fid_to_bundle.get(fid, -1)),
                    }
                    pair_metrics_by_fid[fid].update(_stage5_pair_aux_metrics(fid, pair_metrics_by_fid[fid]))
                    if 'multivar_auc' in row:
                        try:
                            multivar_auc = float(row.get('multivar_auc', 'nan'))
                            multivar_auc_source = 'feature_contributions.csv'
                        except Exception:
                            pass
                    if 'multivar_auc_holdout' in row:
                        try:
                            multivar_auc_holdout = float(row.get('multivar_auc_holdout', 'nan'))
                        except Exception:
                            pass

            _pair_output_header = [
                'fid','pair_type','atom_i','atom_j','res_i','res_j','tv','auc_single',
                'coef_multi','feature_std','contribution_multi','multivar_selected',
                'condition_effect_score','sig_strength','ced_p_null','ced_q_null',
                'transport_w1','transport_signed','transport_ratio',
                'stage5_score','stage5_score_name','bundle_id','multivar_auc',
            ]

            def _stage5_pair_output_row(fid: int, pm: Mapping[str, object], rank_idx: int | None = None) -> list[object]:
                kind = int(pair_meta.kind[fid]) if (0 <= fid < len(pair_meta)) else 1
                ai = int(pair_meta.atom_i[fid]) if (0 <= fid < len(pair_meta) and kind == 0) else -1
                aj = int(pair_meta.atom_j[fid]) if (0 <= fid < len(pair_meta) and kind == 0) else -1
                ri = int(_meta_res(pair_meta, fid, 'i')) if 0 <= fid < len(pair_meta) else -1
                rj = int(_meta_res(pair_meta, fid, 'j')) if 0 <= fid < len(pair_meta) else -1
                row = [
                    int(fid), pm.get('pair_type',''), ai, aj, ri, rj,
                    _format_float_csv(pm.get('tv_c', float('nan'))),
                    _format_float_csv(pm.get('auc_single', float('nan'))),
                    _format_float_csv(pm.get('coef_multi', 0.0)),
                    _format_float_csv(pm.get('feature_std', 0.0)),
                    _format_float_csv(pm.get('contribution_multi', 0.0)),
                    int(pm.get('multivar_selected', 0)),
                    _format_float_csv(pm.get('condition_effect_score', 0.0)),
                    _format_float_csv(pm.get('sig_strength', 0.0)),
                    _format_float_csv(pm.get('ced_p_null', 1.0)),
                    _format_float_csv(pm.get('ced_q_null', 1.0)),
                    _format_float_csv(pm.get('transport_w1', 0.0)),
                    _format_float_csv(pm.get('transport_signed', 0.0)),
                    _format_float_csv(pm.get('transport_ratio', 0.0)),
                    _format_float_csv(pm.get('stage5_score', 0.0)),
                    str(pm.get('stage5_score_name', '') or ''),
                    int(pm.get('bundle_id', -1)),
                    _format_float_csv(multivar_auc),
                ]
                return ([int(rank_idx)] + row) if rank_idx is not None else row

            def _write_stage5_pair(_fh):
                wcsv = csv.writer(_fh)
                wcsv.writerow(_pair_output_header)
                for fid in sorted(pair_metrics_by_fid):
                    wcsv.writerow(_stage5_pair_output_row(int(fid), pair_metrics_by_fid[int(fid)]))

            residue_near = defaultdict(float); residue_long = defaultdict(float)
            residue_count = defaultdict(int)
            stage5_progress_interval_sec = float(getattr(args, 'progress_interval_sec', 300.0) or 300.0)
            stage5_res_logger = _progress_logger('Stage5/residue_rollup', total_units=max(1, len(pair_metrics_by_fid)), min_interval_sec=stage5_progress_interval_sec)
            for idx_pm, (fid, pm) in enumerate(pair_metrics_by_fid.items(), start=1):
                c = float(pm.get('contribution_multi', 0.0))
                if not np.isfinite(c) or c == 0.0:
                    if _log_enabled('info'):
                        stage5_res_logger(idx_pm, active=len(residue_contrib_map), force=False)
                    continue
                kind = str(pm.get('pair_type', ''))
                ri = int(_meta_res(pair_meta, fid, 'i'))
                rj = int(_meta_res(pair_meta, fid, 'j'))
                if ri == rj:
                    residue_contrib_map[ri] = residue_contrib_map.get(ri, 0.0) + c
                    residue_count[ri] += 1
                    if kind == 'near': residue_near[ri] += c
                    else: residue_long[ri] += c
                else:
                    for rix in (ri, rj):
                        residue_contrib_map[rix] = residue_contrib_map.get(rix, 0.0) + 0.5 * c
                        residue_count[rix] += 1
                        if kind == 'near': residue_near[rix] += 0.5 * c
                        else: residue_long[rix] += 0.5 * c
                if _log_enabled('info'):
                    stage5_res_logger(idx_pm, active=len(residue_contrib_map), force=False)
            if _log_enabled('info'):
                stage5_res_logger(len(pair_metrics_by_fid), active=len(residue_contrib_map), force=True)

            _write_csv_atomic(pair_contrib_csv, _write_stage5_pair)
            ranked_pair_rows = sorted(
                pair_metrics_by_fid.items(),
                key=_stage5_pair_rank_key,
                reverse=True,
            )

            def _write_stage5_pair_ranked(_fh):
                wcsv = csv.writer(_fh)
                wcsv.writerow(['rank'] + _pair_output_header)
                for rank_idx, (fid, pm) in enumerate(ranked_pair_rows, start=1):
                    wcsv.writerow(_stage5_pair_output_row(int(fid), pm, rank_idx=int(rank_idx)))
            _write_csv_atomic(pair_contrib_ranked_csv, _write_stage5_pair_ranked)

            def _write_stage5_pair_ranked_pretty(path: Path):
                with open(path, 'w', encoding='utf-8') as fo:
                    fo.write('# DISTIL Stage5 ranked pair scores\n')
                    fo.write(f'# source_csv: {pair_contrib_ranked_csv.name}\n')
                    fo.write(f'# selection_mode: {selection_mode_main}\n')
                    fo.write(f'# primary_pair_score: {_stage5_pair_aux_metrics(int(ranked_pair_rows[0][0]), ranked_pair_rows[0][1]).get("stage5_score_name", "") if ranked_pair_rows else "none"}\n\n')
                    for rank_idx, (fid, pm) in enumerate(ranked_pair_rows, start=1):
                        fo.write('=' * 72 + '\n')
                        fo.write(f'Rank {rank_idx}\n')
                        fo.write('=' * 72 + '\n')
                        fo.write(f'  fid                    : {fid}\n')
                        fo.write(f'  pair_type              : {pm.get("pair_type", "")}\n')
                        fo.write(f'  stage5_score_name      : {pm.get("stage5_score_name", "")}\n')
                        fo.write(f'  stage5_score           : {float(pm.get("stage5_score", 0.0)):.6f}\n')
                        fo.write(f'  auc_single             : {float(pm.get("auc_single", float("nan"))):.6f}\n')
                        fo.write(f'  tv                     : {float(pm.get("tv_c", float("nan"))):.6f}\n')
                        fo.write(f'  contribution_multi     : {float(pm.get("contribution_multi", 0.0)):.6f}\n')
                        if selection_mode_main == 'ced':
                            fo.write(f'  condition_effect_score : {float(pm.get("condition_effect_score", 0.0)):.6f}\n')
                            fo.write(f'  ced_p_null             : {float(pm.get("ced_p_null", 1.0)):.6g}\n')
                            fo.write(f'  ced_q_null             : {float(pm.get("ced_q_null", 1.0)):.6g}\n')
                            fo.write(f'  transport_ratio        : {float(pm.get("transport_ratio", 0.0)):.6f}\n')
                        elif selection_mode_main == 'sig':
                            fo.write(f'  sig_strength           : {float(pm.get("sig_strength", 0.0)):.6f}\n')
                        else:
                            fo.write(f'  coef_multi             : {float(pm.get("coef_multi", 0.0)):.6f}\n')
                            fo.write(f'  feature_std            : {float(pm.get("feature_std", 0.0)):.6f}\n')
                        fo.write(f'  bundle_id              : {int(pm.get("bundle_id", -1))}\n\n')
            _write_stage5_pair_ranked_pretty(pair_contrib_ranked_pretty)
            def _write_stage5_residue(_fh):
                wcsv = csv.writer(_fh)
                wcsv.writerow(['res_idx','chain','resid','resname','contribution','supporting_pair_count','near_contribution','long_contribution'])
                for ri in sorted(residue_contrib_map):
                    if 0 <= ri < len(res_keys):
                        chain, resid = res_keys[ri]
                        resn = ''
                        if 0 <= ri < len(atoms_by_res) and atoms_by_res[ri]:
                            ak0 = int(atoms_by_res[ri][0])
                            if 0 <= ak0 < len(atoms_sel):
                                resn = str(atoms_sel[ak0].resname).strip()
                    else:
                        chain, resid, resn = '', -1, ''
                    wcsv.writerow([ri, chain, resid, resn, f"{float(residue_contrib_map.get(ri,0.0)):.6f}", int(residue_count.get(ri,0)), f"{float(residue_near.get(ri,0.0)):.6f}", f"{float(residue_long.get(ri,0.0)):.6f}"])
            _write_csv_atomic(residue_contrib_csv, _write_stage5_residue)
            nz_near = sum(1 for fid, pm in pair_metrics_by_fid.items() if pm.get('pair_type','') == 'near' and int(pm.get('multivar_selected', 0)) == 1)
            nz_long = sum(1 for fid, pm in pair_metrics_by_fid.items() if pm.get('pair_type','') == 'long' and int(pm.get('multivar_selected', 0)) == 1)
            log_info(f"[Stage5] multivariate AUC(fitted)={multivar_auc if np.isfinite(multivar_auc) else float('nan'):.4f} holdout={multivar_auc_holdout if np.isfinite(multivar_auc_holdout) else float('nan'):.4f} pairs={len(pair_metrics_by_fid)} nonzero_near={nz_near} nonzero_long={nz_long} residues={len(residue_contrib_map)}")
            if int(nz_near + nz_long) == 0:
                log_info('Stage5 degenerate: no multivariate features selected')
                log_info('Stage5 final ranking uses Stage5-weight lexicographic order; auc_excess is only a formal tie-breaker, not a fallback ranking mode')
            try:
                (outdir / 'contribution_status.json').write_text(json.dumps({
                    'n_nonzero_multi': int(nz_near + nz_long),
                    'multivar_auc_fitted': float(multivar_auc) if np.isfinite(multivar_auc) else None,
                    'multivar_auc_holdout': float(multivar_auc_holdout) if np.isfinite(multivar_auc_holdout) else None,
                    'is_degenerate': bool(int(nz_near + nz_long) == 0),
                    'selected_features': int(len(pair_metrics_by_fid)),
                }, indent=2, sort_keys=True), encoding='utf-8')
            except Exception:
                pass
            _save_stage_meta(stage5_pair_meta, want5_pair)
            _write_stage_done_atomic(stage5_pair_done, stage_name='Stage5_aggregation', meta=want5_pair, outputs=[pair_contrib_csv, pair_contrib_ranked_csv, pair_contrib_ranked_pretty, residue_contrib_csv, stage5_pair_meta], counts={'pairs': int(len(pair_metrics_by_fid)), 'residues': int(len(residue_contrib_map))})

    # ============================================================
    # Stage 5: Region inference by weighted Max-Cut on element graph
    # ============================================================

    bundle_regions_csv = outdir / "bundle_regions.csv"
    stage5_regions_meta = stage5_regions_dir / "region_meta.json"
    stage5_regions_done = stage5_regions_dir / "region.done.json"

    supporting_topK = int(getattr(args, "supporting_topK", getattr(args, "supporting_topK", 50)))
    maxcut_max_iter = int(getattr(args, "maxcut_max_iter", getattr(args, "maxcut_max_iter", 1000)))
    maxcut_restarts = max(1, int(getattr(args, "maxcut_restarts", 3)))

    global_auc_txt = outdir / "global_ensemble_difference.txt"
    if stage5_pair_cache_ok or not np.isfinite(multivar_auc):
        if global_auc_txt.exists():
            try:
                raw = global_auc_txt.read_text(encoding="utf-8").strip()
                if raw:
                    token = raw.split()[-1]
                    val = float(token)
                    if np.isfinite(val):
                        multivar_auc = float(val)
                        multivar_auc_source = 'global_ensemble_difference.txt'
            except Exception:
                pass
        if not np.isfinite(multivar_auc):
            try:
                with open(pair_contrib_csv, 'r', encoding='utf-8') as f:
                    for row in csv.DictReader(f):
                        if 'multivar_auc' in row:
                            val = float(row.get('multivar_auc', 'nan'))
                            if np.isfinite(val):
                                multivar_auc = float(val)
                                multivar_auc_source = 'pair_contrib.csv'
                                break
            except Exception:
                pass
        if not np.isfinite(multivar_auc) and region_contrib_csv.exists():
            try:
                with open(region_contrib_csv, 'r', encoding='utf-8') as f:
                    for row in csv.DictReader(f):
                        if 'multivar_auc' in row:
                            val = float(row.get('multivar_auc', 'nan'))
                            if np.isfinite(val):
                                multivar_auc = float(val)
                                multivar_auc_source = 'region_contrib.csv'
                                break
            except Exception:
                pass
    try:
        if selection_mode_main == 'standard':
            log_info(f"Global ensemble difference (multivariate AUC on fitted model) = {multivar_auc:.6f}" if np.isfinite(multivar_auc) else "Global ensemble difference (multivariate AUC on fitted model) = NA (standard-mode contribution model unavailable)")
            try:
                status_path = outdir / 'contribution_status.json'
                if status_path.exists():
                    st = json.loads(status_path.read_text(encoding='utf-8'))
                    mvh = st.get('multivar_auc_holdout', None)
                    if mvh is not None:
                        log_info(f"Global ensemble difference (multivariate AUC on holdout blocks) = {float(mvh):.6f}")
            except Exception:
                pass
            value_text = (f"global_auc\t{multivar_auc:.6f}\n" if np.isfinite(multivar_auc) else "global_auc\tNA\nreason\tstandard_contribution_model_unavailable\n")
            global_auc_txt.write_text(value_text, encoding="utf-8")
            log_info(f"[Stage5] global AUC source={multivar_auc_source} written=global_ensemble_difference.txt")
        else:
            log_info(f"Global ensemble difference (multivariate AUC) = NA because selection_mode={selection_mode_main}; Stage2 contribution learning is skipped and Stage5 uses {('sig_strength' if selection_mode_main == 'sig' else 'ced_effect_score')}")
            value_text = (
                "global_auc\tNA\n"
                f"reason\tskipped_nonstandard_selection_mode\n"
                f"selection_mode\t{selection_mode_main}\n"
                f"stage5_weight\t{('sig_strength' if selection_mode_main == 'sig' else 'ced_effect_score')}\n"
            )
            global_auc_txt.write_text(value_text, encoding="utf-8")
            log_info("[Stage5] global AUC marked NA in global_ensemble_difference.txt for non-standard selection mode.")
    except Exception:
        pass

    # Determine the feature weight used by Stage5 region inference/ranking.
    # Standard mode is contribution-only.  Explicit sig mode is sig_strength-only,
    # independent of whether the multivariate contribution model produced nonzero
    # coefficients.  This keeps the Stage5 ranking semantics aligned with the
    # user's feature-selection mode and prevents silent metric switching.
    selection_mode_for_stage5 = _normalize_selection_mode(getattr(args, 'selection_mode', 'standard'))
    contrib_vals_stage5 = []
    for _fid_m, _pm_m in pair_metrics_by_fid.items():
        try:
            _c_m = float(_pm_m.get('contribution_multi', 0.0))
            if np.isfinite(_c_m):
                contrib_vals_stage5.append(abs(_c_m))
        except Exception:
            pass
    contribution_nonzero_stage5 = any(float(_c) > 1e-12 for _c in contrib_vals_stage5)
    sig_strength_by_fid_stage5 = {}
    sig_strength_vals_stage5 = []
    for _fs_m in feats:
        try:
            _fid_m = int(_fs_m.fid)
            _s_m = float(getattr(_fs_m, 'sig_strength', 0.0))
            sig_strength_by_fid_stage5[_fid_m] = _s_m
            if np.isfinite(_s_m):
                sig_strength_vals_stage5.append(abs(_s_m))
        except Exception:
            pass
    sig_strength_nonzero_stage5 = any(float(_s) > 1e-12 for _s in sig_strength_vals_stage5)
    ced_effect_by_fid_stage5 = {}
    ced_effect_vals_stage5 = []
    for _fs_m in feats:
        try:
            _fid_m = int(_fs_m.fid)
            _c_m = float(getattr(_fs_m, 'ced_effect_score', 0.0))
            ced_effect_by_fid_stage5[_fid_m] = _c_m
            if np.isfinite(_c_m):
                ced_effect_vals_stage5.append(abs(_c_m))
        except Exception:
            pass
    ced_effect_nonzero_stage5 = any(float(_c) > 1e-12 for _c in ced_effect_vals_stage5)
    stage5_region_weight_mode = 'contribution'
    stage5_weight_formula = 'abs(contribution_multi)'
    stage5_weight_reason = 'standard mode ranks Stage5 regions by multivariate contribution scores'
    stage5_weight_by_fid = None
    if selection_mode_for_stage5 == 'sig':
        stage5_region_weight_mode = 'sig_strength'
        stage5_weight_formula = 'sig_strength = sum(|mean_A_bin - mean_B_bin| * -log10(p_bin)) over significant important bins'
        stage5_weight_reason = 'explicit -sm sig ranks Stage5 regions lexicographically by run-bin significance strength; auc_excess is used only as a deterministic tie-breaker'
        stage5_weight_by_fid = dict(sig_strength_by_fid_stage5)
        if sig_strength_nonzero_stage5:
            log_info('Stage5 region ranking uses sig_strength because selection_mode=sig.')
        else:
            raise SystemExit('[DISTIL] Stage5 cannot rank sig-mode results: all sig_strength values are zero. No fallback to AUC/TV is performed because that would change the selected ranking metric silently.')
    elif selection_mode_for_stage5 == 'ced':
        stage5_region_weight_mode = 'ced_effect_score'
        stage5_weight_formula = 'ced_effect_score = D_between * log(R_within) * Z_within * log(R_null) * Z_null * max(-log10(p_null),1), where D_null is obtained from pooled-label run splits'
        stage5_weight_reason = 'explicit -sm ced ranks Stage5 regions lexicographically by condition-excess difference scores; auc_excess is used only as a deterministic tie-breaker'
        stage5_weight_by_fid = dict(ced_effect_by_fid_stage5)
        if ced_effect_nonzero_stage5:
            log_info('Stage5 region ranking uses ced_effect_score because selection_mode=ced.')
        else:
            raise SystemExit('[DISTIL] Stage5 cannot rank CED-mode results: all ced_effect_score values are zero. No fallback to AUC/TV is performed because that would change the selected ranking metric silently.')
    else:
        stage5_weight_by_fid = {int(fid): abs(float(pair_metrics_by_fid.get(int(fid), {}).get('contribution_multi', 0.0))) for fid in pair_metrics_by_fid}
        if contribution_nonzero_stage5:
            log_info('Stage5 region ranking uses lexicographic multivariate contribution scores; auc_excess is used only when contribution-score rows remain tied.')
        else:
            raise SystemExit('[DISTIL] Stage5 cannot rank standard-mode results: all multivariate contribution scores are zero. No fallback to AUC/TV is performed because contribution-based ranking would be undefined.')

    try:
        stage5_weight_signature = hashlib.sha256(_json_canonical_dumps({str(int(k)): float(v) for k, v in sorted((stage5_weight_by_fid or {}).items())}).encode('utf-8')).hexdigest()[:16]
    except Exception:
        stage5_weight_signature = 'unavailable'

    region_build_weight_requested = str(getattr(args, 'region_build_weight', 'auto') or 'auto')
    if region_build_weight_requested == 'auto':
        if selection_mode_for_stage5 == 'sig':
            region_build_weight_mode = 'stage5_weight'
        elif selection_mode_for_stage5 == 'ced':
            region_build_weight_mode = 'stage5_weight'
        else:
            region_build_weight_mode = 'auc_excess'
    else:
        region_build_weight_mode = region_build_weight_requested
    region_build_weight_by_fid = {}
    for _fid, _pm in pair_metrics_by_fid.items():
        _fid_i = int(_fid)
        _auc = float(_pm.get('auc_single', float('nan')))
        _tv = float(_pm.get('tv_c', _pm.get('tv', 0.0)))
        _contrib = abs(float(_pm.get('contribution_multi', 0.0)))
        _stage5_w = float((stage5_weight_by_fid or {}).get(_fid_i, 0.0))
        if region_build_weight_mode == 'tv':
            _w = _tv
        elif region_build_weight_mode == 'unit':
            _w = 1.0
        elif region_build_weight_mode == 'contribution':
            _w = _contrib
        elif region_build_weight_mode == 'stage5_weight':
            _w = abs(_stage5_w)
        else:
            _w = max(0.0, _auc - 0.5) if np.isfinite(_auc) else 0.0
        region_build_weight_by_fid[_fid_i] = float(_w if np.isfinite(_w) else 0.0)
    try:
        region_build_weight_signature = hashlib.sha256(_json_canonical_dumps({str(int(k)): float(v) for k, v in sorted(region_build_weight_by_fid.items())}).encode('utf-8')).hexdigest()[:16]
    except Exception:
        region_build_weight_signature = 'unavailable'
    log_info(
        f"Stage5 region construction weight={region_build_weight_mode} "
        f"(auc_excess=max(0,AUC-0.5) when active); "
        f"ranking=lexicographic cross-stage5 weights, tie=lexicographic cross-auc_excess"
    )

    want5_regions = {
        "cache_version": int(STAGE5_REGION_CACHE_VERSION),
        "cache_namespace": CACHE_NAMESPACE,
        "stage5_region_weight_mode": str(stage5_region_weight_mode),
        "stage5_weight_formula": str(stage5_weight_formula),
        "stage5_weight_signature": str(stage5_weight_signature),
        "region_build_weight_requested": str(region_build_weight_requested),
        "region_build_weight_mode": str(region_build_weight_mode),
        "region_build_weight_signature": str(region_build_weight_signature),
        "ranking_policy": "stage5_lexicographic_then_auc_excess_v1",
        "rank_lexicographic_top_k": int(RANK_LEXICOGRAPHIC_TOP_K),
        "pair_contrib_csv": _content_sig(pair_contrib_csv),
        "feature_contributions_csv": _content_sig(feature_contrib_csv),
        "bundles_csv": _content_sig(bundles_csv),
        "supporting_topK": int(supporting_topK),
        "maxcut_max_iter": int(maxcut_max_iter),
        "maxcut_restarts": int(maxcut_restarts),
        "seed": int(seed),
    }

    stage5_regions_cache_ok, stage5_regions_state, stage5_regions_reasons = _cache_check_with_reasons(
        required_paths=[(bundle_regions_csv, bundle_regions_csv.name)],
        meta_path=stage5_regions_meta,
        done_path=stage5_regions_done,
        want_meta=want5_regions,
        stage_name='Stage5_regions',
        validators=[('bundle_regions_csv', lambda: ((_csv_row_count(bundle_regions_csv) > 0), f"invalid_output: {bundle_regions_csv.name} rows={_csv_row_count(bundle_regions_csv)}"))],
    ) if not force else (False, 'miss', ['forced recompute'])
    if stage5_regions_cache_ok:
        log_skip("Stage5: region inference", "using cached bundle_regions.csv")
    else:
        if not force and stage5_regions_state != 'first_run':
            kind = 'incomplete cache' if stage5_regions_state == 'incomplete' else 'cache miss'
            log_recalc('Stage5: region inference', kind)
            for msg in stage5_regions_reasons:
                log_why(msg)
        with SectionTimer("Stage5: region inference", enabled=True):
            # Prepare per-feature TV/AUC/contribution lookup
            tv_by_fid = {}
            auc_by_fid = {}
            contrib_by_fid = {}
            kind_by_fid = {}
            minv_by_fid = {}
            maxv_by_fid = {}
            bins_by_fid = {}
            for fs in feats:
                fid = int(fs.fid)
                tv_by_fid[fid] = float(fs.tv)
                auc_by_fid[fid] = float(pair_metrics_by_fid.get(fid, {}).get('auc_single', float('nan')) )
                contrib_by_fid[fid] = float(pair_metrics_by_fid.get(fid, {}).get('contribution_multi', float('nan')) )
                kind_by_fid[fid] = int(fs.kind)
                minv_by_fid[fid] = float(fs.minv)
                maxv_by_fid[fid] = float(fs.maxv)
                bins_by_fid[fid] = int(fs.bins)

            # Compute per-bundle (A,B). Thread pool keeps pickling overhead small.
            rows = []
            stage5_regions_progress_interval_sec = float(getattr(args, 'progress_interval_sec', 300.0) or 300.0)
            bundle_workers, bundle_workers_detail = _resolve_stage_workers(int(getattr(args, 'bundle_workers', 0) or 0), stage='stage5_regions', item_count=len(bundles))
            max_workers = int(bundle_workers)
            stage5_regions_logger = _progress_logger('Stage5/regions', total_units=max(1, len(bundles)), min_interval_sec=stage5_regions_progress_interval_sec)
            log_info(f"Stage5 region workers: bundle={max_workers} ({bundle_workers_detail}) bundles={len(bundles)}")
            stage5_region_tasks = [(int(b["bundle_id"]), [int(x) for x in b["members"]]) for b in bundles]
            stage5_region_backend = 'process' if max_workers > 1 else 'sequential'
            log_info(f"Stage5 region backend: {stage5_region_backend}")
            if max_workers > 1:
                with ProcessPoolExecutor(max_workers=max_workers, initializer=_stage6_regions_init, initargs=(tv_by_fid, auc_by_fid, contrib_by_fid, kind_by_fid, pair_meta, int(seed), int(maxcut_restarts), int(maxcut_max_iter), int(supporting_topK), stage5_weight_by_fid, stage5_region_weight_mode, region_build_weight_by_fid, region_build_weight_mode)) as ex:
                    done_regions = 0
                    for row in ex.map(_stage6_solve_one_bundle, stage5_region_tasks, chunksize=1):
                        rows.append(row)
                        done_regions += 1
                        if _log_enabled('info'):
                            stage5_regions_logger(done_regions, active=max(0, len(stage5_region_tasks) - done_regions))
            else:
                _stage6_regions_init(tv_by_fid, auc_by_fid, contrib_by_fid, kind_by_fid, pair_meta, int(seed), int(maxcut_restarts), int(maxcut_max_iter), int(supporting_topK), stage5_weight_by_fid, stage5_region_weight_mode, region_build_weight_by_fid, region_build_weight_mode)
                done_regions = 0
                for task in stage5_region_tasks:
                    rows.append(_stage6_solve_one_bundle(task))
                    done_regions += 1
                    if _log_enabled('info'):
                        stage5_regions_logger(done_regions, active=max(0, len(stage5_region_tasks) - done_regions))
            if _log_enabled('info'):
                stage5_regions_logger(len(rows), active=0, force=True)

            # Assign the final Stage5 ranking rank to every bundle/region row before
            # writing bundle_regions.csv.  The CSV remains sorted by bundle_id for stable
            # lookup, but the explicit rank column records the lexicographic ranking used
            # later in ranked_pairs.csv and the pretty outputs.
            def _stage5_region_rank_key_for_csv(d):
                def _f_local(x) -> float:
                    try:
                        return float(x)
                    except Exception:
                        return 0.0
                def _rank_tuple_local(key: str):
                    txt = d.get(key, '')
                    if txt:
                        return _rank_text_to_tuple(txt, top_k=RANK_LEXICOGRAPHIC_TOP_K)
                    if key == 'rank_stage5_top_values':
                        return _rank_text_to_tuple(d.get('rank_score', d.get('max_stage5_weight_cross', '0')), top_k=RANK_LEXICOGRAPHIC_TOP_K)
                    if key == 'rank_auc_excess_top_values':
                        return _rank_text_to_tuple(_auc_excess_value(_f_local(d.get('max_auc_cross', '0'))), top_k=RANK_LEXICOGRAPHIC_TOP_K)
                    return tuple([0.0] * RANK_LEXICOGRAPHIC_TOP_K)
                return (
                    _rank_tuple_local('rank_stage5_top_values'),
                    _rank_tuple_local('rank_auc_excess_top_values'),
                    _f_local(d.get('max_auc_cross', '0')),
                    _f_local(d.get('max_tv_cross', '0')),
                    _f_local(d.get('cut_weight', '0')),
                    -int(float(d.get('bundle_id', 0) or 0)),
                )

            _ranked_region_rows_for_csv = sorted(rows, key=_stage5_region_rank_key_for_csv, reverse=True)
            for _rank_i, _row in enumerate(_ranked_region_rows_for_csv, start=1):
                _row['rank'] = int(_rank_i)
            rows.sort(key=lambda d: int(d["bundle_id"]))
            def _write_stage5_regions(_fh):
                wcsv = csv.writer(_fh)
                wcsv.writerow([
                    "bundle_id",
                    "rank",
                    "regionA_nodes", "regionB_nodes",
                    "nA", "nB",
                    "cut_weight",
                    "max_tv_cross",
                    "max_auc_cross",
                    "max_contribution_cross",
                    "sum_contribution_multi",
                    "mean_contribution_multi",
                    "density_contribution_multi",
                    "cross_contribution_sum",
                    "cross_contribution_mean",
                    "cross_contribution_density",
                    "max_stage5_weight_cross",
                    "sum_stage5_weight",
                    "mean_stage5_weight",
                    "density_stage5_weight",
                    "cross_stage5_weight_sum",
                    "cross_stage5_weight_mean",
                    "cross_stage5_weight_density",
                    "stage5_weight_name",
                    "region_build_weight_name",
                    "rank_score",
                    "rank_score_source",
                    "rank_stage5_1",
                    "rank_stage5_2",
                    "rank_stage5_3",
                    "rank_stage5_4",
                    "rank_stage5_5",
                    "rank_stage5_top_values",
                    "rank_auc_excess_1",
                    "rank_auc_excess_2",
                    "rank_auc_excess_3",
                    "rank_auc_excess_4",
                    "rank_auc_excess_5",
                    "rank_auc_excess_top_values",
                    "has_positive_stage5_weight",
                    "mean_auc_single",
                    "n_crossing_features",
                    "argmax_pair_id",
                    "argmax_pair_type",
                    "supporting_pairs_topK",
                ])
                for r in rows:
                    wcsv.writerow([
                        int(r["bundle_id"]),
                        int(r.get("rank", 0) or 0),
                        r["regionA_nodes"], r["regionB_nodes"],
                        int(r["nA"]), int(r["nB"]),
                        f"{float(r['cut_weight']):.6f}",
                        f"{float(r.get('max_tv_cross', 0.0)):.6f}",
                        (f"{float(r.get('max_auc_cross', float('nan'))):.6f}" if np.isfinite(float(r.get('max_auc_cross', float('nan')))) else 'nan'),
                        f"{float(r.get('max_contribution_cross', 0.0)):.6f}",
                        f"{float(r.get('sum_contribution_multi', 0.0)):.6f}",
                        f"{float(r.get('mean_contribution_multi', 0.0)):.6f}",
                        f"{float(r.get('density_contribution_multi', 0.0)):.6f}",
                        f"{float(r.get('cross_contribution_sum', 0.0)):.6f}",
                        f"{float(r.get('cross_contribution_mean', 0.0)):.6f}",
                        f"{float(r.get('cross_contribution_density', 0.0)):.6f}",
                        f"{float(r.get('max_stage5_weight_cross', 0.0)):.6f}",
                        f"{float(r.get('sum_stage5_weight', 0.0)):.6f}",
                        f"{float(r.get('mean_stage5_weight', 0.0)):.6f}",
                        f"{float(r.get('density_stage5_weight', 0.0)):.6f}",
                        f"{float(r.get('cross_stage5_weight_sum', 0.0)):.6f}",
                        f"{float(r.get('cross_stage5_weight_mean', 0.0)):.6f}",
                        f"{float(r.get('cross_stage5_weight_density', 0.0)):.6f}",
                        str(r.get('stage5_weight_name', stage5_region_weight_mode)),
                        str(r.get('region_build_weight_name', region_build_weight_mode)),
                        f"{float(r.get('rank_score', 0.0)):.6f}",
                        str(r.get('rank_score_source', '')),
                        f"{float(r.get('rank_stage5_1', 0.0)):.6f}",
                        f"{float(r.get('rank_stage5_2', 0.0)):.6f}",
                        f"{float(r.get('rank_stage5_3', 0.0)):.6f}",
                        f"{float(r.get('rank_stage5_4', 0.0)):.6f}",
                        f"{float(r.get('rank_stage5_5', 0.0)):.6f}",
                        str(r.get('rank_stage5_top_values', '')),
                        f"{float(r.get('rank_auc_excess_1', 0.0)):.6f}",
                        f"{float(r.get('rank_auc_excess_2', 0.0)):.6f}",
                        f"{float(r.get('rank_auc_excess_3', 0.0)):.6f}",
                        f"{float(r.get('rank_auc_excess_4', 0.0)):.6f}",
                        f"{float(r.get('rank_auc_excess_5', 0.0)):.6f}",
                        str(r.get('rank_auc_excess_top_values', '')),
                        int(r.get('has_positive_stage5_weight', 0) or 0),
                        (f"{float(r.get('mean_auc_single', float('nan'))):.6f}" if np.isfinite(float(r.get('mean_auc_single', float('nan')))) else 'nan'),
                        int(r.get('n_crossing_features', 0) or 0),
                        r.get("argmax_pair_id", ""),
                        r.get("argmax_pair_type", ""),
                        r.get("supporting_pairs_topK", ""),
                    ])

            _write_csv_atomic(bundle_regions_csv, _write_stage5_regions)
            _save_stage_meta(stage5_regions_meta, want5_regions)
            _write_stage_done_atomic(stage5_regions_done, stage_name='Stage5_regions', meta=want5_regions, outputs=[bundle_regions_csv, stage5_regions_meta], counts={'rows': int(len(rows))})

    _pipeline_progress_emit(5, total_stages, "Stage5 region inference complete", t0=pipeline_t0, extra=f"regions_csv={bundle_regions_csv.name}")

    # ============================================================
    # Stage 5 (final phase): Rank region pairs + output distributions + PDB visualization
    # ============================================================
    ranked_pairs_csv = outdir / "ranked_pairs.csv"
    ranked_pairs_pretty = outdir / "ranked_pairs_pretty.txt"
    bundle_regions_pretty = outdir / "bundle_regions_pretty.txt"
    plots_dir = outdir / "plots"
    pdb_dir = outdir / "pdb"
    stage5_rank_meta = stage5_regions_dir / "ranking_meta.json"
    stage5_rank_done = stage5_regions_dir / "ranking.done.json"

    topN_pairs = int(getattr(args, "topN_pairs", getattr(args, "topN_pairs", 200)))
    plot_format = str(getattr(args, "plot_format", getattr(args, "plot_format", "png"))).lower()
    plot_dpi = int(getattr(args, "plot_dpi", getattr(args, "plot_dpi", 150)))
    plot_run_errorbars = bool(getattr(args, "plot_run_errorbars", False))
    stage5_output_top_regions = max(0, int(getattr(args, 'stage5_output_top_regions', 20) or 0))
    stage5_write_all_individual_visuals = bool(getattr(args, 'stage5_write_all_individual_visuals', False))
    # ref PDB is mandatory per spec (Stage5 region inference)
    refA, _refB = _resolve_refs(args)
    ref_sig = _content_sig(refA)

    want5 = {
        "cache_version": int(STAGE5_RANK_CACHE_VERSION),
        "cache_namespace": CACHE_NAMESPACE,
        "stage5_region_weight_mode": str(stage5_region_weight_mode),
        "stage5_weight_formula": str(stage5_weight_formula),
        "stage5_weight_reason": str(stage5_weight_reason),
        "region_build_weight_mode": str(region_build_weight_mode),
        "ranking_policy": "stage5_lexicographic_then_auc_excess_v1",
        "rank_lexicographic_top_k": int(RANK_LEXICOGRAPHIC_TOP_K),
        "bundle_regions_csv": _content_sig(bundle_regions_csv),
        "bundles_csv": _content_sig(bundles_csv),
        "pair_contrib_csv": _content_sig(pair_contrib_csv),
        "feature_contributions_csv": _content_sig(feature_contrib_csv),
        "stage5_aggregation_done": _done_cache_sig(stage5_pair_done),
        "topN_pairs": int(topN_pairs),
        "plot_format": plot_format,
        "plot_dpi": int(plot_dpi),
        "plot_run_errorbars": bool(plot_run_errorbars),
        "stage5_output_top_regions": int(stage5_output_top_regions),
        "stage5_write_all_individual_visuals": bool(stage5_write_all_individual_visuals),
        "stage5_bundle_pdb_score_mode": "pair_rank/all_ranked bfactor=active Stage5 metric (contribution in standard, sig_strength in -sm sig, ced_effect_score in -sm ced); occupancy=auc_single; Stage5 metric PDBs include contribution/coef_abs/feature_std plus sig or CED metrics when active",
        "stage5_combined_ranked_pdb": True,
        "stage5_combined_ranked_pdb_mode": "default plus independent metric-specific PDBs over ranked bundle member features",
        "atom_spec": str(getattr(args,"atom_specA", None) or getattr(args,"atom_spec", "") or ""),
        "ref_pdb": ref_sig,
        "sel_fids": _content_sig(sel_fids_path),
    }

    stage5_rank_cache_ok = False
    stage5_ranked_count = 0
    stage5_rank_cache_ok, stage5_rank_state, stage5_rank_reasons = _cache_check_with_reasons(
        # Do not include the shared pdb/ directory in required_paths.
        # Stage1 metric PDBs create pdb/ before Stage5 ranking, and using the
        # directory itself here makes a clean first Stage5 run look like an
        # incomplete ranking cache. Stage5-owned PDB/PML files are checked by
        # _validate_stage5_rank_outputs() instead.
        required_paths=[
            (ranked_pairs_csv, ranked_pairs_csv.name),
            (ranked_pairs_pretty, ranked_pairs_pretty.name),
            (bundle_regions_pretty, bundle_regions_pretty.name),
            (region_contrib_csv, region_contrib_csv.name),
            (plots_dir, plots_dir.name),
        ],
        meta_path=stage5_rank_meta,
        done_path=stage5_rank_done,
        want_meta=want5,
        stage_name='Stage5_ranking',
        validators=[
            ('stage5_rank_outputs', lambda: _validate_stage5_rank_outputs(ranked_pairs_csv, region_contrib_csv, plots_dir, pdb_dir, stage5_rank_done)),
        ],
    ) if not force else (False, 'miss', ['forced recompute'])
    if stage5_rank_cache_ok:
        log_skip("Stage5: ranking", "using cached ranked_pairs.csv/plots/Stage5-owned PDBs")
        try:
            with open(ranked_pairs_csv, "r", encoding="utf-8") as f:
                stage5_ranked_count = sum(1 for _ in csv.DictReader(f))
        except Exception:
            stage5_ranked_count = 0
    elif not force and stage5_rank_state != 'first_run':
        kind = 'incomplete cache' if stage5_rank_state == 'incomplete' else 'cache miss'
        log_recalc('Stage5: ranking', kind)
        for msg in stage5_rank_reasons:
            log_why(msg)

    if not stage5_rank_cache_ok:
        with SectionTimer("Stage5: ranking", enabled=True):
            stage5_rank_progress_interval_sec = float(getattr(args, 'progress_interval_sec', 300.0) or 300.0)
            # -------------------------------------------------------------
            # Clean Stage5-owned outputs when Stage5 is actually recomputed.
            # Do NOT remove the whole pdb_dir: Stage1 metric PDBs are written
            # before Stage5 and must survive Stage5 reranking.  Only remove
            # files whose ownership belongs to Stage5 (pair_rank*/all_ranked*)
            # plus obsolete Stage5 metric maps.
            # -------------------------------------------------------------
            if plots_dir.exists():
                shutil.rmtree(plots_dir)
            if pdb_dir.exists():
                stage5_pdb_patterns = [
                    'pair_rank*_regions.pdb',
                    'pair_rank*_view.pml',
                    'all_ranked_bundles_regions.pdb',
                    'all_ranked_bundles_view.pml',
                    'all_ranked_bundles_metric_*.pdb',
                ]
                removed_stage5_pdbs = 0
                for _pat in stage5_pdb_patterns:
                    for _pp in pdb_dir.glob(_pat):
                        try:
                            if _pp.is_file() or _pp.is_symlink():
                                _pp.unlink()
                                removed_stage5_pdbs += 1
                        except Exception as e:
                            log_warn(f"Stage5 cleanup: could not remove {_pp}: {e}")
                metric_json = pdb_dir / 'metric_pdbs.json'
                if metric_json.exists():
                    try:
                        _mj = _load_json(metric_json)
                        if isinstance(_mj, dict):
                            for _key in list(_mj.keys()):
                                _ks = str(_key)
                                if _ks.startswith('all_ranked_bundles_metric_') or _ks.startswith('pair_rank') or _ks in ('all_ranked_bundles_regions.pdb', 'all_ranked_bundles_view.pml'):
                                    _mj.pop(_key, None)
                            _write_json_atomic(metric_json, _mj)
                    except Exception as e:
                        log_warn(f"Stage5 cleanup: could not update {metric_json}: {e}")
                if _log_enabled('info'):
                    log_info(f"Stage5 cleanup: preserved Stage1 metric PDBs; removed Stage5-owned PDB files={removed_stage5_pdbs}")

            plots_dir.mkdir(parents=True, exist_ok=True)
            pdb_dir.mkdir(parents=True, exist_ok=True)

            # Load Stage5 region definitions/results
            rows = []
            with open(bundle_regions_csv, "r", encoding="utf-8") as f:
                r = csv.DictReader(f)
                for row in r:
                    rows.append(row)

            if str(stage5_region_weight_mode) == 'contribution':
                stage5_primary_score_col = 'contribution_score'
            elif str(stage5_region_weight_mode) == 'ced_effect_score':
                stage5_primary_score_col = 'condition_effect_score'
            else:
                stage5_primary_score_col = 'sig_strength'
            stage5_primary_metric_col = 'rank_score'
            stage5_primary_sum_col = 'cross_stage5_weight_sum'
            stage5_tie_breakers = ['rank_stage5_top_values', 'rank_auc_excess_top_values', 'max_auc_cross', 'max_tv_cross', 'cut_weight', 'bundle_id']
            stage5_ranking_mode_json = {
                'mode': str(stage5_region_weight_mode),
                'primary_score_column': stage5_primary_score_col,
                'primary_metric_column': stage5_primary_metric_col,
                'primary_metric_sum_column': stage5_primary_sum_col,
                'tie_breakers': list(stage5_tie_breakers),
                'feature_weight_formula': str(stage5_weight_formula),
                'reason': str(stage5_weight_reason),
                'ranking_policy': 'stage5_lexicographic_then_auc_excess_v1',
                'rank_lexicographic_top_k': int(RANK_LEXICOGRAPHIC_TOP_K),
                'note': 'Final ranking compares sorted cross-region Stage5 weights lexicographically; if these do not distinguish rows, sorted cross-region auc_excess=max(0,AUC-0.5) values are used. cross_stage5_weight_sum is auxiliary and is not the primary ranking key. bundle_regions.csv includes a rank column with this same ordering while keeping rows sorted by bundle_id.',
            }
            try:
                _write_json_atomic(stage5_regions_dir / 'ranking_mode.json', stage5_ranking_mode_json)
                _write_json_atomic(outdir / 'ranking_mode.json', stage5_ranking_mode_json)
            except Exception as e:
                log_warn(f"Stage5 ranking: could not write ranking_mode.json: {e}")
            log_info(f"Stage5 ranking mode = {stage5_region_weight_mode}; primary_score_column={stage5_ranking_mode_json['primary_score_column']}; policy=stage5_lexicographic_then_auc_excess_v1; stage5_weight_sum is auxiliary")
            _stage5_pdb_metric_label = (
                'sig_strength' if str(stage5_region_weight_mode) == 'sig_strength'
                else ('ced_effect_score' if str(stage5_region_weight_mode) == 'ced_effect_score' else 'contribution')
            )
            log_info(f"Stage5 ranking outputs: ranked_rows={len(rows)} plot_format={plot_format} plot_errorbars={'auto-run-SE' if str(selection_mode_main) in ('sig', 'ced') else bool(plot_run_errorbars)} pdb_metric={_stage5_pdb_metric_label}")

            # Write region_contrib.csv from region definitions, then rank by the active Stage5 score

            bundle_members: dict[int, list[int]] = {}
            with open(bundles_csv, 'r', encoding='utf-8') as f:
                for row in csv.DictReader(f):
                    bid = int(row['bundle_id'])
                    bundle_members[bid] = [int(x) for x in str(row.get('member_fids','') or '').split(';') if str(x).strip()]

            def _node_key_stage6(kind: int, fid: int, which: str) -> str:
                if int(kind) == 0:
                    res = int(pair_meta.res_i[fid]) if which == 'i' else int(pair_meta.res_j[fid])
                    at = int(pair_meta.atom_i[fid]) if which == 'i' else int(pair_meta.atom_j[fid])
                    ag = int(pair_meta.agroup_i[fid]) if which == 'i' else int(pair_meta.agroup_j[fid])
                    return f"atom:{res}:{at}:ag{ag}"
                res = int(_meta_res(pair_meta, fid, 'i' if which == 'i' else 'j'))
                return f"res:{res}"

            def _write_stage5_region_contrib(_fh):
                wcsv = csv.writer(_fh)
                wcsv.writerow(['bundle_id','region_id','contribution_sum','contribution_mean','contribution_density','pair_count','near_pair_count','long_pair_count','mean_auc_single','max_auc_single','multivar_auc'])
                for row in rows:
                    bid = int(row.get('bundle_id', 0) or 0)
                    regionA_set = {tok.strip() for tok in str(row.get('regionA_nodes','') or '').split(';') if tok.strip()}
                    regionB_set = {tok.strip() for tok in str(row.get('regionB_nodes','') or '').split(';') if tok.strip()}
                    metrics = {'A': {'vals': [], 'aucs': [], 'near': 0, 'long': 0, 'count': 0}, 'B': {'vals': [], 'aucs': [], 'near': 0, 'long': 0, 'count': 0}}
                    for fid in bundle_members.get(bid, []):
                        if int(fid) not in pair_metrics_by_fid:
                            continue
                        pm = pair_metrics_by_fid[int(fid)]
                        c = float(pm.get('contribution_multi', 0.0))
                        a = float(pm.get('auc_single', float('nan')))
                        kind = 0 if pm.get('pair_type','') == 'near' else 1
                        k1 = _node_key_stage6(kind, int(fid), 'i')
                        k2 = _node_key_stage6(kind, int(fid), 'j')
                        inA = (k1 in regionA_set) + (k2 in regionA_set)
                        inB = (k1 in regionB_set) + (k2 in regionB_set)
                        if inA > 0:
                            share = c if inA == 2 and inB == 0 else 0.5 * c
                            metrics['A']['vals'].append(share)
                            metrics['A']['count'] += 1
                            metrics['A']['near' if kind == 0 else 'long'] += 1
                            if np.isfinite(a): metrics['A']['aucs'].append(a)
                        if inB > 0:
                            share = c if inB == 2 and inA == 0 else 0.5 * c
                            metrics['B']['vals'].append(share)
                            metrics['B']['count'] += 1
                            metrics['B']['near' if kind == 0 else 'long'] += 1
                            if np.isfinite(a): metrics['B']['aucs'].append(a)
                    for region_id in ('A', 'B'):
                        vals = metrics[region_id]['vals']
                        aucs = metrics[region_id]['aucs']
                        csum = float(np.sum(vals)) if vals else 0.0
                        cmean = float(np.mean(vals)) if vals else 0.0
                        cdens = float(csum / max(1, metrics[region_id]['count']))
                        mauc = float(np.mean(aucs)) if aucs else float('nan')
                        xauc = float(np.max(aucs)) if aucs else float('nan')
                        wcsv.writerow([bid, region_id, f"{csum:.6f}", f"{cmean:.6f}", f"{cdens:.6f}", metrics[region_id]['count'], metrics[region_id]['near'], metrics[region_id]['long'], f"{mauc:.6f}" if np.isfinite(mauc) else 'nan', f"{xauc:.6f}" if np.isfinite(xauc) else 'nan', f"{multivar_auc:.6f}" if np.isfinite(multivar_auc) else 'nan'])
            _write_csv_atomic(region_contrib_csv, _write_stage5_region_contrib)

            # Rank regions lexicographically by cross-region Stage5 weights.
            # If Stage5 weights are identical (including all-zero cases), use
            # cross-region auc_excess=max(0,AUC-0.5) values as a formal
            # tie-breaker.  cross_stage5_weight_sum is retained as an auxiliary
            # output but must not dominate the ranking.
            def _f(x: str) -> float:
                try:
                    return float(x)
                except Exception:
                    return 0.0

            def _row_rank_tuple(d, key):
                txt = d.get(key, '')
                if txt:
                    return _rank_text_to_tuple(txt, top_k=RANK_LEXICOGRAPHIC_TOP_K)
                if key == 'rank_stage5_top_values':
                    return _rank_text_to_tuple(d.get('rank_score', d.get('max_stage5_weight_cross', '0')), top_k=RANK_LEXICOGRAPHIC_TOP_K)
                if key == 'rank_auc_excess_top_values':
                    return _rank_text_to_tuple(_auc_excess_value(_f(d.get('max_auc_cross', '0'))), top_k=RANK_LEXICOGRAPHIC_TOP_K)
                return tuple([0.0] * RANK_LEXICOGRAPHIC_TOP_K)

            rows.sort(key=lambda d: (
                _row_rank_tuple(d, 'rank_stage5_top_values'),
                _row_rank_tuple(d, 'rank_auc_excess_top_values'),
                _f(d.get('max_auc_cross', '0')),
                _f(d.get('max_tv_cross', '0')),
                _f(d.get('cut_weight', '0')),
                -int(float(d.get('bundle_id', 0) or 0)),
            ), reverse=True)
            stage5_total_region_pairs = int(len(rows))
            rows = rows[:max(0, topN_pairs)]
            stage5_rank_logger = _progress_logger('Stage5/ranking', total_units=max(1, len(rows)), min_interval_sec=stage5_rank_progress_interval_sec)

            # Prepare feature lookup (from in-memory feats)
            feats_by_fid = {int(fs.fid): fs for fs in feats}

            plots_dir.mkdir(parents=True, exist_ok=True)
            pdb_dir.mkdir(parents=True, exist_ok=True)

            def _res_key_info(res_idx: int) -> tuple[str, int | str, str]:
                """Return (chain, resid, resname) for a selected-residue index.

                Older/current contexts store res_keys as (chain, resid), while
                some pretty-print code previously assumed (chain, resid, resname).
                Keep both layouts valid and recover resname from atoms_by_res when
                it is not stored in res_keys.
                """
                try:
                    rk = res_keys[int(res_idx)]
                except Exception:
                    return "", "?", ""
                chain = ""
                resid: int | str = "?"
                resname = ""
                try:
                    if isinstance(rk, (tuple, list)):
                        if len(rk) >= 1:
                            chain = str(rk[0])
                        if len(rk) >= 2:
                            resid = int(rk[1])
                        if len(rk) >= 3:
                            resname = str(rk[2])
                    else:
                        resid = str(rk)
                except Exception:
                    pass
                if not resname and 0 <= int(res_idx) < len(atoms_by_res) and atoms_by_res[int(res_idx)]:
                    ak0 = int(atoms_by_res[int(res_idx)][0])
                    if 0 <= ak0 < len(atoms_sel):
                        resname = str(atoms_sel[ak0].resname).strip()
                return chain, resid, resname

            def _node_info_from_key(key: str) -> dict[str, object]:
                key = str(key or "").strip()
                parts = key.split(":")
                out = {"raw": key, "kind": "unknown"}
                if not parts or not parts[0]:
                    return out
                if parts[0] == "atom":
                    res_idx = int(parts[1]) if len(parts) >= 2 and parts[1].lstrip("-").isdigit() else -1
                    atom_idx = int(parts[2]) if len(parts) >= 3 and parts[2].lstrip("-").isdigit() else -1
                    ag = parts[3][2:] if len(parts) >= 4 and parts[3].startswith("ag") else ""
                    out.update({"kind": "atom", "res_idx": res_idx, "atom_idx": atom_idx, "agroup": ag})
                    if 0 <= atom_idx < len(atoms_sel):
                        a = atoms_sel[atom_idx]
                        out.update({
                            "chain": str(a.chain),
                            "resid": int(a.resid),
                            "resname": str(a.resname),
                            "atom_name": str(a.name),
                            "pdb_serial": int(a.idx1),
                        })
                    elif 0 <= res_idx < len(res_keys):
                        c, resid, resn = _res_key_info(res_idx)
                        out.update({"chain": str(c), "resid": resid, "resname": str(resn)})
                    return out
                if parts[0] == "res":
                    res_idx = int(parts[1]) if len(parts) >= 2 and parts[1].lstrip("-").isdigit() else -1
                    out.update({"kind": "res", "res_idx": res_idx})
                    if 0 <= res_idx < len(res_keys):
                        c, resid, resn = _res_key_info(res_idx)
                        atom_names = sorted({atoms_sel[ak].name.strip() for ak in atoms_by_res[res_idx] if 0 <= ak < len(atoms_sel)})
                        out.update({
                            "chain": str(c),
                            "resid": resid,
                            "resname": str(resn),
                            "atom_names": atom_names,
                            "n_atoms": int(len(atoms_by_res[res_idx])),
                        })
                    return out
                return out

            def _format_node_pretty(key: str, indent: str = "") -> list[str]:
                info = _node_info_from_key(key)
                kind = str(info.get("kind", "unknown"))
                if kind == "atom":
                    chain = str(info.get("chain", "") or "-")
                    resid = info.get("resid", "?")
                    resname = str(info.get("resname", "?") or "?")
                    atom_name = str(info.get("atom_name", "?") or "?")
                    res_idx = info.get("res_idx", "?")
                    atom_idx = info.get("atom_idx", "?")
                    pdb_serial = info.get("pdb_serial", "?")
                    ag = str(info.get("agroup", "") or "-")
                    return [f"{indent}- atom node: chain={chain} resid={resid} resname={resname} atom={atom_name} [res_idx={res_idx}, atom_idx={atom_idx}, pdb_serial={pdb_serial}, agroup={ag}]"]
                if kind == "res":
                    chain = str(info.get("chain", "") or "-")
                    resid = info.get("resid", "?")
                    resname = str(info.get("resname", "?") or "?")
                    res_idx = info.get("res_idx", "?")
                    atom_names = list(info.get("atom_names", []) or [])
                    if atom_names:
                        preview = ", ".join(atom_names[:12])
                        if len(atom_names) > 12:
                            preview += ", ..."
                        return [
                            f"{indent}- residue node: chain={chain} resid={resid} resname={resname} [res_idx={res_idx}, n_selected_atoms={info.get('n_atoms', len(atom_names))}]",
                            f"{indent}  selected_atoms: {preview}",
                        ]
                    return [f"{indent}- residue node: chain={chain} resid={resid} resname={resname} [res_idx={res_idx}]"]
                return [f"{indent}- {key}"]

            def _pair_summary_lines(fid: int, indent: str = "") -> list[str]:
                fid = int(fid)
                if not (0 <= fid < len(pair_meta)):
                    return [f"{indent}- fid={fid} (out of range)"]
                fs = feats_by_fid.get(fid)
                pm = pair_metrics_by_fid.get(fid, {})
                metric_lines: list[str] = []
                if fs is not None:
                    metric_lines.extend([
                        f"{indent}  mean_A={float(getattr(fs, 'meanA', float('nan'))):.6f} mean_B={float(getattr(fs, 'meanB', float('nan'))):.6f} delta_mean(B-A)={float(getattr(fs, 'meanB', 0.0) - getattr(fs, 'meanA', 0.0)):.6f}",
                        f"{indent}  TV={float(getattr(fs, 'tv', float('nan'))):.6f} AUC={float(pm.get('auc_single', float('nan'))):.6f}",
                    ])
                    if selection_mode_main == 'ced':
                        metric_lines.append(
                            f"{indent}  CED_score={float(getattr(fs, 'ced_effect_score', 0.0)):.6f} passed_CED={bool(getattr(fs, 'passed_ced', False))} "
                            f"p_null={float(getattr(fs, 'ced_p_null', 1.0)):.6g} q_null={float(getattr(fs, 'ced_q_null', 1.0)):.6g}"
                        )
                    elif selection_mode_main == 'sig':
                        metric_lines.append(f"{indent}  sig_strength={float(getattr(fs, 'sig_strength', 0.0)):.6f}")
                if selection_mode_main == 'standard':
                    metric_lines.append(
                        f"{indent}  contribution_score={float(pm.get('contribution_multi', 0.0)):.6f} "
                        f"coef={float(pm.get('coef_multi', 0.0)):.6f} feature_std={float(pm.get('feature_std', 0.0)):.6f}"
                    )
                kind = int(pair_meta.kind[fid])
                if kind == 0:
                    ai = int(pair_meta.atom_i[fid])
                    aj = int(pair_meta.atom_j[fid])
                    ri = int(_meta_res(pair_meta, fid, "i"))
                    rj = int(_meta_res(pair_meta, fid, "j"))
                    agi = _agroup_label(int(pair_meta.agroup_i[fid]))
                    agj = _agroup_label(int(pair_meta.agroup_j[fid]))
                    if 0 <= ai < len(atoms_sel):
                        a1 = atoms_sel[ai]
                        left = f"chain={a1.chain or '-'} resid={int(a1.resid)} resname={a1.resname} atom={a1.name} [res_idx={ri}, atom_idx={ai}, pdb_serial={int(a1.idx1)}, agroup={agi}]"
                    else:
                        left = f"res_idx={ri} atom_idx={ai} [agroup={agi}]"
                    if 0 <= aj < len(atoms_sel):
                        a2 = atoms_sel[aj]
                        right = f"chain={a2.chain or '-'} resid={int(a2.resid)} resname={a2.resname} atom={a2.name} [res_idx={rj}, atom_idx={aj}, pdb_serial={int(a2.idx1)}, agroup={agj}]"
                    else:
                        right = f"res_idx={rj} atom_idx={aj} [agroup={agj}]"
                    return [
                        f"{indent}- near fid={fid}",
                        f"{indent}  left : {left}",
                        f"{indent}  right: {right}",
                        *metric_lines,
                    ]
                ri = int(_meta_res(pair_meta, fid, "i"))
                rj = int(_meta_res(pair_meta, fid, "j"))
                if 0 <= ri < len(res_keys):
                    c1, resid1, resn1 = _res_key_info(ri)
                    left = f"chain={c1 or '-'} resid={resid1} resname={resn1} [res_idx={ri}, n_selected_atoms={len(atoms_by_res[ri])}]"
                else:
                    left = f"res_idx={ri}"
                if 0 <= rj < len(res_keys):
                    c2, resid2, resn2 = _res_key_info(rj)
                    right = f"chain={c2 or '-'} resid={resid2} resname={resn2} [res_idx={rj}, n_selected_atoms={len(atoms_by_res[rj])}]"
                else:
                    right = f"res_idx={rj}"
                return [
                    f"{indent}- long fid={fid}",
                    f"{indent}  left : {left}",
                    f"{indent}  right: {right}",
                    *metric_lines,
                ]

            def _parse_supporting_fids(s: str) -> list[int]:
                out = []
                for tok in str(s or "").split(";"):
                    tok = tok.strip()
                    if tok and tok.lstrip("-").isdigit():
                        out.append(int(tok))
                return out

            def _region_lines(title: str, nodes_s: str, indent: str = "") -> list[str]:
                nodes = [tok.strip() for tok in str(nodes_s or "").split(";") if tok.strip()]
                lines = [f"{indent}{title} (n={len(nodes)}):"]
                if not nodes:
                    lines.append(f"{indent}  (empty)")
                    return lines
                for key in nodes:
                    lines.extend(_format_node_pretty(key, indent + "  "))
                return lines

            def _write_bundle_regions_pretty(path: Path, rows_all: list[dict[str, object]]) -> None:
                with open(path, "w", encoding="utf-8") as fo:
                    fo.write("# DISTIL bundle regions (human-readable)\n")
                    fo.write(f"# source_csv: {bundle_regions_csv.name}\n\n")
                    for idx, rowp in enumerate(rows_all, start=1):
                        bid = int(rowp.get("bundle_id", 0) or 0)
                        fo.write("=" * 72 + "\n")
                        fo.write(f"Bundle {bid}\n")
                        fo.write("=" * 72 + "\n")
                        fo.write(f"  rank            : {rowp.get('rank', '')}\n")
                        fo.write(f"  cut_weight      : {_f(rowp.get('cut_weight', '0')):.6f}\n")
                        fo.write(f"  max_tv_cross    : {_f(rowp.get('max_tv_cross', '0')):.6f}\n")
                        fo.write(f"  max_auc_cross   : {_f(rowp.get('max_auc_cross', '0')):.6f}\n")
                        fo.write(f"  max_contrib     : {_f(rowp.get('max_contribution_cross', '0')):.6f}\n")
                        fo.write(f"  rank_score      : {_f(rowp.get('rank_score', '0')):.6f}\n")
                        fo.write(f"  rank_score_source: {rowp.get('rank_score_source', '')}\n")
                        fo.write(f"  rank_stage5_top : {rowp.get('rank_stage5_top_values', '')}\n")
                        fo.write(f"  rank_auc_excess_top: {rowp.get('rank_auc_excess_top_values', '')}\n")
                        fo.write(f"  n_crossing_features: {int(rowp.get('n_crossing_features', 0) or 0)}\n")
                        fo.write(f"  argmax_pair_id  : {rowp.get('argmax_pair_id', '')}\n")
                        fo.write(f"  argmax_pair_type: {rowp.get('argmax_pair_type', '')}\n")
                        argmax_s = str(rowp.get("argmax_pair_id", "") or "").strip()
                        if argmax_s.lstrip("-").isdigit():
