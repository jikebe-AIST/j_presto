                stage1_auc_frame_mode=str(stage1_auc_frame_mode),
                verbose=_log_enabled('info'),
            )
            if True:
                stage1_ok, stage1_reasons = _stage1_scoring_outputs_ok()
                if not stage1_ok:
                    raise RuntimeError('Stage1 feature scoring did not produce valid scoring artifacts: ' + '; '.join(stage1_reasons[:6]))
                stage1_scoring_built = True

            # persist cache after successful Stage1 computation
            _write_pickle_atomic(stage1_cache, feats)

        assert feats is not None

        # Stage1 metric PDBs: write all-feature metric maps as soon as Stage1 values are available.
        try:
            full_to_sel_stage1 = np.full((len(atoms_ref),), -1, dtype=np.int64)
            for k, ai in enumerate(np.asarray(sel_idx, dtype=np.int64).tolist()):
                if 0 <= int(ai) < len(full_to_sel_stage1):
