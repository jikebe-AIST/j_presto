        'stage5_rank_done': _done_cache_sig(stage5_rank_done),
        'pair_scores_csv': _content_sig(pair_scores_csv),
        'pair_contrib_csv': _content_sig(pair_contrib_csv),
        'bundle_regions_csv': _content_sig(bundle_regions_csv),
        'ranked_pairs_csv': _content_sig(ranked_pairs_csv),
        'n_atoms': int(len(atoms_sel)),
        'equiv_policy': 'collapse_group_sum_weight_mixture_transport_equal_member_projection_v1',
        'display_policy': 'q95_to_3A_clip_4.5A_hide_below_0.45A_vermilion',
    }
    cache_ok, cache_state, cache_reasons = _cache_check_with_reasons(
        required_paths=[(bild_path, bild_path.name), (cmd_path, cmd_path.name), (tsv_path, tsv_path.name)],
        meta_path=meta_path,
        done_path=done_path,
        want_meta=want,
        stage_name='Stage5_direction_map',
        validators=[('direction_map_tsv', lambda: (tsv_path.exists() and tsv_path.stat().st_size > 0, f'invalid_output: {tsv_path.name}'))],
    )
    if cache_ok:
        log_skip('Stage5: ensemble direction map', 'using cached ensemble_direction_map.*')
        return {'cache': True}
    if cache_state != 'first_run':
        log_recalc('Stage5: ensemble direction map', 'incomplete cache' if cache_state == 'incomplete' else 'cache miss')
        for reason in cache_reasons:
            log_why(reason)

    fs_by_fid = {int(fs.fid): fs for fs in feats}
    positive_scores: dict[int, float] = {}
    for fid in pair_metrics_by_fid:
        q = float(stage5_weight_by_fid.get(int(fid), 0.0) or 0.0)
        if np.isfinite(q) and q > 0.0 and int(fid) in fs_by_fid:
            positive_scores[int(fid)] = float(q)

    # Build all equivalent-group members from the complete feature metadata,
    # not just the L1-selected member(s).
    equiv_members: dict[int, list[int]] = defaultdict(list)
    gids = np.asarray(getattr(pair_meta, 'equiv_group_id', np.full((len(pair_meta),), -1, dtype=np.int32)), dtype=np.int32)
    for fid in range(len(pair_meta)):
        gid = int(gids[fid]) if fid < gids.size else -1
        if gid >= 0:
            equiv_members[gid].append(int(fid))

    logical_units: list[dict[str, object]] = []
    consumed: set[int] = set()
    for fid in sorted(positive_scores):
        if fid in consumed:
            continue
        gid = int(gids[fid]) if fid < gids.size else -1
        if gid >= 0:
            all_members = sorted(set(equiv_members.get(gid, [fid])))
            selected_members = [m for m in all_members if m in positive_scores]
            q = float(sum(positive_scores[m] for m in selected_members))
            for m in selected_members:
                consumed.add(int(m))
            # Every member has the same mixture-based transport fields in the
            # current Stage1 implementation. Use the first available member.
            fs_ref = next((fs_by_fid.get(m) for m in all_members if m in fs_by_fid), fs_by_fid[fid])
            logical_units.append({'q': q, 'ratio': float(getattr(fs_ref, 'transport_ratio', 0.0)), 'members': all_members, 'equiv_group_id': gid})
        else:
            consumed.add(fid)
            logical_units.append({'q': float(positive_scores[fid]), 'ratio': float(getattr(fs_by_fid[fid], 'transport_ratio', 0.0)), 'members': [fid], 'equiv_group_id': -1})

    total_q = float(sum(float(u['q']) for u in logical_units if np.isfinite(float(u['q'])) and float(u['q']) > 0.0))
    n_atoms = int(len(atoms_sel))
    atom_vectors = np.zeros((n_atoms, 3), dtype=np.float64)
    atom_feature_counts = np.zeros((n_atoms,), dtype=np.int64)
    used_units = 0
    used_member_features = 0

    if total_q > 0.0 and np.isfinite(total_q):
        for unit in logical_units:
            q = float(unit['q'])
            ratio = float(unit['ratio'])
            members = [int(x) for x in unit['members']]
            if q <= 0.0 or not np.isfinite(q) or not np.isfinite(ratio) or ratio == 0.0 or not members:
                continue
            d_unit = (q / total_q) * float(np.clip(ratio, -1.0, 1.0))
            d_member = d_unit / float(len(members))
            used_units += 1
            for fid in members:
                if not (0 <= fid < len(pair_meta)):
                    continue
                kind = int(pair_meta.kind[fid])
                used_member_features += 1
                if kind == 0:
                    ai = int(pair_meta.atom_i[fid]); aj = int(pair_meta.atom_j[fid])
                    if not (0 <= ai < n_atoms and 0 <= aj < n_atoms):
                        continue
                    pi = np.asarray([atoms_sel[ai].x, atoms_sel[ai].y, atoms_sel[ai].z], dtype=np.float64)
                    pj = np.asarray([atoms_sel[aj].x, atoms_sel[aj].y, atoms_sel[aj].z], dtype=np.float64)
                    u = pj - pi
                    norm = float(np.linalg.norm(u))
                    if not np.isfinite(norm) or norm <= 0.0:
                        continue
                    u /= norm
                    delta = 0.5 * d_member * u
                    atom_vectors[ai] -= delta
                    atom_vectors[aj] += delta
                    atom_feature_counts[ai] += 1
                    atom_feature_counts[aj] += 1
                else:
                    ri = int(pair_meta.res_i[fid]); rj = int(pair_meta.res_j[fid])
                    left = _direction_map_residue_atom_ids(ri, atoms_by_res, atoms_sel)
                    right = _direction_map_residue_atom_ids(rj, atoms_by_res, atoms_sel)
                    ci = _direction_map_centroid(left, atoms_sel)
                    cj = _direction_map_centroid(right, atoms_sel)
                    if ci is None or cj is None:
                        continue
                    u = np.asarray(cj - ci, dtype=np.float64)
                    norm = float(np.linalg.norm(u))
                    if not np.isfinite(norm) or norm <= 0.0:
                        continue
                    u /= norm
                    delta = 0.5 * d_member * u
                    for ai in left:
                        atom_vectors[int(ai)] -= delta
                        atom_feature_counts[int(ai)] += 1
                    for aj in right:
                        atom_vectors[int(aj)] += delta
                        atom_feature_counts[int(aj)] += 1

    magnitudes = np.linalg.norm(atom_vectors, axis=1)
    nonzero = magnitudes[np.isfinite(magnitudes) & (magnitudes > 0.0)]
    q95 = float(np.percentile(nonzero, 95.0)) if nonzero.size else 0.0
    if not np.isfinite(q95) or q95 <= 0.0:
        q95 = 1.0
    display_lengths = np.clip(3.0 * magnitudes / q95, 0.0, 4.5)
    show = np.isfinite(display_lengths) & (display_lengths >= 0.45) & np.isfinite(magnitudes) & (magnitudes > 0.0)

    with open(bild_path, 'w', encoding='utf-8') as fh:
        fh.write('# DISTIL ensemble direction map (A -> B)\n')
        fh.write('# Arrows summarize weighted ensemble-distribution direction, not physical trajectories.\n')
        fh.write('.color 0.84 0.37 0.00\n')
        for atom_idx in np.where(show)[0].tolist():
            a = atoms_sel[int(atom_idx)]
            start = np.asarray([float(a.x), float(a.y), float(a.z)], dtype=np.float64)
            unit = atom_vectors[int(atom_idx)] / float(magnitudes[int(atom_idx)])
            end = start + unit * float(display_lengths[int(atom_idx)])
            _direction_map_write_arrow(fh, start, end)

    with open(cmd_path, 'w', encoding='utf-8') as fh:
        fh.write('# UCSF Chimera command script\n')
        fh.write('open reference_A_selected.pdb\n')
        fh.write('open ensemble_direction_map.bild\n')
        fh.write('background solid white\n')
        fh.write('~display #0\n')
        fh.write('ribbon #0\n')
        fh.write('color light gray #0\n')
        fh.write('focus #0\n')

    with open(tsv_path, 'w', encoding='utf-8', newline='') as fh:
        w = csv.writer(fh, delimiter='\t')
        w.writerow(['atom_index','chain','residue_number','residue_name','atom_name','vx','vy','vz','vector_magnitude','display_length','n_contributing_member_features'])
        for atom_idx, a in enumerate(atoms_sel):
            w.writerow([
                int(atom_idx), str(a.chain).strip(), int(a.resid), str(a.resname).strip(), str(a.name).strip(),
                f'{float(atom_vectors[atom_idx,0]):.10g}', f'{float(atom_vectors[atom_idx,1]):.10g}', f'{float(atom_vectors[atom_idx,2]):.10g}',
                f'{float(magnitudes[atom_idx]):.10g}', f'{float(display_lengths[atom_idx]):.10g}', int(atom_feature_counts[atom_idx]),
            ])

    _save_stage_meta(meta_path, want)
    _write_stage_done_atomic(
        done_path,
        stage_name='Stage5_direction_map',
        meta=want,
        outputs=[bild_path, cmd_path, tsv_path, meta_path],
        counts={
            'positive_raw_features': int(len(positive_scores)),
            'logical_units': int(len(logical_units)),
            'used_logical_units': int(used_units),
            'projected_member_features': int(used_member_features),
            'displayed_arrows': int(np.count_nonzero(show)),
        },
    )
    log_info(
        f'[Stage5] ensemble direction map: positive_raw_features={len(positive_scores)} '
        f'logical_units={len(logical_units)} used_units={used_units} '
        f'projected_members={used_member_features} arrows={int(np.count_nonzero(show))}'
    )
    return {'cache': False, 'arrows': int(np.count_nonzero(show))}

def build_argparser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(
        prog='DISTIL',
        description='DISTIL: distribution-aware comparison of molecular structural ensembles with correlated-feature bundling and ranked structural-region pairs'
    )
    ap.add_argument('-V', '--version', action='version', version=f'%(prog)s {DISTIL_VERSION}')

    # Inputs
    ap.add_argument('access_key', nargs='?', default='', help=argparse.SUPPRESS)
    ap.add_argument('-A', '--ensembleA', type=Path, required=False, help='.cod/.cods or .list (A)')
    ap.add_argument('-B', '--ensembleB', type=Path, required=False, help='.cod/.cods or .list (B)')
    ap.add_argument('-fs', '--frame-stride', type=int, default=0,
                    help='Input frame stride for ensembles. 0 disables; if k>0, after applying ist..ien ranges, keep every k-th frame (frames[::k]).')
    ap.add_argument('-r', '--ref',  type=Path, required=False, help='PDB for BOTH A,B')
    ap.add_argument('-rA', '--refA', type=Path, required=False, help='PDB for A (overrides -r)')
    ap.add_argument('-rB', '--refB', type=Path, required=False, help='PDB for B (overrides -r)')
    ap.add_argument('-p', '--prob',  type=Path, required=False, help='*.prob for BOTH')
    ap.add_argument('-pA', '--probA', type=Path, required=False, help='*.prob for A')
    ap.add_argument('-pB', '--probB', type=Path, required=False, help='*.prob for B')
    ap.add_argument('-a', '--atom-spec', type=str, required=False, default='!H*,h*', help="atom selection (common). Syntax examples: 'CA' selects atom name CA; 'ALA:CA' selects ALA CA atoms; 'A:88:O' selects chain A residue 88 atom O; default excludes hydrogens with '!H*,h*'.")
    ap.add_argument('-aA', '--atom-specA', type=str, required=False, help='atom selection for A')
    ap.add_argument('-aB', '--atom-specB', type=str, required=False, help='atom selection for B')
    ap.add_argument('-o', '--outdir', type=Path, required=False, default=Path('distil_out'), help='output directory')
    ap.add_argument('-frf', '--force-recompute-features', action='store_true',
                    help='Ignore any cached pool/features in outdir and recompute them (disables auto-resume).')
    ap.add_argument('-f', '--force', action='store_true', help='Force recompute of pipeline stages after feature generation')

    # Runtime / logging
    ap.add_argument('-bt', '--blas-threads', type=int, default=1, help='Force BLAS/OpenBLAS/MKL thread count')
    ap.add_argument('-na', '--no-accelerate', action='store_true', help='Disable on-disk caches/JIT acceleration')
    ap.add_argument('-l', '--log-level', choices=['quiet','info','debug'], default='info')
    ap.add_argument('--verbose', action='store_true', help=argparse.SUPPRESS)
    ap.add_argument('--debug', action='store_true', help=argparse.SUPPRESS)
    ap.add_argument('-sc', '--self-check', action='store_true', help='Run lightweight internal smoke tests (artifact-free) and exit')

    # Feature generation
    ap.add_argument('-cd', '--contact-distance', type=float, default=6.0, help='Cutoff distance for near contacts (Å)')
    ap.add_argument('-t', '--tpl', type=Path, required=False, default=None,
                    help='j_presto topology file (*.tpl). If provided, bonded relations (1-2/1-3/...) will be excluded from near pairs.')
    ap.add_argument('-tA', '--tplA', type=Path, required=False, default=None, help='Topology file (*.tpl) for refA (defaults to --tpl)')
    ap.add_argument('-tB', '--tplB', type=Path, required=False, default=None, help='Topology file (*.tpl) for refB (defaults to --tpl)')
    ap.add_argument('-teu', '--tpl-exclude-up-to', type=int, default=2, help='Exclude bonded relations up to N bonds in the full tpl topology (1=1-2; 2=1-2/1-3; 3=also 1-4; default 2).')
    ap.add_argument('-ea', '--equiv-atoms', choices=['aggregate','report'], default='aggregate', help='Handle chemically/force-field equivalent atoms. aggregate (default) uses equivalent-group mixture distributions for Stage1 while keeping raw atom-pair distances; report uses the non-aggregated calculation and only writes equivalence diagnostics.')
    ap.add_argument('-em', '--equiv-map', type=Path, default=None, help='Optional CSV defining additional equivalent atom groups for non-standard residues/ligands. Columns: chain,resid,resname,atoms (semicolon-separated atom names).')
    ap.add_argument('-edr', '--equiv-debug-residue', action='append', default=[], help='Debug equivalent-atom detection for a reference-PDB residue. Forms: resid, resid:RES, chain:resid:RES. May be repeated or comma-separated. Writes equiv_debug_* CSV files.')
    ap.add_argument('-edx', '--equiv-debug-exit', action='store_true', help='Exit after equivalent-atom diagnostics and atom-mapping/reference diagnostics are written. Use with --equiv-debug-residue for short diagnostic jobs.')
    ap.add_argument('-ees', '--equiv-expand-selection', dest='equiv_expand_selection', action='store_true', default=True, help='In aggregate mode, expand atom selection to include missing members of selected equivalent-atom groups (default on).')
    ap.add_argument('-nees', '--no-equiv-expand-selection', dest='equiv_expand_selection', action='store_false', help='Disable aggregate-mode automatic addition of missing equivalent-atom selection members.')
    ap.add_argument('-eibp', '--equiv-infer-bonds-from-pdb', action='store_true', help='Experimental: infer bonds from reference PDB when TPL is absent for equivalence diagnostics. Currently reserved; TPL or known rules are preferred.')

    # Stage 1: feature scoring (TV/AUC standard mode, optional run-bin significance mode)
    ap.add_argument('-bm', '--bins-max', type=int, default=128, help='Max histogram bins for strict TV/AUC (default 128)')
    ap.add_argument('--bins-min-neff-per-bin', type=float, default=30.0,
                    help='Minimum average effective sample size per strict-TV/AUC histogram bin; bins are additionally capped so min(N_eff_A,N_eff_B)/bins stays at least this value (default 30.0)')
    ap.add_argument('-s1c', '--tv-threshold', type=float, default=0.35,
                    help='Strict TV threshold used before AUC scoring (default 0.35)')
    ap.add_argument('-sd', '--seed', type=int, default=0, help='RNG seed')
    ap.add_argument('-tw', '--tv-workers', type=int, default=0, help='Workers for chunked Stage1 TV->AUC processing (0=auto; scheduler/affinity-aware, capped conservatively)')
    ap.add_argument('-tc', '--tv-chunk', type=int, default=0, help='Feature count per chunk for Stage1 feature scoring (0=auto)')
    ap.add_argument('--feat-chunk', type=int, default=0, help=argparse.SUPPRESS)
    ap.add_argument('--feat-pair-block', type=int, default=100000, help=argparse.SUPPRESS)
    ap.add_argument('-pis', '--progress-interval-sec', type=float, default=300.0,
                    help='Time-based progress log interval for long scans (Stage1 feature scoring, Stage2 contribution, Stage3 correlation, Stage4 bundles, Stage5 regions/ranking, Stage6 stability, contact collection; default 300s)')
    ap.add_argument('-s1mb', '--stage1-memory-budget-mib', type=float, default=2048.0,
                    help='Soft transient-memory budget used to cap strict-TV feature chunk size (default 2048 MiB)')
    ap.add_argument('-ae', '--auc-eps', type=float, default=1e-8,
                    help='Pseudo-count added to block histograms before normalization (default 1e-8)')
    ap.add_argument('-ak', '--auc-cv-folds', type=int, default=5,
                    help='Cross-validation folds for Stage1 hold-out AUC and Stage2 contribution models (default 5)')
    ap.add_argument('-ars2', '--auc-random-state', type=int, default=None,
                    help='Random state for Stage1 AUC and Stage2 contribution CV-based models (default: use --seed)')
    ap.add_argument('-aw', '--auc-workers', type=int, default=0,
                    help='Workers for Stage1 single-feature AUC evaluation (0=auto-safe)')
    ap.add_argument('-at', '--auc-threshold', type=float, default=0.8,
                    help='Stage1 threshold on pooled hold-out AUC (default 0.80)')
    ap.add_argument('-ascope', '--auc-scope', choices=['pass','all'], default='pass',
                    help='Features for Stage1 single-feature AUC calculation: pass computes AUC only for features passing the primary Stage1 selector; all computes AUC for every feature.')
    ap.add_argument('-sm', '--selection-mode', metavar='{standard,sig,ced}', default='standard',
                    help='Feature selection mode: standard=TV prefilter followed by AUC threshold; sig=run-level weighted bin significance test using -> run groups; ced=Condition-Excess Difference mode, selecting features whose A/B distribution distance exceeds both within-label and pooled-label-null run-split variability (default standard).')
    ap.add_argument('-sgt', '--sig-test', choices=['weighted_z'], default='weighted_z', help='Per-bin test for --selection-mode sig: DISTRIB-style run-total-weighted mean/SE with a two-sided normal approximation (default weighted_z).')
    ap.add_argument('-sa', '--sig-alpha', type=float, default=0.05, help='Per-bin alpha for --selection-mode sig (default 0.05).')
    ap.add_argument('-sfdr', '--sig-fdr', choices=['off','on'], default='off', help='Apply Benjamini-Hochberg FDR to important-bin p-values in --selection-mode sig (default off, matching original polyL analysis style).')
    ap.add_argument('-sbpf', '--sig-bin-peak-frac', type=float, default=0.03, help='Important-bin threshold as a fraction of the maximum run-mean bin height in either ensemble (default 0.03).')
    ap.add_argument('-sbmc', '--sig-bin-min-count', type=int, default=3, help='Minimum number of important bins by pooled mean probability (default 3).')
    ap.add_argument('-sat', '--sig-area-threshold', type=float, default=0.0, help='Minimum sum of |mean_A-mean_B| over significant important bins for feature selection (default 0.0).')
    ap.add_argument('-cws', '--ced-within-splits', type=int, default=CED_WITHIN_SPLITS_DEFAULT,
                    help=f'CED mode: number of random within-label run splits per ensemble used to estimate within-label variability (default {CED_WITHIN_SPLITS_DEFAULT} per ensemble).')
    ap.add_argument('-cns', '--ced-null-splits', type=int, default=CED_NULL_SPLITS_DEFAULT,
                    help=f'CED mode: number of pooled-label null splits. Runs from A and B are pooled and randomly split into nA/nB groups to estimate random-label finite-sampling variability without rereading frames (default {CED_NULL_SPLITS_DEFAULT}; minimum empirical p=1/(n+1)).')
    ap.add_argument('-cqt', '--ced-q-threshold', type=float, default=1.0,
                    help='CED mode: BH-FDR threshold for empirical condition-excess p-values (default 1.0; diagnostic only by default because empirical p is coarse at practical split counts).')
    ap.add_argument('-crt', '--ced-r-threshold', type=float, default=1.5,
                    help='CED mode: minimum ratio D_between / median(D_within) for feature selection (default 1.5).')
    ap.add_argument('-czt', '--ced-z-threshold', type=float, default=2.0,
                    help='CED mode: minimum within-label Z-like excess score (D_between - mean(D_within)) / sd(D_within) for feature selection (default 2.0).')
    ap.add_argument('-cnrt', '--ced-null-r-threshold', type=float, default=1.2,
                    help='CED pooled-label null: minimum ratio D_between / median(D_null) for feature selection (default 1.2).')
    ap.add_argument('-cnzt', '--ced-null-z-threshold', type=float, default=1.0,
                    help='CED pooled-label null: minimum Z-like excess score (D_between - mean(D_null)) / sd(D_null) for feature selection (default 1.0).')
    ap.add_argument('-cnpt', '--ced-null-p-threshold', type=float, default=0.10,
                    help='CED pooled-label null: maximum empirical p_null=P(D_null>=D_between) used as a diagnostic/pre-FDR gate before q_null is known (default 0.10).')
    ap.add_argument('-cnqt', '--ced-null-q-threshold', type=float, default=0.05,
                    help='CED pooled-label null: maximum BH-FDR adjusted q_null for final feature selection (default 0.05). This is the primary pooled-null pass criterion.')
    ap.add_argument('-cmt', '--ced-min-tv', type=float, default=0.02,
                    help='CED mode: minimum A/B TV distance D_between required before relative excess is considered (default 0.02).')
    ap.add_argument('-ceps', '--ced-eps', type=float, default=1e-6,
                    help='CED mode: small denominator floor for D_within ratios/Z scores (default 1e-6).')
    ap.add_argument('-crs', '--ced-random-state', type=int, default=None,
                    help='CED mode: RNG seed for deterministic internal run splits (default: use --seed).')
    ap.add_argument('--ced-pattern-batch-size', type=int, default=CED_PATTERN_BATCH_SIZE_DEFAULT,
                    help=f'CED mode: number of within/null split patterns evaluated per vectorized matrix batch (default {CED_PATTERN_BATCH_SIZE_DEFAULT}; performance-only, does not change results).')

    # Stage 3: correlation graph construction
    ap.add_argument('-ct', '--corr-tau', type=float, default=0.95, help='Keep all selected-feature distance-correlation edges with corr >= tau (default 0.95; positive only)')
    ap.add_argument('-cb', '--corr-block', type=int, default=0, help='Feature block size for Stage3 weighted correlation matrix products (default 0=auto: 1024 for small, 512 medium, 256 large)')
    ap.add_argument('-cmf', '--corr-max-features', type=int, default=0, help='Optional emergency cap for corr/bundling after AUC/CED final selection (default 0=disabled).')
    ap.add_argument('--corr-method', type=str, default='auto', choices=['auto','exact_safe_reject','exact_blockwise','safe_prune'], help='Stage3 complete correlation search method (default auto=exact_safe_reject; exact_blockwise is kept as a debug/compatibility alias).')
    ap.add_argument('--corr-exact-max-features', type=int, default=20000, help=argparse.SUPPRESS)
    ap.add_argument('--corr-dense-max-pairs', type=int, default=20000000, help='Compatibility threshold for dense-like Stage3 planning (default 20000000); the auto planner also considers frames, RAM, and probe rejection rate.')
    ap.add_argument('--corr-execution-profile', type=str, default='auto', choices=['auto','dense_like','pruned_active'], help='Stage3 exact-safe-reject execution profile (default auto: decide from F, frames, RAM, and early rejection probe).')
    ap.add_argument('--corr-dense-work-threshold', type=float, default=1.0e11, help='Dense-like Stage3 when pair_count*frames is below this value and RAM is sufficient (default 1e11).')
    ap.add_argument('--corr-profile-probe-reject-threshold', type=float, default=0.50, help='Stage3 exact-safe-reject profile probe: reject-ratio threshold used when choosing the execution profile (default 0.50).')
    ap.add_argument('--corr-profile-probe-units', type=int, default=24, help='Number of representative feature-block-pair units used by Stage3 auto profile probe (default 24).')
    ap.add_argument('--corr-profile-probe-frames', type=int, default=65536, help='Maximum frames used by Stage3 auto profile probe before extrapolating dense/pruned cost (default 65536; capped at total frames).')
    ap.add_argument('--corr-profile-pruned-cost-ratio', type=float, default=0.65, help='Choose pruned_active when estimated pruned/dense cost ratio is below this value (default 0.65).')
    ap.add_argument('--corr-profile-dense-cost-ratio', type=float, default=0.85, help='Choose dense_like when estimated pruned/dense cost ratio is above this value; ambiguous cases default to dense_like (default 0.85).')
    ap.add_argument('--corr-profile-probe-seed', type=int, default=12345, help='Seed for selecting random supplemental Stage3 profile probe block pairs (default 12345).')
    ap.add_argument('--corr-sample-block', type=int, default=4096, help='Sample/frame block size for Stage3 safe early rejection mode (default 4096)')
