                    ('mixture' if (hasattr(pair_meta, 'equiv_group_id') and fid < len(pair_meta) and int(pair_meta.equiv_group_id[fid]) >= 0) else 'raw'),
                    ('raw_member_distance_with_equiv_distribution' if (hasattr(pair_meta, 'equiv_group_id') and fid < len(pair_meta) and int(pair_meta.equiv_group_id[fid]) >= 0) else 'raw'),
                ])
