def _weighted_run_bin_pvalue(meanA: float, seA: float, nA: int, meanB: float, seB: float, nB: int) -> float:
    """Two-sided bin-level p-value from DISTRIB-style weighted run SE.

    The per-run bin probabilities are first summarized by run-total-weighted
    means and standard errors.  This function then tests the difference of the
    two weighted means with a normal approximation using the two reported SEs.
    """
    meanA = float(meanA); meanB = float(meanB)
    seA = float(seA); seB = float(seB)
    if int(nA) < 2 or int(nB) < 2:
        return float('nan')
    if not (np.isfinite(meanA) and np.isfinite(meanB) and np.isfinite(seA) and np.isfinite(seB)):
        return float('nan')
    se2 = seA * seA + seB * seB
    diff = abs(meanA - meanB)
    if se2 <= 0.0 or not np.isfinite(se2):
        return 1.0 if diff <= 0.0 else 0.0
    z = diff / math.sqrt(se2)
    return float(math.erfc(z / math.sqrt(2.0)))


def _run_bin_hist_matrix(x: np.ndarray, w: np.ndarray, run_ids: np.ndarray, *, bins: int, x_min: float, x_max: float, n_runs: int) -> tuple[np.ndarray, np.ndarray]:
    """Return per-run probability histograms and per-run total weights.

    Each run histogram is accumulated with frame weights and normalized within
    that run.  The returned run_weight vector is the unnormalized sum of frame
    weights in each run and is used for DISTRIB-style run-total-weighted
    mean/SE calculations.
    """
    x = np.asarray(x, dtype=np.float64)
    w = np.asarray(w, dtype=np.float64)
    run_ids = np.asarray(run_ids, dtype=np.int32)
    bins = int(bins); n_runs = int(n_runs)
    H = np.zeros((max(0, n_runs), max(1, bins)), dtype=np.float64)
    run_weight = np.zeros((max(0, n_runs),), dtype=np.float64)
    if x.size == 0 or n_runs <= 0 or bins <= 0 or not (x_max > x_min):
        H[:, :] = np.nan
        return H, run_weight
    if int(w.size) != int(x.size) or int(run_ids.size) != int(x.size):
        raise ValueError(
            f"run-bin histogram frame alignment mismatch: x={int(x.size)} weights={int(w.size)} run_ids={int(run_ids.size)} n_runs={int(n_runs)}"
        )
    bw = (float(x_max) - float(x_min)) / float(bins)
    idx = np.floor((x - float(x_min)) / bw).astype(np.int64, copy=False)
    idx = np.clip(idx, 0, bins - 1)
    ww = np.where(np.isfinite(w), w, 0.0)
    valid = (run_ids >= 0) & (run_ids < n_runs) & np.isfinite(x) & (ww >= 0.0)
    if np.any(valid):
        ridx = run_ids[valid].astype(np.int64)
        np.add.at(H, (ridx, idx[valid]), ww[valid])
    run_weight = H.sum(axis=1)
    nz = run_weight > 0.0
    H[nz, :] /= run_weight[nz, None]
    # Runs with zero total statistical weight do not contribute to the
    # weighted ensemble. Mark them as NaN so downstream calculations do not
    # treat inactive runs as real zero-probability distributions.
    H[~nz, :] = np.nan
    return H, run_weight


def _run_bin_mean_se(H: np.ndarray, run_weight: np.ndarray) -> tuple[np.ndarray, np.ndarray, int]:
    """DISTRIB-style run-total-weighted mean and standard error.

    For active run k, H[k, b] is the normalized probability of bin b and
    run_weight[k] is the run's total statistical weight.  The mean and second
    moment are weighted by run_weight.  The SE follows DISTRIB's convention:
    sqrt(max(E_w[p^2] - E_w[p]^2, 0) * n/(n-1)) / sqrt(n), where n is the
    number of active runs.
    """
    H = np.asarray(H, dtype=np.float64)
    run_weight = np.asarray(run_weight, dtype=np.float64)
    if H.ndim != 2 or H.shape[1] <= 0:
        return np.zeros((0,), dtype=np.float64), np.zeros((0,), dtype=np.float64), 0
    if run_weight.ndim != 1 or run_weight.shape[0] != H.shape[0]:
        raise ValueError(f"run_weight shape mismatch: H={H.shape} run_weight={run_weight.shape}")
    active = np.any(np.isfinite(H), axis=1) & np.isfinite(run_weight) & (run_weight > 0.0)
    n_active = int(np.count_nonzero(active))
    if n_active <= 0:
        z = np.zeros((H.shape[1],), dtype=np.float64)
        return z, z.copy(), 0
    H_active = H[active, :]
    W = run_weight[active].astype(np.float64, copy=False)
    wsum = float(np.sum(W))
    if not np.isfinite(wsum) or wsum <= 0.0:
        z = np.zeros((H.shape[1],), dtype=np.float64)
        return z, z.copy(), 0
    H_active = np.where(np.isfinite(H_active), H_active, 0.0)
    mean = np.sum(H_active * W[:, None], axis=0) / wsum
    if n_active >= 2:
        second = np.sum((H_active * H_active) * W[:, None], axis=0) / wsum
        var = np.maximum(second - mean * mean, 0.0) * (float(n_active) / float(n_active - 1))
        se = np.sqrt(var) / math.sqrt(float(n_active))
    else:
        se = np.zeros_like(mean)
    mean = np.where(np.isfinite(mean), mean, 0.0)
    se = np.where(np.isfinite(se), se, 0.0)
    return mean, se, n_active


def _compute_run_bin_significance_from_values(
    xA: np.ndarray, xB: np.ndarray, wA: np.ndarray, wB: np.ndarray,
    run_idsA: np.ndarray, run_idsB: np.ndarray, *,
    n_runs_A: int, n_runs_B: int, bins: int, x_min: float, x_max: float,
    peak_frac: float, min_count: int, alpha: float, fdr: bool, sig_area_threshold: float,
) -> dict[str, object]:
    HA, run_weight_A = _run_bin_hist_matrix(xA, wA, run_idsA, bins=bins, x_min=x_min, x_max=x_max, n_runs=n_runs_A)
    HB, run_weight_B = _run_bin_hist_matrix(xB, wB, run_idsB, bins=bins, x_min=x_min, x_max=x_max, n_runs=n_runs_B)
    meanA, seA, n_active_A = _run_bin_mean_se(HA, run_weight_A)
    meanB, seB, n_active_B = _run_bin_mean_se(HB, run_weight_B)
    if n_active_A < 2 or n_active_B < 2:
        pvals0 = np.full((bins,), np.nan, dtype=np.float64)
        return {
            'passed': False,
            'n_important_bins': 0,
            'n_sig_bins': 0,
            'min_p_bin': float('nan'),
            'min_q_bin': float('nan'),
            'sig_area': 0.0,
            'sig_logpmax': 0.0,
            'sig_strength': 0.0,
            'meanA': meanA, 'meanB': meanB, 'seA': seA, 'seB': seB,
            'run_weight_A': run_weight_A, 'run_weight_B': run_weight_B,
            'n_active_runs_A': int(n_active_A), 'n_active_runs_B': int(n_active_B),
            'run_se_weighting': 'distrib_swei',
            'important': np.zeros((bins,), dtype=bool),
            'sig': np.zeros((bins,), dtype=bool),
            'pvals': pvals0, 'qvals': pvals0.copy(), 'sig_logp': np.zeros((bins,), dtype=np.float64),
        }
    pmaxA = float(np.max(meanA)) if meanA.size else 0.0
    pmaxB = float(np.max(meanB)) if meanB.size else 0.0
    frac = max(0.0, float(peak_frac))
    important = np.zeros((bins,), dtype=bool)
    if pmaxA > 0.0:
        important |= meanA >= frac * pmaxA
    if pmaxB > 0.0:
        important |= meanB >= frac * pmaxB
    min_count = max(0, int(min_count))
    if min_count > 0 and bins > 0:
        pooled = 0.5 * (meanA + meanB)
        topn = min(int(min_count), int(bins))
        if topn > 0:
            important[np.argsort(pooled)[-topn:]] = True
    pvals = np.full((bins,), np.nan, dtype=np.float64)
    for b in np.where(important)[0]:
        pvals[int(b)] = _weighted_run_bin_pvalue(meanA[int(b)], seA[int(b)], n_active_A, meanB[int(b)], seB[int(b)], n_active_B)
    qvals = _bh_fdr(pvals) if bool(fdr) else np.array(pvals, copy=True)
    sig_metric = qvals if bool(fdr) else pvals
    sig = important & np.isfinite(sig_metric) & (sig_metric <= float(alpha))
    sig_diff = np.abs(meanA - meanB)
    sig_area = float(np.sum(sig_diff[sig])) if np.any(sig) else 0.0
    sig_metric_eff = sig_metric if bool(fdr) else pvals
    sig_logp = np.zeros((bins,), dtype=np.float64)
    finite_metric = np.isfinite(sig_metric_eff) & (sig_metric_eff > 0.0)
    sig_logp[finite_metric] = -np.log10(np.maximum(sig_metric_eff[finite_metric], 1.0e-300))
    sig_logp[~finite_metric & sig] = 300.0
    sig_logpmax = float(np.max(sig_logp[sig])) if np.any(sig) else 0.0
    sig_strength = float(np.sum(sig_diff[sig] * sig_logp[sig])) if np.any(sig) else 0.0
    passed = bool(np.count_nonzero(sig) >= 1 and sig_area >= float(sig_area_threshold))
    finite_p = pvals[np.isfinite(pvals)]
    finite_q = qvals[np.isfinite(qvals)]
    return {
        'passed': bool(passed),
        'n_important_bins': int(np.count_nonzero(important)),
        'n_sig_bins': int(np.count_nonzero(sig)),
        'min_p_bin': float(np.min(finite_p)) if finite_p.size else float('nan'),
        'min_q_bin': float(np.min(finite_q)) if finite_q.size else float('nan'),
        'sig_area': float(sig_area),
        'sig_logpmax': float(sig_logpmax),
        'sig_strength': float(sig_strength),
        'meanA': meanA, 'meanB': meanB, 'seA': seA, 'seB': seB,
        'run_weight_A': run_weight_A, 'run_weight_B': run_weight_B,
        'n_active_runs_A': int(n_active_A), 'n_active_runs_B': int(n_active_B),
        'run_se_weighting': 'distrib_swei',
        'important': important, 'sig': sig, 'pvals': pvals, 'qvals': qvals, 'sig_logp': sig_logp,
    }


def _weighted_run_subset_mean(H: np.ndarray, run_weight: np.ndarray, idx: np.ndarray) -> np.ndarray:
    """Weighted mean of per-run probability histograms for a run subset."""
    H = np.asarray(H, dtype=np.float64)
    run_weight = np.asarray(run_weight, dtype=np.float64)
    idx = np.asarray(idx, dtype=np.int64)
    if H.ndim != 2 or H.shape[1] <= 0 or idx.size <= 0:
        return np.zeros((H.shape[1] if H.ndim == 2 else 0,), dtype=np.float64)
    valid = idx[(idx >= 0) & (idx < H.shape[0])]
    if valid.size <= 0:
        return np.zeros((H.shape[1],), dtype=np.float64)
    HH = H[valid, :]
    WW = run_weight[valid]
    active = np.any(np.isfinite(HH), axis=1) & np.isfinite(WW) & (WW > 0.0)
    if not np.any(active):
        return np.zeros((H.shape[1],), dtype=np.float64)
    HH = np.where(np.isfinite(HH[active, :]), HH[active, :], 0.0)
    WW = WW[active].astype(np.float64, copy=False)
    wsum = float(np.sum(WW))
    if not np.isfinite(wsum) or wsum <= 0.0:
        return np.zeros((H.shape[1],), dtype=np.float64)
    out = np.sum(HH * WW[:, None], axis=0) / wsum
    return np.where(np.isfinite(out), out, 0.0)


def _tv_between_prob_vectors(p: np.ndarray, q: np.ndarray) -> float:
    p = np.asarray(p, dtype=np.float64)
    q = np.asarray(q, dtype=np.float64)
    if p.shape != q.shape or p.size <= 0:
        return 0.0
    val = 0.5 * float(np.sum(np.abs(np.where(np.isfinite(p), p, 0.0) - np.where(np.isfinite(q), q, 0.0))))
    if not np.isfinite(val):
        return 0.0
    return float(max(0.0, min(1.0, val)))


def _compute_ced_from_values(
    xA: np.ndarray, xB: np.ndarray, wA: np.ndarray, wB: np.ndarray,
    run_idsA: np.ndarray, run_idsB: np.ndarray, *,
    n_runs_A: int, n_runs_B: int, bins: int, x_min: float, x_max: float,
    within_splits: int, r_threshold: float, z_threshold: float, min_tv: float,
    seed: int, eps: float, null_splits: int = CED_NULL_SPLITS_DEFAULT, null_r_threshold: float = 1.2, null_z_threshold: float = 1.0, null_p_threshold: float = 0.10,
) -> dict[str, object]:
    """Backward-compatible CED wrapper for callers that only have frame values.

    The implementation now builds per-run histograms once and delegates to the
    optimized run-histogram CED core.  No within split recomputes frame-level
    histograms.
    """
    HA, run_weight_A = _run_bin_hist_matrix(xA, wA, run_idsA, bins=bins, x_min=x_min, x_max=x_max, n_runs=n_runs_A)
    HB, run_weight_B = _run_bin_hist_matrix(xB, wB, run_idsB, bins=bins, x_min=x_min, x_max=x_max, n_runs=n_runs_B)
    meanA, _seA, n_active_A = _run_bin_mean_se(HA, run_weight_A)
    meanB, _seB, n_active_B = _run_bin_mean_se(HB, run_weight_B)
    patterns_A = _ced_make_split_patterns(int(n_runs_A), int(within_splits), int(seed) + 17)
    patterns_B = _ced_make_split_patterns(int(n_runs_B), int(within_splits), int(seed) + 31)
    return _compute_ced_from_run_hists(
        HA, HB, run_weight_A, run_weight_B,
        meanA=meanA, meanB=meanB,
        n_active_A=int(n_active_A), n_active_B=int(n_active_B),
        patterns_A=patterns_A, patterns_B=patterns_B,
        within_splits=int(within_splits), null_splits=int(null_splits), seed=int(seed),
        r_threshold=float(r_threshold), z_threshold=float(z_threshold),
        null_r_threshold=float(null_r_threshold), null_z_threshold=float(null_z_threshold), null_p_threshold=float(null_p_threshold),
        min_tv=float(min_tv), eps=float(eps),
    )

def _ced_make_split_patterns(n_runs: int, within_splits: int, seed: int) -> list[tuple[np.ndarray, np.ndarray]]:
    """Create deterministic within-condition run split patterns.

    The patterns are generated once per ensemble and then reused for every
    feature.  Reusing the same split patterns avoids per-feature RNG overhead,
    makes CED feature-to-feature comparisons more stable, and preserves the
    intended question: whether A/B separation exceeds typical same-condition
    run-split separation.
    """
    n_runs = int(n_runs)
    within_splits = max(0, int(within_splits))
    if n_runs < 4 or within_splits <= 0:
        return []
    rng = np.random.default_rng(int(seed) & 0xffffffff)
    base = np.arange(n_runs, dtype=np.int64)
    n1 = n_runs // 2
    patterns: list[tuple[np.ndarray, np.ndarray]] = []
    for _ in range(within_splits):
        perm = rng.permutation(base)
        g1 = np.asarray(perm[:n1], dtype=np.int64).copy()
        g2 = np.asarray(perm[n1:], dtype=np.int64).copy()
        if g1.size > 0 and g2.size > 0:
            patterns.append((g1, g2))
    return patterns


def _ced_make_pooled_label_patterns(n_runs_A: int, n_runs_B: int, null_splits: int, seed: int) -> list[tuple[np.ndarray, np.ndarray]]:
    """Create deterministic pooled-label nA/nB split patterns for CED null tests.

    The original A/B labels are ignored after the run-level histograms have been
    built.  The resulting random splits estimate how large a group difference can
    arise from finite run sampling alone.  Patterns are generated once per Stage1
    run and reused for all features, so no frame-level distances or histograms are
    recomputed for the null model.
    """
    nA = int(n_runs_A)
    nB = int(n_runs_B)
    n_total = nA + nB
    null_splits = max(0, int(null_splits))
    if nA <= 0 or nB <= 0 or n_total < 4 or null_splits <= 0:
        return []
    rng = np.random.default_rng(int(seed) & 0xffffffff)
    base = np.arange(n_total, dtype=np.int64)
    patterns: list[tuple[np.ndarray, np.ndarray]] = []
    for _ in range(null_splits):
        perm = rng.permutation(base)
        g1 = np.asarray(perm[:nA], dtype=np.int64).copy()
        g2 = np.asarray(perm[nA:nA + nB], dtype=np.int64).copy()
        if g1.size > 0 and g2.size > 0:
            patterns.append((g1, g2))
    return patterns


def _weighted_run_subset_mean_valid(H: np.ndarray, run_weight: np.ndarray, idx: np.ndarray) -> tuple[np.ndarray, bool]:
    """Weighted mean of run histograms plus a validity flag.

    Unlike _weighted_run_subset_mean(), this helper reports whether at least one
    active run contributed to the subset.  CED uses the flag to skip split probes
    that become empty after zero-weight/inactive runs are removed.
    """
    H = np.asarray(H, dtype=np.float64)
    run_weight = np.asarray(run_weight, dtype=np.float64)
    idx = np.asarray(idx, dtype=np.int64)
    if H.ndim != 2 or H.shape[1] <= 0 or idx.size <= 0:
        return np.zeros((H.shape[1] if H.ndim == 2 else 0,), dtype=np.float64), False
    valid = idx[(idx >= 0) & (idx < H.shape[0])]
    if valid.size <= 0:
        return np.zeros((H.shape[1],), dtype=np.float64), False
    HH = H[valid, :]
    WW = run_weight[valid]
    active = np.any(np.isfinite(HH), axis=1) & np.isfinite(WW) & (WW > 0.0)
    if not np.any(active):
        return np.zeros((H.shape[1],), dtype=np.float64), False
    HH = np.where(np.isfinite(HH[active, :]), HH[active, :], 0.0)
    WW = WW[active].astype(np.float64, copy=False)
    wsum = float(np.sum(WW))
    if not np.isfinite(wsum) or wsum <= 0.0:
        return np.zeros((H.shape[1],), dtype=np.float64), False
    out = np.sum(HH * WW[:, None], axis=0) / wsum
    return np.where(np.isfinite(out), out, 0.0), True


def _ced_tvs_from_patterns_batched(
    H: np.ndarray,
    run_weight: np.ndarray,
    patterns: list[tuple[np.ndarray, np.ndarray]],
    *,
    batch_size: int = CED_PATTERN_BATCH_SIZE_DEFAULT,
) -> np.ndarray:
    """Compute split-pattern TVs by vectorized weighted run averaging.

    The split definitions are converted to normalized run-weight matrices in
    bounded batches.  Matrix multiplication evaluates all probability-vector
    means in a batch at once, avoiding a Python loop over histogram bins while
    keeping peak memory independent of the total number of split probes.
    Invalid probes whose group loses every positive-weight active run are
    skipped exactly as in the scalar implementation.
    """
    if not patterns:
        return np.zeros((0,), dtype=np.float64)
    H = np.asarray(H, dtype=np.float64)
    run_weight = np.asarray(run_weight, dtype=np.float64).reshape(-1)
    if H.ndim != 2 or H.shape[1] <= 0 or H.shape[0] != run_weight.size:
        return np.zeros((0,), dtype=np.float64)
    n_runs, n_bins = H.shape
    active = np.any(np.isfinite(H), axis=1) & np.isfinite(run_weight) & (run_weight > 0.0)
    H_clean = np.where(np.isfinite(H), H, 0.0)
    rw_clean = np.where(active, run_weight, 0.0)
    batch_size = max(1, int(batch_size or CED_PATTERN_BATCH_SIZE_DEFAULT))
    chunks: list[np.ndarray] = []
    for p0 in range(0, len(patterns), batch_size):
        batch = patterns[p0:p0 + batch_size]
        W1 = np.zeros((len(batch), n_runs), dtype=np.float64)
        W2 = np.zeros((len(batch), n_runs), dtype=np.float64)
        valid_probe = np.zeros((len(batch),), dtype=bool)
        for row, (g1_raw, g2_raw) in enumerate(batch):
            g1 = np.asarray(g1_raw, dtype=np.int64).reshape(-1)
            g2 = np.asarray(g2_raw, dtype=np.int64).reshape(-1)
            g1 = g1[(g1 >= 0) & (g1 < n_runs)]
            g2 = g2[(g2 >= 0) & (g2 < n_runs)]
            if g1.size <= 0 or g2.size <= 0:
                continue
            w1 = rw_clean[g1]
            w2 = rw_clean[g2]
            s1 = float(np.sum(w1))
            s2 = float(np.sum(w2))
            if not (np.isfinite(s1) and s1 > 0.0 and np.isfinite(s2) and s2 > 0.0):
                continue
            W1[row, g1] = w1 / s1
            W2[row, g2] = w2 / s2
            valid_probe[row] = True
        if not np.any(valid_probe):
            continue
        p1 = W1[valid_probe, :] @ H_clean
        p2 = W2[valid_probe, :] @ H_clean
        tv = 0.5 * np.sum(np.abs(p1 - p2), axis=1)
        tv = np.clip(np.where(np.isfinite(tv), tv, np.nan), 0.0, 1.0)
        tv = tv[np.isfinite(tv)]
        if tv.size:
            chunks.append(np.asarray(tv, dtype=np.float64))
    if not chunks:
        return np.zeros((0,), dtype=np.float64)
    return np.concatenate(chunks)


def _ced_within_tvs_from_patterns(
    H: np.ndarray,
    run_weight: np.ndarray,
    patterns: list[tuple[np.ndarray, np.ndarray]],
    *,
    batch_size: int = CED_PATTERN_BATCH_SIZE_DEFAULT,
) -> np.ndarray:
    """Compute same-condition split TVs from precomputed run histograms."""
    return _ced_tvs_from_patterns_batched(H, run_weight, patterns, batch_size=int(batch_size))


def _ced_null_tvs_from_patterns(
    HA: np.ndarray,
    HB: np.ndarray,
    run_weight_A: np.ndarray,
    run_weight_B: np.ndarray,
    patterns: list[tuple[np.ndarray, np.ndarray]],
    *,
    batch_size: int = CED_PATTERN_BATCH_SIZE_DEFAULT,
) -> np.ndarray:
    """Compute pooled-label null TVs from run histograms in bounded batches."""
    if not patterns:
        return np.zeros((0,), dtype=np.float64)
    HA = np.asarray(HA, dtype=np.float64)
    HB = np.asarray(HB, dtype=np.float64)
    if HA.ndim != 2 or HB.ndim != 2 or HA.shape[1] != HB.shape[1]:
        return np.zeros((0,), dtype=np.float64)
    Hpool = np.vstack([HA, HB])
    rw_pool = np.concatenate([
        np.asarray(run_weight_A, dtype=np.float64),
        np.asarray(run_weight_B, dtype=np.float64),
    ])
    return _ced_tvs_from_patterns_batched(Hpool, rw_pool, patterns, batch_size=int(batch_size))

def _compute_ced_from_run_hists(
    HA: np.ndarray,
    HB: np.ndarray,
    run_weight_A: np.ndarray,
    run_weight_B: np.ndarray,
    *,
    meanA: np.ndarray | None = None,
    meanB: np.ndarray | None = None,
    n_active_A: int | None = None,
    n_active_B: int | None = None,
    patterns_A: list[tuple[np.ndarray, np.ndarray]] | None = None,
    patterns_B: list[tuple[np.ndarray, np.ndarray]] | None = None,
    patterns_null: list[tuple[np.ndarray, np.ndarray]] | None = None,
    within_splits: int = CED_WITHIN_SPLITS_DEFAULT,
    null_splits: int = CED_NULL_SPLITS_DEFAULT,
    seed: int = 0,
    r_threshold: float = 1.5,
    z_threshold: float = 2.0,
    null_r_threshold: float = 1.2,
    null_z_threshold: float = 1.0,
    null_p_threshold: float = 0.10,
    min_tv: float = 0.02,
    eps: float = 1.0e-6,
    pattern_batch_size: int = CED_PATTERN_BATCH_SIZE_DEFAULT,
) -> dict[str, object]:
    """Compute CED diagnostics from already-built per-run histograms.

    This is the optimized CED core.  The caller builds HA/HB once for a feature;
    this function derives the ordinary A/B TV, all within-condition split TVs,
    and the CED score from those histograms without revisiting frame-level data.
    """
    HA = np.asarray(HA, dtype=np.float64)
    HB = np.asarray(HB, dtype=np.float64)
    run_weight_A = np.asarray(run_weight_A, dtype=np.float64)
    run_weight_B = np.asarray(run_weight_B, dtype=np.float64)
    if meanA is None or meanB is None or n_active_A is None or n_active_B is None:
        meanA0, _seA, nA0 = _run_bin_mean_se(HA, run_weight_A)
        meanB0, _seB, nB0 = _run_bin_mean_se(HB, run_weight_B)
        meanA = meanA0 if meanA is None else meanA
        meanB = meanB0 if meanB is None else meanB
        n_active_A = nA0 if n_active_A is None else n_active_A
        n_active_B = nB0 if n_active_B is None else n_active_B
    meanA = np.asarray(meanA, dtype=np.float64)
    meanB = np.asarray(meanB, dtype=np.float64)
    between_tv = _tv_between_prob_vectors(meanA, meanB)

    if patterns_A is None:
        patterns_A = _ced_make_split_patterns(HA.shape[0], int(within_splits), int(seed) + 17)
    if patterns_B is None:
        patterns_B = _ced_make_split_patterns(HB.shape[0], int(within_splits), int(seed) + 31)
    within_A = _ced_within_tvs_from_patterns(HA, run_weight_A, patterns_A, batch_size=int(pattern_batch_size))
    within_B = _ced_within_tvs_from_patterns(HB, run_weight_B, patterns_B, batch_size=int(pattern_batch_size))
    if within_A.size and within_B.size:
        within = np.concatenate([within_A, within_B])
    elif within_A.size:
        within = within_A
    elif within_B.size:
        within = within_B
    else:
        within = np.zeros((0,), dtype=np.float64)
    within = within[np.isfinite(within)]

    if within.size:
        within_median = float(np.median(within))
        within_mean = float(np.mean(within))
        within_std = float(np.std(within, ddof=1)) if within.size >= 2 else 0.0
        ge = int(np.count_nonzero(within >= between_tv))
        p_effect = float((1 + ge) / (1 + int(within.size)))
    else:
        within_median = 0.0
        within_mean = 0.0
        within_std = 0.0
        p_effect = 1.0

    if patterns_null is None:
        patterns_null = _ced_make_pooled_label_patterns(HA.shape[0], HB.shape[0], int(null_splits), int(seed) + 1019)
    null_vals = _ced_null_tvs_from_patterns(HA, HB, run_weight_A, run_weight_B, patterns_null, batch_size=int(pattern_batch_size))
    null_vals = null_vals[np.isfinite(null_vals)]
    if null_vals.size:
        null_median = float(np.median(null_vals))
        null_mean = float(np.mean(null_vals))
        null_std = float(np.std(null_vals, ddof=1)) if null_vals.size >= 2 else 0.0
        ge_null = int(np.count_nonzero(null_vals >= between_tv))
        p_null = float((1 + ge_null) / (1 + int(null_vals.size)))
    else:
        null_median = 0.0
        null_mean = 0.0
        null_std = 0.0
        p_null = 1.0

    eps = max(1.0e-12, float(eps))
    r_effect = float(between_tv / max(within_median, eps)) if between_tv > 0.0 else 0.0
    z_effect = float((between_tv - within_mean) / max(within_std, eps)) if between_tv > 0.0 else 0.0
    r_null = float(between_tv / max(null_median, eps)) if between_tv > 0.0 else 0.0
    z_null = float((between_tv - null_mean) / max(null_std, eps)) if between_tv > 0.0 else 0.0
    if not np.isfinite(z_effect):
        z_effect = 0.0
    if not np.isfinite(r_effect):
        r_effect = 0.0
    if not np.isfinite(z_null):
        z_null = 0.0
    if not np.isfinite(r_null):
        r_null = 0.0
    passed_prelim = bool(
        (between_tv >= float(min_tv))
        and (r_effect >= float(r_threshold))
        and (z_effect >= float(z_threshold))
        and (r_null >= float(null_r_threshold))
        and (z_null >= float(null_z_threshold))
        and (p_null <= float(null_p_threshold))
    )
    p_term = -math.log10(max(float(p_null), 1.0e-300))
    score = float(
        between_tv
        * max(0.0, math.log(max(r_effect, 1.0)))
        * max(0.0, z_effect)
        * max(0.0, math.log(max(r_null, 1.0)))
        * max(0.0, z_null)
        * max(1.0, p_term)
    )
    if not np.isfinite(score):
        score = 0.0
    return {
        'passed_prelim': bool(passed_prelim),
        'passed': bool(passed_prelim),
        'ced_between_tv': float(between_tv),
        'ced_within_median': float(within_median),
        'ced_within_mean': float(within_mean),
        'ced_within_std': float(within_std),
        'ced_r_effect': float(r_effect),
        'ced_z_effect': float(z_effect),
        'ced_p_effect': float(p_effect),
        'ced_q_effect': 1.0,
        'ced_effect_score': float(score),
        'ced_n_within': int(within.size),
        'ced_null_median': float(null_median),
        'ced_null_mean': float(null_mean),
        'ced_null_std': float(null_std),
        'ced_r_null': float(r_null),
        'ced_z_null': float(z_null),
        'ced_p_null': float(p_null),
        'ced_q_null': 1.0,
        'ced_n_null': int(null_vals.size),
        'run_weight_A': run_weight_A,
        'run_weight_B': run_weight_B,
        'n_active_runs_A': int(n_active_A or 0),
        'n_active_runs_B': int(n_active_B or 0),
    }


def _apply_ced_result_to_feature_stat(fs: FeatureStat, ced: dict[str, object]) -> FeatureStat:
    fs.passed_ced = bool(ced.get('passed', False))
    fs.ced_between_tv = float(ced.get('ced_between_tv', 0.0))
    fs.ced_within_median = float(ced.get('ced_within_median', 0.0))
    fs.ced_within_mean = float(ced.get('ced_within_mean', 0.0))
    fs.ced_within_std = float(ced.get('ced_within_std', 0.0))
    fs.ced_r_effect = float(ced.get('ced_r_effect', 0.0))
    fs.ced_z_effect = float(ced.get('ced_z_effect', 0.0))
    fs.ced_p_effect = float(ced.get('ced_p_effect', 1.0))
    fs.ced_q_effect = float(ced.get('ced_q_effect', 1.0))
    fs.ced_effect_score = float(ced.get('ced_effect_score', 0.0))
    fs.ced_n_within = int(ced.get('ced_n_within', 0))
    fs.ced_null_median = float(ced.get('ced_null_median', 0.0))
    fs.ced_null_mean = float(ced.get('ced_null_mean', 0.0))
    fs.ced_null_std = float(ced.get('ced_null_std', 0.0))
    fs.ced_r_null = float(ced.get('ced_r_null', 0.0))
    fs.ced_z_null = float(ced.get('ced_z_null', 0.0))
    fs.ced_p_null = float(ced.get('ced_p_null', 1.0))
    fs.ced_q_null = float(ced.get('ced_q_null', 1.0))
    fs.ced_n_null = int(ced.get('ced_n_null', 0))
    return fs


def _compute_feature_stat_ced_from_values(
    *,
    fid: int,
    kind: int,
    id_str: str,
    xA: np.ndarray,
    xB: np.ndarray,
    wA: np.ndarray,
    wB: np.ndarray,
    run_idsA: np.ndarray,
    run_idsB: np.ndarray,
    n_runs_A: int,
    n_runs_B: int,
    bins_max: int,
    bins_min_neff_per_bin: float,
    tv_threshold: float,
    within_splits: int,
    null_splits: int,
    r_threshold: float,
    z_threshold: float,
    null_r_threshold: float,
    null_z_threshold: float,
    null_p_threshold: float,
    min_tv: float,
    eps: float,
    patterns_A: list[tuple[np.ndarray, np.ndarray]] | None = None,
    patterns_B: list[tuple[np.ndarray, np.ndarray]] | None = None,
    patterns_null: list[tuple[np.ndarray, np.ndarray]] | None = None,
    pattern_batch_size: int = CED_PATTERN_BATCH_SIZE_DEFAULT,
    use_full_range: bool = True,
) -> FeatureStat:
    """Compute FeatureStat and CED diagnostics with a single run-hist pass.

    For CED mode, ordinary TV and CED's D_between use the same A/B mean
    distributions.  This avoids the previous duplicate work where a global TV
    histogram was built first and a second run-level histogram was built for CED.
    """
    xA = np.asarray(xA, dtype=np.float64)
    xB = np.asarray(xB, dtype=np.float64)
    wA = np.asarray(wA, dtype=np.float64)
    wB = np.asarray(wB, dtype=np.float64)
    nA = int(xA.size)
    nB = int(xB.size)
    n_eff_frames = nA + nB
    if n_eff_frames <= 0:
        return FeatureStat(fid=fid, kind=kind, id_str=id_str, tv=0.0, passed_tv=False, bins=1, n_eff=0, meanA=0.0, meanB=0.0, stdA=0.0, stdB=0.0, minv=0.0, maxv=0.0)
    xs = np.concatenate([xA, xB]) if bool(use_full_range) else np.concatenate([xA, xB])
    if xs.size == 0:
        return FeatureStat(fid=fid, kind=kind, id_str=id_str, tv=0.0, passed_tv=False, bins=1, n_eff=n_eff_frames, meanA=0.0, meanB=0.0, stdA=0.0, stdB=0.0, minv=0.0, maxv=0.0)
    x_min, x_max = _winsor_limits_from_sample(xs, q=_TV_WINSOR_Q)
    if x_max <= x_min:
        x_max = x_min + 1e-6
    mean_val_A, stdA = _weighted_mean_std(xA, wA)
    mean_val_B, stdB = _weighted_mean_std(xB, wB)
    minv = float(min(x_min, float(np.min(xA)) if xA.size else x_min, float(np.min(xB)) if xB.size else x_min))
    maxv = float(max(x_max, float(np.max(xA)) if xA.size else x_max, float(np.max(xB)) if xB.size else x_max))
    bins_used, _neffA, _neffB, neff = _stagec_bins_from_weights(wA, wB, bins_max, bins_min_neff_per_bin)
    HA, run_weight_A = _run_bin_hist_matrix(xA, wA, run_idsA, bins=int(bins_used), x_min=float(x_min), x_max=float(x_max), n_runs=int(n_runs_A))
    HB, run_weight_B = _run_bin_hist_matrix(xB, wB, run_idsB, bins=int(bins_used), x_min=float(x_min), x_max=float(x_max), n_runs=int(n_runs_B))
    meanA_hist, _seA, n_active_A = _run_bin_mean_se(HA, run_weight_A)
    meanB_hist, _seB, n_active_B = _run_bin_mean_se(HB, run_weight_B)
    tv = _tv_between_prob_vectors(meanA_hist, meanB_hist)
    transport_w1, transport_signed, transport_ratio = _directional_transport_from_prob(meanA_hist, meanB_hist, x_min=float(x_min), x_max=float(x_max))
    fs = FeatureStat(fid=fid, kind=kind, id_str=id_str, tv=float(tv), passed_tv=bool(tv >= float(tv_threshold)), bins=int(bins_used), n_eff=int(neff), meanA=mean_val_A, meanB=mean_val_B, stdA=stdA, stdB=stdB, minv=minv, maxv=maxv, transport_w1=float(transport_w1), transport_signed=float(transport_signed), transport_ratio=float(transport_ratio))
    ced = _compute_ced_from_run_hists(
        HA, HB, run_weight_A, run_weight_B,
        meanA=meanA_hist, meanB=meanB_hist,
        n_active_A=int(n_active_A), n_active_B=int(n_active_B),
        patterns_A=patterns_A, patterns_B=patterns_B, patterns_null=patterns_null,
        within_splits=int(within_splits), null_splits=int(null_splits), seed=0,
        r_threshold=float(r_threshold), z_threshold=float(z_threshold),
        null_r_threshold=float(null_r_threshold), null_z_threshold=float(null_z_threshold),
        null_p_threshold=float(null_p_threshold),
        min_tv=float(min_tv), eps=float(eps), pattern_batch_size=int(pattern_batch_size),
    )
    return _apply_ced_result_to_feature_stat(fs, ced)

def _compute_feature_stat_strict_from_values(
    *,
    fid: int,
    kind: int,
    id_str: str,
    xA: np.ndarray,
    xB: np.ndarray,
    wA: np.ndarray,
    wB: np.ndarray,
    bins_max: int,
    bins_min_neff_per_bin: float,
    tv_threshold: float,
    idxA_bins: np.ndarray | None = None,
    idxB_bins: np.ndarray | None = None,
    use_full_range: bool = False,
) -> FeatureStat:
    """Compute exact Stage1 statistics for one feature."""
    xA = np.asarray(xA, dtype=np.float64)
    xB = np.asarray(xB, dtype=np.float64)
    wA = np.asarray(wA, dtype=np.float64)
    wB = np.asarray(wB, dtype=np.float64)
    nA = int(xA.size)
    nB = int(xB.size)
    n_eff = nA + nB
    if n_eff <= 0:
        return FeatureStat(fid=fid, kind=kind, id_str=id_str, tv=0.0, passed_tv=False, bins=1, n_eff=0, meanA=0.0, meanB=0.0, stdA=0.0, stdB=0.0, minv=0.0, maxv=0.0)
    idxA_bins = np.asarray(idxA_bins if idxA_bins is not None else np.zeros((0,), dtype=np.int64), dtype=np.int64)
    idxB_bins = np.asarray(idxB_bins if idxB_bins is not None else np.zeros((0,), dtype=np.int64), dtype=np.int64)
    if use_full_range or (idxA_bins.size == 0 and idxB_bins.size == 0):
        xs = np.concatenate([xA, xB])
    else:
        xs = np.concatenate([xA[idxA_bins], xB[idxB_bins]])
    if xs.size == 0:
        return FeatureStat(fid=fid, kind=kind, id_str=id_str, tv=0.0, passed_tv=False, bins=1, n_eff=n_eff, meanA=0.0, meanB=0.0, stdA=0.0, stdB=0.0, minv=0.0, maxv=0.0)
    x_min, x_max = _winsor_limits_from_sample(xs, q=_TV_WINSOR_Q)
    if x_max <= x_min:
        x_max = x_min + 1e-6
    meanA, stdA = _weighted_mean_std(xA, wA)
    meanB, stdB = _weighted_mean_std(xB, wB)
    minv = float(min(x_min, float(np.min(xA)) if xA.size else x_min, float(np.min(xB)) if xB.size else x_min))
    maxv = float(max(x_max, float(np.max(xA)) if xA.size else x_max, float(np.max(xB)) if xB.size else x_max))
    bins_used, _neffA, _neffB, neff = _stagec_bins_from_weights(wA, wB, bins_max, bins_min_neff_per_bin)
    pA = _hist_prob_uniform_clip(xA, wA, bins=bins_used, x_min=x_min, x_max=x_max)
    pB = _hist_prob_uniform_clip(xB, wB, bins=bins_used, x_min=x_min, x_max=x_max)
    ovl = float(np.minimum(pA, pB).sum())
    tv = max(0.0, min(1.0, 1.0 - ovl))
    transport_w1, transport_signed, transport_ratio = _directional_transport_from_prob(pA, pB, x_min=float(x_min), x_max=float(x_max))
    passed = bool(tv >= float(tv_threshold))
    return FeatureStat(fid=fid, kind=kind, id_str=id_str, tv=float(tv), passed_tv=passed, bins=int(bins_used), n_eff=int(neff), meanA=meanA, meanB=meanB, stdA=stdA, stdB=stdB, minv=minv, maxv=maxv, transport_w1=float(transport_w1), transport_signed=float(transport_signed), transport_ratio=float(transport_ratio))


def _compute_feature_stat_strict(
    j: int,
    XA: np.ndarray,
    XB: np.ndarray,
    wA: np.ndarray,
    wB: np.ndarray,
    *,
    kind: int,
    id_str: str,
    idxA_bins: np.ndarray,
    idxB_bins: np.ndarray,
    bins_max: int,
    bins_min_neff_per_bin: float,
    tv_threshold: float,
    use_full_range: bool = False,
) -> FeatureStat:
    """Compute per-feature statistics for Stage1 TV."""
    return _compute_feature_stat_strict_from_values(
        fid=int(j),
        kind=int(kind),
        id_str=str(id_str),
        xA=np.asarray(XA[:, j], dtype=np.float64),
        xB=np.asarray(XB[:, j], dtype=np.float64),
        wA=np.asarray(wA, dtype=np.float64),
        wB=np.asarray(wB, dtype=np.float64),
        bins_max=int(bins_max),
        bins_min_neff_per_bin=float(bins_min_neff_per_bin),
        tv_threshold=float(tv_threshold),
        idxA_bins=np.asarray(idxA_bins, dtype=np.int64),
        idxB_bins=np.asarray(idxB_bins, dtype=np.int64),
        use_full_range=bool(use_full_range),
    )


def _phase1_feat_init_strict(
    featA_path: str,
    featB_path: str,
    wA: np.ndarray,
    wB: np.ndarray,
    idxA_bins: np.ndarray,
    idxB_bins: np.ndarray,
    bins_max: int,
    bins_min_neff_per_bin: float,
    tv_threshold: float,
    meta_kind: np.ndarray,
    meta_i: np.ndarray,
    meta_j: np.ndarray,
    meta_res_i: np.ndarray,
    meta_res_j: np.ndarray,
    meta_atom_i: np.ndarray,
    meta_atom_j: np.ndarray,
) -> None:
    _PHASE1_SHM["XA"] = np.load(featA_path, mmap_mode="r")
    _PHASE1_SHM["XB"] = np.load(featB_path, mmap_mode="r")
    _PHASE1_SHM["wA"] = np.asarray(wA, dtype=np.float64)
    _PHASE1_SHM["wB"] = np.asarray(wB, dtype=np.float64)
    _PHASE1_SHM["idxA_bins"] = np.asarray(idxA_bins, dtype=np.int64)
    _PHASE1_SHM["idxB_bins"] = np.asarray(idxB_bins, dtype=np.int64)
    _PHASE1_SHM["bins_max"] = int(bins_max)
    _PHASE1_SHM["bins_min_neff_per_bin"] = float(bins_min_neff_per_bin)
    _PHASE1_SHM["tv_threshold"] = float(tv_threshold)
    _PHASE1_SHM["meta_kind"] = np.asarray(meta_kind, dtype=np.uint8)
    _PHASE1_SHM["meta_i"] = np.asarray(meta_i, dtype=np.int32)
    _PHASE1_SHM["meta_j"] = np.asarray(meta_j, dtype=np.int32)
    _PHASE1_SHM["meta_res_i"] = np.asarray(meta_res_i, dtype=np.int32)
    _PHASE1_SHM["meta_res_j"] = np.asarray(meta_res_j, dtype=np.int32)
    _PHASE1_SHM["meta_atom_i"] = np.asarray(meta_atom_i, dtype=np.int32)
    _PHASE1_SHM["meta_atom_j"] = np.asarray(meta_atom_j, dtype=np.int32)


def _phase1_feat_worker_strict(task):
    j0, j1 = task
    XA = _PHASE1_SHM["XA"]
    XB = _PHASE1_SHM["XB"]
    wA = _PHASE1_SHM["wA"]
    wB = _PHASE1_SHM["wB"]
    idxA_bins = _PHASE1_SHM["idxA_bins"]
    idxB_bins = _PHASE1_SHM["idxB_bins"]
    bins_max = int(_PHASE1_SHM["bins_max"])
    bins_min_neff_per_bin = float(_PHASE1_SHM.get("bins_min_neff_per_bin", 30.0) or 0.0)
    tv_threshold = float(_PHASE1_SHM.get("tv_threshold", 0.35))
    mk = _PHASE1_SHM["meta_kind"]
    mi = _PHASE1_SHM["meta_i"]
    mj = _PHASE1_SHM["meta_j"]
    mri = _PHASE1_SHM["meta_res_i"]
    mrj = _PHASE1_SHM["meta_res_j"]
    mai = _PHASE1_SHM["meta_atom_i"]
    maj = _PHASE1_SHM["meta_atom_j"]

    def _id_str(j: int) -> str:
        k = int(mk[j])
        if k == 0:
            ai = int(mai[j]); aj = int(maj[j])
            return f"{ai}-{aj}" if (ai >= 0 and aj >= 0) else f"f{j}"
        if k == 1:
            ri = int(mri[j]) if int(mri[j]) >= 0 else int(mi[j])
            rj = int(mrj[j]) if int(mrj[j]) >= 0 else int(mj[j])
            return f"{ri}-{rj}"
        return f"f{j}"

    out: list[FeatureStat] = []
    for j in range(int(j0), int(j1)):
        out.append(_compute_feature_stat_strict(
            j, XA, XB, wA, wB,
            kind=int(mk[j]),
            id_str=_id_str(j),
            idxA_bins=idxA_bins,
            idxB_bins=idxB_bins,
            bins_max=bins_max,
            bins_min_neff_per_bin=bins_min_neff_per_bin,
            tv_threshold=tv_threshold,
            use_full_range=True,
        ))
    return int(j0), out


def _compute_stage1_features_parallel_files_strict(
    featA_path: Path,
    featB_path: Path,
    wA: np.ndarray,
    wB: np.ndarray,
    meta: TopPairsMeta,
    *,
    bins_max: int,
    bins_min_neff_per_bin: float,
    tv_threshold: float,
    idxA_bins: np.ndarray,
    idxB_bins: np.ndarray,
    workers: int,
    chunk: int,
    progress_interval_sec: float = 300.0,
) -> list[FeatureStat]:
    """Compute strict-TV FeatureStat for all features in parallel."""
    nA, M = np.load(featA_path, mmap_mode="r").shape
    kind_arr = np.asarray(meta.kind, dtype=np.int8)
    workers = int(workers) if int(workers) > 0 else _auto_workers()
    workers = max(1, workers)
    chunk = max(1, int(chunk))
    tasks = [(int(j0), int(min(M, j0 + chunk))) for j0 in range(0, M, chunk)]
    logger = _progress_logger("Stage1-TV", total_units=M, min_interval_sec=max(30.0, float(progress_interval_sec)))
    if workers <= 1 or M <= chunk:
        XA = np.load(featA_path, mmap_mode="r")
        XB = np.load(featB_path, mmap_mode="r")
        out: list[FeatureStat] = []
        for j in range(int(M)):
            out.append(_compute_feature_stat_strict(
                j, XA, XB, wA, wB,
                kind=int(kind_arr[j]),
                id_str=str(_meta_idstr(meta, j)),
                idxA_bins=idxA_bins,
                idxB_bins=idxB_bins,
                bins_max=bins_max,
                bins_min_neff_per_bin=bins_min_neff_per_bin,
                tv_threshold=tv_threshold,
                use_full_range=True,
            ))
            logger(j + 1, force=False)
        logger(M, force=True)
        return out

    out_lists: dict[int, list[FeatureStat]] = {}
    with ProcessPoolExecutor(
        max_workers=workers,
        initializer=_phase1_feat_init_strict,
        initargs=(str(featA_path), str(featB_path), np.asarray(wA, dtype=np.float64), np.asarray(wB, dtype=np.float64),
                  np.asarray(idxA_bins, dtype=np.int64), np.asarray(idxB_bins, dtype=np.int64), int(bins_max), float(bins_min_neff_per_bin),
                  float(tv_threshold), np.asarray(meta.kind, dtype=np.int8), np.asarray(meta.i, dtype=np.int32), np.asarray(meta.j, dtype=np.int32),
                  np.asarray(meta.res_i, dtype=np.int32), np.asarray(meta.res_j, dtype=np.int32), np.asarray(meta.atom_i, dtype=np.int32), np.asarray(meta.atom_j, dtype=np.int32)),
    ) as ex:
        done = 0
        for j0, rows in ex.map(_phase1_feat_worker_strict, tasks):
            out_lists[int(j0)] = rows
            done += len(rows)
            logger(done, force=False)
    logger(M, force=True)
    out: list[FeatureStat] = []
    for j0, _j1 in tasks:
        out.extend(out_lists[int(j0)])
    return out


# The integrated
# _run_stage1_feature_scoring() path below is the single supported Stage1
# implementation and owns Stage1 cache, TV/AUC/sig/CED selection, and the
# Stage1->Stage3 direct distance store.


def _run_stage1_feature_scoring(*,
                                             ensembleA: Path,
                                             ensembleB: Path,
                                             natomA: int,
                                             natomB: int,
                                             sel_idxA: Optional[np.ndarray],
                                             sel_idxB: Optional[np.ndarray],
                                             frame_stride: int,
                                             pair_meta: TopPairsMeta,
                                             res_of_atomA: np.ndarray,
                                             res_of_atomB: np.ndarray,
                                             n_res: int,
                                             perm_B_of_A: Optional[np.ndarray],
                                             wA: np.ndarray,
                                             wB: np.ndarray,
                                             idxA_bins: np.ndarray,
                                             idxB_bins: np.ndarray,
                                             stage1_auc_idxA_use: np.ndarray,
                                             stage1_auc_idxB_use: np.ndarray,
                                             stage1_auc_wA: np.ndarray,
                                             stage1_auc_wB: np.ndarray,
                                             bins_max: int,
                                             bins_min_neff_per_bin: float,
                                             tv_threshold: float,
                                             auc_threshold: float,
                                             auc_eps: float,
                                             auc_cv_folds: int,
                                             auc_random_state: int,
                                             auc_scope: str = 'pass',
                                             selection_mode: str = 'standard',
                                             run_idsA: np.ndarray | None = None,
                                             run_idsB: np.ndarray | None = None,
                                             n_runs_A: int = 1,
                                             n_runs_B: int = 1,
                                             run_group_hash_A: str = '',
                                             run_group_hash_B: str = '',
                                             sig_test: str = 'weighted_z',
                                             sig_alpha: float = 0.05,
                                             sig_fdr: bool = False,
                                             sig_bin_peak_frac: float = 0.03,
                                             sig_bin_min_count: int = 3,
                                             sig_area_threshold: float = 0.0,
                                             ced_within_splits: int = CED_WITHIN_SPLITS_DEFAULT,
                                             ced_null_splits: int = CED_NULL_SPLITS_DEFAULT,
                                             ced_q_threshold: float = 1.0,
                                             ced_r_threshold: float = 1.5,
                                             ced_z_threshold: float = 2.0,
                                             ced_null_r_threshold: float = 1.2,
                                             ced_null_z_threshold: float = 1.0,
                                             ced_null_p_threshold: float = 0.10,
                                             ced_null_q_threshold: float = 0.05,
                                             ced_min_tv: float = 0.02,
                                             ced_eps: float = 1.0e-6,
                                             ced_random_state: int = 0,
                                             ced_pattern_batch_size: int = CED_PATTERN_BATCH_SIZE_DEFAULT,
                                             run_hist_dir: Path | None = None,
                                             feat_chunk: int = 0,
                                             pair_block: int,
                                             workers: int = 1,
                                             progress_interval_sec: float = 300.0,
                                             memory_budget_mib: float = 512.0,
                                             frame_keep_maskA: np.ndarray | None = None,
                                             frame_keep_maskB: np.ndarray | None = None,
                                             stage1_ckpt_dir: Path | None = None,
                                             selected_feature_ids_path: Path | None = None,
                                             selected_feature_positions_path: Path | None = None,
                                             single_feature_scores_path: Path | None = None,
                                             single_feature_metrics_csv: Path | None = None,
                                             feature_metrics_dir: Path | None = None,
                                             scoring_meta_path_path: Path | None = None,
                                             scoring_done_path_path: Path | None = None,
                                             stage3_direct_store_dir: Path | None = None,
                                             stage1_auc_frame_mode: str = 'full',
                                             verbose: bool = True) -> list[FeatureStat]:
    """Integrated direct Stage1 using block-driven 1.5-pass exact processing.

    Pass 1: read trajectory blocks once and materialize per-block/per-feature-batch scratch arrays.
    Pass 1.5: read scratch for each feature batch, compute exact TV over all values, then compute AUC only
    for primary-pass features (or all features when --auc-scope all is used) and persist final artifacts. Reuse is allowed only when the full run signature
    matches; otherwise all prior scratch/chunk artifacts are invalidated.
    """
    nA_raw = count_ensemble_frames(Path(ensembleA), natomA, sel_idx=sel_idxA, frame_stride=frame_stride)
    nB_raw = count_ensemble_frames(Path(ensembleB), natomB, sel_idx=sel_idxB, frame_stride=frame_stride)
    keep_maskA = np.ones((int(nA_raw),), dtype=bool) if frame_keep_maskA is None else np.asarray(frame_keep_maskA, dtype=bool)
    keep_maskB = np.ones((int(nB_raw),), dtype=bool) if frame_keep_maskB is None else np.asarray(frame_keep_maskB, dtype=bool)
    if keep_maskA.size != int(nA_raw) or keep_maskB.size != int(nB_raw):
        raise ValueError(f"frame keep mask length mismatch: A {keep_maskA.size}/{nA_raw}, B {keep_maskB.size}/{nB_raw}")
    nA = int(np.count_nonzero(keep_maskA))
    nB = int(np.count_nonzero(keep_maskB))
    M = int(len(pair_meta))
