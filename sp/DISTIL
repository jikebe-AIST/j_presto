# ---- Memory helpers (singleton zero Δ vectors) ----
_ZERO_DELTA_CACHE: dict[int, np.ndarray] = {}

def _zero_delta(bins_max: int) -> np.ndarray:
    """Return a shared zero Δ vector of length bins_max (float32).

    Many features fail Stage1 and never need their own Δ allocation. Sharing a
    singleton saves significant memory at large feature counts.
    """
    b = int(bins_max)
    z = _ZERO_DELTA_CACHE.get(b)
    if z is None:
        z = np.zeros((b,), dtype=np.float32)
        _ZERO_DELTA_CACHE[b] = z
    return z

_LOG_PREFIX_STACK: list[str] = []

def _current_log_prefix() -> str:
    return "".join(_LOG_PREFIX_STACK)


def _apply_log_prefix(msg: str) -> str:
    prefix = _current_log_prefix()
    if not prefix:
        return str(msg)
    return f"{prefix}{msg}"


class _LogPrefixScope:
    def __init__(self, prefix: str | None):
        self.prefix = str(prefix or "")

    def __enter__(self):
        _LOG_PREFIX_STACK.append(self.prefix)
        return self

    def __exit__(self, exc_type, exc, tb):
        if _LOG_PREFIX_STACK:
            _LOG_PREFIX_STACK.pop()
        return False


class _Log:
    ind = 0
    @staticmethod
    def p(tag: str, msg: str = ""):
        pad = "  " * _Log.ind
        print(_apply_log_prefix(f"{pad}{tag} {msg}".rstrip()), file=sys.stderr, flush=True)
class SectionTimer:
    """Context manager that prints [START]/[END]/elapsed for long stages.

    It always prints when enabled=True, independent of log-level, to satisfy the
    project logging policy.
    """
    def __init__(self, name: str, enabled: bool = True):
        self.name = str(name)
        self.enabled = bool(enabled)
        self._t0 = None

    def __enter__(self):
        if self.enabled:
            print(_apply_log_prefix(f"[START] {self.name}"), file=sys.stderr, flush=True)
        self._t0 = time.perf_counter()
        _Log.ind += 1
        return self

    def __exit__(self, exc_type, exc, tb):
        _Log.ind -= 1
        if self.enabled and self._t0 is not None:
            dt = time.perf_counter() - self._t0
            print(_apply_log_prefix(f"[END] {self.name} elapsed {dt:.2f} s"), file=sys.stderr, flush=True)
        return False


@dataclass
class TopPairsMeta:
    """Memory-lean metadata for feature columns.

    This replaces the old `list[dict]` representation which becomes a memory bottleneck
    at O(10^6) features.

    Fields are stored as numpy arrays (int32/uint8) and optional small string tables.
    """
    kind: np.ndarray  # uint8: 0=near, 1=long, 2=other
    i: np.ndarray     # int32 (residue index for index-related)
    j: np.ndarray     # int32
    res_i: np.ndarray # int32 (-1 if unknown)
    res_j: np.ndarray # int32 (-1 if unknown)
    agroup_i: np.ndarray  # uint8: 0=unk,1=bb,2=sc,3=other
    agroup_j: np.ndarray  # uint8
    atom_i: np.ndarray   # int32 (near only; -1 if unknown/NA)
    atom_j: np.ndarray   # int32 (near only; -1 if unknown/NA)
    equiv_group_id: np.ndarray  # int32; -1 means no equivalent-atom aggregate group
    # Optional atom-name columns are intentionally not loaded by default to avoid huge memory use.
    # If you really need them for node-keys, enable --modules-nodekey-atomname and regenerate pool.

    def __len__(self) -> int:
        return int(self.kind.shape[0])


