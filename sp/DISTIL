def _stage1_cache_check(meta: dict, want: dict, *, cache_path: Path, meta_path: Path, done_path: Path, pair_scores_path: Path):
    required = [
        (cache_path, cache_path.name),
        (pair_scores_path, pair_scores_path.name),
        (meta_path, meta_path.name),
    ]
    present = [p.exists() for p, _ in required]
    if not any(present) and not done_path.exists():
        return False, "first_run", []

    reasons: list[str] = []
    for (p, label), exists in zip(required, present):
        if not exists:
            reasons.append(f"missing: {label}")
    if not done_path.exists():
        reasons.append(f"missing: {done_path.name}")
    if reasons:
        return False, "incomplete", reasons

    if not isinstance(meta, dict):
        return False, "miss", [f"invalid JSON: {meta_path.name}"]

    for k, v in want.items():
        got = meta.get(k)
        if not _cache_equal(got, v):
            exp_short = _json_canonical_dumps(_json_normalize(_cache_key_normalize(v)))[:160]
            got_short = _json_canonical_dumps(_json_normalize(_cache_key_normalize(got)))[:160]
            reasons.append(f"stage1 meta mismatch at key={k}: expected={exp_short} got={got_short}")

    ok_done, done_reasons, done = _validate_done_payload(
        done_path,
        stage_name="Stage1",
        want_meta=want,
        required_paths=required,
    )
    if not ok_done:
        reasons.extend(done_reasons)

    nrows = _csv_row_count(pair_scores_path)
    if nrows <= 0:
        reasons.append(f"invalid_output: {pair_scores_path.name} rows={nrows}")

    if isinstance(done, dict):
        try:
            done_rows = int(((done.get("counts", {}) or {}).get("rows", -1)))
        except Exception:
            done_rows = -1
        if done_rows >= 0 and done_rows != int(nrows):
            reasons.append(f"done mismatch: rows expected={done_rows} got={nrows}")

    if reasons:
        return False, "miss", reasons
    return True, "hit", []

def _resolve_refs(args) -> tuple[Path, Path]:
    """-rA/-rB を優先。指定がなければ -r を両方に適用。足りなければエラー。PDBのみ受け付ける"""
    rA = args.refA if args.refA else args.ref
    rB = args.refB if args.refB else args.ref
    if rA is None or rB is None:
        raise SystemExit("Error: please specify -rA/-rB or -r to provide reference PDB(s).")
    rA = _ensure_pdb_path(rA)
    rB = _ensure_pdb_path(rB)
    return rA, rB

def _effective_n_from_weights(w: np.ndarray) -> float:
    """Effective sample size from nonnegative weights.

    N_eff = (sum w)^2 / sum(w^2). If weights are uniform, N_eff ≈ N.
    If weights are concentrated, N_eff becomes much smaller.

    Returns 0.0 if weights are empty or all-zero.
    """
    w = np.asarray(w, dtype=np.float64)
    if w.size == 0:
        return 0.0
    ww = np.where(np.isfinite(w), w, 0.0)
    s1 = float(ww.sum())
    if s1 <= 0.0:
        return 0.0
    s2 = float(np.square(ww).sum())
    if s2 <= 0.0:
        return 0.0
    return (s1 * s1) / s2

def _stagec_bins_from_weights(
    wA: np.ndarray,
    wB: np.ndarray,
    bins_max: int,
    bins_min_neff_per_bin: float = 30.0,
) -> tuple[int, float, float, float]:
    """Decide Stage-C histogram bins from weighted effective sample sizes.

    Primary rule:
        bins ~ sqrt(min(N_eff_A, N_eff_B))

    Additional guard:
        also cap bins so that the average effective sample size per bin is at
        least ``bins_min_neff_per_bin``. This prevents over-fragmentation of the
        Stage1-C histogram in very large datasets while preserving the original
        ``sqrt(N_eff)`` scaling for small/medium sample sizes.
    """
    neffA = _effective_n_from_weights(wA)
    neffB = _effective_n_from_weights(wB)
    neff = min(neffA, neffB)
    cand = int(math.floor(math.sqrt(neff))) if neff > 0.0 else 2

    avg_floor = float(bins_min_neff_per_bin)
    if np.isfinite(avg_floor) and avg_floor > 0.0 and neff > 0.0:
        avg_cap = int(math.floor(neff / avg_floor))
        cand = min(cand, avg_cap)

    b = max(2, min(int(bins_max), cand))
    return int(b), float(neffA), float(neffB), float(neff)


def _rank_nonnegative_desc_values(values, *, top_k: int = RANK_LEXICOGRAPHIC_TOP_K, eps: float = 1e-12) -> list[float]:
    """Return positive finite ranking values in descending order.

    Stage5 region-pair ranking is lexicographic: compare the largest
    cross-region score first, then the second largest, and so on.  Values at
    numerical zero are omitted so that rows with only zero Stage5 weights are
    retained but are not artificially distinguished before the auc_excess
    tie-breaker.
    """
    vals: list[float] = []
    for x in values:
        try:
            v = float(x)
        except Exception:
            continue
        if np.isfinite(v) and v > float(eps):
            vals.append(v)
    vals.sort(reverse=True)
    return vals[:max(0, int(top_k))]


def _rank_values_to_text(values, *, top_k: int = RANK_LEXICOGRAPHIC_TOP_K) -> str:
    vals = list(values)[:max(0, int(top_k))]
    return ';'.join(f"{float(v):.10g}" for v in vals if np.isfinite(float(v)))


def _rank_text_to_tuple(text, *, top_k: int = RANK_LEXICOGRAPHIC_TOP_K) -> tuple[float, ...]:
    vals: list[float] = []
    for tok in str(text or '').replace(',', ';').split(';'):
        tok = tok.strip()
        if not tok:
            continue
        try:
            v = float(tok)
        except Exception:
            continue
        if np.isfinite(v):
            vals.append(max(0.0, v))
    vals = vals[:max(0, int(top_k))]
    if len(vals) < max(0, int(top_k)):
        vals.extend([0.0] * (max(0, int(top_k)) - len(vals)))
    return tuple(vals)


def _auc_excess_value(auc: float) -> float:
    try:
        a = float(auc)
    except Exception:
        return 0.0
    return max(0.0, a - 0.5) if np.isfinite(a) else 0.0


def _build_near_residue_block_from_final_near_pairs(near_pairs_A: np.ndarray, res_of_atomA: np.ndarray) -> set[int]:
    """Return residue-pair keys whose long features are covered by final near features.

    Long residue-centroid features are removed only when at least one atom-pair
    feature for the same residue pair remains in the final analysis feature set.
    Raw contact candidates that are later removed by topology filtering (for
    example 1-2/1-3 bonded relations) must not suppress the corresponding long
    residue-pair feature, otherwise both the near and long descriptions of that
    residue-pair change can disappear.
    """
    blocked: set[int] = set()
    arr = np.asarray(near_pairs_A)
    if arr.size == 0:
        return blocked
    res_map = np.asarray(res_of_atomA)
    for ia, ja in arr.reshape((-1, 2)).tolist():
        ri = int(res_map[int(ia)])
        rj = int(res_map[int(ja)])
        if ri == rj:
            continue
        if ri < rj:
            blocked.add(_pack_pair(ri, rj))
        else:
            blocked.add(_pack_pair(rj, ri))
    return blocked

def _self_check():
    """Lightweight internal smoke tests that do not require feature artifacts.

    This command is intentionally limited to syntax/static checks plus core
    helper-function tests on synthetic in-memory data. It must be runnable in a
    clean environment where PASS/full feature artifacts do not exist.
    """

    # ------------------------------------------------------------------
    # (0) Static checks: duplicate top-level defs/classes
    # ------------------------------------------------------------------
    try:
        src = Path(__file__).read_text(encoding="utf-8")
        tree = ast.parse(src)
        seen = {}
        dups = []
        for node in tree.body:
            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
                name = node.name
                if name in seen:
                    dups.append((name, seen[name], getattr(node, "lineno", None)))
                else:
                    seen[name] = getattr(node, "lineno", None)
        if dups:
            for name, l1, l2 in dups:
                print(f"[SELF-CHECK][ERROR] duplicate definition: {name} (lines {l1} and {l2})", file=sys.stderr)
            raise SystemExit(2)
    except SystemExit:
        raise
    except Exception as e:  # pragma: no cover
        print(f"[SELF-CHECK][WARN] static duplicate check skipped: {e}", file=sys.stderr)

    # ------------------------------------------------------------------
    # (1) Parser smoke test (no access key / no artifacts required)
    # ------------------------------------------------------------------
    try:
        ap = build_argparser()
        parsed = ap.parse_args(['--self-check'])
        assert getattr(parsed, 'self_check', False) is True
        assert int(parsed.ced_within_splits) == int(CED_WITHIN_SPLITS_DEFAULT)
        assert int(parsed.ced_null_splits) == int(CED_NULL_SPLITS_DEFAULT)
        assert int(parsed.ced_pattern_batch_size) == int(CED_PATTERN_BATCH_SIZE_DEFAULT)
        _sig_default = _stage1_selection_cache_fields(parsed, selection_mode='ced')
        _parsed_alt = argparse.Namespace(**vars(parsed))
        _parsed_alt.ced_null_splits = int(parsed.ced_null_splits) + 1
        _sig_alt = _stage1_selection_cache_fields(_parsed_alt, selection_mode='ced')
        assert _sig_default != _sig_alt
    except Exception as e:
        print(f"[SELF-CHECK][ERROR] argparser smoke test failed: {e}", file=sys.stderr)
        raise SystemExit(2)

    # j_presto writes and reads PDB residue names as a 4-character field
    # (see src_Ens_Ana/intmp.f90: (6x,i6,a4,x,a4,a1,i8,...)).  This test
    # prevents regressions where charged/protonation labels such as LYS+ are
    # truncated to standard 3-letter PDB residue names.
    try:
        with tempfile.TemporaryDirectory(prefix='distil_pdb_parser_selfcheck_') as ttd:
            p4 = Path(ttd) / 'jpresto_resname4.pdb'
            p4.write_text('ATOM     36  N   LYS+    3       1.383 -29.603 -15.509 14.01 -0.35\n')
            a = load_pdb_atoms_one(p4)[0]
            assert a.idx1 == 36 and a.name == 'N' and a.resname == 'LYS+' and a.chain == '' and a.resid == 3
            ps = Path(ttd) / 'standard_resname3_chain.pdb'
            ps.write_text('ATOM      1  N   MET A   1      11.104  13.207   9.456  1.00 10.00           N\n')
            b = load_pdb_atoms_one(ps)[0]
            assert b.idx1 == 1 and b.name == 'N' and b.resname == 'MET' and b.chain == 'A' and b.resid == 1
    except Exception as e:
        print(f"[SELF-CHECK][ERROR] PDB parser 4-character-resname smoke test failed: {e}", file=sys.stderr)
        raise SystemExit(2)

    rng = np.random.default_rng(0)

    # Directional transport must distinguish unidirectional shifts from
    # bidirectional reshaping with no net direction.
    try:
        _w, _s, _r = _directional_transport_from_prob(np.asarray([1.0, 0.0]), np.asarray([0.0, 1.0]), x_min=0.0, x_max=2.0)
        assert _w > 0.0 and _s > 0.0 and abs(_r - 1.0) < 1e-9
        _w, _s, _r = _directional_transport_from_prob(np.asarray([0.0, 1.0]), np.asarray([1.0, 0.0]), x_min=0.0, x_max=2.0)
        assert _w > 0.0 and _s < 0.0 and abs(_r + 1.0) < 1e-9
