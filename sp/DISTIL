                                   nA: int,
                                   nB: int,
                                   outdir: str,
                                   atoms_selA: Optional[Sequence['AtomRec']] = None,
                                   args: Optional[Any] = None,
                                   equiv_group_id_by_near: Optional[np.ndarray] = None) -> dict:
    """Write feature metadata without materializing full feature matrices.

    This preserves the on-disk pair contract required by downstream stages while
    allowing Stage1 to consume coordinates directly from ensemble blocks.
    """
    os.makedirs(outdir, exist_ok=True)
    outdirP = Path(outdir)
    K = int(near_pairs_A.shape[0])
    L = int(res_pairs_idx.shape[0])
    N = K + L

    pair_index_path = outdirP / "pair_index.npy"
    kinds = np.concatenate([np.zeros(K, dtype=np.int32), np.ones(L, dtype=np.int32)], axis=0)
    rowidx = np.concatenate([np.arange(K, dtype=np.int32), np.arange(L, dtype=np.int32)], axis=0)
    pair_index = np.column_stack([kinds, rowidx])
    np.save(pair_index_path, pair_index)
    with open(str(pair_index_path) + ".ok", "w") as _f:
        _f.write("ok\n")

    pool_csv = outdirP / "top_pairs_pool.csv"
    with open(pool_csv, "w") as f:
        f.write("feature,kind,i,j,ai,aj,res_i,res_j,aname_i,aname_j,agroup_i,agroup_j,equiv_group_id,equiv_group_label,equiv_distribution_mode\n")
        for idx in range(K):
            a, b = int(near_pairs_A[idx, 0]), int(near_pairs_A[idx, 1])
            ri = int(res_of_atomA[a]); rj = int(res_of_atomA[b])
            an_i = atoms_selA[a].name if (atoms_selA is not None and a < len(atoms_selA)) else ""
            an_j = atoms_selA[b].name if (atoms_selA is not None and b < len(atoms_selA)) else ""
            ag_i = _atom_group(an_i) if an_i else ""
            ag_j = _atom_group(an_j) if an_j else ""
            egid = -1
            if equiv_group_id_by_near is not None and int(idx) < int(np.asarray(equiv_group_id_by_near).shape[0]):
                try:
                    egid = int(np.asarray(equiv_group_id_by_near, dtype=np.int32)[int(idx)])
                except Exception:
                    egid = -1
            eglabel = f"equiv_pair_group_{egid}" if egid >= 0 else ""
            edmode = "mixture" if egid >= 0 else "raw"
            f.write(f"{idx},near,{ri},{rj},{a},{b},{ri},{rj},{an_i},{an_j},{ag_i},{ag_j},{egid},{eglabel},{edmode}\n")
        for jdx in range(L):
            ri, rj = int(res_pairs_idx[jdx, 0]), int(res_pairs_idx[jdx, 1])
            f.write(f"{K + jdx},long,{ri},{rj},,,{ri},{rj},,,,,-1,,raw\n")

    meta = {
        "top_pairs_csv": str(pool_csv.resolve()),
        "pair_index": str(pair_index_path.resolve()),
        "N_total": int(N),
        "K_near": int(K),
        "L_long": int(L),
    }
    source_missing = _streaming_direct_source_sig()
    refA_path, refB_path = _resolve_refs(args) if args is not None else (None, None)
    payload = _metadata_signature_payload(
        args=args,
        refA_path=refA_path,
        refB_path=refB_path,
        extra={
            "top_pairs_csv": str(pool_csv.resolve()),
            "pair_index": str(pair_index_path.resolve()),
            "source_features_A": source_missing,
            "source_features_B": source_missing,
            "top_pairs_csv_sig": _content_sig(pool_csv),
            "pair_index_sig": _content_sig(pair_index_path),
            "M": int(N),
            "nA": int(nA),
            "nB": int(nB),
            "K_near": int(K),
            "L_long": int(L),
            "feature_definition_version": int(FEATURE_DEFINITION_VERSION),
            "pair_index_version": int(PAIR_INDEX_VERSION),
            "features_cache_version": int(FEATURES_CACHE_VERSION),
            "feature_generation_mode": "metadata-only",
        },
    )
    _merge_update_features_meta(outdirP, **payload)
    _read_features_meta_checked(
        outdirP,
        required_keys=(
            "top_pairs_csv", "pair_index", "source_features_A", "source_features_B",
            "listA_sha256", "listB_sha256", "ensembleA_sources_sig", "ensembleB_sources_sig",
            "refA_sha256", "refB_sha256", "atom_spec", "contact_distance",
            "features_cache_version", "feature_definition_version", "pair_index_version",
        ),
        context="write_feature_metadata_only_v1",
    )
    return meta
# =========================
# DISTIL public v1 I/O schema
# =========================
# These CSV schemas are part of the public v1 contract: downstream analysis should be able
# to rely on stable filenames and stable column sets.
def _write_csv(path: 'Path', columns: list[str], rows: list[list[object]] | None = None) -> None:
    """Write a CSV with an explicit schema."""
    from pathlib import Path as _Path
    path = _Path(path)
    with open(path, 'w') as f:
        f.write(','.join(columns) + '\n')
        if rows:
            ncol = len(columns)
            for r in rows:
                if len(r) != ncol:
                    raise ValueError(f'[CSV] column mismatch for {path.name}: expected {ncol}, got {len(r)}')
                f.write(','.join('' if v is None else str(v) for v in r) + '\n')

def _write_csv_stream(path: 'Path', columns: list[str], row_iter) -> None:
    """Write a CSV by streaming rows (memory-safe for huge outputs)."""
    from pathlib import Path as _Path
    path = _Path(path)
    ncol = len(columns)
    with open(path, 'w') as f:
        f.write(','.join(columns) + '\n')
        for r in row_iter:
            if len(r) != ncol:
                raise ValueError(f"CSV schema mismatch: expected {ncol} cols, got {len(r)}")
            f.write(','.join('' if v is None else str(v) for v in r) + '\n')


def _count_csv_data_rows(csv_path: 'Path') -> int:
    """Count data rows in a CSV (excluding header). Returns -1 on error.
    Used for cache-consistency checks without loading huge files.
    """
    from pathlib import Path as _Path
    p = _Path(csv_path)
    try:
        with open(p, 'rb') as f:
            _ = f.readline()  # header
            return sum(1 for _ in f)
    except Exception:
        return -1
_BACKBONE_ATOMNAMES = {"N", "CA", "C", "O", "OXT"}

def _atom_group(atom_name: str) -> str:
    """Coarse atom group for near interactions: backbone vs sidechain (keeps sub-residue structure)."""
    an = (atom_name or '').strip().upper()
    return 'bb' if an in _BACKBONE_ATOMNAMES else 'sc'


def _node_key_from_meta(meta: TopPairsMeta, idx: int, side: str, *, include_atomname: bool = False) -> str:
    """Create a node key for module extraction.

    Design goals:
      - Keep near sub-residue structure (e.g., backbone vs sidechain) without exploding to full atom-ids.
      - Remain memory-safe for O(10^6) features (avoid loading atom-name strings by default).

    Node keys:
      - near:  NEAR:<res>:<agroup>
      - long:  LONG:<res>:cent
    """
    k = int(meta.kind[idx])
    if k == 0:  # near
        res = _meta_res(meta, idx, side)
        ag = int(meta.agroup_i[idx]) if side == 'i' else int(meta.agroup_j[idx])
        return f"NEAR:{res}:{_agroup_label(ag)}"
    # long (residue centroid distance)
    res = int(meta.i[idx]) if side == 'i' else int(meta.j[idx])
    return f"LONG:{res}:cent"

def _canonical_edge(u: str, v: str) -> tuple[str, str]:
    return (u, v) if u <= v else (v, u)


