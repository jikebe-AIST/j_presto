    chunk_ids = list(range(len(chunk_fids)))
    total_chunks = max(1, int(len(chunk_ids)))

    def _mark_chunk_complete(chunk_id: int, *, n_features: int, tv_passed: int, auc_passed: int) -> None:
        nonlocal done_cols, done_chunks, total_tv_passed, total_auc_passed
        cid = int(chunk_id)
        if cid in completed_chunk_ids:
            return
        completed_chunk_ids.add(cid)
        done_cols += int(n_features)
        done_chunks = len(completed_chunk_ids)
        total_tv_passed += int(tv_passed)
        total_auc_passed += int(auc_passed)

    # Identify chunks that are already complete and can be reused.
    def _chunk_cache_ok(chunk_id: int, fids: np.ndarray, cpaths: dict[str, Path]) -> tuple[bool, list[FeatureStat], list[tuple[int, int, dict[str, object]]], str]:
        try:
            done_payload = _load_json(cpaths['done']) or {}
            if str(done_payload.get('run_signature_hash', '')) != str(run_sig_hash):
                return False, [], [], 'run_signature_hash mismatch'
            rows = pickle.load(open(cpaths['stage1'], 'rb'))
            out_rows = list(rows)
            if len(out_rows) != int(fids.size):
                return False, [], [], 'stage1 row count mismatch'
            try:
                row_fids = np.asarray([int(fs.fid) for fs in out_rows], dtype=np.int64)
            except Exception:
                return False, [], [], 'invalid stage1 rows'
            if row_fids.shape[0] != int(fids.size) or not np.array_equal(row_fids, np.asarray(fids, dtype=np.int64)):
                return False, [], [], 'stage1 fid range mismatch'
            rows_chunk_metrics = _load_chunk_metrics(cpaths['metrics'])
            pos_arr = np.asarray(np.load(cpaths['pos'], mmap_mode='r'), dtype=np.int64)
            scores_shape = tuple(np.load(cpaths['scores'], mmap_mode='r').shape)
            expected_rows = int(stage1_auc_idxA_use.size + stage1_auc_idxB_use.size)
            if len(scores_shape) != 2 or int(scores_shape[0]) != expected_rows:
                return False, [], [], 'scores shape mismatch'
            auc_rows = [(int(pos), int(fid), m) for (pos, fid, m) in rows_chunk_metrics if bool(m.get('passed_final', False)) and int(pos) >= 0]
            auc_rows.sort(key=lambda t: int(t[0]))
            auc_pos = np.asarray([int(pos) for pos, _fid, _m in auc_rows], dtype=np.int64)
            auc_fids = np.asarray([int(fid) for _pos, fid, _m in auc_rows], dtype=np.int64)
            if pos_arr.shape[0] != auc_pos.shape[0] or scores_shape[1] != int(pos_arr.shape[0]):
                return False, [], [], 'positions/scores column mismatch'
            if auc_pos.size and not np.array_equal(pos_arr, auc_pos):
                return False, [], [], 'downstream feature positions mismatch'
            if auc_fids.size and np.any((auc_fids < int(fids[0])) | (auc_fids > int(fids[-1]))):
                return False, [], [], 'metrics fid outside chunk'
            return True, out_rows, rows_chunk_metrics, ''
        except Exception as e:
            return False, [], [], str(e)

    pending_chunks: list[int] = []
    for chunk_id, fids in zip(chunk_ids, chunk_fids):
        cpaths = _chunk_paths(chunk_id)
        can_reuse = False
        if cpaths is not None and all(cpaths[k].exists() for k in ('metrics','pos','scores','done','stage1')):
            ok_cache, out_rows, rows_chunk_metrics, reason = _chunk_cache_ok(int(chunk_id), np.asarray(fids, dtype=np.int64), cpaths)
            if ok_cache:
                all_metric_rows.extend(rows_chunk_metrics)
                for _pos, _fid, _metrics in rows_chunk_metrics:
                    auc_metrics_by_fid[int(_fid)] = dict(_metrics)
                out.extend(out_rows)
                n_pass = sum(1 for fs in out_rows if bool(_primary_pass(fs)))
                prefilter_pos_counter += int(n_pass)
                auc_pass_count = sum(1 for _pos, _fid, metrics in rows_chunk_metrics if bool(metrics.get('passed_final', False)))
                _mark_chunk_complete(int(chunk_id), n_features=int(fids.size), tv_passed=int(n_pass), auc_passed=int(auc_pass_count))
                can_reuse = True
                if verbose:
                    log_skip(f"Stage1 chunk {int(chunk_id):05d}", f"reuse cache {_primary_count_label()}={n_pass}/{int(fids.size)} {_downstream_count_label()}={auc_pass_count}/{max(1, n_pass) if n_pass else 0} {_auc_note_label()}")
            elif verbose and reason:
                log_recalc(f"Stage1 chunk {int(chunk_id):05d}", f"cache miss ({reason})")
        if not can_reuse:
            pending_chunks.append(int(chunk_id))

    stage1a_t0 = time.perf_counter()
    if pending_chunks and verbose:
        total_blocks_A = _estimate_total_blocks(Path(ensembleA), int(natomA), sel_idx=sel_idxA, frame_stride_local=int(frame_stride))
        total_blocks_B = _estimate_total_blocks(Path(ensembleB), int(natomB), sel_idx=sel_idxB, frame_stride_local=int(frame_stride))
        log_info(
            f"[START] Stage1/scratch: build scratch from trajectory blocks pending_chunks={len(pending_chunks)}/{len(chunk_ids)} "
            f"mode=blockwise-1.5-pass-exact A_blocks={int(total_blocks_A)} B_blocks={int(total_blocks_B)}"
        )
    else:
        total_blocks_A = 0
        total_blocks_B = 0

    # PASS 1: read trajectory once and materialize per-block/per-chunk scratch for pending chunks only.
    pending_set = set(int(x) for x in pending_chunks)
    stage1a_saved = 0
    stage1a_reused = 0
    if pending_set:
        chunk_planA = {cid: _selected_feature_build_plan(pair_meta, chunk_fids[cid]) for cid in pending_set}
        chunk_planB = {cid: _remap_selected_feature_plan_atoms(chunk_planA[cid], perm_B_of_A) for cid in pending_set}
        stage1a_A_logger = _progress_logger("Stage1/scratch/A blocks", total_units=max(1, int(total_blocks_A)), min_interval_sec=float(progress_interval_sec or 300.0), active_label='processed_frames')
        blocks_done_A = 0
        frames_seen_A = 0
        write_pos_A_by_chunk = {int(cid): 0 for cid in pending_set}
        write_pos_B_by_chunk = {int(cid): 0 for cid in pending_set}

        def _prepare_chunk_memmap(cid: int, tag: str, n_rows_expected: int, n_cols_expected: int):
            data_path = _scratch_chunk_path(cid, tag)
            done_path = _scratch_chunk_done_path(cid, tag)
            if data_path is None or done_path is None:
                return None, False
            if _scratch_chunk_ok(int(cid), str(tag), int(n_rows_expected), int(n_cols_expected)):
                return np.load(data_path, mmap_mode='r+'), True
            try:
                if data_path.exists():
                    data_path.unlink()
                if done_path.exists():
                    done_path.unlink()
            except Exception:
                pass
            data_path.parent.mkdir(parents=True, exist_ok=True)
            mm = open_memmap(str(data_path), mode='w+', dtype=np.float32, shape=(int(n_rows_expected), int(n_cols_expected)))
            return mm, False

        chunk_mm_A: dict[int, object] = {}
        chunk_mm_B: dict[int, object] = {}
        chunk_reused_A: set[int] = set()
        chunk_reused_B: set[int] = set()
        for cid in pending_chunks:
            mm, reused = _prepare_chunk_memmap(int(cid), 'A', int(nA), int(chunk_fids[int(cid)].size))
            if mm is not None:
                chunk_mm_A[int(cid)] = mm
                if reused:
                    chunk_reused_A.add(int(cid)); stage1a_reused += 1
            mm, reused = _prepare_chunk_memmap(int(cid), 'B', int(nB), int(chunk_fids[int(cid)].size))
            if mm is not None:
                chunk_mm_B[int(cid)] = mm
                if reused:
                    chunk_reused_B.add(int(cid)); stage1a_reused += 1

        for block_id, frames_blk, info in _iter_blocks_with_ids(Path(ensembleA), int(natomA), sel_idx=sel_idxA, frame_stride_local=int(frame_stride)):
            nblk_raw = int(frames_blk.shape[0])
            mask = keep_maskA[frames_seen_A:frames_seen_A+nblk_raw]
            frames_seen_A += nblk_raw
            if mask.size != nblk_raw:
                raise RuntimeError(f"Stage1/scratch A keep-mask block mismatch: got={mask.size} expected={nblk_raw}")
            if bool(np.any(mask)):
                frames_use = np.asarray(frames_blk[mask], dtype=np.float32)
                nblk = int(frames_use.shape[0])
                for cid in pending_chunks:
                    cid_i = int(cid)
                    if cid_i in chunk_reused_A:
                        continue
                    arr = _materialize_frames_to_array(frames_use, plan=chunk_planA[cid_i], res_of_atom=np.asarray(res_of_atomA, dtype=np.int32), n_res_local=int(n_res))
                    w0 = int(write_pos_A_by_chunk[cid_i]); w1 = w0 + nblk
                    chunk_mm_A[cid_i][w0:w1, :] = arr
                    write_pos_A_by_chunk[cid_i] = w1
                    stage1a_saved += 1
            blocks_done_A += 1
            if verbose:
                stage1a_A_logger(blocks_done_A, active=frames_seen_A, force=False)
        if verbose:
            stage1a_A_logger(blocks_done_A, active=frames_seen_A, force=True)

        stage1a_B_logger = _progress_logger("Stage1/scratch/B blocks", total_units=max(1, int(total_blocks_B)), min_interval_sec=float(progress_interval_sec or 300.0), active_label='processed_frames')
        blocks_done_B = 0
        frames_seen_B = 0
        for block_id, frames_blk, info in _iter_blocks_with_ids(Path(ensembleB), int(natomB), sel_idx=sel_idxB, frame_stride_local=int(frame_stride)):
            nblk_raw = int(frames_blk.shape[0])
            mask = keep_maskB[frames_seen_B:frames_seen_B+nblk_raw]
            frames_seen_B += nblk_raw
            if mask.size != nblk_raw:
                raise RuntimeError(f"Stage1/scratch B keep-mask block mismatch: got={mask.size} expected={nblk_raw}")
            if bool(np.any(mask)):
                frames_use = np.asarray(frames_blk[mask], dtype=np.float32)
                nblk = int(frames_use.shape[0])
                for cid in pending_chunks:
                    cid_i = int(cid)
                    if cid_i in chunk_reused_B:
                        continue
                    arr = _materialize_frames_to_array(frames_use, plan=chunk_planB[cid_i], res_of_atom=np.asarray(res_of_atomB, dtype=np.int32), n_res_local=int(n_res))
                    w0 = int(write_pos_B_by_chunk[cid_i]); w1 = w0 + nblk
                    chunk_mm_B[cid_i][w0:w1, :] = arr
                    write_pos_B_by_chunk[cid_i] = w1
                    stage1a_saved += 1
            blocks_done_B += 1
            if verbose:
                stage1a_B_logger(blocks_done_B, active=frames_seen_B, force=False)
        if verbose:
            stage1a_B_logger(blocks_done_B, active=frames_seen_B, force=True)

        for cid in pending_chunks:
            cid_i = int(cid)
            if cid_i not in chunk_reused_A:
                if int(write_pos_A_by_chunk[cid_i]) != int(nA):
                    raise RuntimeError(f"Stage1/scratch A write count mismatch for chunk {cid_i}: wrote={write_pos_A_by_chunk[cid_i]} expected={nA}")
                mm = chunk_mm_A.get(cid_i)
                if hasattr(mm, 'flush'):
                    mm.flush()
                del mm
                _write_scratch_chunk_done(_scratch_chunk_done_path(cid_i, 'A'), _scratch_chunk_path(cid_i, 'A'), (int(nA), int(chunk_fids[cid_i].size)), 'A', cid_i)
            if cid_i not in chunk_reused_B:
                if int(write_pos_B_by_chunk[cid_i]) != int(nB):
                    raise RuntimeError(f"Stage1/scratch B write count mismatch for chunk {cid_i}: wrote={write_pos_B_by_chunk[cid_i]} expected={nB}")
                mm = chunk_mm_B.get(cid_i)
                if hasattr(mm, 'flush'):
                    mm.flush()
                del mm
                _write_scratch_chunk_done(_scratch_chunk_done_path(cid_i, 'B'), _scratch_chunk_path(cid_i, 'B'), (int(nB), int(chunk_fids[cid_i].size)), 'B', cid_i)
        chunk_mm_A.clear(); chunk_mm_B.clear()
        gc.collect()
    if pending_chunks and verbose:
        log_info(
            f"[END  ] Stage1/scratch: build scratch from trajectory blocks elapsed {time.perf_counter() - stage1a_t0:.1f}s "
            f"layout=chunk_memmap_v1 A_blocks={int(total_blocks_A)} B_blocks={int(total_blocks_B)} scratch_saved_units={int(stage1a_saved)} scratch_reused_chunks={int(stage1a_reused)} "
            f"kept_frames_A={int(nA)}/{int(nA_raw)} kept_frames_B={int(nB)}/{int(nB_raw)}"
        )


    stage1_tv_t0 = time.perf_counter()
    stage1_tv_next_t = stage1_tv_t0 + float(progress_interval_sec)

    def _emit_stage1_tv_progress(*, force: bool = False) -> None:
        nonlocal stage1_tv_next_t
        if not verbose:
            return
        now = time.perf_counter()
        if (not force) and now < stage1_tv_next_t:
            return
        done_chunk_ids_sorted = sorted(int(cid) for cid in completed_chunk_ids if 0 <= int(cid) < len(chunk_fids))
        done_chunks_i = min(len(done_chunk_ids_sorted), total_chunks)
        done_cols_i = int(sum(int(chunk_fids[cid].size) for cid in done_chunk_ids_sorted))
        done_cols_i = min(done_cols_i, int(M))
        elapsed = now - stage1_tv_t0
        done, total_norm, pct, rate, eta = _format_progress_fields(done_chunks_i, total_chunks, elapsed=elapsed)
        msg = f"[PROG ] Stage1: phase=chunks chunks={done}/{total_norm} ({pct:.1f}%) features={done_cols_i}/{int(M)}"
        msg = _append_progress_timing(msg, elapsed=elapsed, rate=rate, eta=eta, rate_suffix=' chunks/s')
        if selection_mode == 'sig':
            msg += f" passed_sig={int(total_tv_passed)} downstream={int(total_auc_passed)}"
        elif selection_mode == 'ced':
            msg += f" preFDR_ced={int(total_tv_passed)} preFDR_downstream={int(total_auc_passed)} final_pending_qnull=yes"
        else:
            msg += f" passed_TV={int(total_tv_passed)} passed_AUC={int(total_auc_passed)}"
        print(_apply_log_prefix(msg), file=sys.stderr, flush=True)
        stage1_tv_next_t = now + float(progress_interval_sec)

    if verbose and done_chunks > 0:
        _emit_stage1_tv_progress(force=False)

    stage12_next_t = time.perf_counter() + float(progress_interval_sec)
    stage12_phase_t0 = time.perf_counter()
    stage12_last_phase = None

    def _emit_stage12_progress(phase: str, *, chunk_id: int | None = None, current_features_done: int = 0, current_features_total: int = 0, auc_done: int = 0, auc_total: int = 0, force: bool = False) -> None:
        nonlocal stage12_next_t, stage12_phase_t0, stage12_last_phase
        if not verbose:
            return
        now = time.perf_counter()
        phase_s = str(phase)
        if stage12_last_phase != phase_s:
            stage12_last_phase = phase_s
            stage12_phase_t0 = now
        if (not force) and now < stage12_next_t:
            return
        stage_elapsed = now - stage1_tv_t0
        phase_elapsed = max(1e-12, now - stage12_phase_t0)
        msg = f"[PROG ] Stage1: phase={phase_s}"
        if chunk_id is not None:
            msg += f" chunk={int(chunk_id)+1}/{int(total_chunks)}"
        if phase_s == 'write_scores' and auc_total > 0:
            done, total_norm, pct, rate, eta = _format_progress_fields(auc_done, auc_total, elapsed=phase_elapsed)
            msg += f" score_rows={done}/{total_norm} ({pct:.1f}%)"
            msg = _append_progress_timing(msg, elapsed=phase_elapsed, rate=rate, eta=eta, rate_suffix=' rows/s')
        elif phase_s == 'AUC' and auc_total > 0:
            done, total_norm, pct, rate, eta = _format_progress_fields(auc_done, auc_total, elapsed=phase_elapsed)
            if selection_mode in ('sig', 'ced'):
                msg += f" auc={done}/{total_norm} ({pct:.1f}%) downstream={int(total_auc_passed)}"
            else:
                msg += f" auc={done}/{total_norm} ({pct:.1f}%) passed_AUC={int(total_auc_passed)}"
            msg = _append_progress_timing(msg, elapsed=phase_elapsed, rate=rate, eta=eta, rate_suffix=' auc/s')
        elif current_features_total > 0:
            done, total_norm, pct, rate, eta = _format_progress_fields(current_features_done, current_features_total, elapsed=phase_elapsed)
            msg += f" features={done}/{total_norm} ({pct:.1f}%)"
            if phase_s == 'TV':
                if selection_mode == 'sig':
                    msg += f" passed_sig={int(total_tv_passed)}"
                elif selection_mode == 'ced':
                    msg += f" preFDR_ced={int(total_tv_passed)} final_pending_qnull=yes"
                else:
                    msg += f" passed_TV={int(total_tv_passed)}"
            msg = _append_progress_timing(msg, elapsed=phase_elapsed, rate=rate, eta=eta, rate_suffix=' features/s')
        else:
            done, total_norm, pct, rate, eta = _format_progress_fields(done_chunks, total_chunks, elapsed=phase_elapsed)
            msg += f" chunks={done}/{total_norm} ({pct:.1f}%)"
            msg = _append_progress_timing(msg, elapsed=phase_elapsed, rate=rate, eta=eta, rate_suffix=' chunks/s')
        msg += f" stage_elapsed={stage_elapsed:.1f}s"
        print(_apply_log_prefix(msg), file=sys.stderr, flush=True)
        stage12_next_t = now + float(progress_interval_sec)

    def _compute_local_rows(XA_chunk, XB_chunk, fids: np.ndarray, s: int, e: int) -> list[FeatureStat]:
        rows: list[FeatureStat] = []
        _local_equiv_members = _equiv_group_member_local_indices(fids, pair_meta)
        _fids_arr = np.asarray(fids, dtype=np.int64)
        for local in range(int(s), int(e)):
            fid = int(fids[local])
            xA_local = np.asarray(XA_chunk[:, local], dtype=np.float64)
            xB_local = np.asarray(XB_chunk[:, local], dtype=np.float64)
            _egid = int(pair_meta.equiv_group_id[fid]) if hasattr(pair_meta, 'equiv_group_id') and 0 <= fid < len(pair_meta) else -1
            _member_locals = _local_equiv_members.get(_egid, [int(local)]) if _egid >= 0 else [int(local)]
            _has_equiv_mix = bool(_egid >= 0 and len(_member_locals) >= 2)
            if _has_equiv_mix:
                _m = int(len(_member_locals))
                _xA_mix = np.asarray(XA_chunk[:, _member_locals], dtype=np.float64).reshape(-1)
                _xB_mix = np.asarray(XB_chunk[:, _member_locals], dtype=np.float64).reshape(-1)
                _wA_mix = np.repeat(np.asarray(wA, dtype=np.float64) / float(_m), _m)
                _wB_mix = np.repeat(np.asarray(wB, dtype=np.float64) / float(_m), _m)
                _run_idsA_mix = np.repeat(np.asarray(run_idsA, dtype=np.int32), _m)
                _run_idsB_mix = np.repeat(np.asarray(run_idsB, dtype=np.int32), _m)
            else:
                _xA_mix, _xB_mix = xA_local, xB_local
                _wA_mix, _wB_mix = np.asarray(wA, dtype=np.float64), np.asarray(wB, dtype=np.float64)
                _run_idsA_mix, _run_idsB_mix = run_idsA, run_idsB
            if selection_mode == 'ced':
                fs = _compute_feature_stat_ced_from_values(
                    fid=fid,
                    kind=int(pair_meta.kind[fid]),
                    id_str=str(_meta_idstr(pair_meta, fid)),
                    xA=_xA_mix,
                    xB=_xB_mix,
                    wA=_wA_mix,
                    wB=_wB_mix,
                    run_idsA=_run_idsA_mix,
                    run_idsB=_run_idsB_mix,
                    n_runs_A=int(n_runs_A),
                    n_runs_B=int(n_runs_B),
                    bins_max=int(bins_max),
                    bins_min_neff_per_bin=float(bins_min_neff_per_bin),
                    tv_threshold=float(tv_threshold),
                    within_splits=int(ced_within_splits),
                    null_splits=int(ced_null_splits),
                    r_threshold=float(ced_r_threshold),
                    z_threshold=float(ced_z_threshold),
                    null_r_threshold=float(ced_null_r_threshold),
                    null_z_threshold=float(ced_null_z_threshold),
                    null_p_threshold=float(ced_null_p_threshold),
                    min_tv=float(ced_min_tv),
                    eps=float(ced_eps),
                    patterns_A=ced_split_patterns_A,
                    patterns_B=ced_split_patterns_B,
                    patterns_null=ced_null_patterns,
                    pattern_batch_size=int(ced_pattern_batch_size),
                    use_full_range=True,
                )
            else:
                if _egid >= 0 and len(_member_locals) >= 2:
                    fs = _compute_feature_stat_equiv_mixture_from_values(
                        fid=fid,
                        kind=int(pair_meta.kind[fid]),
                        id_str=str(_meta_idstr(pair_meta, fid)),
                        local_idx=int(local),
                        XA=XA_chunk,
                        XB=XB_chunk,
                        member_locals=_member_locals,
                        wA=np.asarray(wA, dtype=np.float64),
                        wB=np.asarray(wB, dtype=np.float64),
                        bins_max=int(bins_max),
                        bins_min_neff_per_bin=float(bins_min_neff_per_bin),
                        tv_threshold=float(tv_threshold),
                        use_full_range=True,
                    )
                else:
                    fs = _compute_feature_stat_strict_from_values(
                        fid=fid,
                        kind=int(pair_meta.kind[fid]),
                        id_str=str(_meta_idstr(pair_meta, fid)),
                        xA=xA_local,
                        xB=xB_local,
                        wA=np.asarray(wA, dtype=np.float64),
                        wB=np.asarray(wB, dtype=np.float64),
                        bins_max=int(bins_max),
                        bins_min_neff_per_bin=float(bins_min_neff_per_bin),
                        tv_threshold=float(tv_threshold),
                        use_full_range=True,
                    )
            if selection_mode == 'sig':
                sig = _compute_run_bin_significance_from_values(
                    _xA_mix, _xB_mix, _wA_mix, _wB_mix,
                    _run_idsA_mix, _run_idsB_mix, n_runs_A=int(n_runs_A), n_runs_B=int(n_runs_B),
                    bins=int(fs.bins), x_min=float(fs.minv), x_max=float(fs.maxv),
                    peak_frac=float(sig_bin_peak_frac), min_count=int(sig_bin_min_count),
                    alpha=float(sig_alpha), fdr=bool(sig_fdr), sig_area_threshold=float(sig_area_threshold),
                )
                fs.passed_sig = bool(sig.get('passed', False))
                fs.n_important_bins = int(sig.get('n_important_bins', 0))
                fs.n_sig_bins = int(sig.get('n_sig_bins', 0))
                fs.min_p_bin = float(sig.get('min_p_bin', float('nan')))
                fs.min_q_bin = float(sig.get('min_q_bin', float('nan')))
                fs.sig_area = float(sig.get('sig_area', 0.0))
                fs.sig_logpmax = float(sig.get('sig_logpmax', 0.0))
                fs.sig_strength = float(sig.get('sig_strength', 0.0))
                if run_hist_dir is not None and fs.passed_sig:
                    np.savez_compressed(Path(run_hist_dir) / f'fid_{int(fid):08d}_runbins.npz',
                        meanA=np.asarray(sig.get('meanA'), dtype=np.float64), meanB=np.asarray(sig.get('meanB'), dtype=np.float64),
                        seA=np.asarray(sig.get('seA'), dtype=np.float64), seB=np.asarray(sig.get('seB'), dtype=np.float64),
                        important=np.asarray(sig.get('important'), dtype=bool), sig=np.asarray(sig.get('sig'), dtype=bool),
                        pvals=np.asarray(sig.get('pvals'), dtype=np.float64), qvals=np.asarray(sig.get('qvals'), dtype=np.float64),
                        sig_logp=np.asarray(sig.get('sig_logp'), dtype=np.float64),
                        sig_area=np.asarray([float(sig.get('sig_area', 0.0))], dtype=np.float64),
                        sig_logpmax=np.asarray([float(sig.get('sig_logpmax', 0.0))], dtype=np.float64),
                        sig_strength=np.asarray([float(sig.get('sig_strength', 0.0))], dtype=np.float64),
                        run_weight_A=np.asarray(sig.get('run_weight_A'), dtype=np.float64),
                        run_weight_B=np.asarray(sig.get('run_weight_B'), dtype=np.float64),
                        n_active_runs_A=np.asarray([int(sig.get('n_active_runs_A', 0))], dtype=np.int64),
                        n_active_runs_B=np.asarray([int(sig.get('n_active_runs_B', 0))], dtype=np.int64),
                        run_se_weighting=np.asarray(['distrib_swei']))
            rows.append(fs)
        return rows

    def _auc_one(local_idx: int, fs: FeatureStat, prefilter_pos: int, XA_chunk, XB_chunk, sub_fids_current: np.ndarray | None = None) -> tuple[int, int, dict[str, object], np.ndarray | None]:
        xA = np.asarray(XA_chunk[:, local_idx] if stage1_auc_idxA_use.shape[0] == XA_chunk.shape[0] else XA_chunk[stage1_auc_idxA_use, local_idx], dtype=np.float64)
        xB = np.asarray(XB_chunk[:, local_idx] if stage1_auc_idxB_use.shape[0] == XB_chunk.shape[0] else XB_chunk[stage1_auc_idxB_use, local_idx], dtype=np.float64)
        _sub_fids_for_auc = np.asarray(sub_fids_current if sub_fids_current is not None else np.zeros((0,), dtype=np.int64), dtype=np.int64)
        _egid_auc = int(pair_meta.equiv_group_id[int(fs.fid)]) if hasattr(pair_meta, 'equiv_group_id') and 0 <= int(fs.fid) < len(pair_meta) else -1
        _member_locals_auc = []
        if _egid_auc >= 0 and _sub_fids_for_auc.size == XA_chunk.shape[1]:
            _member_locals_auc = [int(i) for i, _fid in enumerate(_sub_fids_for_auc.tolist()) if 0 <= int(_fid) < len(pair_meta) and int(pair_meta.equiv_group_id[int(_fid)]) == _egid_auc]
        x_min = float(fs.minv); x_max = float(fs.maxv)
        if (not np.isfinite(x_min)) or (not np.isfinite(x_max)) or x_max <= x_min:
            xs = np.concatenate([xA, xB])
            x_min, x_max = _winsor_limits_from_sample(xs, q=_TV_WINSOR_Q)
            if x_max <= x_min:
                x_max = x_min + 1e-6
        bins = max(2, int(fs.bins))
        if _egid_auc >= 0 and len(_member_locals_auc) >= 2:
            XA_group_full = XA_chunk[:, _member_locals_auc]
            XB_group_full = XB_chunk[:, _member_locals_auc]
            XA_group = XA_group_full if stage1_auc_idxA_use.shape[0] == XA_chunk.shape[0] else XA_group_full[stage1_auc_idxA_use, :]
            XB_group = XB_group_full if stage1_auc_idxB_use.shape[0] == XB_chunk.shape[0] else XB_group_full[stage1_auc_idxB_use, :]
            res = _compute_single_feature_auc_and_scores_equiv_distribution(
                xA, xB, XA_group, XB_group, stage1_auc_wA, stage1_auc_wB,
                bins=bins, x_min=x_min, x_max=x_max,
                eps=float(auc_eps), cv_folds=int(auc_cv_folds),
                random_state=int(auc_random_state) + (int(prefilter_pos) if int(prefilter_pos) >= 0 else (1_000_003 + int(fs.fid))),
                progress_label=None, progress_interval_sec=progress_interval_sec,
            )
        else:
            res = _compute_single_feature_auc_and_scores(
                xA, xB, stage1_auc_wA, stage1_auc_wB,
                bins=bins, x_min=x_min, x_max=x_max,
                eps=float(auc_eps), cv_folds=int(auc_cv_folds),
                random_state=int(auc_random_state) + (int(prefilter_pos) if int(prefilter_pos) >= 0 else (1_000_003 + int(fs.fid))),
                progress_label=None, progress_interval_sec=progress_interval_sec,
            )
        auc_single = float(res.get('auc', float('nan')))
        passed_auc = bool(np.isfinite(auc_single) and auc_single >= float(auc_threshold))
        if selection_mode == 'sig':
            passed_final = bool(getattr(fs, 'passed_sig', False))
        elif selection_mode == 'ced':
            passed_final = bool(getattr(fs, 'passed_ced', False))
        else:
            passed_final = bool(passed_auc and fs.passed_tv)
        metrics = {
            'auc_single': auc_single,
            'passed_auc': bool(passed_auc),
            'passed_final': bool(passed_final),
            'passed_tv': bool(fs.passed_tv),
            'auc_scope': str(auc_scope),
            'n_samples_A': int(stage1_auc_idxA_use.size),
            'n_samples_B': int(stage1_auc_idxB_use.size),
            'score_mean_A': float(res.get('score_mean_A', float('nan'))),
            'score_mean_B': float(res.get('score_mean_B', float('nan'))),
            'neff_A': float(res.get('neff_A', float('nan'))),
            'neff_B': float(res.get('neff_B', float('nan'))),
            'pair_type': 'near' if int(fs.kind) == 0 else 'long',
        }
        scores = np.asarray(res.get('scores', np.zeros((stage1_auc_idxA_use.size + stage1_auc_idxB_use.size,), dtype=np.float64)), dtype=np.float32) if passed_final else None
        return int(prefilter_pos), int(fs.fid), metrics, scores

    def _stage3_direct_save_part(chunk_id: int, col0: int, XA_chunk: np.ndarray, XB_chunk: np.ndarray, sub_fids: np.ndarray, keep_local: list[int]) -> None:
        nonlocal stage3_direct_part_counter, stage3_direct_saved_features
        if stage3_direct_parts_dir is None or not keep_local:
            return
        keep = np.asarray(keep_local, dtype=np.int64)
        fids_keep = np.asarray(sub_fids[keep], dtype=np.int64)
        if stage1_auc_idxA_use.shape[0] == XA_chunk.shape[0]:
            A_keep = np.asarray(XA_chunk[:, keep].T, dtype=np.float32, order='C')
        else:
            A_keep = np.asarray(XA_chunk[np.asarray(stage1_auc_idxA_use, dtype=np.int64), :][:, keep].T, dtype=np.float32, order='C')
        if stage1_auc_idxB_use.shape[0] == XB_chunk.shape[0]:
            B_keep = np.asarray(XB_chunk[:, keep].T, dtype=np.float32, order='C')
        else:
            B_keep = np.asarray(XB_chunk[np.asarray(stage1_auc_idxB_use, dtype=np.int64), :][:, keep].T, dtype=np.float32, order='C')
        part_id = int(stage3_direct_part_counter)
        stage3_direct_part_counter += 1
        prefix = stage3_direct_parts_dir / f'part_{part_id:06d}_chunk_{int(chunk_id):05d}_col_{int(col0):06d}'
        _save_npy_atomic(prefix.with_name(prefix.name + '_fids.npy'), fids_keep)
        _save_npy_atomic(prefix.with_name(prefix.name + '_A.npy'), A_keep)
        _save_npy_atomic(prefix.with_name(prefix.name + '_B.npy'), B_keep)
        stage3_direct_saved_features += int(fids_keep.size)
        if verbose:
            _emit_stage12_progress('stage3_direct_store', chunk_id=int(chunk_id), current_features_done=int(stage3_direct_saved_features), current_features_total=max(1, int(len(pair_meta))))

    # PASS 1.5: process scratch chunk-by-chunk.
    # Score each scratch chunk in smaller column batches.  A whole 2048-feature
    # scratch chunk can exceed a 64-GiB cgroup for T4L-scale inputs, because it
    # requires concatenating A/B arrays over millions of frames.  The scratch
    # chunk layout is kept unchanged so existing scratch artifacts remain usable.
    bytes_per_feature_all_frames = max(1, int(nA + nB)) * np.dtype(np.float32).itemsize
    mem_budget_bytes = int(max(128.0, float(memory_budget_mib or 512.0)) * 1024.0 * 1024.0)
    score_cols_per_batch = max(1, int(mem_budget_bytes // max(1, bytes_per_feature_all_frames * 3)))
    score_cols_per_batch = max(1, min(score_cols_per_batch, io_feat_chunk))
    if verbose and score_cols_per_batch < io_feat_chunk:
        est_full_gib = (float(bytes_per_feature_all_frames) * float(io_feat_chunk) * 2.0) / (1024.0 ** 3)
        est_batch_gib = (float(bytes_per_feature_all_frames) * float(score_cols_per_batch) * 2.0) / (1024.0 ** 3)
        log_info(
            f"Stage1 scoring memory guard: scratch_chunk_features={int(io_feat_chunk)} "
            f"score_batch_features={int(score_cols_per_batch)} "
            f"estimated_full_concat≈{est_full_gib:.1f}GiB estimated_batch≈{est_batch_gib:.1f}GiB "
            f"budget={float(memory_budget_mib or 512.0):.1f}MiB"
        )

    for chunk_id in pending_chunks:
        fids = chunk_fids[chunk_id]
        chunk_label = f"stage1_chunk_{int(fids[0]):06d}_{int(fids[-1]):06d}"
        cpaths = _chunk_paths(chunk_id)
        assert cpaths is not None
        if verbose:
            log_info(f"[START] Stage1 scoring chunk {chunk_label}: features={int(fids.size)} mode=SCRATCH")

        ap_chunk = _scratch_chunk_path(int(chunk_id), 'A')
        bp_chunk = _scratch_chunk_path(int(chunk_id), 'B')
        scratch_layout_used = 'chunk_memmap_v1'
        xa_blocks = None
        xb_blocks = None
        if ap_chunk is not None and bp_chunk is not None and _scratch_chunk_ok(int(chunk_id), 'A', int(nA), int(fids.size)) and _scratch_chunk_ok(int(chunk_id), 'B', int(nB), int(fids.size)):
            XA_scratch = np.load(ap_chunk, mmap_mode='r')
            XB_scratch = np.load(bp_chunk, mmap_mode='r')
        else:
            scratch_layout_used = 'block_fallback'
            if verbose:
                log_warn(f"Stage1 scoring chunk {chunk_label}: using block scratch fallback; performance may be slower.")
            xa_blocks = []
            xb_blocks = []
            block_id = 0
            while True:
                ap = _scratch_paths(chunk_id, block_id, 'A')
                bp = _scratch_paths(chunk_id, block_id, 'B')
                if ap is not None and ap.exists():
                    xa_blocks.append(np.load(ap, mmap_mode='r'))
                if bp is not None and bp.exists():
                    xb_blocks.append(np.load(bp, mmap_mode='r'))
                if (ap is None or not ap.exists()) and (bp is None or not bp.exists()):
                    break
                block_id += 1
                _emit_stage12_progress('load_scratch', chunk_id=int(chunk_id), current_features_done=0, current_features_total=int(fids.size))
            _emit_stage12_progress('load_scratch', chunk_id=int(chunk_id), current_features_done=0, current_features_total=int(fids.size), force=False)
            XA_scratch = None
            XB_scratch = None

        rows: list[FeatureStat] = []
        rows_chunk_metrics: list[tuple[int, int, dict[str, object]]] = []
        passed_score_entries: list[tuple[int, Path]] = []
        auc_pass_count = 0
        score_tmp_dir = Path(stage1_ckpt_dir) / 'tmp_score_vectors' / f'chunk_{int(chunk_id):05d}' if stage1_ckpt_dir is not None else None
        if score_tmp_dir is not None:
            if score_tmp_dir.exists():
                shutil.rmtree(score_tmp_dir, ignore_errors=True)
            score_tmp_dir.mkdir(parents=True, exist_ok=True)

        try:
            _score_ranges = _local_ranges_group_safe(int(fids.size), int(score_cols_per_batch), fids, _stage1_equiv_group_ids)
            for col0, col1 in _score_ranges:
                sub_fids = np.asarray(fids[int(col0):int(col1)], dtype=np.int64)
                if verbose and int(fids.size) > int(score_cols_per_batch):
                    log_info(
                        f"[START] Stage1 scoring subchunk {chunk_label}: "
                        f"cols={int(col0)}:{int(col1)}/{int(fids.size)} features={int(sub_fids.size)} phase=load+metrics"
                    )
                t_load0 = time.perf_counter()
                if scratch_layout_used == 'chunk_memmap_v1':
                    XA_chunk = np.asarray(XA_scratch[:, col0:col1], dtype=np.float32)
                    XB_chunk = np.asarray(XB_scratch[:, col0:col1], dtype=np.float32)
                else:
                    XA_chunk = np.concatenate([np.asarray(x[:, col0:col1], dtype=np.float32) for x in xa_blocks], axis=0) if xa_blocks else np.zeros((0, int(sub_fids.size)), dtype=np.float32)
                    XB_chunk = np.concatenate([np.asarray(x[:, col0:col1], dtype=np.float32) for x in xb_blocks], axis=0) if xb_blocks else np.zeros((0, int(sub_fids.size)), dtype=np.float32)
                if verbose and (time.perf_counter() - t_load0) > 1.0:
                    log_info(f"Stage1 scoring subchunk {chunk_label}: load_or_map_scratch elapsed={time.perf_counter()-t_load0:.2f}s layout={scratch_layout_used} cols={int(col0)}:{int(col1)}")

                n_parts = min(max(1, workers), max(1, int(sub_fids.size)))
                base = int(math.ceil(int(sub_fids.size) / float(n_parts)))
                local_ranges = _local_ranges_group_safe(int(sub_fids.size), base, sub_fids, _stage1_equiv_group_ids)
                sub_rows: list[FeatureStat] = []
                if workers > 1 and len(local_ranges) > 1:
                    with ThreadPoolExecutor(max_workers=min(workers, len(local_ranges))) as ex:
                        futs = [ex.submit(_compute_local_rows, XA_chunk, XB_chunk, sub_fids, s, e) for s, e in local_ranges]
                        for fut in futs:
                            sub_rows.extend(fut.result())
                else:
                    for s, e in local_ranges:
                        sub_rows.extend(_compute_local_rows(XA_chunk, XB_chunk, sub_fids, s, e))
                sub_rows.sort(key=lambda fs: int(fs.fid))

                auc_candidates: list[tuple[int, FeatureStat, int]] = []
                n_pass = 0
                for local_idx, fs in enumerate(sub_rows):
                    primary = bool(_primary_pass(fs))
                    if primary:
                        n_pass += 1
                    if auc_scope == 'all' or primary:
                        if primary:
                            pref_pos = int(prefilter_pos_counter)
                            prefilter_pos_counter += 1
                        else:
                            pref_pos = -1 - int(fs.fid)
                        auc_candidates.append((local_idx, fs, pref_pos))

                if auc_candidates:
                    if verbose:
                        log_info(
                            f"[INFO ] Stage1 scoring subchunk {chunk_label}: "
                            f"cols={int(col0)}:{int(col1)}/{int(fids.size)} auc_diagnostic_candidates={len(auc_candidates)} "
                            f"auc_scope_diagnostic={auc_scope} auc_backend={'thread' if workers > 1 else 'sequential'}"
                        )
                    auc_rows: list[tuple[int, int, dict[str, object], np.ndarray | None]] = []
                    auc_done_local = 0
                    if workers > 1 and len(auc_candidates) > 1:
                        with ThreadPoolExecutor(max_workers=min(workers, len(auc_candidates))) as ex:
                            futs = [ex.submit(_auc_one, local_idx, fs, pref_pos, XA_chunk, XB_chunk, sub_fids) for local_idx, fs, pref_pos in auc_candidates]
                            for fut in as_completed(futs):
                                auc_rows.append(fut.result())
                                auc_done_local += 1
                                _emit_stage12_progress('AUC', chunk_id=int(chunk_id), current_features_done=int(col1), current_features_total=int(fids.size), auc_done=int(auc_done_local), auc_total=int(len(auc_candidates)))
                    else:
                        for local_idx, fs, pref_pos in auc_candidates:
                            auc_rows.append(_auc_one(local_idx, fs, pref_pos, XA_chunk, XB_chunk, sub_fids))
                            auc_done_local += 1
                            _emit_stage12_progress('AUC', chunk_id=int(chunk_id), current_features_done=int(col1), current_features_total=int(fids.size), auc_done=int(auc_done_local), auc_total=int(len(auc_candidates)))
                    auc_rows.sort(key=lambda t: int(t[0]))
                    _stage3_keep_local: list[int] = []
                    _stage3_local_by_fid = {int(fid): int(i) for i, fid in enumerate(np.asarray(sub_fids, dtype=np.int64).tolist())}
                    for pref_pos, fid, metrics, scores in auc_rows:
                        if bool(metrics.get('passed_final', False)) and int(fid) in _stage3_local_by_fid:
                            _stage3_keep_local.append(int(_stage3_local_by_fid[int(fid)]))
                        rows_chunk_metrics.append((int(pref_pos), int(fid), metrics))
                        all_metric_rows.append((int(pref_pos), int(fid), metrics))
                        auc_metrics_by_fid[int(fid)] = dict(metrics)
                        if bool(metrics.get('passed_final', False)) and int(pref_pos) >= 0:
                            auc_pass_count += 1
                            if scores is not None:
                                if score_tmp_dir is None:
                                    raise RuntimeError('internal error: score_tmp_dir is unavailable for Stage1 score vector staging')
                                tmp_score = score_tmp_dir / f'pos_{int(pref_pos):010d}_fid_{int(fid):010d}.npy'
                                _save_npy_atomic(tmp_score, np.asarray(scores, dtype=np.float32))
                                passed_score_entries.append((int(pref_pos), tmp_score))
                    if _stage3_keep_local:
                        _stage3_direct_save_part(int(chunk_id), int(col0), XA_chunk, XB_chunk, sub_fids, _stage3_keep_local)
                rows.extend(sub_rows)
                del XA_chunk, XB_chunk
                gc.collect()

            rows.sort(key=lambda fs: int(fs.fid))
            passed_score_entries.sort(key=lambda x: int(x[0]))
            passed_pos_arr = np.asarray([int(pos) for pos, _path in passed_score_entries], dtype=np.int64)
            if passed_score_entries:
                n_score_rows = int(stage1_auc_idxA_use.size + stage1_auc_idxB_use.size)
                score_vectors = [np.load(path, mmap_mode='r') for _pos, path in passed_score_entries]
                def _score_write_progress(done_rows: int, total_rows: int, _chunk_id=int(chunk_id), _fids_size=int(fids.size)):
                    _emit_stage12_progress('write_scores', chunk_id=int(_chunk_id), current_features_done=int(_fids_size), current_features_total=int(_fids_size), auc_done=int(done_rows), auc_total=int(total_rows))
                _write_score_vectors_rowwise(
                    cpaths['scores'],
                    score_vectors,
                    n_rows=n_score_rows,
                    progress_cb=_score_write_progress,
                    memory_budget_mib=max(128.0, float(memory_budget_mib) * 0.50),
                )
                del score_vectors
            else:
                _save_npy_atomic(cpaths['scores'], np.zeros((int(stage1_auc_idxA_use.size + stage1_auc_idxB_use.size), 0), dtype=np.float32))
            _save_npy_atomic(cpaths['pos'], passed_pos_arr)

            def _write_chunk_metrics(_f, _rows=rows_chunk_metrics):
                wcsv = csv.writer(_f)
                wcsv.writerow(['pos','fid','pair_type','auc_single','passed_auc','passed_final','n_samples_A','n_samples_B','score_mean_A','score_mean_B','neff_A','neff_B'])
                for pos, fid, metrics in _rows:
                    wcsv.writerow([pos, fid, metrics.get('pair_type',''), metrics.get('auc_single', float('nan')), int(bool(metrics.get('passed_auc', False))), int(bool(metrics.get('passed_final', False))), metrics.get('n_samples_A', stage1_auc_idxA_use.size), metrics.get('n_samples_B', stage1_auc_idxB_use.size), metrics.get('score_mean_A', float('nan')), metrics.get('score_mean_B', float('nan')), metrics.get('neff_A', float('nan')), metrics.get('neff_B', float('nan'))])
            _write_csv_atomic(cpaths['metrics'], _write_chunk_metrics)
            _write_pickle_atomic(cpaths['stage1'], rows)
            _write_json_atomic(cpaths['done'], {
                'chunk_label': chunk_label,
                'n_positions': int(sum(1 for fs in rows if bool(_primary_pass(fs)))),
                'n_passed': int(sum(1 for _pos, _fid, m in rows_chunk_metrics if bool(m.get('passed_final', False)))),
                'auc_backend': 'thread' if workers > 1 else 'sequential',
                'score_batch_features': int(score_cols_per_batch),
                'run_signature_hash': run_sig_hash,
            })
            out.extend(rows)
            if verbose:
                n_pass = sum(1 for fs in rows if bool(_primary_pass(fs)))
                _mark_chunk_complete(int(chunk_id), n_features=int(fids.size), tv_passed=int(n_pass), auc_passed=int(auc_pass_count))
                _emit_stage1_tv_progress(force=False)
                if str(selection_mode).lower() == 'sig':
                    log_info(f"[END  ] Stage1 chunk {chunk_label}: features={int(fids.size)} primary_pass_sig={n_pass}/{int(fids.size)} downstream={auc_pass_count}/{max(1, n_pass) if n_pass else 0} auc_scope_diagnostic={auc_scope}")
                elif str(selection_mode).lower() == 'ced':
                    log_info(f"[END  ] Stage1 chunk {chunk_label}: features={int(fids.size)} preFDR_ced={n_pass}/{int(fids.size)} preFDR_downstream={auc_pass_count}/{max(1, n_pass) if n_pass else 0} final_pending_qnull=yes auc_scope_diagnostic={auc_scope}")
                else:
                    log_info(f"[END  ] Stage1 chunk {chunk_label}: features={int(fids.size)} primary_pass_{_primary_pass_label()}={n_pass}/{int(fids.size)} downstream={auc_pass_count}/{max(1, n_pass) if n_pass else 0} auc_scope={auc_scope} {_auc_note_label()}")
        finally:
            if score_tmp_dir is not None and score_tmp_dir.exists():
                shutil.rmtree(score_tmp_dir, ignore_errors=True)
        # scratch is retained until PASS-artifact assembly finishes.
        try:
            del xa_blocks, xb_blocks, XA_scratch, XB_scratch
        except Exception:
            pass
        gc.collect()

    if verbose:
        _emit_stage1_tv_progress(force=True)

    out.sort(key=lambda fs: int(fs.fid))
    if selection_mode == 'ced' and out:
        ced_p_all = np.asarray([float(getattr(fs, 'ced_p_effect', 1.0)) for fs in out], dtype=np.float64)
        ced_null_p_all = np.asarray([float(getattr(fs, 'ced_p_null', 1.0)) for fs in out], dtype=np.float64)
        ced_q_all = _bh_fdr(ced_p_all)
        ced_null_q_all = _bh_fdr(ced_null_p_all)
        qthr = float(ced_q_threshold)
        null_qthr = float(ced_null_q_threshold)
        _ced_preFDR_count = int(sum(1 for fs in out if bool(getattr(fs, 'passed_ced', False))))
        for fs, qv, qn in zip(out, ced_q_all, ced_null_q_all):
            fs.ced_q_effect = float(qv) if np.isfinite(qv) else 1.0
            fs.ced_q_null = float(qn) if np.isfinite(qn) else 1.0
            fs.passed_ced = bool(
                bool(getattr(fs, 'passed_ced', False))
                and float(getattr(fs, 'ced_q_effect', 1.0)) <= qthr
