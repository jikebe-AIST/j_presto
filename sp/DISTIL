def _community_detect_auto(G, seed: int = 0, method: str = "auto") -> tuple[list[list[int]], dict[str, object]]:
    """Detect communities and report the backend that actually produced them."""
    requested = str(method or "auto").lower()
    nodes = list(G.nodes())
    info: dict[str, object] = {
        'community_method_requested': requested,
        'community_method_effective': '',
        'community_backend_versions': _community_backend_versions(),
        'community_fallbacks': [],
    }
    if not nodes:
        info['community_method_effective'] = 'empty_graph'
        return [], info
    if G.number_of_edges() == 0:
        info['community_method_effective'] = 'singleton_no_edges'
        return [[n] for n in nodes], info

    fallbacks: list[str] = info['community_fallbacks']  # type: ignore[assignment]
    if requested in ("auto", "leiden"):
        try:
            import igraph as ig
            import leidenalg as la

            node_list = list(G.nodes())
            node_to_idx = {n: i for i, n in enumerate(node_list)}
            edges = []
            weights = []
            for u, v, data in G.edges(data=True):
                edges.append((node_to_idx[u], node_to_idx[v]))
                weights.append(float((data or {}).get("weight", 1.0)))

            gg = ig.Graph(n=len(node_list), edges=edges, directed=False)
            part = la.find_partition(
                gg,
                la.ModularityVertexPartition,
                weights=weights,
                seed=int(seed),
            )
            info['community_method_effective'] = 'leiden'
            return [[node_list[int(i)] for i in comm] for comm in part], info
        except Exception as exc:
            fallbacks.append(f"leiden_failed:{type(exc).__name__}:{exc}")

    try:
        import networkx as nx
        if requested in ("auto", "leiden", "louvain") and hasattr(nx.community, "louvain_communities"):
            comms = nx.community.louvain_communities(G, seed=int(seed), weight="weight")
            info['community_method_effective'] = 'louvain'
            return [list(c) for c in comms], info
        comms = nx.community.greedy_modularity_communities(G, weight="weight")
        info['community_method_effective'] = 'greedy_modularity'
        return [list(c) for c in comms], info
    except Exception as exc:
        fallbacks.append(f"networkx_failed:{type(exc).__name__}:{exc}")
        info['community_method_effective'] = 'singleton_fallback'
        return [[n] for n in nodes], info

def _read_pair_ranking(path: Path) -> list[tuple[int, float]]:
    rows: list[tuple[int, float, float]] = []
    with open(path, "r", encoding="utf-8") as f:
        for row in csv.DictReader(f):
            fid_raw = row.get("fid", row.get("pair_id", row.get("argmax_pair_id", "-1")))
            try:
                fid = int(str(fid_raw).strip() or -1)
            except Exception:
                continue

            score = None
            for key in ("rank_score", "contribution_score", "contribution_multi", "cross_contribution_sum", "max_stage5_weight_cross", "cross_stage5_weight_sum", "score", "cut_weight", "auc_single", "tv"):
                if key in row:
                    try:
                        score = float(row.get(key, "nan") or "nan")
                        break
                    except Exception:
                        score = None
            if score is None or not np.isfinite(float(score)):
                score = float("-inf")

            try:
                rank = float(row.get("rank", "nan") or "nan")
            except Exception:
                rank = float("nan")

            rows.append((int(fid), float(score), float(rank)))

    if any(np.isfinite(r) for *_s, r in rows):
        rows.sort(key=lambda t: ((t[2] if np.isfinite(t[2]) else float("inf")), -abs(t[1]), -t[1], t[0]))
    else:
        rows.sort(key=lambda t: (-abs(t[1]), -t[1], t[0]))

    return [(int(fid), float(score)) for fid, score, _rank in rows if int(fid) >= 0]


def _parse_node_set(s: str) -> set[str]:
    out: set[str] = set()
    for tok in str(s or "").split(";"):
        tok = tok.strip()
        if tok:
            out.add(tok)
    return out


def _jaccard_from_sets(a: set[str], b: set[str]) -> float:
    if not a and not b:
        return 1.0
    u = set(a) | set(b)
    if not u:
        return 1.0
    return float(len(set(a) & set(b)) / float(len(u)))


def _read_bundle_region_map(path: Path) -> dict[int, tuple[set[str], set[str]]]:
    out: dict[int, tuple[set[str], set[str]]] = {}
    with open(path, "r", encoding="utf-8") as f:
        for row in csv.DictReader(f):
            try:
                bid = int(row.get("bundle_id", "-1") or -1)
            except Exception:
                continue
            out[int(bid)] = (
                _parse_node_set(row.get("regionA_nodes", "")),
                _parse_node_set(row.get("regionB_nodes", "")),
            )
    return out


def _region_overlap_pair(a1: set[str], b1: set[str], a2: set[str], b2: set[str]) -> float:
    direct = 0.5 * (_jaccard_from_sets(a1, a2) + _jaccard_from_sets(b1, b2))
    swapped = 0.5 * (_jaccard_from_sets(a1, b2) + _jaccard_from_sets(b1, a2))
    return float(max(direct, swapped))


def _spearman_from_rank_maps(base_rank: dict[int, int], rep_rank: dict[int, int], topn: int) -> float:
    n = max(1, int(topn))
    universe = sorted(set(int(k) for k in base_rank.keys()) | set(int(k) for k in rep_rank.keys()))
    if len(universe) < 2:
        return 1.0
    miss = float(n + 1)
    xb = np.asarray([float(base_rank.get(int(k), miss)) for k in universe], dtype=np.float64)
    xr = np.asarray([float(rep_rank.get(int(k), miss)) for k in universe], dtype=np.float64)
    xb = xb - float(np.mean(xb))
    xr = xr - float(np.mean(xr))
    den = float(np.sqrt(np.sum(xb * xb) * np.sum(xr * xr)))
    if den <= 0.0:
        return 1.0
    return float(np.sum(xb * xr) / den)


def _stability_levels(extra: int) -> list[int]:
    vals = {int(v) for v in STABILITY_TOP_LEVELS if int(v) > 0}
    if int(extra) > 0:
