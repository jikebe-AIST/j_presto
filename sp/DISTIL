    def _materialize_frames_to_array(frames_blk: np.ndarray, *, plan: dict, res_of_atom: np.ndarray, n_res_local: int) -> np.ndarray:
        F = int(np.asarray(plan['sel_fids']).size)
        X = np.empty((int(frames_blk.shape[0]), F), dtype=np.float32)
        near_cols = np.asarray(plan['near_cols'], dtype=np.int64)
        long_cols = np.asarray(plan['long_cols'], dtype=np.int64)
        near_pairs = np.asarray(plan['near_pairs'], dtype=np.int32)
        long_pairs = np.asarray(plan['long_pairs'], dtype=np.int32)
        K = int(near_pairs.shape[0])
        L = int(long_pairs.shape[0])
        dn_buf = np.empty((K,), dtype=np.float32) if K else None
        dl_buf = np.empty((L,), dtype=np.float32) if L else None
        cent_tmp = np.empty((int(n_res_local), 3), dtype=np.float32) if L else None
        for fi in range(int(frames_blk.shape[0])):
            coords = np.asarray(frames_blk[fi], dtype=np.float32)
            row = X[fi]
            if K:
                for p0 in range(0, K, pair_block):
                    p1 = min(K, p0 + pair_block)
                    _pairwise_distances_into_j(coords, near_pairs[p0:p1], dn_buf[p0:p1])
                row[near_cols] = dn_buf
            if L:
                _centroids_from_coords(coords, np.asarray(res_of_atom, dtype=np.int32), int(n_res_local), cent_tmp)
                for p0 in range(0, L, pair_block):
                    p1 = min(L, p0 + pair_block)
                    _pairwise_distances_into_j(cent_tmp, long_pairs[p0:p1], dl_buf[p0:p1])
                row[long_cols] = dl_buf
        return X

    def _iter_blocks_with_ids(inp: Path, natom: int, *, sel_idx: Optional[np.ndarray], frame_stride_local: int):
        block_id = 0
        for frames_blk, _hdr, info in iter_ensemble_blocks(inp, natom, sel_idx=sel_idx, frame_stride=frame_stride_local, with_headers=False):
            yield block_id, np.asarray(frames_blk, dtype=np.float32), info
            block_id += 1

    def _count_selected_frames_in_range(ist: int, ien: int, stride_local: int) -> int:
        ist = int(ist); ien = int(ien)
        if ien < ist:
            return 0
        if int(stride_local or 0) <= 0:
            return int(ien - ist + 1)
        return int(((ien - ist) // int(stride_local)) + 1)

    def _estimate_total_blocks(inp: Path, natom: int, *, sel_idx: Optional[np.ndarray], frame_stride_local: int) -> int:
        inp = Path(inp).resolve()
        stride_local = int(frame_stride_local or 0)
        block_size = int(_DISTIL_FRAME_BLOCK_SIZE)
        if inp.suffix.lower() in ('.list', '.txt'):
            items = _parse_list(inp)
            groups: dict[Path, list[tuple[int, str]]] = defaultdict(list)
            for it in items:
                groups[it.path].append((it.ist, it.ien_raw))
            resolved_groups, _ = _resolve_list_items_for_loaded_groups(groups, natom=natom, sel_idx=sel_idx)
            total_blocks = 0
            # Match iter_ensemble_blocks(): each resolved range is streamed independently.
            for _p, ranges in resolved_groups.items():
                for ist, ien, _n, _tok in ranges:
                    nsel = _count_selected_frames_in_range(ist, ien, stride_local)
                    total_blocks += int(math.ceil(float(nsel) / float(block_size))) if nsel > 0 else 0
            return int(total_blocks)
        total_raw = _count_cod_frames(inp, natom)
        total_selected = _count_selected_frames_in_range(1, int(total_raw), stride_local)
        return int(math.ceil(float(total_selected) / float(block_size))) if total_selected > 0 else 0

    def _load_chunk_metrics(metrics_path: Path) -> list[tuple[int, int, dict[str, object]]]:
        rows: list[tuple[int, int, dict[str, object]]] = []
        with open(metrics_path, 'r', encoding='utf-8', newline='') as f:
            for row in csv.DictReader(f):
                try:
                    pos = int(row.get('pos', '-1') or -1)
                    fid = int(row.get('fid', '-1') or -1)
                except Exception:
                    continue
                metrics = {
                    'pair_type': row.get('pair_type', ''),
                    'auc_single': float(row.get('auc_single', 'nan') or 'nan'),
                    'passed_auc': bool(int(row.get('passed_auc', '0') or 0)),
                    'passed_final': bool(int(row.get('passed_final', row.get('passed_auc', '0')) or 0)),
                    'n_samples_A': int(row.get('n_samples_A', stage1_auc_idxA_use.size) or stage1_auc_idxA_use.size),
                    'n_samples_B': int(row.get('n_samples_B', stage1_auc_idxB_use.size) or stage1_auc_idxB_use.size),
                    'score_mean_A': float(row.get('score_mean_A', 'nan') or 'nan'),
                    'score_mean_B': float(row.get('score_mean_B', 'nan') or 'nan'),
                    'neff_A': float(row.get('neff_A', 'nan') or 'nan'),
                    'neff_B': float(row.get('neff_B', 'nan') or 'nan'),
                }
                rows.append((pos, fid, metrics))
        rows.sort(key=lambda t: int(t[0]))
        return rows

