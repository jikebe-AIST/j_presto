            feat_std = np.asarray(mv.get('feature_std', np.zeros((X_multi.shape[1],), dtype=np.float64)), dtype=np.float64)
            mu = np.mean(Xtr, axis=0)
            keep = np.isfinite(feat_std) & (feat_std > 1e-12)
            Xte_use = np.asarray(Xte, dtype=np.float64)
            if bool(standardize):
                if np.any(keep):
                    Xte_use[:, keep] = (Xte_use[:, keep] - mu[keep][None, :]) / feat_std[keep][None, :]
                if np.any(~keep):
                    Xte_use[:, ~keep] = 0.0
            preds[test_idx] = Xte_use @ coef + intercept
        elif contrib_solver == 'memmap_block_proxgrad':
            if x_memmap_path is None:
                return float('nan')
            # IMPORTANT: memmap solvers interpret row_indices as row numbers in
            # the full on-disk matrix.  Therefore y/sample_weight must also be
            # the full arrays here.  Passing y[train_idx] together with
            # row_indices=train_idx makes the internal gradient code index the
            # shortened label vector with full row ids, causing e.g.
            # "index 300000 is out of bounds for axis 0 with size 300000".
            mv = _fit_multivar_contrib_memmap_block_proxgrad(Path(x_memmap_path), y, sample_weight=sw, penalty=penalty, C=float(C), max_iter=max(20, min(int(max_iter), 60)), standardize=bool(standardize), random_state=int(random_state), progress_interval_sec=max(float(progress_interval_sec), 300.0), sample_block_size=int(sample_block_size), tol=1e-4, patience=3, row_indices=train_idx, pruning_mode=str(pruning_mode), prune_warmup_epochs=int(prune_warmup_epochs), prune_every=int(prune_every), reactivate_every=int(reactivate_every), min_active_features=int(min_active_features), keep_top_beta=int(keep_top_beta), keep_top_grad=int(keep_top_grad), keep_top_auc=int(keep_top_auc), contrib_initial_active_features=contrib_initial_active_features, contrib_reactivate_top=int(contrib_reactivate_top), single_feature_auc=(np.asarray(single_feature_auc, dtype=np.float64) if single_feature_auc is not None else None))
            coef = np.asarray(mv.get('coef', np.zeros((0,), dtype=np.float64)), dtype=np.float64)
            feat_std = np.asarray(mv.get('feature_std', np.zeros_like(coef)), dtype=np.float64)
            mu, _sd = _memmap_block_feature_stats(Path(x_memmap_path), progress_interval_sec=max(float(progress_interval_sec),300.0), row_indices=train_idx)
            keep = np.isfinite(feat_std) & (feat_std > 1e-12)
            pred_te = _memmap_block_decision_function(Path(x_memmap_path), coef, float(mv.get('intercept', 0.0)), mu=mu, sd=feat_std, keep=keep, standardize=bool(standardize), row_block=int(sample_block_size), progress_interval_sec=max(float(progress_interval_sec),300.0), row_indices=test_idx)
            preds[test_idx] = pred_te
        else:
            return float('nan')
        done += 1
        if _log_enabled('info') and split_logger is not None:
            split_logger(done, active=1, force=False)
    if _log_enabled('info') and split_logger is not None:
        split_logger(len(splits), active=0, force=True)
    ok = np.isfinite(preds)
    if int(np.count_nonzero(ok)) < 4:
        return float('nan')
    auc_kwargs = {}
    if sw is not None:
        auc_kwargs['sample_weight'] = sw[ok]
    try:
        return float(roc_auc_score(y[ok], preds[ok], **auc_kwargs))
    except Exception:
        return float('nan')

def _stage1_estimate_feature_peak_bytes(total_frames: int, n_features: int, *, auc_workers: int = 1) -> int:
    mat = _estimate_feature_matrix_bytes(total_frames, n_features, dtype=np.float32)
    per_feature_scores = int(total_frames) * np.dtype(np.float64).itemsize
    worker_overhead = max(1, int(auc_workers)) * max(per_feature_scores * 2, 8 * (1024 ** 2))
    fixed = 512 * (1024 ** 2)
    return int(max(0, mat * 2 + worker_overhead + fixed))


def _auto_stage1_chunk_features(total_frames: int, n_candidates: int, *, auc_workers: int = 1, min_features: int = 16, max_features: int = 4096) -> tuple[int, dict[str, int | None]]:
    avail_eff, mem_meta = _effective_available_ram_bytes()
    if avail_eff is None:
        avail_eff = 8 * (1024 ** 3)
    reserve = max(4 * (1024 ** 3), int(avail_eff * 0.25))
    budget = max(256 * (1024 ** 2), int(avail_eff) - int(reserve))
    lo = 1
    hi = max(1, min(int(max_features), int(max(1, n_candidates))))
    best = max(1, min(int(min_features), hi))
    while lo <= hi:
        mid = (lo + hi) // 2
        need = _stage1_estimate_feature_peak_bytes(total_frames, mid, auc_workers=auc_workers)
        if need <= budget:
            best = mid
            lo = mid + 1
        else:
            hi = mid - 1
    best = max(1, min(int(max_features), int(max(min_features, best)), int(max(1, n_candidates))))
    meta = dict(mem_meta)
    meta.update({'avail_eff': int(avail_eff), 'budget': int(budget), 'chosen_chunk_features': int(best), 'auc_workers': int(max(1, auc_workers))})
    return int(best), meta


_STAGE1_AUC_GLOBALS = {}


def _stage1_auc_init(xa_path: str, xb_path: str, shapeA: tuple[int, int], shapeB: tuple[int, int], dtype_str: str,
                     pos_arr: np.ndarray, sel_fids_prefilter_arr: np.ndarray, stage1_auc_idxA_use_arr: np.ndarray | None,
                     stage1_auc_idxB_use_arr: np.ndarray | None, stage1_auc_wA_arr: np.ndarray, stage1_auc_wB_arr: np.ndarray,
                     fs_meta: dict[int, tuple[float, float, int, int]], stage1_auc_frame_mode: str,
                     auc_eps: float, auc_cv_folds: int, auc_random_state: int, progress_interval_sec: float):
    _STAGE1_AUC_GLOBALS.clear()
    _STAGE1_AUC_GLOBALS['XA'] = np.memmap(xa_path, mode='r', dtype=np.dtype(dtype_str), shape=tuple(shapeA))
    _STAGE1_AUC_GLOBALS['XB'] = np.memmap(xb_path, mode='r', dtype=np.dtype(dtype_str), shape=tuple(shapeB))
    _STAGE1_AUC_GLOBALS['pos_arr'] = np.asarray(pos_arr, dtype=np.int64)
    _STAGE1_AUC_GLOBALS['sel_fids_prefilter'] = np.asarray(sel_fids_prefilter_arr, dtype=np.int64)
    _STAGE1_AUC_GLOBALS['idxA'] = None if stage1_auc_idxA_use_arr is None else np.asarray(stage1_auc_idxA_use_arr, dtype=np.int64)
    _STAGE1_AUC_GLOBALS['idxB'] = None if stage1_auc_idxB_use_arr is None else np.asarray(stage1_auc_idxB_use_arr, dtype=np.int64)
    _STAGE1_AUC_GLOBALS['wA'] = np.asarray(stage1_auc_wA_arr, dtype=np.float64)
    _STAGE1_AUC_GLOBALS['wB'] = np.asarray(stage1_auc_wB_arr, dtype=np.float64)
    _STAGE1_AUC_GLOBALS['fs_meta'] = dict(fs_meta)
    _STAGE1_AUC_GLOBALS['frame_mode'] = str(stage1_auc_frame_mode)
    _STAGE1_AUC_GLOBALS['auc_eps'] = float(auc_eps)
    _STAGE1_AUC_GLOBALS['auc_cv_folds'] = int(auc_cv_folds)
    _STAGE1_AUC_GLOBALS['auc_random_state'] = int(auc_random_state)
    _STAGE1_AUC_GLOBALS['progress_interval_sec'] = float(progress_interval_sec)



def _stage1_auc_worker(local_pos: int):
    G = _STAGE1_AUC_GLOBALS
    pos = int(G['pos_arr'][int(local_pos)])
    fid = int(G['sel_fids_prefilter'][pos])
    minv, maxv, bins, kind = G['fs_meta'][fid]
    XA = G['XA']; XB = G['XB']
    if G['frame_mode'] == 'full':
        xA = np.asarray(XA[:, int(local_pos)], dtype=np.float64)
        xB = np.asarray(XB[:, int(local_pos)], dtype=np.float64)
    else:
        xA = np.asarray(XA[G['idxA'], int(local_pos)], dtype=np.float64)
        xB = np.asarray(XB[G['idxB'], int(local_pos)], dtype=np.float64)
    x_min = float(minv); x_max = float(maxv)
    if not np.isfinite(x_min) or not np.isfinite(x_max) or x_max <= x_min:
        xs = np.concatenate([xA, xB])
        x_min, x_max = _winsor_limits_from_sample(xs, q=_TV_WINSOR_Q)
        if x_max <= x_min:
            x_max = x_min + 1e-6
    res = _compute_single_feature_auc_and_scores(
        xA, xB, G['wA'], G['wB'], bins=max(2, int(bins)), x_min=x_min, x_max=x_max,
        eps=G['auc_eps'], cv_folds=G['auc_cv_folds'], random_state=G['auc_random_state'] + pos,
        progress_label=None, progress_interval_sec=G['progress_interval_sec'],
    )
    auc_single = float(res.get('auc', float('nan')))
    scores = np.asarray(res.get('scores', np.zeros((xA.shape[0] + xB.shape[0],), dtype=np.float64)), dtype=np.float32)
    passed_auc = bool(np.isfinite(auc_single) and auc_single >= 0.0)
    metrics = {
        'auc_single': auc_single,
        'n_samples_A': int(xA.shape[0]),
        'n_samples_B': int(xB.shape[0]),
        'score_mean_A': float(res.get('score_mean_A', float('nan'))),
        'score_mean_B': float(res.get('score_mean_B', float('nan'))),
        'neff_A': float(res.get('neff_A', float('nan'))),
        'neff_B': float(res.get('neff_B', float('nan'))),
        'pair_type': 'near' if int(kind) == 0 else 'long',
    }
    return int(local_pos), int(pos), int(fid), metrics, scores


_STAGE6_GLOBALS = {}


def _stage6_regions_init(tv_by_fid, auc_by_fid, contrib_by_fid, kind_by_fid, pair_meta_obj, seed_value: int,
                         maxcut_restarts_value: int, maxcut_max_iter_value: int, supporting_topK_value: int,
                         stage5_weight_by_fid=None, stage5_weight_name: str = 'contribution',
                         region_build_weight_by_fid=None, region_build_weight_name: str = 'auc_excess'):
    _STAGE6_GLOBALS.clear()
    _STAGE6_GLOBALS['tv_by_fid'] = dict(tv_by_fid)
    _STAGE6_GLOBALS['auc_by_fid'] = dict(auc_by_fid)
    _STAGE6_GLOBALS['contrib_by_fid'] = dict(contrib_by_fid)
    _STAGE6_GLOBALS['stage5_weight_by_fid'] = dict(stage5_weight_by_fid if stage5_weight_by_fid is not None else contrib_by_fid)
    _STAGE6_GLOBALS['stage5_weight_name'] = str(stage5_weight_name or 'contribution')
    _STAGE6_GLOBALS['region_build_weight_by_fid'] = dict(region_build_weight_by_fid if region_build_weight_by_fid is not None else {})
    _STAGE6_GLOBALS['region_build_weight_name'] = str(region_build_weight_name or 'auc_excess')
    _STAGE6_GLOBALS['kind_by_fid'] = dict(kind_by_fid)
    _STAGE6_GLOBALS['pair_meta'] = pair_meta_obj
    _STAGE6_GLOBALS['seed'] = int(seed_value)
    _STAGE6_GLOBALS['maxcut_restarts'] = int(maxcut_restarts_value)
    _STAGE6_GLOBALS['maxcut_max_iter'] = int(maxcut_max_iter_value)
    _STAGE6_GLOBALS['supporting_topK'] = int(supporting_topK_value)



def _stage6_node_key(kind: int, fid: int, which: str) -> str:
    pair_meta = _STAGE6_GLOBALS['pair_meta']
    if int(kind) == 0:
        res = int(pair_meta.res_i[fid]) if which == 'i' else int(pair_meta.res_j[fid])
        at = int(pair_meta.atom_i[fid]) if which == 'i' else int(pair_meta.atom_j[fid])
        ag = int(pair_meta.agroup_i[fid]) if which == 'i' else int(pair_meta.agroup_j[fid])
        return f"atom:{res}:{at}:ag{ag}"
    else:
        res = int(pair_meta.res_i[fid]) if which == 'i' else int(pair_meta.res_j[fid])
        if res < 0:
            res = int(pair_meta.i[fid]) if which == 'i' else int(pair_meta.j[fid])
        return f"res:{res}"



def _stage6_solve_one_bundle(task):
    """Solve one bundle's two-region split.

    Region construction and final ranking intentionally use different scores.

    In standard mode, Max-Cut uses auc_excess = max(0, AUC - 0.5) as a
    structural build weight so that bundle splitting follows single-feature
    A/B separation.  Final bundle/region-pair ranking uses sorted cross-region
    Stage5 weights lexicographically; if Stage5 weights do not distinguish
    rows, sorted cross-region auc_excess values are used as a formal
    tie-breaker.  This keeps zero-contribution bundles in the output without
    returning to a sum-dominated ranking.
    """
    bundle_id, member_fids = task
    G = _STAGE6_GLOBALS
    tv_by_fid = G['tv_by_fid']
    auc_by_fid = G['auc_by_fid']
    contrib_by_fid = G['contrib_by_fid']
    stage5_weight_by_fid = G.get('stage5_weight_by_fid', contrib_by_fid)
    stage5_weight_name = str(G.get('stage5_weight_name', 'contribution'))
    region_build_weight_by_fid = G.get('region_build_weight_by_fid', {})
    region_build_weight_name = str(G.get('region_build_weight_name', 'auc_excess'))
    kind_by_fid = G['kind_by_fid']
    pair_meta = G['pair_meta']
    seed = int(G['seed'])
    maxcut_restarts = int(G['maxcut_restarts'])
    maxcut_max_iter = int(G['maxcut_max_iter'])
    supporting_topK = int(G['supporting_topK'])

    edges = []
    nodes = {}
    def _nid(key: str) -> int:
        if key in nodes:
            return nodes[key]
        nid = len(nodes)
        nodes[key] = nid
        return nid

    for fid0 in member_fids:
        fid = int(fid0)
        if fid not in tv_by_fid:
            continue
        k = int(kind_by_fid.get(fid, int(pair_meta.kind[fid]) if fid < len(pair_meta) else 1))
        ukey = _stage6_node_key(k, fid, 'i')
        vkey = _stage6_node_key(k, fid, 'j')
        if ukey == vkey:
            continue
        w_tv = float(tv_by_fid.get(fid, 0.0))
        w_auc = float(auc_by_fid.get(fid, float('nan')))
        w_contrib = float(contrib_by_fid.get(fid, 0.0))
        w_stage5 = float(stage5_weight_by_fid.get(fid, 0.0))
        w_build = float(region_build_weight_by_fid.get(fid, float('nan')))
        if not np.isfinite(w_build):
            if region_build_weight_name == 'tv':
                w_build = w_tv
            elif region_build_weight_name == 'unit':
                w_build = 1.0
            elif region_build_weight_name in ('contribution', 'stage5_weight'):
                w_build = w_stage5
            else:
                w_build = max(0.0, w_auc - 0.5) if np.isfinite(w_auc) else 0.0
        if not (w_build > 0.0 and np.isfinite(w_build)):
            continue
        u = _nid(ukey)
        v = _nid(vkey)
        # edge tuple: region-build weight, fid, kind, tv, auc, contribution, stage5 rank weight
        edges.append((u, v, float(w_build), fid, k, w_tv, w_auc, w_contrib, w_stage5))

    n = len(nodes)
    empty = {
        'bundle_id': int(bundle_id), 'regionA_nodes': '', 'regionB_nodes': '', 'nA': 0, 'nB': 0,
        'cut_weight': 0.0, 'max_tv_cross': 0.0, 'max_auc_cross': float('nan'),
        'max_contribution_cross': 0.0, 'sum_contribution_multi': 0.0,
        'mean_contribution_multi': 0.0, 'density_contribution_multi': 0.0,
        'cross_contribution_sum': 0.0, 'cross_contribution_mean': 0.0,
        'cross_contribution_density': 0.0,
        'max_stage5_weight_cross': 0.0, 'sum_stage5_weight': 0.0,
        'mean_stage5_weight': 0.0, 'density_stage5_weight': 0.0,
        'cross_stage5_weight_sum': 0.0, 'cross_stage5_weight_mean': 0.0,
        'cross_stage5_weight_density': 0.0, 'stage5_weight_name': stage5_weight_name,
        'region_build_weight_name': region_build_weight_name,
        'rank_score': 0.0, 'rank_score_source': 'stage5_weight_lexicographic_then_auc_excess',
        'rank_stage5_top_values': '', 'rank_auc_excess_top_values': '',
        'rank_stage5_1': 0.0, 'rank_stage5_2': 0.0, 'rank_stage5_3': 0.0, 'rank_stage5_4': 0.0, 'rank_stage5_5': 0.0,
        'rank_auc_excess_1': 0.0, 'rank_auc_excess_2': 0.0, 'rank_auc_excess_3': 0.0, 'rank_auc_excess_4': 0.0, 'rank_auc_excess_5': 0.0,
        'has_positive_stage5_weight': 0,
        'mean_auc_single': float('nan'),
        'n_crossing_features': 0,
        'argmax_pair_id': '', 'argmax_pair_type': '', 'supporting_pairs_topK': ''
    }
    if n == 0 or not edges:
        return empty

    adj = [[] for _ in range(n)]
    tmp = {}
    for (u, v, w_build, _fid, _k, _wtv, _wauc, _wcontrib, _wstage5) in edges:
        if u == v:
            continue
        a, b = (u, v) if u < v else (v, u)
        tmp[(a, b)] = tmp.get((a, b), 0.0) + float(w_build)
    for (a, b), wsum in tmp.items():
        if not (wsum > 0.0 and np.isfinite(wsum)):
            continue
        adj[a].append((b, wsum))
        adj[b].append((a, wsum))

    rng_local = np.random.default_rng(int(seed) ^ (int(bundle_id) * 0x9E3779B97F4A7C15))
    x = rng_local.normal(size=(n,)).astype(np.float64)
    x /= max(1e-12, float(np.linalg.norm(x)))
    y = np.zeros_like(x)
    for _ in range(20):
        y.fill(0.0)
        for u in range(n):
            su = 0.0
            for v, wsum in adj[u]:
                su += wsum * x[v]
            y[u] = su
        ny = float(np.linalg.norm(y))
        if not (ny > 1e-12 and np.isfinite(ny)):
            break
        x = y / ny

    best_s = None
    best_cut = -1.0
    best_cross = []
    for rr in range(maxcut_restarts):
        if rr == 0:
            svec = np.where(x >= 0.0, 1, -1).astype(np.int8)
            if np.all(svec == 1) or np.all(svec == -1):
                half = max(1, n // 2)
                svec[:] = 1
                svec[half:] = -1
        else:
            rng = np.random.default_rng(int(seed) + int(bundle_id) * 1000003 + int(rr))
            svec = np.ones((n,), dtype=np.int8)
            perm = rng.permutation(n)
            half = max(1, n // 2)
            svec[perm[half:]] = -1

        t = np.zeros((n,), dtype=np.float64)
        for u in range(n):
            su = 0.0
            for v, wsum in adj[u]:
                su += wsum * float(svec[v])
            t[u] = su
        it = 0
        while it < maxcut_max_iter:
            gains = svec.astype(np.float64) * t
            i = int(np.argmax(gains))
            g = float(gains[i])
            if not (g > 1e-12 and np.isfinite(g)):
                break
            si_old = int(svec[i])
            svec[i] = np.int8(-si_old)
            for v, wsum in adj[i]:
                t[v] -= 2.0 * wsum * float(si_old)
            su = 0.0
            for v, wsum in adj[i]:
                su += wsum * float(svec[v])
            t[i] = su
            it += 1

        cut_w = 0.0
        cross = []
        for (u, v, w_build, fid, k, wtv, wauc, wcontrib, wstage5) in edges:
            if svec[u] != svec[v]:
                cut_w += w_build
                cross.append((w_build, fid, k, wtv, wauc, wcontrib, wstage5))
        cross.sort(key=lambda t: (t[6] if np.isfinite(t[6]) else 0.0,
                                  t[5] if np.isfinite(t[5]) else 0.0,
                                  t[4] if np.isfinite(t[4]) else 0.0,
                                  t[0]), reverse=True)
        best_rank_key = (
            tuple(_rank_nonnegative_desc_values((t[6] for t in best_cross), top_k=RANK_LEXICOGRAPHIC_TOP_K)),
            tuple(_rank_nonnegative_desc_values((_auc_excess_value(t[4]) for t in best_cross), top_k=RANK_LEXICOGRAPHIC_TOP_K)),
        )
        cur_rank_key = (
            tuple(_rank_nonnegative_desc_values((t[6] for t in cross), top_k=RANK_LEXICOGRAPHIC_TOP_K)),
            tuple(_rank_nonnegative_desc_values((_auc_excess_value(t[4]) for t in cross), top_k=RANK_LEXICOGRAPHIC_TOP_K)),
        )
        if (cut_w > best_cut + 1e-12) or (abs(cut_w - best_cut) <= 1e-12 and cur_rank_key > best_rank_key):
            best_cut = float(cut_w)
            best_s = svec.copy()
            best_cross = cross

    svec = best_s if best_s is not None else np.ones((n,), dtype=np.int8)
    cut_w = float(best_cut if best_cut >= 0 else 0.0)
    cross = best_cross
    max_tv = float(max((t[3] for t in cross), default=0.0)) if cross else 0.0
    finite_aucs = [float(t[4]) for t in cross if np.isfinite(float(t[4]))]
    max_auc = float(max(finite_aucs)) if finite_aucs else float('nan')
    finite_contrib = [float(t[5]) for t in cross if np.isfinite(float(t[5]))]
    max_contrib = float(max(finite_contrib)) if finite_contrib else 0.0
    finite_stage5 = [float(t[6]) for t in cross if np.isfinite(float(t[6]))]
    max_stage5_weight = float(max(finite_stage5)) if finite_stage5 else 0.0

    csum = float(np.sum(finite_contrib)) if finite_contrib else 0.0
    cmean = float(np.mean(finite_contrib)) if finite_contrib else 0.0
    cdens = float(csum / max(1, len(cross))) if cross else 0.0
    swsum = float(np.sum(finite_stage5)) if finite_stage5 else 0.0
    swmean = float(np.mean(finite_stage5)) if finite_stage5 else 0.0
    swdens = float(swsum / max(1, len(cross))) if cross else 0.0
    rank_stage5_values = _rank_nonnegative_desc_values((t[6] for t in cross), top_k=RANK_LEXICOGRAPHIC_TOP_K)
    rank_auc_excess_values = _rank_nonnegative_desc_values((_auc_excess_value(t[4]) for t in cross), top_k=RANK_LEXICOGRAPHIC_TOP_K)
    rank_stage5_tuple = tuple(rank_stage5_values + [0.0] * max(0, RANK_LEXICOGRAPHIC_TOP_K - len(rank_stage5_values)))
    rank_auc_excess_tuple = tuple(rank_auc_excess_values + [0.0] * max(0, RANK_LEXICOGRAPHIC_TOP_K - len(rank_auc_excess_values)))
    has_positive = int(rank_stage5_tuple[0] > 1e-12) if rank_stage5_tuple else 0
    rank_score = float(rank_stage5_tuple[0]) if rank_stage5_tuple else 0.0
    rank_score_source = 'stage5_weight_lexicographic_then_auc_excess'

    key_fn = lambda t: (
        t[6] if np.isfinite(t[6]) else 0.0,
        _auc_excess_value(t[4]),
        t[5] if np.isfinite(t[5]) else 0.0,
        t[4] if np.isfinite(t[4]) else 0.0,
        t[3] if np.isfinite(t[3]) else 0.0,
        t[0],
    )
    arg = max(cross, key=key_fn) if cross else None
    argmax_fid = int(arg[1]) if arg is not None else -1
    argmax_kind = int(arg[2]) if arg is not None else -1

    inv_nodes = [None] * n
    for key, nid in nodes.items():
