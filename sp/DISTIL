def _materialize_feature_chunk_to_path_from_blocks(block_iter,
                                                   *,
                                                   out_path: Path,
                                                   n_frames_total: int,
                                                   plan: dict,
                                                   res_of_atom: np.ndarray,
                                                   n_res: int,
                                                   pair_block: int = 100_000,
                                                   progress_label: str = "CHUNK",
                                                   verbose: bool = True,
                                                   progress_interval_sec: float = 300.0) -> Path:
    out_path = Path(out_path)
    F = int(np.asarray(plan["sel_fids"]).size)
    X = open_memmap(str(out_path), mode="w+", dtype=np.float32, shape=(int(n_frames_total), F))
    near_cols = np.asarray(plan["near_cols"], dtype=np.int64)
    long_cols = np.asarray(plan["long_cols"], dtype=np.int64)
    near_pairs = np.asarray(plan["near_pairs"], dtype=np.int32)
    long_pairs = np.asarray(plan["long_pairs"], dtype=np.int32)
    K = int(near_pairs.shape[0])
    L = int(long_pairs.shape[0])
    pair_block = max(10_000, int(pair_block))
    dn_buf = np.empty((K,), dtype=np.float32) if K else None
    dl_buf = np.empty((L,), dtype=np.float32) if L else None
    cent_tmp = np.empty((int(n_res), 3), dtype=np.float32) if L else None
    dist_pair = _pairwise_distances_into_j
    dist_long = _pairwise_distances_into_j
    centroids = _centroids_from_coords
    write_pos = 0
    t0 = time.perf_counter()
    last_prog = t0
    progress_interval_sec = max(1.0, float(progress_interval_sec or 300.0))
    for frames_blk, _headers_blk, _info in block_iter:
        blk = np.asarray(frames_blk, dtype=np.float32)
        for fi in range(int(blk.shape[0])):
            coords = blk[fi]
            row = X[write_pos]
            if K:
                for p0 in range(0, K, pair_block):
                    p1 = min(K, p0 + pair_block)
                    dist_pair(coords, near_pairs[p0:p1], dn_buf[p0:p1])
                row[near_cols] = dn_buf
            if L:
                centroids(coords, res_of_atom, int(n_res), cent_tmp)
                for p0 in range(0, L, pair_block):
                    p1 = min(L, p0 + pair_block)
                    dist_long(cent_tmp, long_pairs[p0:p1], dl_buf[p0:p1])
                row[long_cols] = dl_buf
            write_pos += 1
        if verbose and n_frames_total > 0:
            now = time.perf_counter()
            frac = write_pos / float(n_frames_total)
            if (now - last_prog) >= progress_interval_sec or write_pos >= int(n_frames_total):
                dt = now - t0
                done_i, total_i, pct_i, rate_i, eta_i = _format_progress_fields(write_pos, int(n_frames_total), elapsed=dt)
                msg_i = f"[PROG ] {progress_label}: {done_i}/{total_i} ({pct_i:.1f}%)"
                msg_i = _append_progress_timing(msg_i, elapsed=dt, rate=rate_i, eta=eta_i, rate_suffix=' frames/s')
                print(_apply_log_prefix(msg_i), file=sys.stderr, flush=True)
                last_prog = now
    if write_pos != int(n_frames_total):
        raise ValueError(f"Feature-chunk materialization frame count mismatch for {out_path}: expected {n_frames_total}, wrote {write_pos}")
    X.flush()
    return out_path


def _auto_stride_for_target(n_frames: int, target_n: int, oversample_factor: int = 4) -> int:
    """Return an auto stride for time-decorrelated candidate frames.

    We keep the final subsample size fixed (``target_n``) but first create a
    somewhat larger decorrelated candidate pool so that weighted selection still
    has room to prefer heavier frames. ``oversample_factor`` controls the rough
    candidate/sample ratio.
    """
    n = int(max(0, n_frames))
    t = int(max(1, target_n))
    if n <= t:
        return 1
    cand_target = min(n, max(t, int(t * max(1, oversample_factor))))
    stride = int(math.floor(n / float(cand_target)))
    return max(1, stride)


def _weighted_systematic_pick(indices: np.ndarray, weights: np.ndarray, target_n: int, *, seed: int) -> np.ndarray:
    """Pick a fixed-size weighted sample without replacement from ordered candidates.

    This is a streaming-friendly systematic PPS-style selector: heavier frames are
    selected more often in expectation, while preserving the candidate order so
    that the final sample remains time-decorrelated after the stride thinning.
    """
    idx = np.asarray(indices, dtype=np.int64)
    w = np.asarray(weights, dtype=np.float64)
    if idx.size == 0 or target_n <= 0:
        return np.zeros((0,), dtype=np.int64)
    target = min(int(target_n), int(idx.size))
    if target <= 0:
        return np.zeros((0,), dtype=np.int64)
    ww = np.where(np.isfinite(w), np.maximum(w, 0.0), 0.0)
    total = float(np.sum(ww))
    if total <= 0.0:
        if idx.size <= target:
            return np.sort(idx.astype(np.int64, copy=False))
        step = float(idx.size) / float(target)
        start = ((int(seed) & 0xFFFFFFFF) / float(2**32)) * step
        pos = start + step * np.arange(target, dtype=np.float64)
        pick = np.floor(pos).astype(np.int64)
        np.clip(pick, 0, idx.size - 1, out=pick)
        return np.sort(idx[pick].astype(np.int64, copy=False))
    if idx.size <= target:
        return np.sort(idx.astype(np.int64, copy=False))
    step = total / float(target)
    rng = np.random.default_rng(int(seed))
    threshold = float(rng.random()) * step
    out = []
    csum = 0.0
    for i, wi in enumerate(ww):
        csum += float(wi)
        while threshold <= csum and len(out) < target:
            out.append(int(idx[i]))
            threshold += step
        if len(out) >= target:
            break
    if len(out) < target:
        chosen = set(out)
        for j in idx[::-1]:
            jj = int(j)
            if jj not in chosen:
                out.append(jj)
                chosen.add(jj)
                if len(out) >= target:
                    break
    return np.sort(np.asarray(out[:target], dtype=np.int64))


def _build_stage_subsample_indices(weights: np.ndarray, target_n: int, seed: int, phase: int) -> np.ndarray:
    """Time-decorrelated + weight-aware deterministic subsample indices.

    1) compute an automatic stride from the target sample count;
    2) build a decorrelated candidate lattice with a phase-dependent offset;
    3) select the final fixed-size subsample by weighted systematic sampling on
       that candidate order, so heavier frames are chosen more often while the
       sample stays well spread over time.
    """
    w = np.asarray(weights, dtype=np.float64)
    n = int(w.size)
    target = min(max(1, int(target_n)), n) if n > 0 else 0
    if target <= 0:
        return np.zeros((0,), dtype=np.int64)
    stride = _auto_stride_for_target(n, target)
    mix = (int(seed) ^ ((int(phase) + 0x9E3779B97F4A7C15) & 0xFFFFFFFFFFFFFFFF)) & 0xFFFFFFFFFFFFFFFF
    rng = np.random.default_rng(mix)
    offset = 0 if stride <= 1 else int(rng.integers(0, stride))
    candidates = np.arange(offset, n, stride, dtype=np.int64)
    if candidates.size == 0:
        candidates = np.arange(n, dtype=np.int64)
    if candidates.size < target:
        extra = np.setdiff1d(np.arange(n, dtype=np.int64), candidates, assume_unique=False)
        need = min(int(target - candidates.size), int(extra.size))
        if need > 0:
            extra_pick = _weighted_systematic_pick(extra, w[extra], need, seed=(mix ^ 0xBF58476D1CE4E5B9))
            candidates = np.sort(np.concatenate([candidates, extra_pick]).astype(np.int64, copy=False))
    if candidates.size <= target:
        return np.sort(candidates.astype(np.int64, copy=False))
    picked = _weighted_systematic_pick(candidates, w[candidates], target, seed=(mix ^ 0x94D049BB133111EB))
    return np.sort(picked.astype(np.int64, copy=False))


def _collect_selected_frames_from_blocks(inp: Path, natom: int, *, sel_idx: Optional[np.ndarray], frame_stride: int,
                                        selected_idx: np.ndarray, progress_label: str | None = None,
                                        log_interval_sec: float = 300.0) -> np.ndarray:
    """Collect only selected frames from a sequential block scan.

    This preserves sequential I/O while avoiding full in-memory trajectory
    concatenation. ``selected_idx`` must refer to the post-stride global frame
    numbering used by ``iter_ensemble_blocks``.
    """
    selected = np.asarray(selected_idx, dtype=np.int64)
    if selected.size == 0:
        atom_count = int(len(sel_idx)) if sel_idx is not None else int(natom)
        return np.empty((0, atom_count, 3), dtype=np.float32)
    atom_count = int(len(sel_idx)) if sel_idx is not None else int(natom)
    out = np.empty((int(selected.size), atom_count, 3), dtype=np.float32)
    write_pos = 0
    global_pos = 0
    sample_t0 = time.perf_counter()
    next_log = sample_t0 + float(log_interval_sec)
    total = int(selected.size)
    for frames_blk, _headers_blk, info in iter_ensemble_blocks(Path(inp), natom, sel_idx=sel_idx, frame_stride=frame_stride, with_headers=False):
        blk = np.asarray(frames_blk, dtype=np.float32)
        nblk = int(blk.shape[0])
        lo = int(np.searchsorted(selected, global_pos, side='left'))
        hi = int(np.searchsorted(selected, global_pos + nblk, side='left'))
        if hi > lo:
            local = selected[lo:hi] - int(global_pos)
            take = int(local.size)
            out[write_pos:write_pos + take] = blk[local]
            write_pos += take
        global_pos += nblk
        if progress_label and time.perf_counter() >= next_log:
            frac = write_pos / float(max(1, total))
            elapsed = time.perf_counter() - sample_t0
            done_i, total_i, pct_i, rate_i, eta_i = _format_progress_fields(write_pos, int(total), elapsed=elapsed)
            msg_i = f"[PROG ] {progress_label}: sampled={done_i}/{total_i} ({pct_i:.1f}%) scanned_frames={int(global_pos)}"
            msg_i = _append_progress_timing(msg_i, elapsed=elapsed, rate=rate_i, eta=eta_i, rate_suffix=' frames/s')
            print(_apply_log_prefix(msg_i), file=sys.stderr, flush=True)
            next_log = time.perf_counter() + float(log_interval_sec)
    if write_pos != total:
        raise ValueError(f"Selected-frame collection mismatch for {inp}: expected {total}, collected {write_pos}")
    if progress_label:
        elapsed = time.perf_counter() - sample_t0
        done_i, total_i, pct_i, rate_i, eta_i = _format_progress_fields(write_pos, int(total), elapsed=elapsed)
        msg_i = f"[PROG ] {progress_label}: sampled={done_i}/{total_i} ({pct_i:.1f}%) scanned_frames={int(global_pos)}"
        msg_i = _append_progress_timing(msg_i, elapsed=elapsed, rate=rate_i, eta=eta_i, rate_suffix=' frames/s')
        print(_apply_log_prefix(msg_i), file=sys.stderr, flush=True)
    return out


def _weighted_quantile_from_sorted(xs: np.ndarray, ws: np.ndarray, q: float) -> float:
    xs = np.asarray(xs, dtype=np.float64)
    ws = np.asarray(ws, dtype=np.float64)
    if xs.size == 0:
        return 0.0
    if xs.size == 1:
        return float(xs[0])
    ww = np.where(np.isfinite(ws), np.maximum(ws, 0.0), 0.0)
    s = float(np.sum(ww))
    if s <= 0.0:
        pos = min(max(int(round(q * (xs.size - 1))), 0), xs.size - 1)
        return float(xs[pos])
    cdf = np.cumsum(ww) / s
    idx = int(np.searchsorted(cdf, float(q), side='left'))
    idx = min(max(idx, 0), xs.size - 1)
    return float(xs[idx])


def _weighted_winsor_limits_from_sample(xs: np.ndarray, ws: np.ndarray, q: float) -> tuple[float, float]:
    xs = np.asarray(xs, dtype=np.float64)
    ws = np.asarray(ws, dtype=np.float64)
    if xs.size == 0:
        return 0.0, 1e-6
    mask = np.isfinite(xs)
    if not np.any(mask):
        return 0.0, 1e-6
    xs = xs[mask]
    ws = ws[mask] if ws.size == mask.size else np.ones(xs.shape[0], dtype=np.float64)
    ws = np.asarray(ws, dtype=np.float64)
    order = np.argsort(xs, kind='mergesort')
    xs = xs[order]
    ws = ws[order]
    lo = _weighted_quantile_from_sorted(xs, ws, float(q))
    hi = _weighted_quantile_from_sorted(xs, ws, 1.0 - float(q))
    if not np.isfinite(lo):
        lo = float(xs[0])
    if not np.isfinite(hi):
        hi = float(xs[-1])
    if hi <= lo:
        hi = lo + 1e-6
    return float(lo), float(hi)


def _materialize_feature_chunk_from_frames(frames_blk: np.ndarray, *, plan: dict, res_of_atom: np.ndarray,
                                           n_res: int, pair_block: int = 100_000) -> np.ndarray:
    """Materialize one feature chunk from an in-memory coordinate block."""
    blk = np.asarray(frames_blk, dtype=np.float32)
    n_frames = int(blk.shape[0])
    F = int(np.asarray(plan["sel_fids"]).size)
    out = np.empty((n_frames, F), dtype=np.float32)
    near_cols = np.asarray(plan["near_cols"], dtype=np.int64)
    long_cols = np.asarray(plan["long_cols"], dtype=np.int64)
    near_pairs = np.asarray(plan["near_pairs"], dtype=np.int32)
    long_pairs = np.asarray(plan["long_pairs"], dtype=np.int32)
    K = int(near_pairs.shape[0])
    L = int(long_pairs.shape[0])
    pair_block = max(10_000, int(pair_block))
    dn_buf = np.empty((K,), dtype=np.float32) if K else None
    dl_buf = np.empty((L,), dtype=np.float32) if L else None
    cent_tmp = np.empty((int(n_res), 3), dtype=np.float32) if L else None
    dist_pair = _pairwise_distances_into_j
    dist_long = _pairwise_distances_into_j
    centroids = _centroids_from_coords
    for fi in range(n_frames):
        coords = blk[fi]
        row = out[fi]
        if K:
            for p0 in range(0, K, pair_block):
                p1 = min(K, p0 + pair_block)
                dist_pair(coords, near_pairs[p0:p1], dn_buf[p0:p1])
            row[near_cols] = dn_buf
        if L:
            centroids(coords, res_of_atom, int(n_res), cent_tmp)
            for p0 in range(0, L, pair_block):
                p1 = min(L, p0 + pair_block)
                dist_long(cent_tmp, long_pairs[p0:p1], dl_buf[p0:p1])
            row[long_cols] = dl_buf
    return out


def _update_hist_chunk(hist_view: np.ndarray, vals: np.ndarray, weights: np.ndarray,
                       x_min: np.ndarray, x_max: np.ndarray) -> None:
    """Accumulate weighted clipped histograms for one feature chunk."""
    if vals.size == 0:
        return
    H = np.asarray(hist_view, dtype=np.float64)
    x = np.asarray(vals, dtype=np.float64)
    w = np.asarray(weights, dtype=np.float64)
    bins = int(H.shape[1])
    xmin = np.asarray(x_min, dtype=np.float64)
    xmax = np.asarray(x_max, dtype=np.float64)
    width = (xmax - xmin) / float(bins)
    width = np.where(width > 0.0, width, 1.0)
    bidx = np.floor((x - xmin[None, :]) / width[None, :]).astype(np.int64)
    np.clip(bidx, 0, bins - 1, out=bidx)
    cols = int(x.shape[1])
    flat_bins = (bidx.reshape(-1) + np.tile(np.arange(cols, dtype=np.int64), int(x.shape[0])) * bins)
    flat_w = np.repeat(w, cols)
    hist_flat = H.reshape(-1)
    np.add.at(hist_flat, flat_bins, flat_w)
    hist_view[:] = H


def _compute_tv_from_histograms(histA: np.ndarray, histB: np.ndarray) -> np.ndarray:
    """Row-wise TV from weighted histogram counts."""
    HA = np.asarray(histA, dtype=np.float64)
    HB = np.asarray(histB, dtype=np.float64)
    sA = HA.sum(axis=1, keepdims=True)
    sB = HB.sum(axis=1, keepdims=True)
    pA = np.divide(HA, sA, out=np.zeros_like(HA), where=sA > 0.0)
    pB = np.divide(HB, sB, out=np.zeros_like(HB), where=sB > 0.0)
    tv = 1.0 - np.minimum(pA, pB).sum(axis=1)
    return np.clip(tv, 0.0, 1.0)


def _format_progress_fields(done_units: int, total_units: int, *, elapsed: float) -> tuple[int, int, float, float, float]:
    """Normalize progress fields as done/total/percent/rate/ETA.

    ETA is NaN when no meaningful estimate is available. The helper is
    deliberately lightweight so heartbeat logging does not change compute paths.
    """
    total = max(1, int(total_units))
    done = min(max(int(done_units), 0), total)
    pct = 100.0 * float(done) / float(total)
    rate = float(done) / max(float(elapsed), 1e-12)
    eta = float('nan')
    if done > 0 and done < total and rate > 0.0:
        eta = float(total - done) / rate
    return done, total, pct, rate, eta


def _append_progress_timing(msg: str, *, elapsed: float, rate: float, eta: float, rate_suffix: str = '/s') -> str:
    msg += f" elapsed={elapsed:.1f}s"
    if math.isfinite(float(eta)):
        msg += f" eta={float(eta):.1f}s"
    if math.isfinite(float(rate)):
        msg += f" rate={float(rate):.3g}{rate_suffix}"
    return msg


def _progress_logger(stage_label: str, *, total_units: int, min_interval_sec: float = 300.0, active_label: str = 'active'):
    """Create a time-based progress logger closure with percent/rate/ETA support."""
    t0 = time.perf_counter()
    next_t = t0 + float(min_interval_sec)
    total = max(1, int(total_units))

    def _emit(done_units: int, *, active: int | None = None, force: bool = False):
        nonlocal next_t
        now = time.perf_counter()
        if (not force) and now < next_t:
            return
        elapsed = now - t0
        done, total_norm, pct, rate, eta = _format_progress_fields(done_units, total, elapsed=elapsed)
        msg = f"[PROG ] {stage_label}: {done}/{total_norm} ({pct:.1f}%)"
        msg = _append_progress_timing(msg, elapsed=elapsed, rate=rate, eta=eta)
        if active is not None:
            msg += f" {active_label}={int(active)}"
        print(_apply_log_prefix(msg), file=sys.stderr, flush=True)
        next_t = now + float(min_interval_sec)

    return _emit

def _pipeline_progress_emit(stage_idx: int, total_stages: int, label: str, *, t0: float, extra: str = "") -> None:
    total = max(1, int(total_stages))
    idx = min(max(int(stage_idx), 0), total)
    frac = float(idx) / float(total)
    msg = f"[PIPE ] {idx}/{total} ({frac*100:.1f}%) {label} elapsed {time.perf_counter() - t0:.1f}s"
    if extra:
        msg += f" {extra}"
    print(_apply_log_prefix(msg), file=sys.stderr, flush=True)


