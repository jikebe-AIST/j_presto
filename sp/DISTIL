def _open_text_maybe_gz(path: Path):
    """Open text file, supporting .gz transparently."""
    p = Path(path).expanduser().resolve()
    if p.name.lower().endswith(".gz"):
        return gzip.open(p, "rt", encoding="utf-8", errors="ignore")
    return p.open("r", encoding="utf-8", errors="ignore")

def _pdb_rec_name(line: str) -> str:
    """Return PDB record name robustly.

    Many in-house pipelines output PDB-like files with leading spaces/tabs
    before the record name. We therefore detect the record after stripping
    leading whitespace, then read fixed-width fields from the same stripped
    line when parsing atom records.
    """
    if not line:
        return ""
    s = line.lstrip(" 	")
    return s[:6].strip()


def natom_from_pdb(pdb_path: Path) -> int:
    """
    Count atoms in a *single PDB file*.
    Accepted records: ATOM / HETATM (PDB columns 1-6).
    """
    p = Path(pdb_path).expanduser().resolve()
    if not p.exists():
        raise FileNotFoundError(f"PDB not found: {p}")
    n = 0
    with _open_text_maybe_gz(p) as fin:
        for line in fin:
            rec = _pdb_rec_name(line)
            if rec == "ATOM" or rec == "HETATM":
                n += 1
    if n == 0:
        raise ValueError(f"No ATOM/HETATM records in PDB: {p.name}")
    return n
HEADER_PATTERN = "i f f f f f f f i i f f f f"
def _struct_fmt(endian: str) -> str:
    return ('<' if endian == 'little' else '>') + HEADER_PATTERN.replace(' ', '')
HEADER_SIZE = struct.calcsize(_struct_fmt('little'))
def _read_exact(fp: io.BufferedReader, n: int) -> bytes:
    b = fp.read(n)
    if b is None or len(b) != n:
        raise EOFError("Unexpected EOF")
    return b
def _read_record_with_markers(fp: io.BufferedReader, nbytes: int, endian_char: str) -> bytes:
    len1 = struct.unpack(endian_char+'i', _read_exact(fp, 4))[0]
    payload = _read_exact(fp, nbytes)
    len2 = struct.unpack(endian_char+'i', _read_exact(fp, 4))[0]
    if len1 != nbytes or len2 != nbytes:
        raise IOError(f"Fortran record length mismatch: {len1}!={nbytes} or {len2}!={nbytes}")
    return payload
def _try_parse_header(buf: bytes, endian_char: str) -> dict | None:
    fmt = (endian_char + HEADER_PATTERN.replace(' ', ''))
    try:
        vals = struct.unpack_from(fmt, buf, 0)
    except struct.error:
        return None
    keys = ["istp","sitime","sec","et","ek","temp","ep","lambda","iyn15v","iyn15h","rmsd2","t1","t2","t3"]
    return dict(zip(keys, vals))
def _header_plausible(h: dict) -> bool:
    try:
        if int(h.get('istp', 1)) < 1:
            return False
        temp = float(h.get('temp', 300.0))
        if not (0.0 <= temp <= 5000.0):
            return False
        lam = float(h.get('lambda', 0.0))
        if not (-1e9 <= lam <= 1e9):
            return False
        return True
    except Exception:
        return False
def _detect_mode_endian(fp: io.BufferedReader, natom: int, suffix: str) -> tuple[str, str]:
    """(mode, endian_char) を返す。mode in {'record','stream'}, endian_char in {'<','>'}"""
    prefer = 'record' if suffix.lower() == '.cod' else ('stream' if suffix.lower() == '.cods' else None)
    coord_bytes = 3 * natom * 4

    # 1) record（両エンディアン）検査
    for e in ('<','>'):
        try:
            fp.seek(0)
            len1 = struct.unpack(e+'i', _read_exact(fp, 4))[0]
            if len1 != HEADER_SIZE:
                continue
            _ = _read_exact(fp, HEADER_SIZE)
            len2 = struct.unpack(e+'i', _read_exact(fp, 4))[0]
            if len2 != HEADER_SIZE:
                continue
            pos = fp.tell()
            try:
                len3 = struct.unpack(e+'i', _read_exact(fp, 4))[0]
            except EOFError:
                continue
            if len3 != coord_bytes:
                continue
            return 'record', e
        except Exception:
            pass
        finally:
            fp.seek(0)

    # 2) stream ヘッダ妥当性
    fp.seek(0)
    try:
        buf = _read_exact(fp, HEADER_SIZE)
    except EOFError:
        return 'stream', '<'
    candidates = []
    for e in ('<','>'):
        h = _try_parse_header(buf, e)
        if h and _header_plausible(h):
            candidates.append(('stream', e))
    if candidates:
        if prefer == 'stream':
            return candidates[0]
        return candidates[0]

    # 3) ヒントに従うかデフォルト
    if prefer == 'record':
        return 'record', '<'
    return 'stream', '<'
def _read_header_stream(fp: io.BufferedReader, endian_str: str) -> dict:
    endian_char = '<' if endian_str == 'little' else '>'
    buf = _read_exact(fp, HEADER_SIZE)
    h = _try_parse_header(buf, endian_char)
    if not h:
        raise EOFError("Cannot parse stream header")
    return h
def _read_header_marked(fp: io.BufferedReader, endian_str: str) -> dict:
    endian_char = '<' if endian_str == 'little' else '>'
    payload = _read_record_with_markers(fp, HEADER_SIZE, endian_char)
    h = _try_parse_header(payload, endian_char)
    if not h:
        raise EOFError("Cannot parse record-marked header")
    return h
def _cod_reader_params(cod_path: Path, natom: int) -> tuple[str, str, str, np.dtype]:
    if not cod_path.exists():
        raise FileNotFoundError(cod_path)
    with cod_path.open('rb') as fp:
        mode, e = _detect_mode_endian(fp, natom, cod_path.suffix)
    endian_str = 'little' if e == '<' else 'big'
    coord_dtype = np.dtype('<f4' if e == '<' else '>f4')
    return mode, e, endian_str, coord_dtype


def _read_coords_once_from_fp(fp: io.BufferedReader, *, mode: str, endian_char: str,
                              coord_dtype: np.dtype, natom: int,
                              sel_idx: Optional[np.ndarray]) -> np.ndarray:
    nfloat = 3 * natom
    nbytes = 4 * nfloat
    if mode == 'stream':
        raw = _read_exact(fp, nbytes)
    else:
        raw = _read_record_with_markers(fp, nbytes, endian_char)
    arr = np.frombuffer(raw, dtype=coord_dtype, count=nfloat)
    if arr.size != nfloat:
        raise EOFError("coordinate length mismatch")
    if not np.isfinite(arr).all():
        alt = arr.byteswap().newbyteorder()
        if not np.isfinite(alt).all():
            raise IOError("NaN/Inf in coordinates (both endianness attempts failed)")
        arr = alt
    arr = arr.reshape((natom, 3))
    if sel_idx is not None:
        arr = arr[sel_idx]
    return np.asarray(arr, dtype=np.float32)


def _skip_coords_once_from_fp(fp: io.BufferedReader, *, mode: str, endian_char: str, natom: int) -> None:
    nbytes = 4 * (3 * natom)
    if mode == 'stream':
        fp.seek(nbytes, os.SEEK_CUR)
    else:
        len1 = struct.unpack(endian_char+'i', _read_exact(fp, 4))[0]
        if len1 != nbytes:
            raise EOFError(f"coordinate record length mismatch: expected {nbytes}, got {len1}")
        fp.seek(nbytes, os.SEEK_CUR)
        len2 = struct.unpack(endian_char+'i', _read_exact(fp, 4))[0]
        if len2 != nbytes:
            raise EOFError(f"coordinate record trailing length mismatch: expected {nbytes}, got {len2}")


_DISTIL_FRAME_BLOCK_SIZE = 2048


def _estimate_frame_store_bytes(total_frames: int, nsel: int) -> int:
    return int(total_frames) * int(nsel) * 3 * np.dtype(np.float32).itemsize


def _read_text_int(path: str) -> int | None:
    try:
        s = Path(path).read_text(encoding='utf-8', errors='ignore').strip()
    except Exception:
        return None
    if not s or s.lower() == 'max':
        return None
    try:
        v = int(s)
    except Exception:
        return None
    return v if v > 0 else None


def _process_rss_bytes() -> int | None:
    try:
        import psutil  # type: ignore
        rss = int(psutil.Process(os.getpid()).memory_info().rss)
        if rss > 0:
            return rss
    except Exception:
        pass
    return None


def _available_ram_bytes() -> int | None:
    try:
        import psutil  # type: ignore
        avail = int(psutil.virtual_memory().available)
        if avail > 0:
            return avail
    except Exception:
        pass
    try:
        page = int(os.sysconf('SC_PAGE_SIZE'))
        avail_pages = int(os.sysconf('SC_AVPHYS_PAGES'))
        avail = page * avail_pages
        if avail > 0:
            return avail
    except Exception:
        pass
    return None


def _cgroup_memory_limit_bytes() -> int | None:
    candidates = [
        '/sys/fs/cgroup/memory.max',
        '/sys/fs/cgroup/memory/memory.limit_in_bytes',
    ]
    limits = []
    for path in candidates:
        v = _read_text_int(path)
        if v is not None and v > 0:
            limits.append(int(v))
    if not limits:
        return None
    huge = 1 << 60
    limits = [v for v in limits if v < huge]
    if not limits:
        return None
    return int(min(limits))


def _slurm_memory_limit_bytes() -> int | None:
    vals = []
    mem_node = os.environ.get('SLURM_MEM_PER_NODE')
    if mem_node:
        try:
            m = int(mem_node)
            if m > 0:
                vals.append(m * 1024 * 1024)
        except Exception:
            pass
    mem_cpu = os.environ.get('SLURM_MEM_PER_CPU')
    if mem_cpu:
        try:
            m = int(mem_cpu)
            cpus = int(os.environ.get('SLURM_CPUS_PER_TASK') or os.environ.get('SLURM_JOB_CPUS_PER_NODE') or '1')
            if m > 0 and cpus > 0:
                vals.append(m * cpus * 1024 * 1024)
        except Exception:
            pass
    if not vals:
        return None
    return int(min(vals))


def _effective_available_ram_bytes() -> tuple[int | None, dict[str, int | None]]:
    sys_avail = _available_ram_bytes()
    rss = _process_rss_bytes()
    cg_limit = _cgroup_memory_limit_bytes()
    slurm_limit = _slurm_memory_limit_bytes()
    limits = [v for v in (cg_limit, slurm_limit) if v is not None and v > 0]
    cap = min(limits) if limits else None
    within_cap = None
    if cap is not None and rss is not None:
        within_cap = max(int(cap - rss), 0)
    candidates = [v for v in (sys_avail, within_cap) if v is not None and v > 0]
    eff = min(candidates) if candidates else (within_cap if within_cap is not None else sys_avail)
    meta = {
        'system_available': sys_avail,
        'process_rss': rss,
        'cgroup_limit': cg_limit,
        'slurm_limit': slurm_limit,
        'effective_available': eff,
    }
    return eff, meta


def _format_bytes(n: int | None) -> str:
    if n is None:
        return 'unknown'
    x = float(n)
    units = ['B','KiB','MiB','GiB','TiB','PiB']
    for u in units:
        if abs(x) < 1024.0 or u == units[-1]:
            return f"{x:.1f} {u}" if u != 'B' else f"{int(x)} B"
        x /= 1024.0
    return f"{n} B"


_FRAME_STORE_RAM_META: dict[int, tuple[int, str]] = {}


def _frame_store_reserved_ram_bytes() -> int:
    total = 0
    for v, _tag in _FRAME_STORE_RAM_META.values():
        try:
            total += int(v)
        except Exception:
            pass
    return int(total)


def _register_frame_store_ram(arr: np.ndarray, req: int, tag: str) -> None:
    try:
        _FRAME_STORE_RAM_META[id(arr)] = (int(req), str(tag))
    except Exception:
        pass


def _release_large_array(arr: Any, *, label: Optional[str] = None, do_gc: bool = True) -> None:
    try:
        meta = _FRAME_STORE_RAM_META.pop(id(arr), None)
        if meta is not None:
            req, tag = meta
            _info(f"Released RAM-backed frame store for {label or tag} (reserved={_format_bytes(req)})")
    except Exception:
        pass
    try:
        if isinstance(arr, np.memmap):
            arr.flush()
    except Exception:
        pass
    try:
        del arr
    except Exception:
        pass
    if do_gc:
        try:
            gc.collect()
        except Exception:
            pass


def _frame_store_decision(total_frames: int, nsel: int, *, tag: str = 'frame_store', additional_copy: bool = False) -> tuple[bool, int, int | None, int, dict[str, int | None]]:
    req = _estimate_frame_store_bytes(total_frames, nsel)
    avail_eff, mem_meta = _effective_available_ram_bytes()
    if avail_eff is None:
        avail_eff = 8 * (1024 ** 3)
    reserve_floor = 2 * (1024 ** 3) if additional_copy else 1 * (1024 ** 3)
    reserve_frac = 0.35 if additional_copy else 0.20
    reserve = max(int(req * reserve_frac), reserve_floor, 512 * (1024 ** 2))

    mem_meta = dict(mem_meta)
    reserved_frame_store_ram = _frame_store_reserved_ram_bytes()
    rss = mem_meta.get('process_rss')
    cg_limit = mem_meta.get('cgroup_limit')
    slurm_limit = mem_meta.get('slurm_limit')
    cap_limit = min([v for v in (cg_limit, slurm_limit) if v is not None and v > 0], default=None)

    # Prefer real process RSS when available. If it is unavailable, fall back to the
    # RAM-backed frame-store reservations that this process itself created. This avoids
    # the previous bug where we logged reserved_frame_store_ram but did not actually use
    # it in the RAM/DISK decision, which could overcommit memory for aligned copies.
    baseline_used = int(rss) if rss is not None and rss > 0 else int(reserved_frame_store_ram)

    headrooms = []
    if avail_eff is not None and avail_eff > 0:
        headrooms.append(int(avail_eff))
    if cap_limit is not None and cap_limit > 0:
        headrooms.append(max(int(cap_limit - baseline_used), 0))
    if headrooms:
        headroom = min(headrooms)
    else:
        headroom = 8 * (1024 ** 3)

    peak_need = int(req + reserve)
    safe = max(int(headroom - reserve), 512 * (1024 ** 2))
    use_disk = peak_need > headroom

    mem_meta.update({
        'reserve_for_future': int(reserve),
        'additional_copy': int(bool(additional_copy)),
        'reserved_frame_store_ram': int(reserved_frame_store_ram),
        'baseline_used_for_limit': int(baseline_used),
        'cap_limit': int(cap_limit) if cap_limit is not None else None,
        'decision_headroom': int(headroom),
        'peak_need_if_ram': int(peak_need),
    })
    return bool(use_disk), int(req), int(avail_eff), int(safe), mem_meta


def _emit_storage_log(use_disk: bool, req: int, avail: int | None, safe: int, path: Optional[Path], *, meta: Optional[dict[str, int | None]] = None, tag: Optional[str] = None) -> None:
    extra = ''
    if meta:
        extra = (
            f", system_available={_format_bytes(meta.get('system_available'))}"
            f", process_rss={_format_bytes(meta.get('process_rss'))}"
            f", cgroup_limit={_format_bytes(meta.get('cgroup_limit'))}"
            f", slurm_limit={_format_bytes(meta.get('slurm_limit'))}"
            f", reserve_for_future={_format_bytes(meta.get('reserve_for_future'))}"
            f", reserved_frame_store_ram={_format_bytes(meta.get('reserved_frame_store_ram'))}"
            f", baseline_used_for_limit={_format_bytes(meta.get('baseline_used_for_limit'))}"
            f", cap_limit={_format_bytes(meta.get('cap_limit'))}"
            f", decision_headroom={_format_bytes(meta.get('decision_headroom'))}"
            f", peak_need_if_ram={_format_bytes(meta.get('peak_need_if_ram'))}"
        )
    prefix = 'Frame storage mode' if not tag else f'Frame storage mode [{tag}]'
    if use_disk:
        _info(f"{prefix}: DISK-backed (estimated={_format_bytes(req)}, ram_available={_format_bytes(avail)}, ram_safe_threshold={_format_bytes(safe)}{extra})")
        if path is not None:
            _info(f"Frame cache path: {path}")
    else:
        _info(f"{prefix}: RAM (estimated={_format_bytes(req)}, ram_available={_format_bytes(avail)}, ram_safe_threshold={_format_bytes(safe)}{extra})")


def _frame_cache_dir(cache_base: Optional[Path]) -> Path:
    if cache_base is None:
        d = Path(tempfile.gettempdir()) / 'distil_frame_cache'
    else:
        d = Path(cache_base).expanduser().resolve() / 'distil_cache' / 'frame_store'
    d.mkdir(parents=True, exist_ok=True)
    return d


def _allocate_frame_store(total_frames: int, nsel: int, *, cache_base: Optional[Path], tag: str, additional_copy: bool = False) -> tuple[np.ndarray, bool, Optional[Path]]:
    use_disk, req, avail, safe, mem_meta = _frame_store_decision(total_frames, nsel, tag=tag, additional_copy=additional_copy)
    if use_disk:
        d = _frame_cache_dir(cache_base)
        fname = f"{tag}_{os.getpid()}_{int(time.time()*1000)}.npy"
        path = d / fname
        free = None
        try:
            free = int(shutil.disk_usage(d).free)
        except Exception:
            free = None
        if free is not None and req > free:
            raise MemoryError(f"Estimated frame store size {_format_bytes(req)} exceeds free disk space {_format_bytes(free)} at {d}")
        arr = open_memmap(path, mode='w+', dtype=np.float32, shape=(int(total_frames), int(nsel), 3))
        _emit_storage_log(True, req, avail, safe, path, meta=mem_meta, tag=tag)
        return arr, True, path
    arr = np.empty((int(total_frames), int(nsel), 3), dtype=np.float32)
    _register_frame_store_ram(arr, req, tag)
    _emit_storage_log(False, req, avail, safe, None, meta=mem_meta, tag=tag)
    return arr, False, None


def _count_cod_frames(cod_path: Path, natom: int) -> int:
    mode, e, endian_str, coord_dtype = _cod_reader_params(cod_path, natom)
    count = 0
    with cod_path.open('rb') as fp:
        while True:
            pos = fp.tell()
            try:
                _ = (_read_header_stream(fp, endian_str) if mode == 'stream' else _read_header_marked(fp, endian_str))
                _skip_coords_once_from_fp(fp, mode=mode, endian_char=e, natom=natom)
                count += 1
            except EOFError:
                break
            except Exception:
                fp.seek(pos)
                break
    if count <= 0:
        raise IOError(f"No frames read from {cod_path} (mode={mode}, endian={endian_str})")
    return int(count)


def _iter_cod_frame_records(cod_path: Path, natom: int, *, sel_idx: Optional[np.ndarray]=None):
    mode, e, endian_str, coord_dtype = _cod_reader_params(cod_path, natom)
    with cod_path.open('rb') as fp:
        frame_no = 0
        while True:
            pos = fp.tell()
            try:
                h = (_read_header_stream(fp, endian_str) if mode == 'stream' else _read_header_marked(fp, endian_str))
                frame_no += 1
                coords = _read_coords_once_from_fp(fp, mode=mode, endian_char=e, coord_dtype=coord_dtype, natom=natom, sel_idx=sel_idx)
                yield frame_no, coords, h
            except EOFError:
                break
            except Exception:
                fp.seek(pos)
                break



def _iter_cod_header_records(cod_path: Path, natom: int):
    """Yield (frame_no, header) while skipping coordinates without materializing them."""
    mode, e, endian_str, _coord_dtype = _cod_reader_params(cod_path, natom)
    with cod_path.open('rb') as fp:
        frame_no = 0
        while True:
            pos = fp.tell()
            try:
                h = (_read_header_stream(fp, endian_str) if mode == 'stream' else _read_header_marked(fp, endian_str))
                frame_no += 1
                _skip_coords_once_from_fp(fp, mode=mode, endian_char=e, natom=natom)
                yield frame_no, h
            except EOFError:
                break
            except Exception:
                fp.seek(pos)
                break


def _slice_headers_by_stride_from_cod(cod_path: Path, natom: int, *, ist: int, ien: int, frame_stride: int = 0) -> list[dict]:
    """Read headers for a 1-based inclusive range, applying frame_stride, without reading coordinates."""
    stride = int(frame_stride or 0)
    out: list[dict] = []
    local_pos = 0
    for frame_no, h in _iter_cod_header_records(Path(cod_path), natom):
        if frame_no < int(ist):
            continue
        if frame_no > int(ien):
            break
        if stride <= 0 or (local_pos % stride) == 0:
            out.append(h)
        local_pos += 1
    return out


def load_ensemble_headers_only(inp: Path, natom: int, *, frame_stride: int = 0) -> tuple[list[dict], list[tuple[Path, int, tuple[int, int]]]]:
    """Load only frame headers, preserving the same post-stride frame order as load_ensemble_with_headers."""
    inp = Path(inp).resolve()
    stride = int(frame_stride or 0)
    if stride < 0:
        raise ValueError(f"frame_stride must be >=0, got {stride}")
    all_headers: list[dict] = []
    per_counts: list[tuple[Path, int, tuple[int, int]]] = []
    if inp.suffix.lower() in ('.list', '.txt'):
        items = _parse_list(inp)
        groups: dict[Path, list[tuple[int, str]]] = defaultdict(list)
        for it in items:
            groups[it.path].append((it.ist, it.ien_raw))
        # Use sel_idx=None because range resolution depends only on trajectory length.
        resolved_groups, _total_frames_raw = _resolve_list_items_for_loaded_groups(groups, natom=natom, sel_idx=None)
        for path_i, ranges in resolved_groups.items():
            for ist, ien, _n_raw, _tok in ranges:
                hpart = _slice_headers_by_stride_from_cod(path_i, natom, ist=int(ist), ien=int(ien), frame_stride=stride)
                all_headers.extend(hpart)
                per_counts.append((path_i, int(len(hpart)), (int(ist), int(ien))))
    else:
        total_raw = _count_cod_frames(inp, natom)
        hpart = _slice_headers_by_stride_from_cod(inp, natom, ist=1, ien=int(total_raw), frame_stride=stride)
        all_headers.extend(hpart)
        per_counts.append((inp, int(len(hpart)), (1, int(total_raw))))
    if not all_headers:
        raise ValueError(f"No headers selected by {inp}")
    return all_headers, per_counts


def _normalise_raw_weights_for_mask(w: np.ndarray, *, label: str) -> tuple[np.ndarray, np.ndarray]:
    """Return raw-length normalized weights and a positive-weight frame mask."""
    ww = np.asarray(np.where(np.asarray(w, dtype=np.float64) > 0.0, w, 0.0), dtype=np.float64)
    s = float(np.sum(ww))
    if s <= 0.0:
        raise ValueError(f"Non-positive raw weight sum for {label}: {s}")
    norm = (ww / s).astype(np.float64, copy=False)
    return norm, np.asarray(norm > 0.0, dtype=bool)


def _weights_and_keep_mask_from_prob_headers(inp: Path, natom: int, prob_path: Optional[Path], *, frame_stride: int = 0, label: str = '') -> tuple[np.ndarray | None, np.ndarray | None, list[dict] | None]:
    """Build raw-length weights/positive mask from headers only; returns (weights, mask, headers)."""
    if prob_path is None:
        return None, None, None
    headers, _counts = load_ensemble_headers_only(Path(inp), natom, frame_stride=frame_stride)
    prob = read_prob_file(Path(prob_path).resolve())
    w = assign_weights_from_prob(headers, prob)
    w_norm, mask = _normalise_raw_weights_for_mask(w, label=label or str(inp))
    return w_norm, mask, headers


def _mask_digest(mask: np.ndarray | None) -> str:
    if mask is None:
        return 'none'
    m = np.asarray(mask, dtype=bool)
    h = hashlib.sha256()
    h.update(np.asarray([m.size], dtype=np.int64).tobytes())
    h.update(np.packbits(m).tobytes())
    return h.hexdigest()[:16]

def read_cod_frames(cod_path: Path, natom: int, *, sel_idx: Optional[np.ndarray]=None) -> tuple[np.ndarray, list[dict], dict]:
    """CODファイルの全フレームを読み、(frames, headers, meta) を返す。
    frames: (F, N, 3) float32
    """
    mode, e, endian_str, coord_dtype = _cod_reader_params(cod_path, natom)
    frames = []
    headers = []
    for _frame_no, coords, h in _iter_cod_frame_records(cod_path, natom, sel_idx=sel_idx):
        headers.append(h)
        frames.append(coords)
    if not frames:
        raise IOError(f"No frames read from {cod_path} (mode={mode}, endian={endian_str})")
    arr = np.stack(frames, axis=0).astype('float32', copy=False)
    return arr, headers, {'mode': mode, 'endian': endian_str}
@dataclass(frozen=True)
class ListItem:
    path: Path
    ist: int
    ien_raw: str
    continue_to_next: bool = False
    run_id: int = 0


@dataclass(frozen=True)
class RunGroup:
    run_id: int
    items: tuple[ListItem, ...]


def _normalize_selection_mode(value: object) -> str:
    """Normalize feature-selection mode names.

    Public short names are used internally.  The long prototype name is
    retained only as an input alias so older command lines fail less often.
    """
    mode = str(value or 'standard').strip().lower().replace('_', '-')
    if mode in ('standard', 'std'):
        return 'standard'
    if mode in ('sig', 'run-bin-significance', 'run-bin-sig', 'runbinsig'):
        return 'sig'
    if mode in ('ced', 'condition-excess-difference', 'condition-excess', 'condition', 'excess'):
        return 'ced'
    raise ValueError(f"invalid selection_mode={value!r}; expected 'standard', 'sig', or 'ced'")


