def _load_feature_matrix_shapes(paths: FeatureArtifactPaths) -> tuple[int, int, int, str]:
    """Return (nA, nB, nF, mode) from metadata-only feature artifacts."""
    if paths.top_pairs_csv.exists() and paths.pair_index.exists():
        nF = int(_count_csv_data_rows(paths.top_pairs_csv))
        nA = nB = None
        wA_path = paths.features_meta.parent / 'weights_A.npy'
        wB_path = paths.features_meta.parent / 'weights_B.npy'
        if wA_path.exists() and wB_path.exists():
            try:
                nA = int(np.load(wA_path, mmap_mode='r').shape[0])
                nB = int(np.load(wB_path, mmap_mode='r').shape[0])
            except Exception:
                nA = nB = None
        if (nA is None or nB is None) and paths.features_meta.exists():
            try:
                fm = _load_json(paths.features_meta)
                nA = int(fm.get('nA')) if fm.get('nA') is not None else nA
                nB = int(fm.get('nB')) if fm.get('nB') is not None else nB
            except Exception:
                pass
        if nA is None or nB is None:
            raise SystemExit('[DISTIL] Metadata-only feature state found, but frame counts are unavailable. Missing weights_A.npy/weights_B.npy or nA/nB in features_meta.json.')
        return int(nA), int(nB), int(nF), 'meta-only'
    raise SystemExit('[DISTIL] Missing feature artifacts. Expected metadata-only pair files. Run feature generation first.')

def _kind_code(s: str) -> int:
    s = (s or '').strip().lower()
    if s == 'near':
        return 0
    if s == 'long':
        return 1
    return 2

def _agroup_code(s: str) -> int:
    s = (s or '').strip().lower()
    if s in ('bb', 'backbone'):
        return 1
    if s in ('sc', 'sidechain'):
        return 2
    if s:
        return 3
    return 0

def _agroup_label(code: int) -> str:
    return {1:'bb', 2:'sc', 3:'other'}.get(int(code), 'unk')

def _load_top_pairs_meta(top_pairs_csv: Path) -> TopPairsMeta:
    """Parse top_pairs_pool.csv into TopPairsMeta (memory-lean).

    Backward compatible:
      - columns: feature,kind,i,j
      - extended columns (near): ai,aj,aname_i,aname_j,agroup_i,agroup_j,res_i,res_j
        * i/j remain residue indices for residue index placeholders by default.

    Notes:
      - atom name strings are NOT loaded to keep memory use small at O(10^6) features.
      - sub-residue granularity for near is preserved via agroup (bb/sc) + residue index.
    """
    # Read header
    with open(top_pairs_csv, 'r') as f:
        header = f.readline().strip().split(',')
        idx = {name: k for k, name in enumerate(header)}
        # Preallocate with list append then convert (more memory-friendly than dicts per row)
        kind_l=[]; i_l=[]; j_l=[]
        resi_l=[]; resj_l=[]
        agi_l=[]; agj_l=[]
        ai_l=[]; aj_l=[]
        eg_l=[]
        for line in f:
            if not line.strip():
                continue
            toks = line.rstrip('\n').split(',')
            kind_l.append(_kind_code(toks[idx.get('kind', 0)] if 'kind' in idx else toks[0]))
            # i/j for index-related
            i_l.append(int(toks[idx.get('i', 1)] if 'i' in idx else toks[1]))
            j_l.append(int(toks[idx.get('j', 2)] if 'j' in idx else toks[2]))
            # optional atom indices for near (kept for atom-level modules)
            if 'ai' in idx and idx['ai'] < len(toks) and toks[idx['ai']]!='':
                ai_l.append(int(toks[idx['ai']]))
            else:
                ai_l.append(-1)
            if 'aj' in idx and idx['aj'] < len(toks) and toks[idx['aj']]!='':
                aj_l.append(int(toks[idx['aj']]))
            else:
                aj_l.append(-1)
            # optional residue mapping for near
            if 'res_i' in idx and idx['res_i'] < len(toks) and toks[idx['res_i']]!='':
                resi_l.append(int(toks[idx['res_i']]))
            else:
                resi_l.append(-1)
            if 'res_j' in idx and idx['res_j'] < len(toks) and toks[idx['res_j']]!='':
                resj_l.append(int(toks[idx['res_j']]))
            else:
                resj_l.append(-1)
            # optional equivalent-atom group id
            if 'equiv_group_id' in idx and idx['equiv_group_id'] < len(toks) and toks[idx['equiv_group_id']]!='':
                try:
                    eg_l.append(int(toks[idx['equiv_group_id']]))
                except Exception:
                    eg_l.append(-1)
            else:
                eg_l.append(-1)

            # atom group
            if 'agroup_i' in idx and idx['agroup_i'] < len(toks):
                agi_l.append(_agroup_code(toks[idx['agroup_i']]))
            else:
                agi_l.append(0)
            if 'agroup_j' in idx and idx['agroup_j'] < len(toks):
                agj_l.append(_agroup_code(toks[idx['agroup_j']]))
            else:
                agj_l.append(0)

    kind = np.asarray(kind_l, dtype=np.uint8)
    i = np.asarray(i_l, dtype=np.int32)
    j = np.asarray(j_l, dtype=np.int32)
    res_i = np.asarray(resi_l, dtype=np.int32)
    res_j = np.asarray(resj_l, dtype=np.int32)
    agroup_i = np.asarray(agi_l, dtype=np.uint8)
    agroup_j = np.asarray(agj_l, dtype=np.uint8)
    atom_i = np.asarray(ai_l, dtype=np.int32)
    atom_j = np.asarray(aj_l, dtype=np.int32)
    equiv_group_id = np.asarray(eg_l, dtype=np.int32) if eg_l else np.full((kind.shape[0],), -1, dtype=np.int32)
    return TopPairsMeta(kind=kind, i=i, j=j, res_i=res_i, res_j=res_j, agroup_i=agroup_i, agroup_j=agroup_j, atom_i=atom_i, atom_j=atom_j, equiv_group_id=equiv_group_id)

def _meta_kind_str(meta: TopPairsMeta, idx: int) -> str:
    return 'near' if int(meta.kind[idx])==0 else 'long' if int(meta.kind[idx])==1 else '?'

def _meta_res(meta: TopPairsMeta, idx: int, side: str) -> int:
    if side == 'i':
        return int(meta.res_i[idx]) if int(meta.res_i[idx]) >= 0 else int(meta.i[idx])
    return int(meta.res_j[idx]) if int(meta.res_j[idx]) >= 0 else int(meta.j[idx])


def _meta_idstr(meta: TopPairsMeta, idx: int) -> str:
    """Return the human-readable pair id string used in CSVs.

    near : "atom_i-atom_j" when available, else "f<feature_index>"
    long : "res_i-res_j" (prefers res_i/res_j when present)
    """
    k = int(meta.kind[idx])
    if k == 0:
        ai = int(meta.atom_i[idx]) if hasattr(meta, 'atom_i') else -1
        aj = int(meta.atom_j[idx]) if hasattr(meta, 'atom_j') else -1
        return f"{ai}-{aj}" if (ai >= 0 and aj >= 0) else f"f{idx}"
    if k == 1:
        ri = int(_meta_res(meta, idx, 'i'))
        rj = int(_meta_res(meta, idx, 'j'))
        return f"{ri}-{rj}"
    return f"f{idx}"
