def _equiv_mode(args) -> str:
    v = str(getattr(args, 'equiv_atoms', 'aggregate') or 'aggregate').strip().lower()
    if v not in ('aggregate', 'report'):
        raise ValueError(f"invalid --equiv-atoms/-ea value {v!r}; expected aggregate or report")
    return v


def _tpl_sections_for_equiv(tpl_path: Path) -> list[tuple[str, list[str]]]:
    """Return normalized J_PRESTO TPL sections.

    This reader intentionally follows j_presto's line-continuation rule: records
    ending before ``->`` are accumulated until a line without ``->`` appears.
    It is used only for equivalent-atom metadata; covalent filtering continues to
    use _parse_jpresto_tpl_atoms_bonds().
    """
    raw = Path(tpl_path).read_text(encoding='utf-8', errors='ignore').splitlines()
    def strip_comment(x: str) -> str:
        # j_presto ignores the part after ';' for keyword parsing.
        return x.split(';', 1)[0].rstrip()
    def norm(name: str) -> str:
        u = str(name).strip().upper()
        return {
            'MOLE': 'MOLECULES', 'MOLECULE': 'MOLECULES', 'MOLECULES': 'MOLECULES',
            'ATOM': 'ATOMS', 'ATOMS': 'ATOMS',
            'BOND': 'BONDS', 'BONDS': 'BONDS',
            'ANGL': 'ANGLES', 'ANGLE': 'ANGLES', 'ANGLES': 'ANGLES',
            'TORS': 'TORSIONS', 'TORSION': 'TORSIONS', 'TORSIONS': 'TORSIONS',
            'IMPR': 'IMPROPER-TORSIONS', 'IMPROPER': 'IMPROPER-TORSIONS', 'IMPROPER-TORSIONS': 'IMPROPER-TORSIONS',
            'FUNC': 'FUNCTIONS', 'FUNCTION': 'FUNCTIONS', 'FUNCTIONS': 'FUNCTIONS',
            'NONB': 'NONBONDS', 'NONBOND': 'NONBONDS', 'NONBONDS': 'NONBONDS',
            'LINK': 'LINK', 'TITL': 'TITLE', 'TITLE': 'TITLE',
        }.get(u, u)
    sections: list[tuple[str, list[str]]] = []
    cur = None
    cur_lines: list[str] = []
    buf = ''
    for line in raw:
        s0 = line.strip()
        m = re.match(r'^TPL>\s*(\S+)', s0, flags=re.IGNORECASE)
        if m:
            if cur is not None:
                if buf.strip():
                    cur_lines.append(buf)
                    buf = ''
                sections.append((norm(cur), cur_lines))
            cur = m.group(1)
            cur_lines = []
            buf = ''
            continue
        if cur is None:
            continue
        sc = strip_comment(line).strip()
        if not sc:
            continue
        # For equivalence detection we keep ATOM primary records and the
        # following numeric inner-coordinate (Z-matrix-like) records as separate
        # logical records.  The parser below attaches each numeric record to the
        # immediately preceding atom instead of treating it as another atom.
        if '->' in sc:
            rec = sc.split('->', 1)[0].strip()
            if rec:
                cur_lines.append(rec)
            buf = ''
            continue
        else:
            rec = (buf + ' ' + sc).strip() if buf else sc
            buf = ''
            if rec:
                cur_lines.append(rec)
    if cur is not None:
        if buf.strip():
            cur_lines.append(buf)
        sections.append((norm(cur), cur_lines))
    return sections


def _is_int_token(tok: str) -> bool:
    return bool(re.fullmatch(r'[+-]?\d+', str(tok)))


def _safe_float_token(tok: str, default: float = float('nan')) -> float:
    try:
        return float(tok.replace('D', 'E').replace('d', 'e'))
    except Exception:
        return default


def _parse_jpresto_tpl_equiv_data(tpl_path: Path) -> dict:
    """Parse J_PRESTO TPL atom properties, nonbond parameters, and bonds.

    Format basis checked against j_presto src_md_run/inptpl.f90 and
    src_md_run/outtpl.f:

      ATOMS record is read by rdatom() as
        atom_name atom_type type_id resname resid mass vdw_radius charge ...
      where atom_type is the J_PRESTO atom species/type name and type_id is the
      nonbonded type number.  The following numeric inner-coordinate record is
      not an atom record; it is attached to the preceding atom as Z-matrix-like
      stereo/local-geometry metadata.

      BONDS record is read by rdbond() as
        local_i local_j force_const r0 ; idx
      and local_i/local_j are local atom ids within the molecule species.

      NONBONDS records provide type-based vdw parameters.  For AMBER/OPLS-like
      function-1 records the first two real parameters correspond to radius and
      energy-minimum in j_presto's rdnoam()/rdnoop() path.  We do not use these
      to infer elements; they are only additional equality labels for equivalent
      atom detection.
    """
    sections = _tpl_sections_for_equiv(Path(tpl_path))
    molecule_order: list[tuple[str, int]] = []
    atoms_by_mol: dict[str, list[dict[str, object]]] = defaultdict(list)
    bonds_by_mol: dict[str, list[tuple[int, int]]] = defaultdict(list)
    bond_params_by_mol: dict[str, list[tuple[int, int, tuple[float, ...]]]] = defaultdict(list)
    angles_by_mol: dict[str, list[tuple[int, int, int, tuple[float, ...]]]] = defaultdict(list)
    torsions_by_mol: dict[str, list[tuple[int, int, int, int, tuple[float, ...]]]] = defaultdict(list)
    impropers_by_mol: dict[str, list[tuple[int, int, int, int, tuple[float, ...]]]] = defaultdict(list)
    link_bonds: list[tuple[int, int]] = []
    nonbond_by_type: dict[int, tuple[float, ...]] = {}
    for sec, lines in sections:
        if sec == 'MOLECULES':
            for rec in lines:
                parts = re.split(r'\s+', rec.strip())
                if len(parts) >= 2 and _is_int_token(parts[-1]):
                    name = ' '.join(parts[:-1]).strip()
                    if name:
                        molecule_order.append((name, int(parts[-1])))
        elif sec == 'ATOMS':
            mol_name = None
            last_atom = None
            for rec in lines:
                parts = re.split(r'\s+', rec.strip())
                if not parts:
                    continue
                # Molecule header lines can appear multiple times inside a
                # single TPL> ATOMS section, one block per molecule species.
                # They are usually a single non-numeric token/string.  Do not
                # treat later molecule headers as malformed atom records.
                if (not _is_int_token(parts[0])) and len(parts) < 8:
                    mol_name = rec.strip()
                    last_atom = None
                    continue
                if mol_name is None:
                    continue
                # Numeric records immediately following an atom line are the
                # J_PRESTO internal-coordinate (Z-matrix-like) record:
                #   4 integer reference offsets + 3 real internal coordinates.
                # outtpl.f writes IXINCD(j)-IATM, so convert offsets to local ids.
                if _is_int_token(parts[0]) and last_atom is not None and len(parts) >= 7:
                    cur_local = int(last_atom.get('local_index', 0))
                    rel = [int(parts[k]) if _is_int_token(parts[k]) else 0 for k in range(4)]
                    refs = []
                    for r in rel:
                        ref = cur_local + int(r)
                        refs.append(int(ref) if ref > 0 else 0)
                    vals = [_safe_float_token(parts[k]) for k in range(4, 7)]
                    last_atom['z_rel'] = tuple(rel)
                    last_atom['z_refs'] = tuple(refs)
                    last_atom['z_values'] = tuple(float(v) for v in vals)
                    continue
                # ATOM records begin with atom name and contain at least 8 fields.
                if _is_int_token(parts[0]) or parts[0].startswith('<') or len(parts) < 8:
                    continue
                name, atype = parts[0], parts[1]
                type_id = int(parts[2]) if _is_int_token(parts[2]) else -1
                resname = parts[3]
                resid = int(parts[4]) if _is_int_token(parts[4]) else 0
                mass = _safe_float_token(parts[5])
                vdw = _safe_float_token(parts[6])
                charge = _safe_float_token(parts[7])
                last_atom = {
                    'local_index': len(atoms_by_mol[mol_name]) + 1,
                    'name': name.strip(), 'atom_type': atype.strip(), 'type_id': int(type_id),
                    'resname': resname.strip(), 'resid': int(resid),
                    'mass': float(mass), 'vdw_radius': float(vdw), 'charge': float(charge),
                    'nonbond_params': (), 'vdw_epsilon': float('nan'),
                    'z_rel': (0,0,0,0), 'z_refs': (0,0,0,0), 'z_values': (float('nan'),float('nan'),float('nan')),
                }
                atoms_by_mol[mol_name].append(last_atom)
        elif sec == 'BONDS':
            mol_name = None
            for rec in lines:
                parts = re.split(r'\s+', rec.strip())
                if not parts:
                    continue
                if not _is_int_token(parts[0]):
                    mol_name = rec.strip()
                    continue
                if mol_name is None:
                    continue
                if len(parts) >= 2 and _is_int_token(parts[0]) and _is_int_token(parts[1]):
                    i, j = int(parts[0]), int(parts[1])
                    if i > 0 and j > 0 and i != j:
                        bonds_by_mol[mol_name].append((i, j))
                        vals = tuple(_safe_float_token(x) for x in parts[2:4]) if len(parts) >= 4 else ()
                        bond_params_by_mol[mol_name].append((i, j, vals))
        elif sec == 'ANGLES':
            mol_name = None
            for rec in lines:
                parts = re.split(r'\s+', rec.strip())
                if not parts:
                    continue
                if not _is_int_token(parts[0]):
                    mol_name = rec.strip()
                    continue
                if mol_name is None:
                    continue
                if len(parts) >= 5 and all(_is_int_token(parts[k]) for k in range(3)):
                    vals = tuple(_safe_float_token(x) for x in parts[3:5])
                    angles_by_mol[mol_name].append((int(parts[0]), int(parts[1]), int(parts[2]), vals))
        elif sec == 'TORSIONS':
            mol_name = None
            for rec in lines:
                parts = re.split(r'\s+', rec.strip())
                if not parts:
                    continue
                if not _is_int_token(parts[0]):
                    mol_name = rec.strip()
                    continue
                if mol_name is None:
                    continue
                if len(parts) >= 8 and all(_is_int_token(parts[k]) for k in range(4)):
                    vals = tuple(_safe_float_token(x) for x in parts[4:9])
                    torsions_by_mol[mol_name].append((int(parts[0]), int(parts[1]), int(parts[2]), int(parts[3]), vals))
        elif sec == 'IMPROPER-TORSIONS':
            mol_name = None
            for rec in lines:
                parts = re.split(r'\s+', rec.strip())
                if not parts:
                    continue
                if not _is_int_token(parts[0]):
                    mol_name = rec.strip()
                    continue
                if mol_name is None:
                    continue
                if len(parts) >= 8 and all(_is_int_token(parts[k]) for k in range(4)):
                    vals = tuple(_safe_float_token(x) for x in parts[4:9])
                    impropers_by_mol[mol_name].append((int(parts[0]), int(parts[1]), int(parts[2]), int(parts[3]), vals))
        elif sec == 'NONBONDS':
            for rec in lines:
                parts = re.split(r'\s+', rec.strip())
                # J_PRESTO rdnonb() first reads three integers: type_i, type_j,
                # function_id.  Function-1 self-type records carry the atom-type
                # vdw parameters; pair records are not assigned to a single atom.
                if len(parts) >= 7 and _is_int_token(parts[0]) and _is_int_token(parts[1]) and _is_int_token(parts[2]):
                    i1, i2, funtyp = int(parts[0]), int(parts[1]), int(parts[2])
                    vals = tuple(_safe_float_token(x) for x in parts[3:7])
                    # outtpl.f writes per-type AMBER/OPLS records as
                    #   ITYP 0 1 radius epsilon scaleE scaleV
                    # and only special pair records use two positive type ids.
                    # Older synthetic tests used i1==i2, so accept both forms.
                    if (i2 == 0 or i1 == i2) and funtyp == 1 and all(np.isfinite(v) for v in vals[:2]):
                        nonbond_by_type[i1] = vals
        elif sec == 'LINK':
            for rec in lines:
                parts = re.split(r'\s+', rec.strip())
                if len(parts) >= 3 and parts[0].upper().startswith('B') and _is_int_token(parts[1]) and _is_int_token(parts[2]):
                    i, j = int(parts[1]), int(parts[2])
                    if i > 0 and j > 0 and i != j:
                        link_bonds.append((i, j))
    # Attach type-based NONBOND parameters after all sections are parsed.
    for lst in atoms_by_mol.values():
        for a in lst:
            nb = nonbond_by_type.get(int(a.get('type_id', -1)), ())
            if nb:
                a['nonbond_params'] = tuple(float(v) for v in nb)
                a['vdw_epsilon'] = float(nb[1]) if len(nb) > 1 else float('nan')
    if not molecule_order:
        molecule_order = [(m, 1) for m in atoms_by_mol.keys()]
    atoms: list[dict[str, object]] = []
    bonds: list[tuple[int, int]] = []
    # Expanded force-field terms.  These are the invariant energy terms used
    # for equivalent-atom detection.  They are stored as global atom indices
    # after molecule/copy expansion; TPL record order and Z-matrix construction
    # order are intentionally not part of the equivalence label.
    bond_terms0: list[tuple[int, int, tuple[float, ...]]] = []
    angle_terms0: list[tuple[int, int, int, tuple[float, ...]]] = []
    torsion_terms0: list[tuple[int, int, int, int, tuple[float, ...]]] = []
    improper_terms0: list[tuple[int, int, int, int, tuple[float, ...]]] = []
    base = 0
    mol_copy_id = 0
    # Internal expanded residue serial.  This is deliberately independent of
    # TPL local resid values, which reset for each molecule template.
    _parse_jpresto_tpl_equiv_data._global_res_serial = 0
    for mol_name, ncopy in molecule_order:
        local_atoms = atoms_by_mol.get(mol_name, [])
        nat = len(local_atoms)
        for c in range(max(0, int(ncopy))):
            mol_copy_id += 1
            off = base + c * nat
            # J_PRESTO TPL stores residue ids inside each molecule template.
            # Reference PDB files generated from the same system are often
            # renumbered continuously over the expanded system, e.g. a holo
            # peptide may be resid 1--15 in TPL but 97--111 in PDB.  Therefore
            # preserve the local TPL resid and also assign an expanded, internal
            # global residue serial in the exact atom-stream order of the TPL.
            # PDB/TPL mapping must compare PDB resid primarily against this
            # tpl_global_resid, not against the local template resid.
            local_res_to_global: dict[int, int] = {}
            prev_local_res_key = None
            for la in local_atoms:
                d = dict(la)
                local_res_key = (int(la.get('resid', 0)), str(la.get('resname', '')).strip())
                if local_res_key != prev_local_res_key:
                    _parse_jpresto_tpl_equiv_data._global_res_serial += 1
                    local_res_to_global[int(la.get('resid', 0))] = int(_parse_jpresto_tpl_equiv_data._global_res_serial)
                    prev_local_res_key = local_res_key
                d['global_index0'] = off + int(la['local_index']) - 1
                d['molecule_name'] = mol_name
                d['molecule_copy'] = int(c + 1)
                d['molecule_copy_id'] = int(mol_copy_id)
                d['tpl_local_resid'] = int(la.get('resid', 0))
                d['tpl_global_resid'] = int(local_res_to_global.get(int(la.get('resid', 0)), _parse_jpresto_tpl_equiv_data._global_res_serial))
                atoms.append(d)
            for i, j in bonds_by_mol.get(mol_name, []):
                if 1 <= i <= nat and 1 <= j <= nat:
                    gi, gj = off + i - 1, off + j - 1
                    bonds.append((gi, gj))
                    # Store the actual expanded force-field term separately from
                    # per-atom incident labels.  The term set, not TPL record
                    # order, is the correct invariant for symmetry detection.
                    for bi, bj, bvals in bond_params_by_mol.get(mol_name, []):
                        if int(bi) == int(i) and int(bj) == int(j):
                            bond_terms0.append((gi, gj, tuple(_round_equiv_float(v) for v in bvals)))
                            break
            # Store compact incident bonded-term signatures on atoms.  These are
            # used as additional labels for equivalence detection so atoms are
            # not grouped merely by same first-neighbor graph.
            for i, j, vals in bond_params_by_mol.get(mol_name, []):
                if 1 <= i <= nat and 1 <= j <= nat:
                    gi, gj = off + i - 1, off + j - 1
                    atoms[gi].setdefault('bond_terms', []).append(('B', tuple(_round_equiv_float(v) for v in vals)))
                    atoms[gj].setdefault('bond_terms', []).append(('B', tuple(_round_equiv_float(v) for v in vals)))
            for i, j, k, vals in angles_by_mol.get(mol_name, []):
                if 1 <= i <= nat and 1 <= j <= nat and 1 <= k <= nat:
                    gi, gj, gk = off+i-1, off+j-1, off+k-1
                    angle_terms0.append((gi, gj, gk, tuple(_round_equiv_float(v) for v in vals)))
                    for gidx, pos in ((gi,0),(gj,1),(gk,2)):
                        atoms[gidx].setdefault('angle_terms', []).append(('A', pos, tuple(_round_equiv_float(v) for v in vals)))
            for i, j, k, l, vals in torsions_by_mol.get(mol_name, []):
                if 1 <= i <= nat and 1 <= j <= nat and 1 <= k <= nat and 1 <= l <= nat:
                    gi, gj, gk, gl = off+i-1, off+j-1, off+k-1, off+l-1
                    torsion_terms0.append((gi, gj, gk, gl, tuple(_round_equiv_float(v) for v in vals)))
                    for gidx, pos in ((gi,0),(gj,1),(gk,2),(gl,3)):
                        atoms[gidx].setdefault('torsion_terms', []).append(('T', pos, tuple(_round_equiv_float(v) for v in vals)))
            for i, j, k, l, vals in impropers_by_mol.get(mol_name, []):
                if 1 <= i <= nat and 1 <= j <= nat and 1 <= k <= nat and 1 <= l <= nat:
                    gi, gj, gk, gl = off+i-1, off+j-1, off+k-1, off+l-1
                    improper_terms0.append((gi, gj, gk, gl, tuple(_round_equiv_float(v) for v in vals)))
                    for gidx, pos in ((gi,0),(gj,1),(gk,2),(gl,3)):
                        atoms[gidx].setdefault('improper_terms', []).append(('I', pos, tuple(_round_equiv_float(v) for v in vals)))
        base += nat * max(0, int(ncopy))
    for i, j in link_bonds:
        bonds.append((i - 1, j - 1))
    seen = set(); b2=[]
    for i, j in bonds:
        if i < 0 or j < 0 or i == j:
            continue
        a, b = (i, j) if i < j else (j, i)
        if (a, b) not in seen:
            seen.add((a, b)); b2.append((a, b))
    return {
        'atoms': atoms,
        'bonds0': b2,
        'bond_terms0': bond_terms0,
        'angle_terms0': angle_terms0,
        'torsion_terms0': torsion_terms0,
        'improper_terms0': improper_terms0,
        'nonbond_by_type': nonbond_by_type,
        'parser': 'jpresto_tpl_equiv_v1_forcefield_terms_hsafe2',
    }

def _round_equiv_float(x: float, ndigits: int = 6) -> str:
    if not np.isfinite(float(x)):
        return 'nan'
    return f"{float(x):.{ndigits}f}"


def _element_for_equiv(atom_name: str, tpl_atom: dict[str, object] | None = None) -> str:
    """Return a conservative element label from the atom name only.

    J_PRESTO ``TPL> ATOMS`` already provides the atom species/type name
    (``atom_type``) and nonbonded type id.  Equivalent-atom detection therefore
    uses those explicit TPL labels directly.  This helper is only a coarse guard
    against grouping different elements and must not infer the element from mass:
    mass is a physical parameter label, not the source of atom identity.
    """
    nm = str(atom_name or '').strip()
    m = re.match(r'^[0-9]*([A-Za-z]+)', nm)
    if not m:
        return ''
    letters = m.group(1).upper()
    for two in ('CL', 'BR', 'NA', 'MG', 'CA', 'FE', 'ZN'):
        if letters.startswith(two):
            return two
    return letters[0]


def _equiv_nonbond_label(tpl_atom: dict[str, object]) -> str:
    vals = tpl_atom.get('nonbond_params', ()) if isinstance(tpl_atom, dict) else ()
    if not vals:
        return ''
    try:
        return ','.join(_round_equiv_float(float(v)) for v in vals)
    except Exception:
        return ''


def _equiv_norm_name(x: object) -> str:
    return str(x or '').strip().upper()


def _equiv_resname_compatible(pdb_resname: str, tpl_resname: str) -> bool:
    """Return True when PDB/TPL residue names are compatible enough for mapping.

    j_presto TPL files usually contain the full solvated system, while the
    DISTIL reference PDB often contains only the analysis molecule or only heavy
    atoms.  Therefore TPL-derived equivalence must map a PDB atom subsequence
    into the full TPL atom list instead of requiring identical atom counts.
    """
    a = _equiv_norm_name(pdb_resname)
    b = _equiv_norm_name(tpl_resname)
    if a == b:
        return True
    # Common histidine/protonation aliases.  Keep this list deliberately small.
    his = {'HIS', 'HID', 'HIE', 'HIP', 'HSD', 'HSE', 'HSP'}
    if a in his and b in his:
        return True
    return False


def _equiv_try_map_pdb_atoms_to_tpl(tatoms: Sequence[dict[str, object]], atoms_pdb: Sequence[AtomRec], *, verbose: bool = True, tpl_name: str = '') -> list[int] | None:
    """Map reference-PDB atoms to atoms in a full j_presto TPL.

    The TPL often contains the full solvated system, while the DISTIL reference
    PDB may contain only the analysis molecule, may omit hydrogens, and in an
    apo/holo comparison may contain a ligand or peptide whose order differs from
    the TPL molecule order.  Therefore this routine does *not* require identical
    atom counts.  It first tries a strict ordered-subsequence map, then falls
    back to a residue-block map that matches PDB residue blocks to TPL residue
    blocks by residue name, residue id, and atom names.

    If both maps fail, callers must stop rather than silently accepting an
    unsafe name-only equivalence map when a TPL was explicitly provided.
    """
    _equiv_try_map_pdb_atoms_to_tpl.last_method = 'not_attempted'
    _equiv_try_map_pdb_atoms_to_tpl.last_failure = ''
    if atoms_pdb is None:
        _equiv_try_map_pdb_atoms_to_tpl.last_method = 'none'
        return None
    if len(atoms_pdb) == 0:
        _equiv_try_map_pdb_atoms_to_tpl.last_method = 'empty'
        return []

    # ------------------------------------------------------------------
    # Pass 1: original strict ordered-subsequence mapping.  This is the
    # safest and fastest route when ref.pdb is literally an ordered subset of
    # the full TPL atom stream.
    # ------------------------------------------------------------------
    out: list[int] = []
    pos = 0
    n = len(tatoms)
    fail_msg = ''
    ordered_ok = True
    for ap in atoms_pdb:
        an = _equiv_norm_name(ap.name)
        rn = _equiv_norm_name(ap.resname)
        rid = int(ap.resid)
        found = -1
        for k in range(pos, n):
            ta = tatoms[k]
            if _equiv_norm_name(ta.get('name', '')) != an:
                continue
            if not _equiv_resname_compatible(rn, str(ta.get('resname', ''))):
                continue
            try:
                trid = int(ta.get('tpl_global_resid', ta.get('resid', 0)))
            except Exception:
                trid = 0
            if rid and trid and rid != trid:
                continue
            found = k
            break
        if found < 0:
            ordered_ok = False
            fail_msg = f"ordered-subsequence failed at PDB atom {ap.idx1}:{ap.resname}{ap.resid}:{ap.name} after tpl_pos={pos}"
            break
        out.append(found)
        pos = found + 1
    if ordered_ok:
        _equiv_try_map_pdb_atoms_to_tpl.last_method = 'ordered_subsequence'
        if verbose:
            log_info(f"Equivalent atom TPL/PDB mapping method for {tpl_name or 'TPL'}: ordered_subsequence mapped_atoms={len(out)}")
        return out

    # ------------------------------------------------------------------
    # Pass 2: residue-block mapping.  This fixes the apo/holo case where the
    # holo ref.pdb contains an analysis-excluded ligand/peptide or where a TPL
    # writes molecule species in a different order.  We still require every PDB
    # atom to be matched to an explicit TPL atom with compatible resname/resid
    # and atom name; this is not a fallback to residue-name equivalence rules.
    # ------------------------------------------------------------------
    def pdb_blocks():
        blocks=[]
        cur_key=None; cur=[]
        for pi, ap in enumerate(atoms_pdb):
            key=(str(ap.chain), int(ap.resid), _equiv_norm_name(ap.resname))
            if cur_key is None or key == cur_key:
                cur_key=key; cur.append(pi)
            else:
                blocks.append((cur_key, cur)); cur_key=key; cur=[pi]
        if cur_key is not None:
            blocks.append((cur_key, cur))
        return blocks

    tpl_blocks=[]
    cur_key=None; cur=[]
    for ti, ta in enumerate(tatoms):
        key=(int(ta.get('molecule_copy_id',0)), str(ta.get('molecule_name','')), int(ta.get('tpl_global_resid', ta.get('resid',0))), _equiv_norm_name(str(ta.get('resname',''))))
        if cur_key is None or key == cur_key:
            cur_key=key; cur.append(ti)
        else:
            tpl_blocks.append((cur_key, cur)); cur_key=key; cur=[ti]
    if cur_key is not None:
        tpl_blocks.append((cur_key, cur))

    used_tpl: set[int] = set()
    mapped=[-1]*len(atoms_pdb)
    last_start=-1
    residue_fail=''

    from collections import Counter
    for (chain, resid, resname), pidxs in pdb_blocks():
        need_names=[_equiv_norm_name(atoms_pdb[pi].name) for pi in pidxs]
        need_counter=Counter(need_names)
        candidates=[]
        for bi, (tkey, tidxs) in enumerate(tpl_blocks):
            _mcid, _mname, trid, trn = tkey
            if not _equiv_resname_compatible(resname, trn):
                continue
            # TPL residue ids in ATOMS are local to each molecule template,
            # but we assigned tpl_global_resid during full-system expansion.
            # Prefer blocks whose expanded global residue serial matches the
            # PDB resid.  This maps, for example, PDB PHE97 to peptide-template
            # PHE1 after expansion instead of treating it as a mismatch.
            avail=[ti for ti in tidxs if ti not in used_tpl]
            have_counter=Counter(_equiv_norm_name(str(tatoms[ti].get('name',''))) for ti in avail)
            if all(have_counter.get(nm,0) >= cnt for nm,cnt in need_counter.items()):
                start=min(tidxs) if tidxs else 10**18
                # Prefer a block after the previous mapped block, then prefer
                # exact residue-number matches when they exist.  This preserves
                # the usual protein mapping while allowing separate ligand/peptide
                # molecule templates whose TPL residue numbers are local.
                order_penalty = 0 if start >= last_start else 1
                resid_penalty = 0
                try:
                    if resid and trid and int(resid) != int(trid):
                        resid_penalty = 1
                except Exception:
                    resid_penalty = 1
                candidates.append((order_penalty, resid_penalty, abs(start-last_start), start, bi, avail))
        if not candidates:
            residue_fail = f"residue-block failed at PDB residue {chain}:{resname}{resid}; atoms={','.join(need_names[:12])}{'...' if len(need_names)>12 else ''}; no unused TPL residue block with compatible resname and complete atom-name multiset"
            break
        candidates.sort()
        _pen_order, _pen_resid, _dist, start, bi, avail = candidates[0]
        by_name: dict[str, list[int]] = defaultdict(list)
        for ti in avail:
            by_name[_equiv_norm_name(str(tatoms[ti].get('name','')))].append(ti)
        for xs in by_name.values():
            xs.sort()
        ok=True
        for pi in pidxs:
            nm=_equiv_norm_name(atoms_pdb[pi].name)
            if not by_name.get(nm):
                ok=False; break
            ti=by_name[nm].pop(0)
            mapped[pi]=ti; used_tpl.add(ti)
        if not ok:
            residue_fail = f"internal residue-block assignment failed at PDB residue {chain}:{resname}{resid}"
            break
        last_start=max(last_start, start)

    if not residue_fail and all(ti >= 0 for ti in mapped):
        _equiv_try_map_pdb_atoms_to_tpl.last_method = 'residue_block'
        if verbose:
            log_info(f"Equivalent atom TPL/PDB mapping method for {tpl_name or 'TPL'}: residue_block mapped_atoms={len(mapped)} ordered_failure='{fail_msg}'")
        return [int(x) for x in mapped]

    full_fail = (fail_msg + '; ' + residue_fail).strip('; ')
    _equiv_try_map_pdb_atoms_to_tpl.last_method = 'failed'
    _equiv_try_map_pdb_atoms_to_tpl.last_failure = full_fail
    if verbose:
        log_warn(f"Equivalent atom TPL/PDB mapping failed for {tpl_name or 'TPL'}: {full_fail}; TPL-derived equivalence is required and the run will stop")
    return None

def _rows_from_pdb_equiv_groups(group_by: np.ndarray, atoms: Sequence[AtomRec], *, source: str, reason: str, mapped_tpl: list[int] | None = None, tatoms: Sequence[dict[str, object]] | None = None) -> list[dict[str, object]]:
    rows: list[dict[str, object]] = []
    members_by_gid: dict[int, list[int]] = defaultdict(list)
    for i, g in enumerate(np.asarray(group_by, dtype=np.int32).tolist()):
        if int(g) >= 0:
            members_by_gid[int(g)].append(int(i))
    for gid, mem in sorted(members_by_gid.items()):
        if len(mem) < 2:
            continue
        a0 = atoms[mem[0]]
        atom_names = [atoms[i].name.strip() for i in mem]
        tpl0 = None
        if mapped_tpl is not None and tatoms is not None and mem[0] < len(mapped_tpl):
            ti = int(mapped_tpl[mem[0]])
            if 0 <= ti < len(tatoms):
                tpl0 = tatoms[ti]
        rows.append({
            'group_id': int(gid), 'source': source, 'confidence': 'medium',
            'molecule_id': '' if tpl0 is None else int(tpl0.get('molecule_copy_id', 0)),
            'molecule_name': '' if tpl0 is None else str(tpl0.get('molecule_name', '')),
            'chain': a0.chain, 'resid': int(a0.resid), 'resname': a0.resname.strip(),
            'atom_names': ';'.join(atom_names),
            'atom_indices_A': ';'.join(str(int(i)) for i in mem), 'atom_indices_B': '',
            'element': a0.elem,
            'atom_type': '' if tpl0 is None else str(tpl0.get('atom_type', '')),
            'charge': '' if tpl0 is None else _round_equiv_float(float(tpl0.get('charge', float('nan')))),
            'vdw_radius': '' if tpl0 is None else _round_equiv_float(float(tpl0.get('vdw_radius', float('nan')))),
            'vdw_epsilon': '' if tpl0 is None else _round_equiv_float(float(tpl0.get('vdw_epsilon', float('nan')))),
            'mass': '' if tpl0 is None else _round_equiv_float(float(tpl0.get('mass', float('nan')))),
            'reason': reason,
        })
    return rows


def _tpl_equiv_is_hydrogen_atom(tpl_atom: dict[str, object]) -> bool:
    return _element_for_equiv(str(tpl_atom.get('name', '')), tpl_atom) == 'H'


def _tpl_equiv_h_neighbors(adj: Sequence[set[int]], tatoms: Sequence[dict[str, object]], atom_i: int) -> list[int]:
    return [int(j) for j in adj[int(atom_i)] if _tpl_equiv_is_hydrogen_atom(tatoms[int(j)])]


def _tpl_equiv_heavy_neighbors(adj: Sequence[set[int]], tatoms: Sequence[dict[str, object]], atom_i: int) -> list[int]:
    return [int(j) for j in adj[int(atom_i)] if not _tpl_equiv_is_hydrogen_atom(tatoms[int(j)])]



def _tpl_equiv_filter_hydrogen_groups(group_by: np.ndarray, tatoms: Sequence[dict[str, object]], adj: Sequence[set[int]]) -> np.ndarray:
    """Drop hydrogen groups that are unsafe under a chirality-aware policy.

    The force-field graph can make same-parent CH2 hydrogens look exchangeable,
    but in a chiral biomolecular environment those hydrogens are usually
    pro-R/pro-S (diastereotopic) labels.  DISTIL therefore accepts only:

    * same-parent CH3/NH3-like groups with all local H siblings present;
    * hydrogens attached to different equivalent heavy parents, with complete
      local H sets on each parent (LEU terminal methyls, PHE/TYR HD1/HD2, etc.).

    Rejected candidates are stored on this function as ``last_rejected_rows`` so
    the caller can write equiv_atom_rejected_groups.csv.
    """
    group_by = np.asarray(group_by, dtype=np.int32).copy()
    by_gid: dict[int, list[int]] = defaultdict(list)
    for i, g in enumerate(group_by.tolist()):
        if int(g) >= 0:
            by_gid[int(g)].append(int(i))

    drop: set[int] = set()
    rejected: list[dict[str, object]] = []

    def add_reject(gid: int, members: list[int], reason: str) -> None:
        drop.add(int(gid))
        if not members:
            return
        first = tatoms[int(members[0])]
        rejected.append({
            'group_id': int(gid), 'source': 'tpl_graph_automorphism_rejected',
            'confidence': 'rejected',
            'molecule_id': int(first.get('molecule_copy_id', 0)),
            'molecule_name': str(first.get('molecule_name','')),
            'chain': '', 'resid': int(first.get('resid', 0)), 'resname': str(first.get('resname','')),
            'atom_names': ';'.join(str(tatoms[i].get('name','')).strip() for i in members),
            'atom_indices_A': ';'.join(str(i) for i in members), 'atom_indices_B': '',
            'element': 'H', 'atom_type': str(first.get('atom_type','')),
            'charge': _round_equiv_float(float(first.get('charge', float('nan')))),
            'vdw_radius': _round_equiv_float(float(first.get('vdw_radius', float('nan')))),
            'vdw_epsilon': _round_equiv_float(float(first.get('vdw_epsilon', float('nan')))),
            'mass': _round_equiv_float(float(first.get('mass', float('nan')))),
            'reason': reason,
        })

    for gid, members in sorted(by_gid.items()):
        is_h = [_tpl_equiv_is_hydrogen_atom(tatoms[i]) for i in members]
        if not all(is_h):
            if any(is_h):
                add_reject(gid, members, 'mixed_hydrogen_and_heavy_atom_candidate')
            continue

        parents: list[int] = []
        ok_parent = True
        for h in members:
            hs = _tpl_equiv_heavy_neighbors(adj, tatoms, h)
            if len(hs) != 1:
                ok_parent = False
                break
            parents.append(int(hs[0]))
        if not ok_parent or not parents:
            add_reject(gid, members, 'hydrogen_without_unique_heavy_parent')
            continue

        parent_set = sorted(set(parents))
        member_set = set(members)
        if len(parent_set) == 1:
            p0 = parent_set[0]
            sibling_h = set(_tpl_equiv_h_neighbors(adj, tatoms, p0))
            if len(sibling_h) >= 3 and member_set == sibling_h:
                # Methyl/ammonium-like local rotor.
                continue
            if len(sibling_h) == 2 and member_set == sibling_h:
                add_reject(gid, members, 'rejected_same_parent_CH2_or_NH2_hydrogens_stereo_not_exchangeable')
            else:
                add_reject(gid, members, 'rejected_incomplete_or_nonrotor_same_parent_hydrogen_set')
            continue

        # Different parents: parent heavy atoms must be in one accepted heavy
        # equivalence group.  Each parent must contribute its full local H set.
        parent_gids = {int(group_by[p]) for p in parent_set if int(group_by[p]) >= 0}
        if len(parent_gids) != 1:
            add_reject(gid, members, 'hydrogen_parents_not_in_one_equivalent_heavy_group')
            continue
        ok = True
        for p0 in parent_set:
            sibling_h = set(_tpl_equiv_h_neighbors(adj, tatoms, p0))
            if len(sibling_h) == 1:
                ok = ok and (next(iter(sibling_h)) in member_set)
            elif len(sibling_h) >= 3:
                ok = ok and sibling_h.issubset(member_set)
            else:
                # CH2/NH2 hydrogens on each parent remain unsafe without a
                # stereochemistry-preserving automorphism proof.
                ok = False
        if not ok:
            add_reject(gid, members, 'rejected_incomplete_or_CH2_like_hydrogen_sets_across_equivalent_parents')

    _tpl_equiv_filter_hydrogen_groups.last_rejected_rows = rejected
    if drop:
        for i, g in enumerate(group_by.tolist()):
            if int(g) in drop:
                group_by[i] = -1
        # Re-number groups densely after dropping unsafe H groups.
        remap: dict[int, int] = {}
        next_gid = 0
        for g in sorted(set(int(x) for x in group_by.tolist() if int(x) >= 0)):
            remap[g] = next_gid; next_gid += 1
        for i, g in enumerate(group_by.tolist()):
            if int(g) >= 0:
                group_by[i] = remap[int(g)]
    return group_by.astype(np.int32)

def _rows_from_tpl_equiv_groups(group_by: np.ndarray, tatoms: Sequence[dict[str, object]], adj: Sequence[set[int]], *, source: str, reason: str) -> list[dict[str, object]]:
    rows: list[dict[str, object]] = []
    members_by_gid: dict[int, list[int]] = defaultdict(list)
    for i, g in enumerate(np.asarray(group_by, dtype=np.int32).tolist()):
        if int(g) >= 0:
            members_by_gid[int(g)].append(int(i))
    for gid, members in sorted(members_by_gid.items()):
        if len(members) < 2:
            continue
        first = tatoms[members[0]]
        labs=[]
        for i in members:
            a = tatoms[i]
            labs.append((_element_for_equiv(str(a.get('name','')), a), str(a.get('atom_type','')), int(a.get('type_id', -1)), _round_equiv_float(float(a.get('charge', float('nan')))), _round_equiv_float(float(a.get('vdw_radius', float('nan')))), _round_equiv_float(float(a.get('mass', float('nan')))), _equiv_nonbond_label(a)))
        atom_names=[str(tatoms[i].get('name','')).strip() for i in members]
        rows.append({
            'group_id': int(gid), 'source': source, 'confidence': 'medium',
            'molecule_id': int(first.get('molecule_copy_id', 0)), 'molecule_name': str(first.get('molecule_name','')),
            'chain': '', 'resid': int(first.get('resid', 0)), 'resname': str(first.get('resname','')),
            'atom_names': ';'.join(atom_names),
            'atom_indices_A': ';'.join(str(i) for i in members), 'atom_indices_B': '',
            'element': labs[0][0], 'atom_type': labs[0][1], 'charge': labs[0][3],
            'vdw_radius': labs[0][4], 'vdw_epsilon': _round_equiv_float(float(first.get('vdw_epsilon', float('nan')))), 'mass': labs[0][5],
            'reason': reason,
        })
    return rows



def _tpl_reconstruct_zmatrix_coords(tatoms: Sequence[dict[str, object]]) -> np.ndarray:
    """Reconstruct a deterministic coordinate model from TPL internal coords.

    The coordinates are not used as MD structures; they are only a local stereo
    reference for rejecting automorphisms that would invert explicitly chiral
    centers.  Missing/invalid Z-matrix references leave NaNs and disable the
    stereo check for affected centers.
    """
    n=len(tatoms)
    coords=np.full((n,3), np.nan, dtype=np.float64)
    by_mol: dict[int, list[int]] = defaultdict(list)
    for i,a in enumerate(tatoms):
        by_mol[int(a.get('molecule_copy_id',0))].append(i)
    for _mol, idxs in by_mol.items():
        idxs=sorted(idxs, key=lambda k: int(tatoms[k].get('global_index0', k)))
        for local_pos, gi in enumerate(idxs):
            a=tatoms[gi]
            refs=[int(x) for x in (a.get('z_refs',(0,0,0,0)) or (0,0,0,0))]
            vals=[float(x) for x in (a.get('z_values',(float('nan'),float('nan'),float('nan'))) or (float('nan'),float('nan'),float('nan')))]
            # Convert molecule-local ids to global indices in this copy.
            def gref(r):
                if r <= 0 or r > len(idxs):
                    return None
                return idxs[r-1]
            r1,r2,r3 = (gref(refs[0]), gref(refs[1]), gref(refs[2]))
            bond = vals[0] if np.isfinite(vals[0]) and vals[0] > 0 else 1.5
            theta = math.radians(vals[1]) if np.isfinite(vals[1]) else math.radians(109.5)
            phi = math.radians(vals[2]) if np.isfinite(vals[2]) else 0.0
            if local_pos == 0 or r1 is None or not np.all(np.isfinite(coords[r1])):
                coords[gi]=np.array([float(local_pos)*1.7, 0.0, 0.0])
            elif r2 is None or not np.all(np.isfinite(coords[r2])):
                coords[gi]=coords[r1] + np.array([bond, 0.0, 0.0])
            elif r3 is None or not np.all(np.isfinite(coords[r3])):
                v=coords[r1]-coords[r2]
                nv=np.linalg.norm(v)
                if nv < 1e-12:
                    v=np.array([1.0,0.0,0.0]); nv=1.0
                e1=v/nv
                # arbitrary perpendicular
                tmp=np.array([0.0,0.0,1.0]) if abs(e1[2]) < 0.9 else np.array([0.0,1.0,0.0])
                e2=np.cross(e1,tmp); e2=e2/(np.linalg.norm(e2)+1e-15)
                coords[gi]=coords[r1] + bond*(-math.cos(theta)*e1 + math.sin(theta)*e2)
            else:
                a1=coords[r1]; a2=coords[r2]; a3=coords[r3]
                e1=a1-a2; e1=e1/(np.linalg.norm(e1)+1e-15)
                nvec=np.cross(a3-a2, e1)
                if np.linalg.norm(nvec) < 1e-12:
                    tmp=np.array([0.0,0.0,1.0]) if abs(e1[2]) < 0.9 else np.array([0.0,1.0,0.0])
                    nvec=np.cross(tmp,e1)
                e2=nvec/(np.linalg.norm(nvec)+1e-15)
                e3=np.cross(e2,e1)
                coords[gi]=a1 + bond*(-math.cos(theta)*e1 + math.sin(theta)*(math.cos(phi)*e3 + math.sin(phi)*e2))
    return coords


def _tpl_signed_volume(coords: np.ndarray, c: int, neigh: Sequence[int]) -> float:
    if len(neigh) < 3:
        return float('nan')
    pts=[coords[int(x)] for x in neigh[:3]]
    if not (np.all(np.isfinite(coords[int(c)])) and all(np.all(np.isfinite(p)) for p in pts)):
        return float('nan')
    return float(np.linalg.det(np.vstack([pts[0]-coords[int(c)], pts[1]-coords[int(c)], pts[2]-coords[int(c)]])))


def _tpl_mapping_preserves_stereo(mp: Mapping[int,int], coords: np.ndarray, adj: Sequence[set[int]], tatoms: Sequence[dict[str, object]]) -> bool:
    """Reject graph automorphisms that invert explicit tetrahedral chirality.

    Only centers with four neighbors and four distinct neighbor labels are used
    as hard chiral centers.  Prochiral CH2 hydrogens are handled separately by
    the hydrogen filter because their parent center has duplicate H labels.
    """
    for c, neigh_set in enumerate(adj):
        if len(neigh_set) != 4 or c not in mp:
            continue
        neigh=list(neigh_set)
        labs=[_tpl_equiv_node_label(tatoms[n]) for n in neigh]
        if len(set(labs)) != 4:
            continue
        order=[n for _,n in sorted(zip(map(repr,labs), neigh))]
        v0=_tpl_signed_volume(coords, c, order)
        if not np.isfinite(v0) or abs(v0) < 1e-9:
            continue
        mc=int(mp[c])
        mapped=[int(mp[n]) for n in order]
        v1=_tpl_signed_volume(coords, mc, mapped)
        if not np.isfinite(v1) or abs(v1) < 1e-9:
            continue
        if v0 * v1 < 0:
            return False
    return True


def _tpl_mapping_hydrogen_safety(
    mp: Mapping[int, int],
    adj: Sequence[set[int]],
    tatoms: Sequence[dict[str, object]],
) -> tuple[bool, str]:
    """Return whether hydrogen motion in an automorphism is safe.

    Force-field topology alone cannot distinguish many same-parent CH2/NH2
    hydrogens: swapping HB2/HB3 often preserves all bond/angle/torsion terms,
    but those hydrogens are potentially pro-R/pro-S labels and should not seed
    equivalent-atom orbits.  This check is intentionally residue-name agnostic;
    it uses only the mapped atom graph.

    Accepted hydrogen motion is limited to two cases:
      1. local rotors with >=3 equivalent hydrogens on one unchanged parent
         (CH3/NH3-like permutations);
      2. hydrogens that move together with their heavy parent, where each moved
         parent contributes either one hydrogen (e.g. aromatic CH) or a complete
         >=3-H rotor set (e.g. exchanged methyl groups).

    Same-parent two-hydrogen swaps are rejected at the candidate-map stage, not
    merely filtered from the final orbit table, so debug output reflects the
    same safety policy used for final grouping.
    """
    moved_h: list[int] = []
    for i, j in mp.items():
        ii = int(i); jj = int(j)
        if ii != jj and _tpl_equiv_is_hydrogen_atom(tatoms[ii]):
            moved_h.append(ii)
    if not moved_h:
        return True, 'no_hydrogen_motion'

    # For every moved hydrogen, the unique heavy parent must map to the unique
    # heavy parent of the destination hydrogen.  Otherwise the H movement is not
    # parent-following and is unsafe.
    parent_to_moved: dict[int, set[int]] = defaultdict(set)
    for h in moved_h:
        dst = int(mp[h])
        psrcs = _tpl_equiv_heavy_neighbors(adj, tatoms, h)
        pdsts = _tpl_equiv_heavy_neighbors(adj, tatoms, dst)
        if len(psrcs) != 1 or len(pdsts) != 1:
            return False, 'hydrogen_without_unique_heavy_parent'
        psrc = int(psrcs[0]); pdst = int(pdsts[0])
        if int(mp.get(psrc, psrc)) != pdst:
            return False, 'hydrogen_does_not_follow_mapped_parent'
        parent_to_moved[psrc].add(h)

    # If all moved atoms are hydrogens, allow only >=3-H local rotors.  This
    # rejects CH2/NH2 prochiral swaps while retaining methyl/ammonium rotations.
    moved_heavy = [int(i) for i, j in mp.items()
                   if int(i) != int(j) and not _tpl_equiv_is_hydrogen_atom(tatoms[int(i)])]
    if not moved_heavy:
        for psrc, hs in parent_to_moved.items():
            siblings = set(_tpl_equiv_h_neighbors(adj, tatoms, psrc))
            if len(siblings) < 3:
                return False, 'hydrogen_only_two_hydrogen_parent_swap'
            if not set(hs).issubset(siblings):
                return False, 'hydrogen_only_non_sibling_motion'
        return True, 'hydrogen_only_local_rotor'

    # Heavy atoms also move.  A moved hydrogen is safe when it follows a moved
    # heavy parent.  For parents with two hydrogens (CH2/NH2-like), remain
    # conservative: these hydrogens can be stereotopic and are not allowed to
    # define H equivalence even when the parent moves.  Parents with one H are
    # aromatic/vinylic-like attached hydrogens; parents with >=3 H are rotors and
    # must move as complete local H sets for each involved parent.
    for psrc, hs in parent_to_moved.items():
        pdst = int(mp.get(psrc, psrc))
        if psrc == pdst:
            # Mixed map where heavy atoms move elsewhere but this local parent is
            # unchanged: same logic as H-only local motion.
            siblings = set(_tpl_equiv_h_neighbors(adj, tatoms, psrc))
            if len(siblings) >= 3:
                continue
            return False, 'same_parent_two_hydrogen_swap_with_unrelated_heavy_motion'
        siblings_src = set(_tpl_equiv_h_neighbors(adj, tatoms, psrc))
        siblings_dst = set(_tpl_equiv_h_neighbors(adj, tatoms, pdst))
        nsrc = len(siblings_src); ndst = len(siblings_dst)
        if nsrc == 1 and ndst == 1:
            # Example: PHE CD1-HD1 follows CD1->CD2 and HD1->HD2.
            if set(hs) != siblings_src:
                return False, 'single_h_parent_incomplete_hydrogen_motion'
            continue
        if nsrc == 2 and ndst == 2:
            # A same-parent two-H swap (handled above when psrc == pdst) is
            # unsafe because it can be a pro-R/pro-S relabeling.  In contrast,
            # when the *heavy parent itself* is exchanged with an equivalent
            # heavy parent, the complete two-H substituent may follow that
            # parent safely.  This is required for residue-name-agnostic
            # guanidinium-like groups such as ARG NH1<->NH2, and also covers
            # symmetric nonstandard molecules without hard-coded amino-acid
            # rules.  Partial two-H motion is still rejected.
            if set(hs) != siblings_src:
                return False, 'two_h_parent_incomplete_hydrogen_motion'
            mapped_hs = {int(mp[h]) for h in siblings_src}
            if mapped_hs != siblings_dst:
                return False, 'two_h_parent_hydrogens_do_not_map_to_destination_group'
            continue
        if nsrc >= 3 and ndst >= 3:
            # Example: exchanged methyl groups; require the complete local rotor
            # on the source parent to participate so partial arbitrary H motion
            # cannot seed an incomplete orbit.
            if set(hs) != siblings_src:
                return False, 'rotor_parent_incomplete_hydrogen_motion'
            mapped_hs = {int(mp[h]) for h in siblings_src}
            if mapped_hs != siblings_dst:
                return False, 'rotor_parent_hydrogens_do_not_map_to_destination_rotor'
            continue
        return False, 'hydrogen_parent_multiplicity_mismatch_or_unsupported'
    return True, 'hydrogen_motion_safe'

def _tpl_equiv_node_label(a: dict[str, object]) -> tuple:
    """Atom label for force-field-topology automorphism matching.

    The label contains only intrinsic atom parameters.  It deliberately excludes
    Z-matrix references and incident angle/torsion/improper records, because
    those records depend on TPL construction order and can break true chemical
    symmetry (for example PHE/TYR aromatic CD1/CD2 and CE1/CE2).  Bonded terms
    are checked as invariant *sets* for each candidate automorphism instead.
    """
    return (
        _element_for_equiv(str(a.get('name','')), a),
        str(a.get('atom_type','')).strip(),
        int(a.get('type_id', -1)),
        _round_equiv_float(float(a.get('charge', float('nan')))),
        _round_equiv_float(float(a.get('vdw_radius', float('nan')))),
        _round_equiv_float(float(a.get('mass', float('nan')))),
        _equiv_nonbond_label(a),
    )


def _tpl_term_tuple_key(kind: str, atoms: tuple[int, ...], params: tuple[object, ...]) -> tuple:
    """Canonical key for a bonded force-field term.

    Bond and angle energies are invariant to endpoint reversal.  Proper torsion
    energies are invariant to full reversal.  Improper records are treated as a
    parameter-labeled atom set for equivalence purposes; chirality/planarity
    safety is checked separately using the TPL internal-coordinate model.  This
    avoids turning arbitrary TPL record orientation into a false asymmetry label.

    J_PRESTO TPL torsion/improper records have five parameter-like fields after
    the four atom ids::

        force_constant, division, periodicity, phase, nbf_flag

    The last integer is read into ``iytnbf``/``iyinbf`` by ``rdtors``/``rdimpr``
    and is used by the MD code as a 1-4 nonbonded interaction flag.  It is not
    part of the torsional energy parameters (the torsion energy uses force
    constant, division, periodicity, and phase only).  In aromatic rings the TPL
    can place this 0/1 flag on only one of several symmetry-related torsion
    records to avoid duplicate 1-4 bookkeeping.  Treating that bookkeeping flag
    as an atom-equivalence label creates false asymmetry, so the automorphism
    term key intentionally ignores it for T/I terms.
    """
    k = str(kind)
    if k in ('T', 'I'):
        vals = tuple(str(x) for x in tuple(params)[:4])
    else:
        vals = tuple(str(x) for x in params)
    if k == 'B':
        aa = tuple(sorted(int(x) for x in atoms[:2]))
    elif k == 'A':
        i, j, l = (int(x) for x in atoms[:3])
        aa = (min(i, l), j, max(i, l))
    elif k == 'T':
        f = tuple(int(x) for x in atoms[:4])
        r = tuple(reversed(f))
        aa = min(f, r)
    elif k == 'I':
        aa = tuple(sorted(int(x) for x in atoms[:4]))
    else:
        aa = tuple(int(x) for x in atoms)
    return (k, aa, vals)


def _tpl_block_term_multiset(
    idxset: set[int],
    *,
    bond_terms0: Sequence[tuple[int, int, tuple[object, ...]]] = (),
    angle_terms0: Sequence[tuple[int, int, int, tuple[object, ...]]] = (),
    torsion_terms0: Sequence[tuple[int, int, int, int, tuple[object, ...]]] = (),
    improper_terms0: Sequence[tuple[int, int, int, int, tuple[object, ...]]] = (),
) -> Counter:
    """Return the bonded-term multiset fully contained in a block."""
    c = Counter()
    for i, j, vals in bond_terms0:
        if int(i) in idxset and int(j) in idxset:
            c[_tpl_term_tuple_key('B', (int(i), int(j)), tuple(vals))] += 1
    for i, j, k, vals in angle_terms0:
        if int(i) in idxset and int(j) in idxset and int(k) in idxset:
            c[_tpl_term_tuple_key('A', (int(i), int(j), int(k)), tuple(vals))] += 1
    for i, j, k, l, vals in torsion_terms0:
        if int(i) in idxset and int(j) in idxset and int(k) in idxset and int(l) in idxset:
            c[_tpl_term_tuple_key('T', (int(i), int(j), int(k), int(l)), tuple(vals))] += 1
    for i, j, k, l, vals in improper_terms0:
        if int(i) in idxset and int(j) in idxset and int(k) in idxset and int(l) in idxset:
            c[_tpl_term_tuple_key('I', (int(i), int(j), int(k), int(l)), tuple(vals))] += 1
    return c


def _tpl_mapped_term_multiset(
    mp: Mapping[int, int],
    idxset: set[int],
    *,
    bond_terms0: Sequence[tuple[int, int, tuple[object, ...]]] = (),
    angle_terms0: Sequence[tuple[int, int, int, tuple[object, ...]]] = (),
    torsion_terms0: Sequence[tuple[int, int, int, int, tuple[object, ...]]] = (),
    improper_terms0: Sequence[tuple[int, int, int, int, tuple[object, ...]]] = (),
) -> Counter:
    """Return the bonded-term multiset after applying an automorphism."""
    c = Counter()
    for i, j, vals in bond_terms0:
        if int(i) in idxset and int(j) in idxset:
            c[_tpl_term_tuple_key('B', (int(mp[int(i)]), int(mp[int(j)])), tuple(vals))] += 1
    for i, j, k, vals in angle_terms0:
        if int(i) in idxset and int(j) in idxset and int(k) in idxset:
            c[_tpl_term_tuple_key('A', (int(mp[int(i)]), int(mp[int(j)]), int(mp[int(k)])), tuple(vals))] += 1
    for i, j, k, l, vals in torsion_terms0:
        if int(i) in idxset and int(j) in idxset and int(k) in idxset and int(l) in idxset:
            c[_tpl_term_tuple_key('T', (int(mp[int(i)]), int(mp[int(j)]), int(mp[int(k)]), int(mp[int(l)])), tuple(vals))] += 1
    for i, j, k, l, vals in improper_terms0:
        if int(i) in idxset and int(j) in idxset and int(k) in idxset and int(l) in idxset:
            c[_tpl_term_tuple_key('I', (int(mp[int(i)]), int(mp[int(j)]), int(mp[int(k)]), int(mp[int(l)])), tuple(vals))] += 1
    return c



def _equiv_parse_debug_residue_specs(specs: object) -> list[tuple[str | None, int, str | None]]:
    """Parse --equiv-debug-residue values.

    Accepted forms: "7", "7:PHE", "A:7:PHE", "A:7", or comma-separated
    combinations.  Returned chain is None when not constrained.
    """
    if specs is None:
        return []
    if isinstance(specs, str):
        raw_items = [specs]
    else:
        try:
            raw_items = list(specs)
        except Exception:
            raw_items = [str(specs)]
    out: list[tuple[str | None, int, str | None]] = []
    for raw in raw_items:
        for item in str(raw or '').split(','):
            item = item.strip()
            if not item:
                continue
            parts = [x.strip() for x in item.split(':') if x.strip() != '']
            chain = None
            resid_s = None
            resname = None
            if len(parts) == 1:
                resid_s = parts[0]
            elif len(parts) == 2:
                # Prefer resid:resname; if first field is nonnumeric, use chain:resid.
                if re.fullmatch(r'[+-]?\d+', parts[0]):
                    resid_s, resname = parts[0], parts[1]
                else:
                    chain, resid_s = parts[0], parts[1]
            else:
                chain, resid_s, resname = parts[0], parts[1], parts[2]
            if resid_s is None or not re.fullmatch(r'[+-]?\d+', resid_s):
                raise SystemExit(f"[equiv-debug-residue] Invalid residue spec: {item!r}. Use e.g. 7:PHE or A:7:PHE")
            out.append((chain, int(resid_s), resname.upper() if resname else None))
    return out


def _equiv_debug_safe_token(x: object) -> str:
    t = str(x if x is not None else '').strip()
    t = re.sub(r'[^A-Za-z0-9_.+-]+', '_', t)
    return t or 'debug'


def _equiv_debug_pdb_block_keys(
    atoms_pdb: Sequence[AtomRec],
    mapped_tpl: Sequence[int],
    tatoms: Sequence[dict[str, object]],
    specs: Sequence[tuple[str | None, int, str | None]],
) -> dict[tuple, str]:
    """Return TPL block keys touched by requested PDB residue specs."""
    ans: dict[tuple, str] = {}
    if not specs:
        return ans
    for chain, resid, resname in specs:
        for pi, a in enumerate(atoms_pdb):
            if int(a.resid) != int(resid):
                continue
            if chain is not None and str(a.chain).strip() != str(chain).strip():
                continue
            if resname is not None and str(a.resname).strip().upper() != str(resname).strip().upper():
                continue
            if pi >= len(mapped_tpl):
                continue
            ti = int(mapped_tpl[pi])
            if not (0 <= ti < len(tatoms)):
                continue
            ta = tatoms[ti]
            key = (int(ta.get('molecule_copy_id', 0)), str(ta.get('molecule_name', '')), int(ta.get('resid', 0)), str(ta.get('resname', '')))
            label_parts = []
            if chain is not None:
                label_parts.append(str(chain))
            label_parts.append(str(resid))
            if resname is not None:
                label_parts.append(str(resname))
            ans[key] = _equiv_debug_safe_token('_'.join(label_parts))
    return ans


def _equiv_debug_write_csv(path: Path, rows: list[dict[str, object]], fieldnames: list[str]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, 'w', newline='') as f:
        w = csv.DictWriter(f, fieldnames=fieldnames)
        w.writeheader()
        for r in rows:
            w.writerow({k: r.get(k, '') for k in fieldnames})


def _equiv_debug_term_counter_diff(a: Counter, b: Counter, limit: int = 8) -> tuple[str, str]:
    missing = []
    excess = []
    for k, v in (a - b).items():
        missing.append(f"{k}x{v}")
        if len(missing) >= limit:
            break
    for k, v in (b - a).items():
        excess.append(f"{k}x{v}")
        if len(excess) >= limit:
            break
    return (' | '.join(missing), ' | '.join(excess))


def _equiv_debug_changed_mapping(mp: Mapping[int, int], tatoms: Sequence[dict[str, object]], idxs: Sequence[int]) -> str:
    parts = []
    for i in idxs:
        j = int(mp.get(int(i), int(i)))
        if j != int(i):
            ai = tatoms[int(i)]
            aj = tatoms[int(j)]
            parts.append(f"{int(i)+1}:{ai.get('name','')}->{int(j)+1}:{aj.get('name','')}")
    return ';'.join(parts)


def _equiv_debug_write_block(
    *,
    outdir: Path,
    side_label: str,
    block_label: str,
    key: tuple,
    idxs: Sequence[int],
    tatoms: Sequence[dict[str, object]],
    adj: Sequence[set[int]],
    bond_terms0: Sequence[tuple[int, int, tuple[object, ...]]],
    angle_terms0: Sequence[tuple[int, int, int, tuple[object, ...]]],
    torsion_terms0: Sequence[tuple[int, int, int, int, tuple[object, ...]]],
    improper_terms0: Sequence[tuple[int, int, int, int, tuple[object, ...]]],
    candidate_rows: list[dict[str, object]],
) -> None:
    prefix = outdir / f"equiv_debug_{_equiv_debug_safe_token(side_label)}_{_equiv_debug_safe_token(block_label)}"
    idxset = set(int(x) for x in idxs)
    node_rows=[]
    for i in idxs:
        a=tatoms[int(i)]
        node_rows.append({
            'tpl_atom_index1': int(i)+1,
            'name': a.get('name',''),
            'resname': a.get('resname',''),
            'local_resid': a.get('resid',''),
            'global_resid': a.get('global_resid',''),
            'molecule_copy_id': a.get('molecule_copy_id',''),
            'molecule_name': a.get('molecule_name',''),
            'element': _element_for_equiv(str(a.get('name','')), a),
            'atom_type': a.get('atom_type',''),
            'type_id': a.get('type_id',''),
            'charge': _round_equiv_float(float(a.get('charge', float('nan')))),
            'vdw_radius': _round_equiv_float(float(a.get('vdw_radius', float('nan')))),
            'vdw_epsilon': _round_equiv_float(float(a.get('vdw_epsilon', float('nan')))),
            'mass': _round_equiv_float(float(a.get('mass', float('nan')))),
            'node_label': repr(_tpl_equiv_node_label(a)),
            'neighbors': ';'.join(f"{j+1}:{tatoms[j].get('name','')}" for j in sorted(adj[int(i)]) if j in idxset),
        })
    _equiv_debug_write_csv(prefix.with_name(prefix.name + '_nodes.csv'), node_rows,
        ['tpl_atom_index1','name','resname','local_resid','global_resid','molecule_copy_id','molecule_name','element','atom_type','type_id','charge','vdw_radius','vdw_epsilon','mass','node_label','neighbors'])
    def nm(i:int)->str:
        return str(tatoms[int(i)].get('name',''))
    bond_rows=[]
    for i,j,vals in bond_terms0:
        if int(i) in idxset and int(j) in idxset:
            bond_rows.append({'i1':int(i)+1,'i_name':nm(i),'j1':int(j)+1,'j_name':nm(j),'params':repr(vals),'key':repr(_tpl_term_tuple_key('B',(int(i),int(j)),tuple(vals)))})
    _equiv_debug_write_csv(prefix.with_name(prefix.name + '_bonds.csv'), bond_rows, ['i1','i_name','j1','j_name','params','key'])
    angle_rows=[]
    for i,j,k,vals in angle_terms0:
        if int(i) in idxset and int(j) in idxset and int(k) in idxset:
            angle_rows.append({'i1':int(i)+1,'i_name':nm(i),'j1':int(j)+1,'j_name':nm(j),'k1':int(k)+1,'k_name':nm(k),'params':repr(vals),'key':repr(_tpl_term_tuple_key('A',(int(i),int(j),int(k)),tuple(vals)))})
    _equiv_debug_write_csv(prefix.with_name(prefix.name + '_angles.csv'), angle_rows, ['i1','i_name','j1','j_name','k1','k_name','params','key'])
    torsion_rows=[]
    for i,j,k,l,vals in torsion_terms0:
        if int(i) in idxset and int(j) in idxset and int(k) in idxset and int(l) in idxset:
            torsion_rows.append({'i1':int(i)+1,'i_name':nm(i),'j1':int(j)+1,'j_name':nm(j),'k1':int(k)+1,'k_name':nm(k),'l1':int(l)+1,'l_name':nm(l),'params':repr(vals),'key':repr(_tpl_term_tuple_key('T',(int(i),int(j),int(k),int(l)),tuple(vals)))})
    _equiv_debug_write_csv(prefix.with_name(prefix.name + '_torsions.csv'), torsion_rows, ['i1','i_name','j1','j_name','k1','k_name','l1','l_name','params','key'])
    improper_rows=[]
    for i,j,k,l,vals in improper_terms0:
        if int(i) in idxset and int(j) in idxset and int(k) in idxset and int(l) in idxset:
            improper_rows.append({'i1':int(i)+1,'i_name':nm(i),'j1':int(j)+1,'j_name':nm(j),'k1':int(k)+1,'k_name':nm(k),'l1':int(l)+1,'l_name':nm(l),'params':repr(vals),'key':repr(_tpl_term_tuple_key('I',(int(i),int(j),int(k),int(l)),tuple(vals)))})
    _equiv_debug_write_csv(prefix.with_name(prefix.name + '_impropers.csv'), improper_rows, ['i1','i_name','j1','j_name','k1','k_name','l1','l_name','params','key'])
    _equiv_debug_write_csv(prefix.with_name(prefix.name + '_candidate_maps.csv'), candidate_rows,
        ['candidate_id','accepted','reject_stage','changed_mapping','term_missing','term_excess','stereo_ok','note'])

def _tpl_build_exact_automorphism_groups(
    tatoms: Sequence[dict[str, object]],
    bonds0: Sequence[tuple[int,int]],
    *,
    bond_terms0: Sequence[tuple[int, int, tuple[object, ...]]] = (),
    angle_terms0: Sequence[tuple[int, int, int, tuple[object, ...]]] = (),
    torsion_terms0: Sequence[tuple[int, int, int, int, tuple[object, ...]]] = (),
    improper_terms0: Sequence[tuple[int, int, int, int, tuple[object, ...]]] = (),
    max_nodes: int = 160,
    max_isomorphisms: int = 50000,
    heartbeat_sec: float = 60.0,
    active_block_keys: set[tuple] | None = None,
    debug_block_labels: dict[tuple, str] | None = None,
    debug_outdir: Path | None = None,
    debug_side_label: str = '',
    verbose: bool = True,
) -> tuple[np.ndarray, list[dict[str, object]]]:
    """Return atom orbits from force-field-term-preserving automorphisms.

    This is the generic detector used when a TPL is available.  Unlike earlier
    versions, it does not use Z-matrix references or incident torsion/improper
    record positions as node labels.  Those are construction-order artifacts and
    can destroy true symmetry.  Candidate graph automorphisms are generated from
    the intrinsic atom labels and bond graph; each candidate is then accepted
    only if it preserves the multiset of bonded force-field terms and does not
    invert explicit tetrahedral chirality in the TPL internal-coordinate model.
    """
    try:
        import networkx as nx
        from networkx.algorithms import isomorphism as iso
    except Exception:
        return np.full((len(tatoms),), -1, dtype=np.int32), []

    n = len(tatoms)
    adj=[set() for _ in range(n)]
    for i,j in bonds0:
        if 0 <= i < n and 0 <= j < n:
            adj[i].add(j); adj[j].add(i)
    coords = _tpl_reconstruct_zmatrix_coords(tatoms)
    by_block: dict[tuple, list[int]] = defaultdict(list)
    for i,a in enumerate(tatoms):
        # Residue-local blocks keep the isomorphism problem tractable while still
        # covering standard residues and common nonstandard residue/ligand names.
        # Repeated molecules/residues are never exchanged.
        key=(int(a.get('molecule_copy_id',0)), str(a.get('molecule_name','')), int(a.get('resid',0)), str(a.get('resname','')))
        # When a reference PDB was supplied, active_block_keys restricts the
        # expensive automorphism search to complete TPL residue/molecule blocks
        # that are actually represented in that PDB.  This still uses the full
        # TPL block, including hydrogens that may be absent from the PDB, so the
        # local bond graph is not damaged; it only avoids solvent/ions or other
        # TPL-only molecules that can never contribute to DISTIL features.
        if active_block_keys is not None and key not in active_block_keys:
            continue
        by_block[key].append(i)

    group_by=np.full((n,), -1, dtype=np.int32)
    next_gid=0
    rejected_large=[]
    blocks = sorted(by_block.items())
    t0 = time.perf_counter()
    next_hb = t0 + max(1.0, float(heartbeat_sec))
    if verbose:
        scope = 'pdb_visible_residue_blocks' if active_block_keys is not None else 'all_tpl_blocks'
        active_atoms = sum(len(v) for _k, v in blocks)
        log_info(f"Equivalent atom generic TPL automorphism: scope={scope} blocks={len(blocks)} active_atoms={active_atoms} tpl_atoms={n} max_nodes={max_nodes} max_iso={max_isomorphisms} heartbeat_sec={float(heartbeat_sec):.0f}")
    done_blocks = 0
    unresolved_iso = 0
    accepted_maps_total = 0
    for key, idxs in blocks:
        done_blocks += 1
        now = time.perf_counter()
        if verbose and now >= next_hb:
            ng = len({int(x) for x in group_by.tolist() if int(x) >= 0})
            log_info(f"Equivalent atom generic TPL automorphism heartbeat: blocks_done={done_blocks}/{len(blocks)} groups={ng} elapsed={now-t0:.1f}s current_block={key} size={len(idxs)}")
            next_hb = now + max(1.0, float(heartbeat_sec))
        if len(idxs) < 2:
            continue
        if len(idxs) > max_nodes:
            rejected_large.append((key, len(idxs)))
            if verbose:
                log_warn(f"Equivalent atom generic TPL automorphism skipped large block key={key} atoms={len(idxs)} max_nodes={max_nodes}")
            continue
        idxset=set(idxs)
        target_terms = _tpl_block_term_multiset(
            idxset,
            bond_terms0=bond_terms0,
            angle_terms0=angle_terms0,
            torsion_terms0=torsion_terms0,
            improper_terms0=improper_terms0,
        )
        G=nx.Graph()
        for i in idxs:
            G.add_node(i, label=_tpl_equiv_node_label(tatoms[i]))
        for i in idxs:
            for j in adj[i]:
                if j in idxset and i < j:
                    # Bond force constants/equilibrium lengths are checked in
                    # the term multiset.  Edge label remains topology-only.
                    G.add_edge(i, j, label='bond')
        nm=iso.categorical_node_match('label', None)
        em=iso.categorical_edge_match('label', None)
        GM=iso.GraphMatcher(G, G, node_match=nm, edge_match=em)
        orbits={i:{i} for i in idxs}
        count=0
        accepted=0
        debug_this = bool(debug_block_labels is not None and key in debug_block_labels and debug_outdir is not None)
        debug_rows: list[dict[str, object]] = []
        debug_row_limit = 500
        for mp in GM.isomorphisms_iter():
            count += 1
            if count > max_isomorphisms:
                unresolved_iso += 1
                # Incomplete automorphism enumeration can give partial orbits.
                # Clear the block rather than producing unsafe groups.
                for i in idxs:
                    orbits[i]={i}
                if verbose:
                    log_warn(f"Equivalent atom generic TPL automorphism truncated block key={key} size={len(idxs)} iso_limit={max_isomorphisms}; block left unresolved")
                if debug_this and len(debug_rows) < debug_row_limit:
                    debug_rows.append({'candidate_id': count, 'accepted': 0, 'reject_stage': 'iso_limit', 'changed_mapping': '', 'term_missing': '', 'term_excess': '', 'stereo_ok': '', 'note': f'block unresolved after {max_isomorphisms} candidates'})
                break
            changed = _equiv_debug_changed_mapping(mp, tatoms, idxs) if debug_this else ''
            mapped_terms = _tpl_mapped_term_multiset(
                mp,
                idxset,
                bond_terms0=bond_terms0,
                angle_terms0=angle_terms0,
                torsion_terms0=torsion_terms0,
                improper_terms0=improper_terms0,
            )
            if mapped_terms != target_terms:
                if debug_this and changed and len(debug_rows) < debug_row_limit:
                    miss, exc = _equiv_debug_term_counter_diff(target_terms, mapped_terms)
                    debug_rows.append({'candidate_id': count, 'accepted': 0, 'reject_stage': 'forcefield_terms', 'changed_mapping': changed, 'term_missing': miss, 'term_excess': exc, 'stereo_ok': '', 'note': ''})
                continue
            stereo_ok = _tpl_mapping_preserves_stereo(mp, coords, adj, tatoms)
            if not stereo_ok:
                if debug_this and changed and len(debug_rows) < debug_row_limit:
                    debug_rows.append({'candidate_id': count, 'accepted': 0, 'reject_stage': 'stereo', 'changed_mapping': changed, 'term_missing': '', 'term_excess': '', 'stereo_ok': 0, 'note': ''})
                continue
            hsafe_ok, hsafe_reason = _tpl_mapping_hydrogen_safety(mp, adj, tatoms)
            if not hsafe_ok:
                if debug_this and changed and len(debug_rows) < debug_row_limit:
                    debug_rows.append({'candidate_id': count, 'accepted': 0, 'reject_stage': 'hydrogen_stereo', 'changed_mapping': changed, 'term_missing': '', 'term_excess': '', 'stereo_ok': 1, 'note': hsafe_reason})
                continue
            accepted += 1
            if debug_this and changed and len(debug_rows) < debug_row_limit:
                debug_rows.append({'candidate_id': count, 'accepted': 1, 'reject_stage': '', 'changed_mapping': changed, 'term_missing': '', 'term_excess': '', 'stereo_ok': 1, 'note': hsafe_reason})
            for i,j in mp.items():
                orbits[int(i)].add(int(j))
        if debug_this:
            try:
                _equiv_debug_write_block(
                    outdir=Path(debug_outdir), side_label=str(debug_side_label or 'side'), block_label=str(debug_block_labels.get(key, key)), key=key, idxs=idxs, tatoms=tatoms, adj=adj,
                    bond_terms0=bond_terms0, angle_terms0=angle_terms0, torsion_terms0=torsion_terms0, improper_terms0=improper_terms0,
                    candidate_rows=debug_rows,
                )
                if verbose:
                    log_info(f"Equivalent atom debug written for side={debug_side_label} block={key} candidates_logged={len(debug_rows)}")
            except Exception as e:
                log_warn(f"Equivalent atom debug write failed for side={debug_side_label} block={key}: {e}")
        accepted_maps_total += accepted
        seen=set()
        for i in idxs:
            orb=tuple(sorted(orbits[i]))
            if len(orb) < 2 or orb in seen:
                continue
            seen.add(orb)
            labs={_tpl_equiv_node_label(tatoms[j]) for j in orb}
            if len(labs) != 1:
                continue
            gid=next_gid; next_gid += 1
            for j in orb:
                group_by[j]=gid
    rows = _rows_from_tpl_equiv_groups(
        group_by, tatoms, adj,
        source='tpl_forcefield_term_automorphism',
        reason='generic atom-label and force-field-term-set preserving graph automorphism with Z-matrix-based stereo safety check',
    )
    if verbose:
        ng = len({int(x) for x in group_by.tolist() if int(x) >= 0})
        log_info(f"Equivalent atom generic TPL automorphism done: groups={ng} accepted_maps={accepted_maps_total} unresolved_blocks={unresolved_iso} skipped_large_blocks={len(rejected_large)} elapsed={time.perf_counter()-t0:.1f}s")
    return group_by, rows

def _wl_equiv_groups_from_tpl(tpl_path: Path, atoms_pdb: Sequence[AtomRec] | None = None, *, verbose: bool = True, debug_residue_specs: Sequence[tuple[str | None, int, str | None]] = (), debug_outdir: Path | None = None, debug_side_label: str = '') -> tuple[np.ndarray, list[dict[str, object]]]:
    """Infer equivalent atom groups from a J_PRESTO TPL.

    The main detector is a residue-local exact labeled-graph automorphism search.
    TPL atom labels (atom type, type id, charge, vdW, mass), bonded-term labels,
    and residue context must be preserved.  A separate hydrogen stereo-safety
    filter rejects CH2/NH2-like hydrogen pairs that are graph-equivalent but not
    safely exchangeable in a chiral environment.
    """
    data = _parse_jpresto_tpl_equiv_data(Path(tpl_path))
    tatoms = data.get('atoms', [])
    n = len(tatoms)
    adj=[set() for _ in range(n)]
    for i,j in data.get('bonds0',[]):
        if 0 <= i < n and 0 <= j < n:
            adj[i].add(j); adj[j].add(i)

    mapped: list[int] | None = None
    active_block_keys: set[tuple] | None = None
    debug_block_labels: dict[tuple, str] = {}
    if atoms_pdb is not None:
        # Map PDB atoms before the expensive symmetry search.  The TPL usually
        # contains the full solvated system, while reference PDB files used by
        # DISTIL commonly omit solvent and ions.  Equivalence must still be
        # inferred from intact TPL residue blocks, so we expand the mapped TPL
        # atoms to their full residue/molecule blocks instead of using only the
        # atom_specifier-selected atoms.
        mapped = _equiv_try_map_pdb_atoms_to_tpl(tatoms, atoms_pdb, verbose=verbose, tpl_name=Path(tpl_path).name)
        if mapped is None:
            _wl_equiv_groups_from_tpl.last_rejected_rows = []
            return np.full((len(atoms_pdb),), -1, dtype=np.int32), []
        active_block_keys = set()
        for ti in mapped:
            if 0 <= int(ti) < n:
                ta = tatoms[int(ti)]
                active_block_keys.add((int(ta.get('molecule_copy_id',0)), str(ta.get('molecule_name','')), int(ta.get('resid',0)), str(ta.get('resname',''))))
        debug_block_labels = _equiv_debug_pdb_block_keys(atoms_pdb, mapped, tatoms, debug_residue_specs)
        if verbose:
            log_info(f"Equivalent atom TPL automorphism scope from reference PDB: pdb_atoms={len(atoms_pdb)} mapped_tpl_atoms={len(mapped)} active_blocks={len(active_block_keys)} tpl_atoms={n}")
            if debug_residue_specs:
                log_info(f"Equivalent atom debug residue request: side={debug_side_label or '-'} specs={debug_residue_specs} matched_blocks={len(debug_block_labels)} outdir={debug_outdir}")

    group_by, _rows0 = _tpl_build_exact_automorphism_groups(
        tatoms, data.get('bonds0', []),
        bond_terms0=data.get('bond_terms0', ()),
        angle_terms0=data.get('angle_terms0', ()),
        torsion_terms0=data.get('torsion_terms0', ()),
        improper_terms0=data.get('improper_terms0', ()),
        active_block_keys=active_block_keys,
        debug_block_labels=debug_block_labels,
        debug_outdir=debug_outdir,
        debug_side_label=debug_side_label,
        verbose=verbose,
    )
    raw_group_count = len({int(x) for x in group_by.tolist() if int(x) >= 0})
    group_by = _tpl_equiv_filter_hydrogen_groups(group_by, tatoms, adj)
    rejected_rows = list(getattr(_tpl_equiv_filter_hydrogen_groups, 'last_rejected_rows', []))
    filtered_group_count = len({int(x) for x in group_by.tolist() if int(x) >= 0})
    if verbose and filtered_group_count < raw_group_count:
        log_info(f"Equivalent atom TPL stereo/hydrogen filter: kept_groups={filtered_group_count} dropped_groups={raw_group_count-filtered_group_count}")
    rows = _rows_from_tpl_equiv_groups(
        group_by, tatoms, adj,
        source='tpl_forcefield_term_automorphism',
        reason='generic atom-label and force-field-term-set preserving automorphism with stereo-safe hydrogen filtering',
    )

    # Attach rejected rows to the function so _build_equiv_context_for_side can
    # include them in equiv_atom_rejected_groups.csv without changing the public
    # return signature used elsewhere.
    _wl_equiv_groups_from_tpl.last_rejected_rows = rejected_rows

    if atoms_pdb is None:
        return group_by, rows

    assert mapped is not None
    pdb_group_old = np.full((len(atoms_pdb),), -1, dtype=np.int32)
    for pi, ti in enumerate(mapped):
        if 0 <= int(ti) < group_by.size:
            pdb_group_old[pi] = int(group_by[int(ti)])
    # Remap only groups with at least two PDB-visible atoms.  This avoids
    # singleton fragments when the PDB omits hydrogens or solvent atoms.
    by_old: dict[int, list[int]] = defaultdict(list)
    for pi, og in enumerate(pdb_group_old.tolist()):
        if int(og) >= 0:
            by_old[int(og)].append(int(pi))
    pdb_group = np.full((len(atoms_pdb),), -1, dtype=np.int32)
    gid = 0
    for _old_gid, mem in sorted(by_old.items()):
        if len(mem) < 2:
            continue
        for pi in mem:
            pdb_group[pi] = gid
        gid += 1
    mapped_rows = _rows_from_pdb_equiv_groups(
        pdb_group, atoms_pdb,
        source='tpl_forcefield_term_automorphism_mapped',
        reason='TPL full-system force-field-term automorphism remapped to reference-PDB atom subset',
        mapped_tpl=mapped, tatoms=tatoms,
    )

    # Do not add built-in amino-acid equivalence rules here.  When a TPL is
    # available, equivalence must come from the generic force-field-term
    # automorphism detector so that nonstandard residues/ligands are treated by
    # the same principle as proteins.  Built-in residue rules are kept only for
    # the explicit no-TPL fallback path below.
    gid = len({int(x) for x in pdb_group.tolist() if int(x) >= 0})
    if verbose:
        log_info(
            f"Equivalent atom TPL/PDB mapping: {Path(tpl_path).name} tpl_atoms={n} "
            f"pdb_atoms={len(atoms_pdb)} mapped_atoms={len(mapped)} mapped_groups={gid} "
            f"source=tpl_forcefield_term_automorphism"
        )
    # Map rejected rows to PDB-visible atom names only when possible.  Keeping the
    # original TPL-local rows is still useful because PDBs may omit hydrogens.
    _wl_equiv_groups_from_tpl.last_rejected_rows = rejected_rows
    return pdb_group, mapped_rows


def _tpl_validated_standard_equiv_groups_from_mapped_pdb(atoms: Sequence[AtomRec], mapped_tpl: Sequence[int], tatoms: Sequence[dict[str, object]], *, source: str = 'tpl_validated_standard_residue_rule') -> tuple[np.ndarray, list[dict[str, object]]]:
    """Build conservative standard-residue equivalence groups after a real TPL/PDB map.

    This is not a name-only fallback.  It is used only after every reference-PDB
    atom has been mapped to a TPL atom.  Candidate groups are standard chemical
    equivalences, and each member must have matching TPL force-field labels
    (atom type/charge/vdW/mass/NONBOND parameters) before the group is accepted.

    Rationale: the generic exact graph-automorphism detector is deliberately
    conservative and can fail for some real j_presto TPLs because residue-local
    Z-matrix/bonded-term labels may be written asymmetrically.  In that case,
    standard-residue groups that are explicitly verified against TPL labels are
    safer than silently running with no equivalence groups.
    """
    rules = {
        'PHE': [('CD1','CD2'), ('CE1','CE2'), ('HD1','HD2'), ('HE1','HE2')],
        'TYR': [('CD1','CD2'), ('CE1','CE2'), ('HD1','HD2'), ('HE1','HE2')],
        'ASP': [('OD1','OD2')],
        'GLU': [('OE1','OE2')],
        'ARG': [('NH1','NH2')],
        # In VAL/LEU, the two terminal methyl groups are interchangeable.  The
        # six terminal methyl hydrogens form one orbit when hydrogens are present.
        # CH2 hydrogens such as GLU HB2/HB3 are intentionally absent here.
        'VAL': [('CG1','CG2'), ('HG11','HG12','HG13','HG21','HG22','HG23')],
        'LEU': [('CD1','CD2'), ('HD11','HD12','HD13','HD21','HD22','HD23')],
    }
    def tpl_label(ti: int) -> tuple:
        ta = tatoms[int(ti)]
        nb = ta.get('nonbond_params', ()) if isinstance(ta, dict) else ()
        return (
            _element_for_equiv(str(ta.get('name','')), ta),
            str(ta.get('atom_type','')).strip(),
            _round_equiv_float(float(ta.get('charge', float('nan')))),
            _round_equiv_float(float(ta.get('vdw_radius', float('nan')))),
            _round_equiv_float(float(ta.get('mass', float('nan')))),
            tuple(_round_equiv_float(float(v)) for v in nb),
        )
    by_res: dict[tuple[str,int,str], dict[str,int]] = defaultdict(dict)
    for pi, a in enumerate(atoms):
        by_res[(a.chain, int(a.resid), a.resname.strip().upper())][a.name.strip().upper()] = int(pi)
    group_by = np.full((len(atoms),), -1, dtype=np.int32)
    rows: list[dict[str, object]] = []
    gid = 0
    for (chain, resid, resname), amap in sorted(by_res.items(), key=lambda x: (x[0][0], x[0][1], x[0][2])):
        for group in rules.get(resname, []):
            idxs = [amap.get(str(name).upper()) for name in group]
            if not all(i is not None for i in idxs):
                continue
            tids = [int(mapped_tpl[int(i)]) for i in idxs]
            if not all(0 <= ti < len(tatoms) for ti in tids):
                continue
            labels = [tpl_label(ti) for ti in tids]
            if len(set(labels)) != 1:
                # The names match a standard rule, but force-field labels do not;
                # do not guess.  The rejected CSV is for graph-derived rejects,
                # so this remains a silent non-group to avoid noisy logs.
                continue
            for i in idxs:
                group_by[int(i)] = gid
            ta0 = tatoms[tids[0]]
            rows.append({
                'group_id': gid,
                'source': source,
                'confidence': 'high',
                'molecule_id': str(ta0.get('molecule_copy_id','')),
                'molecule_name': str(ta0.get('molecule_name','')),
                'chain': chain,
                'resid': int(resid),
                'resname': resname,
                'atom_names': ';'.join(group),
                'atom_indices_A': ';'.join(str(int(i)) for i in idxs),
                'atom_indices_B': '',
                'element': _element_for_equiv(str(ta0.get('name','')), ta0),
                'atom_type': str(ta0.get('atom_type','')),
                'charge': _round_equiv_float(float(ta0.get('charge', float('nan')))),
                'vdw_radius': _round_equiv_float(float(ta0.get('vdw_radius', float('nan')))),
                'vdw_epsilon': _round_equiv_float(float(ta0.get('vdw_epsilon', float('nan')))),
                'mass': _round_equiv_float(float(ta0.get('mass', float('nan')))),
                'reason': 'standard-residue equivalence verified by explicit TPL/PDB mapping and matching TPL force-field labels',
            })
            gid += 1
    return group_by, rows



def _equiv_member_set_from_row(row: dict[str, object]) -> set[int]:
    """Return PDB-local atom indices encoded in an equivalence CSV row."""
    vals: set[int] = set()
    for key in ('atom_indices_A', 'atom_indices_B'):
        text = str(row.get(key, '') or '').strip()
        if not text:
            continue
        for x in text.split(';'):
            x = x.strip()
            if not x:
                continue
            try:
                vals.add(int(x))
            except Exception:
                pass
    return vals


def _merge_tpl_validated_standard_groups(
    base_group_by: np.ndarray,
    base_rows: list[dict[str, object]],
    std_group_by: np.ndarray,
    std_rows: list[dict[str, object]],
    *,
    prefer_standard_for_overlaps: bool = True,
) -> tuple[np.ndarray, list[dict[str, object]], dict[str, int]]:
    """Augment generic TPL automorphism groups with TPL-validated standard groups.

    Generic exact automorphism is intentionally conservative.  In real j_presto
    TPLs, Z-matrix construction order and torsion/improper records can be
    asymmetric even when the chemical/force-field orbit is unambiguous.  Standard
    amino-acid candidates are therefore added after a proven PDB->TPL map, but
    only if all members have matching explicit TPL force-field labels.  This is
    a TPL-validated augmentation, not an unvalidated name-rule fallback.
    """
    base_group_by = np.asarray(base_group_by, dtype=np.int32).copy()
    std_group_by = np.asarray(std_group_by, dtype=np.int32)
    n = int(base_group_by.size)
    if std_group_by.size != n:
        return base_group_by, list(base_rows), {'added': 0, 'skipped_duplicate': 0, 'replaced_overlap': 0}
    base_members: dict[int, set[int]] = defaultdict(set)
    for i, g in enumerate(base_group_by.tolist()):
        if int(g) >= 0:
            base_members[int(g)].add(int(i))
    existing_sets = {frozenset(v) for v in base_members.values() if len(v) >= 2}
    rows = [dict(r) for r in base_rows]
    next_gid = (max(base_members.keys()) + 1) if base_members else 0
    stats = {'added': 0, 'skipped_duplicate': 0, 'replaced_overlap': 0}
    for sr in std_rows:
        mem = sorted(_equiv_member_set_from_row(sr))
        mem = [int(i) for i in mem if 0 <= int(i) < n]
        if len(mem) < 2:
            continue
        fmem = frozenset(mem)
        if fmem in existing_sets:
            stats['skipped_duplicate'] += 1
            continue
        overlapping = {int(base_group_by[i]) for i in mem if int(base_group_by[i]) >= 0}
        if overlapping:
            if not prefer_standard_for_overlaps:
                continue
            stats['replaced_overlap'] += 1
            for og in overlapping:
                for j, g in enumerate(base_group_by.tolist()):
                    if int(g) == int(og):
                        base_group_by[j] = -1
            rows = [r for r in rows if int(r.get('group_id', -999999)) not in overlapping]
            existing_sets = {frozenset(i for i, g in enumerate(base_group_by.tolist()) if int(g) == gid)
                             for gid in set(int(x) for x in base_group_by.tolist() if int(x) >= 0)}
        gid = next_gid
        next_gid += 1
        for i in mem:
            base_group_by[i] = gid
        rr = dict(sr)
        rr['group_id'] = gid
        rr['source'] = str(rr.get('source', 'tpl_validated_standard_residue_rule_mapped'))
        rr['confidence'] = str(rr.get('confidence', 'high'))
        reason = str(rr.get('reason', ''))
        rr['reason'] = (reason + '; ' if reason else '') + 'augmented onto generic TPL graph groups after force-field-label validation'
        rows.append(rr)
        existing_sets.add(fmem)
        stats['added'] += 1
    return base_group_by.astype(np.int32), rows, stats


def _known_equiv_groups_from_atoms(atoms: Sequence[AtomRec]) -> tuple[np.ndarray, list[dict[str, object]]]:
    """Known conservative equivalences for standard residues when TPL is absent."""
    rules = {
        'PHE': [('CD1','CD2'), ('CE1','CE2'), ('HD1','HD2'), ('HE1','HE2')],
        'TYR': [('CD1','CD2'), ('CE1','CE2'), ('HD1','HD2'), ('HE1','HE2')],
        'ASP': [('OD1','OD2')],
        'GLU': [('OE1','OE2')],
        'ARG': [('NH1','NH2')],
        'VAL': [('CG1','CG2'), ('HG11','HG21'), ('HG12','HG22'), ('HG13','HG23')],
        'LEU': [('CD1','CD2'), ('HD11','HD21'), ('HD12','HD22'), ('HD13','HD23')],
    }
    by_res=defaultdict(dict)
    for idx,a in enumerate(atoms):
        by_res[(a.chain, a.resid, a.resname.strip().upper())][a.name.strip().upper()] = idx
    group_by=np.full((len(atoms),), -1, dtype=np.int32)
    rows=[]; gid=0
    for (chain,resid,resname), amap in by_res.items():
        for group in rules.get(resname, []):
            members=[amap.get(x.upper()) for x in group]
            if all(m is not None for m in members):
                for m in members: group_by[int(m)] = gid
                rows.append({'group_id': gid, 'source': 'known_amino_acid_rule', 'confidence': 'medium', 'molecule_id': '', 'molecule_name': '', 'chain': chain, 'resid': resid, 'resname': resname, 'atom_names': ';'.join(group), 'atom_indices_A': ';'.join(str(int(m)) for m in members), 'atom_indices_B': '', 'element': atoms[int(members[0])].elem, 'atom_type': '', 'charge': '', 'vdw_radius': '', 'vdw_epsilon': '', 'mass': '', 'reason': 'built-in standard-residue equivalent atom rule'})
                gid += 1
    return group_by, rows


def _load_equiv_map_file(path: Path, atoms: Sequence[AtomRec], group_by: np.ndarray, start_gid: int) -> tuple[np.ndarray, list[dict[str, object]], int]:
    """Load optional user equivalence map CSV.

    Accepted minimal columns: chain,resid,resname,atoms.  atoms is a semicolon- or
    whitespace-separated atom-name list.  This deliberately augments rather than
    overrides TPL/known groups.
    """
    rows=[]; gid=int(start_gid)
    if path is None or not Path(path).exists():
        return group_by, rows, gid
    with open(path, newline='', encoding='utf-8') as f:
        for r in csv.DictReader(f):
            chain=str(r.get('chain','')).strip()
            resid_s=str(r.get('resid','')).strip()
            resname=str(r.get('resname','')).strip().upper()
            atoms_s=str(r.get('atoms', r.get('atom_names',''))).strip()
            if not atoms_s:
                continue
            names=[x.strip().upper() for x in re.split(r'[;\s]+', atoms_s) if x.strip()]
            matches=[]
            for i,a in enumerate(atoms):
                if chain and a.chain != chain: continue
                if resid_s and str(a.resid) != resid_s: continue
                if resname and a.resname.strip().upper() != resname: continue
                if a.name.strip().upper() in names: matches.append(i)
            if len(matches) >= 2:
                for i in matches: group_by[i]=gid
                rows.append({'group_id': gid, 'source': 'user_equiv_map', 'confidence': 'user', 'molecule_id': '', 'molecule_name': '', 'chain': chain, 'resid': resid_s, 'resname': resname, 'atom_names': ';'.join(names), 'atom_indices_A': ';'.join(str(i) for i in matches), 'atom_indices_B': '', 'element': atoms[matches[0]].elem, 'atom_type': '', 'charge': '', 'vdw_radius': '', 'vdw_epsilon': '', 'mass': '', 'reason': f'user map {Path(path).name}'})
                gid += 1
    return group_by, rows, gid


def _build_equiv_context_for_side(atoms: Sequence[AtomRec], *, tpl_path: Path | None = None, equiv_map: Path | None = None, mode: str = 'aggregate', verbose: bool = True, debug_residue_specs: Sequence[tuple[str | None, int, str | None]] = (), debug_outdir: Path | None = None, debug_side_label: str = '') -> EquivContext:
    rejected_rows: list[dict[str, object]] = []
    if tpl_path is not None:
        group_by, rows = _wl_equiv_groups_from_tpl(Path(tpl_path), atoms, verbose=verbose, debug_residue_specs=debug_residue_specs, debug_outdir=debug_outdir, debug_side_label=debug_side_label)
        rejected_rows = list(getattr(_wl_equiv_groups_from_tpl, 'last_rejected_rows', []))
        if group_by.size != len(atoms):
            raise RuntimeError(
                f"Equivalent atom TPL/PDB mapping returned an invalid size for {Path(tpl_path).name}: "
                f"groups={group_by.size}, pdb_atoms={len(atoms)}. Because a TPL file was explicitly provided, "
                "DISTIL will not fall back to residue-name rules. Fix the TPL/PDB mapping or run without TPL-derived equivalence."
            )
        # If a TPL file is explicitly provided, TPL-derived equivalence is the
        # source of truth.  Falling back to name-only standard residue rules would
        # mix different equivalence definitions between A/B sides and can change
        # aggregate distributions silently.  However, a correctly mapped system
        # may legitimately have no equivalent atoms.  Stop only on mapping
        # failure; otherwise proceed with zero aggregate groups.
        if not np.any(group_by >= 0):
            _method = getattr(_equiv_try_map_pdb_atoms_to_tpl, 'last_method', 'unknown')
            _failure = getattr(_equiv_try_map_pdb_atoms_to_tpl, 'last_failure', '')
            if str(_method) == 'failed':
                raise RuntimeError(
                    f"No TPL-derived equivalent atom groups were mapped for {Path(tpl_path).name}. "
                    f"mapping_method={_method}. " + (f"mapping_failure={_failure}. " if _failure else "") +
                    "Because a TPL file was explicitly provided, fallback to unvalidated known amino-acid rules is disabled. "
                    "Check TPL/PDB atom mapping and generic force-field automorphism diagnostics."
                )
            if verbose:
                log_warn(
                    f"Equivalent atom TPL detection found no aggregate groups for {Path(tpl_path).name} "
                    f"after successful mapping_method={_method}; continuing without equivalent-atom aggregation"
                )
    else:
        group_by, rows = _known_equiv_groups_from_atoms(atoms)
    next_gid = int(np.max(group_by)) + 1 if np.any(group_by >= 0) else 0
    if equiv_map is not None:
        group_by, extra, next_gid = _load_equiv_map_file(Path(equiv_map), atoms, group_by, next_gid)
        rows.extend(extra)
    members=defaultdict(list)
    for i,g in enumerate(group_by.tolist()):
        if int(g) >= 0: members[int(g)].append(int(i))
    # Drop accidental singleton groups.
    remap={}; new_gid=0; new_group_by=np.full_like(group_by, -1)
    for old, mem in sorted(members.items()):
        if len(mem) < 2: continue
        remap[old]=new_gid
        for i in mem: new_group_by[i]=new_gid
        new_gid += 1
    for r in rows:
        try:
            og=int(r.get('group_id', -1))
            if og in remap: r['group_id']=remap[og]
            else: r['group_id']=-1
        except Exception: pass
    rows=[r for r in rows if int(r.get('group_id', -1)) >= 0]
    members=defaultdict(list)
    for i,g in enumerate(new_group_by.tolist()):
        if int(g) >= 0: members[int(g)].append(int(i))
    source={int(g): str(next((r.get('source','') for r in rows if int(r.get('group_id',-1))==int(g)), '')) for g in members}
    labels={}
    for g, mem in members.items():
        names=[atoms[i].name.strip() for i in mem]
        if mem:
            a=atoms[mem[0]]
            labels[int(g)] = f"{a.resname.strip()}{a.resid}:{{{','.join(names)}}}"
    return EquivContext(mode=str(mode), group_by_global=new_group_by.astype(np.int32), source_by_group=source, label_by_group=labels, members_by_group={int(k): list(v) for k,v in members.items()}, selected_added=[], details_rows=rows, rejected_rows=rejected_rows)


def _expand_selection_for_equiv(mask: np.ndarray, equiv: EquivContext, atoms: Sequence[AtomRec], *, label: str, enabled: bool = True) -> np.ndarray:
    mask = np.asarray(mask, dtype=bool).copy()
    equiv.selected_added.clear()
    if not enabled or equiv is None or equiv.group_by_global.size != mask.size:
        return mask
    for gid, members in sorted(equiv.members_by_group.items()):
        vals=[bool(mask[i]) for i in members]
        if any(vals) and not all(vals):
            for i in members:
                if not mask[i]:
                    mask[i]=True
                    equiv.selected_added.append((int(i), equiv.label_by_group.get(int(gid), f'group{gid}')))
    if equiv.selected_added:
        for i, lab in equiv.selected_added[:20]:
            a=atoms[int(i)]
            log_info(f"Equivalent atom selection expanded ({label}): added {a.chain}:{a.resname}{a.resid}:{a.name} for {lab}")
        if len(equiv.selected_added) > 20:
            log_info(f"Equivalent atom selection expanded ({label}): ... {len(equiv.selected_added)-20} additional atoms omitted from log")
    return mask


def _write_equiv_atom_groups(outdir: Path, equivA: EquivContext | None, equivB: EquivContext | None = None, *, selected_idxA: Sequence[int] | None = None, selected_idxB: Sequence[int] | None = None) -> None:
    outdir = Path(outdir); outdir.mkdir(parents=True, exist_ok=True)
    selected_by_side = {
        'A': None if selected_idxA is None else {int(x) for x in np.asarray(selected_idxA, dtype=np.int64).tolist()},
        'B': None if selected_idxB is None else {int(x) for x in np.asarray(selected_idxB, dtype=np.int64).tolist()},
    }
    def _row_overlaps_selected(row: dict[str, object], side: str) -> bool:
        sel = selected_by_side.get(side)
        if sel is None:
            return True
        idxs = _equiv_member_set_from_row(row)
        return bool(idxs and any(i in sel for i in idxs))

    rows=[]
    for side, eq in [('A', equivA), ('B', equivB)]:
        if eq is None:
            continue
        for r in eq.details_rows:
            if not _row_overlaps_selected(r, side):
                continue
            rr = dict(r)
            rr['side'] = side
            # Keep the side-specific index column meaningful in the CSV.  The
            # internal row creator uses atom_indices_A as a generic local index
            # field before A/B are combined.
            if side == 'B' and rr.get('atom_indices_B', '') in ('', None):
                rr['atom_indices_B'] = rr.get('atom_indices_A', '')
                rr['atom_indices_A'] = ''
            rows.append(rr)
    path=outdir/'equiv_atom_groups.csv'
    cols=['side','group_id','source','confidence','molecule_id','molecule_name','chain','resid','resname','atom_names','atom_indices_A','atom_indices_B','element','atom_type','charge','vdw_radius','vdw_epsilon','mass','reason']
    with open(path, 'w', newline='', encoding='utf-8') as f:
        w=csv.DictWriter(f, fieldnames=cols); w.writeheader()
        for r in rows: w.writerow({c: r.get(c,'') for c in cols})
    _write_json_atomic(outdir/'equiv_atom_groups.json', {'version': EQUIV_ATOMS_VERSION, 'n_rows': len(rows), 'csv': str(path.resolve())})

    rejected=[]
    for side, eq in [('A', equivA), ('B', equivB)]:
        if eq is None:
            continue
        for r in getattr(eq, 'rejected_rows', []) or []:
            # Current rejected rows are produced in TPL-global atom indices before
            # PDB remapping.  Do not compare those raw TPL indices with selected
            # PDB indices, because the numeric ranges can overlap by accident and
            # would reintroduce water/ion/excluded-hydrogen noise.  Only future
            # rejected rows explicitly marked as mapped/PDB-local are user-facing.
            if 'mapped' not in str(r.get('source', '')).lower():
                continue
            if not _row_overlaps_selected(r, side):
                continue
            rr=dict(r); rr['side']=side
            if side == 'B' and rr.get('atom_indices_B', '') in ('', None):
                rr['atom_indices_B'] = rr.get('atom_indices_A', '')
                rr['atom_indices_A'] = ''
            rejected.append(rr)
    rpath=outdir/'equiv_atom_rejected_groups.csv'
    with open(rpath, 'w', newline='', encoding='utf-8') as f:
        w=csv.DictWriter(f, fieldnames=cols); w.writeheader()
        for r in rejected: w.writerow({c: r.get(c,'') for c in cols})
    _write_json_atomic(outdir/'equiv_atom_rejected_groups.json', {'version': EQUIV_ATOMS_VERSION, 'n_rows': len(rejected), 'csv': str(rpath.resolve())})


def _selected_equiv_groups(sel_idx: np.ndarray, equiv: EquivContext | None) -> tuple[np.ndarray, dict[int, list[int]]]:
    sel_idx=np.asarray(sel_idx, dtype=np.int64)
    out=np.full((sel_idx.size,), -1, dtype=np.int32)
    members=defaultdict(list)
    if equiv is None or equiv.group_by_global.size == 0:
        return out, {}
    for k,gidx in enumerate(sel_idx.tolist()):
        if 0 <= int(gidx) < equiv.group_by_global.size:
            gid=int(equiv.group_by_global[int(gidx)])
            if gid >= 0:
                out[k]=gid; members[gid].append(k)
    return out, {int(k): list(v) for k,v in members.items()}


def _equiv_pair_key_for_atoms(a: int, b: int, sel_group: np.ndarray) -> tuple:
    ga=int(sel_group[a]) if 0 <= a < sel_group.size else -1
    gb=int(sel_group[b]) if 0 <= b < sel_group.size else -1
    da=('g',ga) if ga >= 0 else ('a',int(a))
    db=('g',gb) if gb >= 0 else ('a',int(b))
    return (da, db) if da <= db else (db, da)


def _close_and_sort_near_pairs_by_equiv(near_pairs: np.ndarray, sel_group: np.ndarray, group_members: dict[int, list[int]], *, verbose: bool = True) -> tuple[np.ndarray, np.ndarray, dict[str, object]]:
    near_pairs=np.asarray(near_pairs, dtype=np.int32)
    if near_pairs.size == 0 or sel_group.size == 0 or not group_members:
        return near_pairs, np.full((near_pairs.shape[0],), -1, dtype=np.int32), {'before': int(near_pairs.shape[0]), 'after': int(near_pairs.shape[0]), 'groups': 0}
    pair_keys=set()
    expanded=set()
    for a,b in near_pairs.tolist():
        a=int(a); b=int(b)
        ga=int(sel_group[a]) if 0 <= a < sel_group.size else -1
        gb=int(sel_group[b]) if 0 <= b < sel_group.size else -1
        as_ = group_members.get(ga, [a]) if ga >= 0 else [a]
        bs_ = group_members.get(gb, [b]) if gb >= 0 else [b]
        for x in as_:
            for y in bs_:
                if int(x) == int(y): continue
                aa,bb=(int(x),int(y)) if int(x)<int(y) else (int(y),int(x))
                expanded.add((aa,bb))
    # Group and sort by pair key to keep equivalent members adjacent for Stage1 chunking.
    key_to_pairs=defaultdict(list)
    for a,b in expanded:
        key=_equiv_pair_key_for_atoms(a,b,sel_group)
        key_to_pairs[key].append((a,b))
    sorted_items=sorted(key_to_pairs.items(), key=lambda kv: repr(kv[0]))
    pairs=[]; gids=[]; gid=0
    for key, plist in sorted_items:
        plist=sorted(set(plist))
        has_equiv=any(part[0]=='g' for part in key)
        this_gid = gid if has_equiv and len(plist) >= 1 else -1
        if this_gid >= 0: gid += 1
        for p in plist:
            pairs.append(p); gids.append(this_gid)
    arr=np.asarray(pairs, dtype=np.int32) if pairs else np.zeros((0,2), dtype=np.int32)
    garr=np.asarray(gids, dtype=np.int32) if gids else np.zeros((0,), dtype=np.int32)
    info={'before': int(near_pairs.shape[0]), 'after': int(arr.shape[0]), 'groups': int(gid)}
    if verbose and (info['after'] != info['before'] or info['groups']):
        log_info(f"Equivalent near closure: near_pairs {info['before']} -> {info['after']} equiv_pair_groups={info['groups']}")
    return arr, garr, info


def _feature_chunk_ranges_group_safe(M: int, chunk: int, group_id: np.ndarray | None) -> list[np.ndarray]:
    M=int(M); chunk=max(1,int(chunk))
    gids=np.asarray(group_id, dtype=np.int32) if group_id is not None and np.asarray(group_id).size == M else np.full((M,), -1, dtype=np.int32)
    out=[]; s=0
    while s < M:
        e=min(M, s+chunk)
        if e < M and gids[e-1] >= 0:
            g=int(gids[e-1])
            while e < M and int(gids[e]) == g:
                e += 1
        out.append(np.arange(s,e,dtype=np.int64)); s=e
    return out


def _local_ranges_group_safe(n: int, base: int, local_fids: np.ndarray, global_group_id: np.ndarray | None) -> list[tuple[int,int]]:
    n=int(n); base=max(1,int(base)); fids=np.asarray(local_fids,dtype=np.int64)
    if global_group_id is None or np.asarray(global_group_id).size == 0:
        return [(s,min(n,s+base)) for s in range(0,n,base)]
    gids=np.asarray(global_group_id,dtype=np.int32)
    out=[]; s=0
    while s<n:
        e=min(n,s+base)
        if e<n:
            fid=int(fids[e-1]); g=int(gids[fid]) if 0 <= fid < gids.size else -1
            if g>=0:
                while e<n:
                    fid2=int(fids[e]); g2=int(gids[fid2]) if 0 <= fid2 < gids.size else -2
                    if g2 != g: break
                    e+=1
        out.append((s,e)); s=e
    return out


def _equiv_group_member_local_indices(sub_fids: np.ndarray, pair_meta: TopPairsMeta) -> dict[int, list[int]]:
    out=defaultdict(list)
    gids=getattr(pair_meta, 'equiv_group_id', None)
    if gids is None:
        return {}
    for loc,fid in enumerate(np.asarray(sub_fids,dtype=np.int64).tolist()):
        if 0 <= int(fid) < len(pair_meta):
            g=int(gids[int(fid)])
            if g>=0: out[g].append(int(loc))
    return {int(k): v for k,v in out.items() if len(v) >= 2}


def _compute_feature_stat_equiv_mixture_from_values(*, fid:int, kind:int, id_str:str, local_idx:int, XA:np.ndarray, XB:np.ndarray, member_locals:list[int], wA:np.ndarray, wB:np.ndarray, bins_max:int, bins_min_neff_per_bin:float, tv_threshold:float, idxA_bins:np.ndarray|None=None, idxB_bins:np.ndarray|None=None, use_full_range:bool=False) -> FeatureStat:
    """FeatureStat with TV/range from an equivalent-group mixture distribution.

    Raw physical distance columns are not changed.  The target feature keeps its
    own mean/std, while TV/min/max/bins are computed from all equivalent member
    columns with per-member frame weights divided by member_count.
    """
    locs=np.asarray(member_locals if member_locals else [int(local_idx)], dtype=np.int64)
    m=max(1,int(locs.size))
    xA_raw=np.asarray(XA[:, int(local_idx)], dtype=np.float64)
    xB_raw=np.asarray(XB[:, int(local_idx)], dtype=np.float64)
    XA_mix=np.asarray(XA[:, locs], dtype=np.float64).reshape(-1)
    XB_mix=np.asarray(XB[:, locs], dtype=np.float64).reshape(-1)
    wA_mix=np.repeat(np.asarray(wA,dtype=np.float64)/float(m), m)
    wB_mix=np.repeat(np.asarray(wB,dtype=np.float64)/float(m), m)
    idxA_bins=np.asarray(idxA_bins if idxA_bins is not None else np.zeros((0,),dtype=np.int64), dtype=np.int64)
    idxB_bins=np.asarray(idxB_bins if idxB_bins is not None else np.zeros((0,),dtype=np.int64), dtype=np.int64)
    if use_full_range or (idxA_bins.size==0 and idxB_bins.size==0):
        xs=np.concatenate([XA_mix, XB_mix])
    else:
        # expand frame indices to flattened mixture indices
        ia=np.concatenate([idxA_bins*m + k for k in range(m)]) if idxA_bins.size else np.zeros((0,),dtype=np.int64)
        ib=np.concatenate([idxB_bins*m + k for k in range(m)]) if idxB_bins.size else np.zeros((0,),dtype=np.int64)
        xs=np.concatenate([XA_mix[ia], XB_mix[ib]])
    if xs.size == 0:
        return FeatureStat(fid=fid, kind=kind, id_str=id_str, tv=0.0, passed_tv=False, bins=1, n_eff=0, meanA=0.0, meanB=0.0, stdA=0.0, stdB=0.0, minv=0.0, maxv=0.0)
    x_min,x_max=_winsor_limits_from_sample(xs, q=_TV_WINSOR_Q)
    if x_max <= x_min: x_max=x_min+1e-6
    # Choose histogram resolution from the number of independent structures,
    # not from the expanded member-counted mixture.  The mixture contributes
    # multiple distances per structure but these are not independent samples.
    bins_used, _na, _nb, neff = _stagec_bins_from_weights(np.asarray(wA, dtype=np.float64), np.asarray(wB, dtype=np.float64), bins_max, bins_min_neff_per_bin)
    pA=_hist_prob_uniform_clip(XA_mix, wA_mix, bins=bins_used, x_min=x_min, x_max=x_max)
    pB=_hist_prob_uniform_clip(XB_mix, wB_mix, bins=bins_used, x_min=x_min, x_max=x_max)
    tv=max(0.0, min(1.0, 1.0-float(np.minimum(pA,pB).sum())))
    transport_w1, transport_signed, transport_ratio = _directional_transport_from_prob(pA, pB, x_min=float(x_min), x_max=float(x_max))
    meanA,stdA=_weighted_mean_std(xA_raw, wA)
    meanB,stdB=_weighted_mean_std(xB_raw, wB)
    minv=float(min(x_min, float(np.min(XA_mix)) if XA_mix.size else x_min, float(np.min(XB_mix)) if XB_mix.size else x_min))
    maxv=float(max(x_max, float(np.max(XA_mix)) if XA_mix.size else x_max, float(np.max(XB_mix)) if XB_mix.size else x_max))
    return FeatureStat(fid=fid, kind=kind, id_str=id_str, tv=float(tv), passed_tv=bool(tv>=float(tv_threshold)), bins=int(bins_used), n_eff=int(neff), meanA=meanA, meanB=meanB, stdA=stdA, stdB=stdB, minv=minv, maxv=maxv, transport_w1=float(transport_w1), transport_signed=float(transport_signed), transport_ratio=float(transport_ratio))


def _topology_excluded_relations_label(exclude_up_to: int) -> str:
    """Human-readable relation label for a bond-distance exclusion cutoff."""
    n = int(exclude_up_to or 0)
    if n <= 0:
        return "none"
    labels = [f"1-{k + 1}" for k in range(1, n + 1)]
    return ",".join(labels)


def _filter_near_pairs_with_tpl_system(near_pairs: np.ndarray, atoms_sel: Sequence[AtomRec], tpl_data: dict, exclude_up_to: int) -> np.ndarray:
    """Return a keep mask after topology-based near-pair exclusion.

    The bonded-neighbor relation is evaluated on the full topology graph from
    the *.tpl bonds, not on the atom subset selected for DISTIL features.  This
    keeps the meaning of ``--tpl-exclude-up-to`` independent of atom selection:
    for example, a Cα-only analysis still recognizes that adjacent Cα atoms are
    three bonds apart through CA-C-N-CA in the full molecular topology.

    ``exclude_up_to`` is a maximum shortest-path distance in bonds:
      1 => exclude 1-2 pairs,
      2 => exclude 1-2 and 1-3 pairs,
      3 => also exclude 1-4 pairs.
    """
    near_pairs = np.asarray(near_pairs, dtype=np.int64)
    bonds = tpl_data.get("bonds", [])
    N = int(exclude_up_to or 0)
    if not bonds or N <= 0 or near_pairs.shape[0] <= 0:
        return np.ones(near_pairs.shape[0], dtype=bool)

    # Build the graph from all topology atoms present in the *.tpl bond list.
    # Do NOT restrict this graph to atoms_sel; otherwise Cα-only or backbone-only
    # analyses lose intermediate atoms and silently change the exclusion rule.
    adj: dict[int, list[int]] = defaultdict(list)
    for i1, j1 in bonds:
        i = int(i1); j = int(j1)
        if i <= 0 or j <= 0 or i == j:
            continue
        adj[i].append(j)
        adj[j].append(i)

    selected_idx1 = [int(a.idx1) for a in atoms_sel]
    selected_set = set(selected_idx1)
    reach_by_idx1: dict[int, set[int]] = {}
    from collections import deque as _dq
    for start in sorted(selected_set):
        q = _dq([(start, 0)])
        seen = {start}
        reach_selected: set[int] = set()
        while q:
            v, dist = q.popleft()
            if dist >= N:
                continue
            for nb in adj.get(v, []):
                if nb in seen:
                    continue
                seen.add(nb)
                if nb in selected_set:
                    reach_selected.add(nb)
                q.append((nb, dist + 1))
        reach_by_idx1[start] = reach_selected

    mask = np.ones(near_pairs.shape[0], dtype=bool)
    n_sel = len(selected_idx1)
    for k in range(int(near_pairs.shape[0])):
        i = int(near_pairs[k, 0]); j = int(near_pairs[k, 1])
        if i < 0 or j < 0 or i >= n_sel or j >= n_sel:
            raise IndexError(f"near pair index out of selected-atom range: pair=({i},{j}) n_selected={n_sel}")
        ai = selected_idx1[i]
        aj = selected_idx1[j]
        if aj in reach_by_idx1.get(ai, set()):
            mask[k] = False
    return mask
@dataclass(frozen=True)
class AtomRec:
    idx1: int        # PDB通し番号(1始まり)
    name: str        # 原子名 (例: CA, CB, O, N)
    resname: str     # 残基名
    chain: str       # 鎖ID (空可)
    resid: int       # 残基番号（挿入コード無視）
    x: float; y: float; z: float
    elem: str        # 元素（PDB列 77-78。無ければ推定）
def _infer_element_from_fields(name: str, resname: str, elem_field: str) -> str:
    # element欄があれば最優先
    if elem_field:
        return elem_field.strip().upper()
    up_name = name.strip().upper()
    up_res  = resname.strip().upper()
    # 典型イオン/金属のRES名は name を元素として採用（CA/ZN/MG/NA/CL/K/LI/FE/CU/MN 等）
    ionic_res = {"CA","ZN","MG","NA","CL","K","LI","FE","CU","MN","BR","SR","BA","CO","NI"}
    if up_res in ionic_res and up_name in ionic_res:
        return up_name
    # それ以外は原子名の先頭英字を元素とみなす（CA, CB などは C）
    for ch in up_name:
        if 'A' <= ch <= 'Z':
            return ch
    return 'X'  # 保険
def load_pdb_atoms_one(pdb_path: Path) -> list[AtomRec]:
    """Load ATOM/HETATM records from a reference PDB.

    Primary: strict fixed-width PDB parsing (classic 80-column).
    Fallback: whitespace-delimited "PDB-like" lines, e.g.
        ATOM 1 N THR 1 0.720 -33.004 -10.718 ...

    This is needed because some ref.pdb variants omit chain/occupancy/B-factor/element
    and do not align coordinates to PDB columns 31-54.
    """
    pdb_path = Path(pdb_path).expanduser().resolve()
    out: list[AtomRec] = []
    with _open_text_maybe_gz(pdb_path) as f:
        for line in f:
            # Use the same left-stripped line for both record detection and parsing.
            s = line.lstrip(" \t")
            rec = _pdb_rec_name(s)
            if not (rec == "ATOM" or rec == "HETATM"):
                continue

            # 1) Fixed-width PDB / j_presto-PDB (preferred).
            #
            # j_presto reads template/reference PDB records with the Fortran
            # format
            #   (6x,i6,a4,x,a4,a1,i8,3f8.3,2f6.3)
            # in src_Ens_Ana/intmp.f90.  In particular, the residue-name field
            # is four characters wide (a4), so protonation/charge labels such as
            # ``LYS+`` and ``GLU-`` must be preserved.  A standard 3-letter PDB
            # slice (line[17:20]) would silently convert ``LYS+`` to ``LYS`` and
            # break strict PDB<->TPL residue-block mapping.
            try:
                idx1   = int(s[6:12])
                name   = s[12:16].strip()
                resn   = s[17:21].strip()
                chain  = s[21:22].strip()
                resid  = int(s[22:30])
                x      = float(s[30:38]); y = float(s[38:46]); z = float(s[46:54])
                elem_f = (s[76:78].strip().upper() if len(s) >= 78 else '')
                elem   = _infer_element_from_fields(name, resn, elem_f)
                out.append(AtomRec(idx1, name, resn, chain, resid, x, y, z, elem))
                continue
            except Exception:
                pass

            # 2) Whitespace-delimited fallback.
            try:
                parts = s.split()
                # minimum: REC serial name resn resid x y z
                if len(parts) < 8:
                    continue
                idx1 = int(parts[1])
                name = parts[2]
                resn = parts[3]

                chain = ""
                # Pattern A: ATOM 1 CA ALA 10 x y z
                # Pattern B: ATOM 1 CA ALA A 10 x y z
                p4 = parts[4]
                if (p4.isalpha() and len(p4) <= 2) and len(parts) >= 9:
                    chain = p4
                    resid = int(parts[5])
                    x = float(parts[6]); y = float(parts[7]); z = float(parts[8])
                else:
                    resid = int(p4)
                    x = float(parts[5]); y = float(parts[6]); z = float(parts[7])

                elem = _infer_element_from_fields(name, resn, "")
                out.append(AtomRec(idx1, name, resn, chain, resid, x, y, z, elem))
            except Exception:
                continue
    if not out:
        raise ValueError(f"No atoms found in PDB: {pdb_path}")
    return out

def _wildcard_match_pos(pattern: str, values: Sequence[str]) -> np.ndarray:
    if pattern == '*':
        return np.ones(len(values), dtype=bool)
    if pattern.endswith('*'):
        pref = pattern[:-1]
        return np.fromiter((v.startswith(pref) for v in values),
                           count=len(values), dtype=bool)
    return np.fromiter((v == pattern for v in values),
                       count=len(values), dtype=bool)
def _mask_names(spec_list: str, values: Sequence[str]) -> np.ndarray:
    """
    spec_list例: 'CA' / 'N,CA,C,O' / 'C*' / '!H*,h*'
    否定トークン（'!'）が1つでも含まれる場合は「ALL − union(否定対象)」。
    ※比較はケースセンシティブ（H* と h* は別物）。
    """
    toks = [t.strip() for t in spec_list.split(',') if t.strip()]
    if not toks:
        return np.ones(len(values), dtype=bool)
    has_neg = any(t.startswith('!') for t in toks)
    if has_neg:
        neg_union = np.zeros(len(values), dtype=bool)
        for t in toks:
            if t.startswith('!'):
                pat = t[1:]  # '!'を外して肯定マッチを作る
                neg_union |= _wildcard_match_pos(pat, values)
        return ~neg_union
    # 肯定のみ: 和集合
    m = np.zeros(len(values), dtype=bool)
    for t in toks:
        m |= _wildcard_match_pos(t, values)
    return m
def _mask_id_ranges(s: str, ids: Sequence[int]) -> np.ndarray:
    m = np.zeros(len(ids), dtype=bool)
    for tok in [t.strip() for t in s.split(',') if t.strip()]:
        if '<' in tok:
            a,b = tok.split('<',1)
            a = int(a); b = int(b)
            m |= (np.asarray(ids)>=a) & (np.asarray(ids)<=b)
        else:
            try:
                v = int(tok)
                m |= (np.asarray(ids)==v)
            except ValueError:
                pass
    return m
def _mask_res(sel: str, resnames: Sequence[str], resids: Sequence[int]) -> np.ndarray:
    rr = np.asarray(resids)
    m = np.zeros(rr.size, dtype=bool)
    name_toks: list[str] = []
    for tok in [t.strip() for t in str(sel).split(',') if t.strip()]:
        if '<' in tok:
            a, b = tok.split('<', 1)
            a = int(a); b = int(b)
            m |= (rr >= a) & (rr <= b)
        elif re.fullmatch(r'-?\d+', tok):
            m |= (rr == int(tok))
        else:
            name_toks.append(tok)
    if name_toks:
        m |= _mask_names(','.join(name_toks), list(resnames))
    return m
def _parse_range_expr(expr: str, arr: np.ndarray) -> np.ndarray:
    expr = expr.strip()
    if not expr:
        return np.ones(arr.size, dtype=bool)
    out = np.zeros(arr.size, dtype=bool)
    for p in [t.strip() for t in expr.split(',') if t.strip()]:
        if '<' in p:
            a,b = p.split('<',1)
            lo = -np.inf if a=='' else float(a)
            hi =  np.inf if b=='' else float(b)
            out |= (arr>=lo) & (arr<=hi)
        else:
            try:
                v = float(p); out |= (arr==v)
            except ValueError:
                pass
    return out
def _mask_coord_block(body: str, atoms: Sequence[AtomRec]) -> np.ndarray:
    xs = np.fromiter((a.x for a in atoms), count=len(atoms), dtype=float)
    ys = np.fromiter((a.y for a in atoms), count=len(atoms), dtype=float)
    zs = np.fromiter((a.z for a in atoms), count=len(atoms), dtype=float)
    parts = (body.split(':') + ['',''])[:3]
    mx = _parse_range_expr(parts[0], xs)
    my = _parse_range_expr(parts[1], ys)
    mz = _parse_range_expr(parts[2], zs)
    return mx & my & mz
def _eval_block(blk: str, atoms: Sequence[AtomRec]) -> np.ndarray:
    blk = blk.strip()
    if blk.startswith('[') and blk.endswith(']'):
        return _mask_coord_block(blk[1:-1], atoms)
    parts = blk.split(':')
    names = [a.name for a in atoms]
    resns = [a.resname for a in atoms]
    chains = [a.chain for a in atoms]
    resids = [a.resid for a in atoms]
    if len(parts) == 1:
        # IDレンジ or 原子名リスト
        s = parts[0]
        if re.search(r'\d', s):
            m_id = _mask_id_ranges(s, [a.idx1 for a in atoms])
            if m_id.any():
                return m_id
        return _mask_names(s, names)
    elif len(parts) == 2:
        m_res  = _mask_res(parts[0], resns, resids)
        m_atom = _mask_names(parts[1], names)
        return m_res & m_atom
    elif len(parts) == 3:
        m_chain = _mask_names(parts[0], chains)
        m_res   = _mask_res(parts[1], resns, resids)
        m_atom  = _mask_names(parts[2], names)
        return m_chain & m_res & m_atom
    else:
        raise SystemExit(f"[atom-spec] Too many ':' in block: {blk}")

# Tokenizer for atom-spec expressions: operators '(', ')', '&', '|'
_tok_pat = re.compile(r"\s*([()&|])\s*")

def eval_atom_specifier(spec: str, atoms: Sequence[AtomRec]) -> np.ndarray:
    tokens: list[str] = []
    i = 0
    while i < len(spec):
        m = _tok_pat.match(spec, i)
        if m:
            tokens.append(m.group(1)); i = m.end()
        else:
            j = i
            while j < len(spec) and not _tok_pat.match(spec, j):
                j += 1
            tokens.append(spec[i:j].strip()); i = j
    def parse_expr(k: int):
        mask, k = parse_term(k)
        while k < len(tokens) and tokens[k] == '|':
            rhs, k = parse_term(k+1); mask = mask | rhs
        return mask, k
    def parse_term(k: int):
        mask, k = parse_factor(k)
        while k < len(tokens) and tokens[k] == '&':
            rhs, k = parse_factor(k+1); mask = mask & rhs
        return mask, k
    def parse_factor(k: int):
        if tokens[k] == '(':
            inner, k2 = parse_expr(k+1)
            if k2 >= len(tokens) or tokens[k2] != ')':
                raise SystemExit("[atom-spec] Unmatched '('")
            return inner, k2+1
        return _eval_block(tokens[k], atoms), k+1
    mask, kfin = parse_expr(0)
    if kfin != len(tokens):
        raise SystemExit("[atom-spec] Trailing tokens")
    return mask

def _parse_dist_plot_pairs_arg(spec: str) -> list[tuple[str, str]]:
    spec = str(spec or '').strip()
    if not spec:
        raise SystemExit("[dist-plot] --dist-plot-pair requires at least one pair specification")
    out: list[tuple[str, str]] = []
    for chunk in spec.split(';'):
        chunk = chunk.strip()
        if not chunk:
            continue
        parts = [p.strip() for p in chunk.split(',')]
        if len(parts) != 2 or (not parts[0]) or (not parts[1]):
            raise SystemExit(f"[dist-plot] invalid pair specification: {chunk!r} (expected 'atom1,atom2')")
        out.append((parts[0], parts[1]))
    if not out:
        raise SystemExit("[dist-plot] --dist-plot-pair did not contain any valid pair specification")
    return out

def _resolve_single_dist_plot_atom(selector: str, atoms: Sequence[AtomRec]) -> int:
    try:
        mask = eval_atom_specifier(selector, atoms)
    except SystemExit as e:
        raise SystemExit(f"DISTIL error: dist-plot atom selector {selector!r} failed to parse: {e}")
    idx = np.where(mask)[0]
    if idx.size == 0:
        raise SystemExit(f"DISTIL error: dist-plot atom selector {selector!r} matched 0 atoms")
    if idx.size != 1:
        raise SystemExit(f"DISTIL error: dist-plot atom selector {selector!r} matched {int(idx.size)} atoms; dist-plot mode requires exactly 1 atom per selector")
    return int(idx[0])

def _sanitize_dist_plot_token(token: str) -> str:
    s = re.sub(r'[^A-Za-z0-9_.-]+', '_', str(token).strip())
    s = s.strip('_')
    return s or 'atom'

def _run_dist_plot_mode(*, args, outdir: Path, atomsA_sel: Sequence[AtomRec], atomsB_sel: Sequence[AtomRec], framesA: np.ndarray, framesB: np.ndarray, wA: np.ndarray, wB: np.ndarray) -> None:
    pair_specs = _parse_dist_plot_pairs_arg(getattr(args, 'dist_plot_pair', ''))
    framesA = np.asarray(framesA)
    framesB = np.asarray(framesB)
    wA = np.asarray(wA, dtype=np.float64)
    wB = np.asarray(wB, dtype=np.float64)
    if int(framesA.shape[0]) != int(wA.size) or int(framesB.shape[0]) != int(wB.size):
        raise SystemExit(
            f"[dist-plot] frame/weight alignment mismatch: "
            f"A frames={int(framesA.shape[0])} weights={int(wA.size)}; "
            f"B frames={int(framesB.shape[0])} weights={int(wB.size)}"
        )
    plots_dir = outdir / 'dist_plots'
    plots_dir.mkdir(parents=True, exist_ok=True)
    bins_max = int(getattr(args, 'bins_max', 128) or 128)
    plot_fmt = str(getattr(args, 'plot_format', 'png') or 'png').lower()
    plot_dpi = int(getattr(args, 'plot_dpi', 150) or 150)
    log_info(f"[dist-plot] plotting {len(pair_specs)} pair(s) -> {plots_dir} frames_A={int(framesA.shape[0])} frames_B={int(framesB.shape[0])}")
    dist_plot_logger = _progress_logger('dist-plot/pairs', total_units=max(1, len(pair_specs)), min_interval_sec=float(getattr(args, 'progress_interval_sec', 300.0) or 300.0))
    for idx, (sel1, sel2) in enumerate(pair_specs, start=1):
        iA = _resolve_single_dist_plot_atom(sel1, atomsA_sel)
        jA = _resolve_single_dist_plot_atom(sel2, atomsA_sel)
        iB = _resolve_single_dist_plot_atom(sel1, atomsB_sel)
        jB = _resolve_single_dist_plot_atom(sel2, atomsB_sel)
        a1A = atomsA_sel[iA]; a2A = atomsA_sel[jA]
        a1B = atomsB_sel[iB]; a2B = atomsB_sel[jB]
        dA = np.linalg.norm(framesA[:, iA, :] - framesA[:, jA, :], axis=1).astype(np.float64, copy=False)
        dB = np.linalg.norm(framesB[:, iB, :] - framesB[:, jB, :], axis=1).astype(np.float64, copy=False)
        xs = np.concatenate([dA, dB])
        x_min, x_max = _winsor_limits_from_sample(xs, q=_TV_WINSOR_Q)
        if not np.isfinite(x_min) or not np.isfinite(x_max) or x_max <= x_min:
            x_min = float(np.min(xs)) if xs.size else 0.0
            x_max = float(np.max(xs)) if xs.size else 1.0
            if not np.isfinite(x_min):
                x_min = 0.0
            if not np.isfinite(x_max) or x_max <= x_min:
                x_max = x_min + 1e-6
        bins_min_neff_per_bin = float(getattr(args, 'bins_min_neff_per_bin', 30.0) or 0.0)
        bins_used, neffA, neffB, _neff = _stagec_bins_from_weights(np.asarray(wA, dtype=np.float64), np.asarray(wB, dtype=np.float64), bins_max, bins_min_neff_per_bin)
        pA = _hist_prob_uniform_clip(dA, np.asarray(wA, dtype=np.float64), bins=bins_used, x_min=x_min, x_max=x_max)
        pB = _hist_prob_uniform_clip(dB, np.asarray(wB, dtype=np.float64), bins=bins_used, x_min=x_min, x_max=x_max)
        tv = 0.5 * float(np.sum(np.abs(pA - pB)))
        edges = np.linspace(x_min, x_max, bins_used + 1, dtype=np.float64)
        centers = 0.5 * (edges[:-1] + edges[1:])
        plt.figure()
        plt.plot(centers, pA, label='A')
        plt.plot(centers, pB, label='B')
        plt.title(f"dist-plot {idx}: {sel1} , {sel2}\nTV={tv:.3f}, bins={bins_used}, N_eff_A={neffA:.1f}, N_eff_B={neffB:.1f}")
        plt.xlabel('Distance (Å)')
        plt.ylabel('Probability')
        plt.legend()
        plt.tight_layout()
        stem = f"distplot_{idx:03d}__{_sanitize_dist_plot_token(sel1)}__{_sanitize_dist_plot_token(sel2)}"
        out_path = plots_dir / f"{stem}.{plot_fmt}"
        if plot_fmt == 'png':
            plt.savefig(out_path, dpi=plot_dpi)
        else:
            plt.savefig(out_path)
        plt.close()
        log_info(f"[dist-plot] {idx}/{len(pair_specs)} {sel1} , {sel2} -> {out_path.name} (TV={tv:.3f}, A={a1A.chain}{a1A.resid}:{a1A.name}-{a2A.chain}{a2A.resid}:{a2A.name}, B={a1B.chain}{a1B.resid}:{a1B.name}-{a2B.chain}{a2B.resid}:{a2B.name})")
        dist_plot_logger(idx, active=int(idx), force=(idx == len(pair_specs)))


def _uniform_bin_index_clip_vector(x: np.ndarray, *, bins: int, x_min: float, x_max: float) -> np.ndarray:
    bins = max(1, int(bins))
    x = np.asarray(x, dtype=np.float64)
    if x.size == 0:
        return np.zeros((0,), dtype=np.int64)
    if not (float(x_max) > float(x_min)):
        return np.zeros((x.size,), dtype=np.int64)
    bw = (float(x_max) - float(x_min)) / float(bins)
    idx = np.floor((x - float(x_min)) / bw).astype(np.int64)
    idx[idx < 0] = 0
    idx[idx >= bins] = bins - 1
    return idx


def _iter_source_frame_numbers_from_counts(counts: list[tuple[Path, int, tuple[int, int]]], *, frame_stride: int) -> list[tuple[Path, int]]:
    step = max(1, int(frame_stride) if int(frame_stride) > 0 else 1)
    out: list[tuple[Path, int]] = []
    for p, _ncopy, (ist, ien) in counts:
        for fr in range(int(ist), int(ien) + 1, step):
            out.append((Path(p), int(fr)))
    return out


def _read_single_cod_frame(cod_path: Path, natom: int, *, source_frame_no: int) -> np.ndarray:
    target = int(source_frame_no)
    if target < 1:
        raise ValueError(f'source_frame_no must be >=1, got {target}')
    for frame_no, coords, _header in _iter_cod_frame_records(Path(cod_path), natom, sel_idx=None):
        if int(frame_no) == target:
            return np.array(coords, dtype=np.float32, copy=False)
    raise IndexError(f'Frame {target} not found in {cod_path}')


def _write_fullframe_pdb_from_reference(*, ref_lines: Sequence[str], coords_full: np.ndarray, out_pdb: Path) -> None:
    atom_counter = -1
    with open(out_pdb, 'w', encoding='utf-8') as fo:
        for line in ref_lines:
            sline = line.lstrip(' 	')
            rec = _pdb_rec_name(sline)
            if not (rec == 'ATOM' or rec == 'HETATM'):
                fo.write(line)
                continue
            atom_counter += 1
            line2 = line.rstrip('\n')
            if len(line2) < 80:
                line2 = line2.ljust(80)
            if 0 <= atom_counter < int(coords_full.shape[0]):
                x, y, z = [float(v) for v in coords_full[atom_counter]]
                line2 = line2[:30] + f"{x:8.3f}{y:8.3f}{z:8.3f}" + line2[54:]
            fo.write(line2 + '\n')


def _read_csv_rows_by_fid(path: Path) -> dict[int, dict[str, str]]:
    out: dict[int, dict[str, str]] = {}
    with open(path, 'r', encoding='utf-8') as f:
        for row in csv.DictReader(f):
            try:
                fid = int(row.get('fid', ''))
            except Exception:
                continue
            out[int(fid)] = dict(row)
    return out



def _repr_float(row: dict[str, str], key: str, default: float = float('nan')) -> float:
    try:
        v = row.get(key, '')
        if v is None or str(v).strip() == '':
            return float(default)
        return float(v)
    except Exception:
        return float(default)


def _repr_bool(row: dict[str, str], *keys: str) -> bool:
    for key in keys:
        if key in row:
            v = str(row.get(key, '')).strip().lower()
            if v in ('1', 'true', 'yes', 'y', 'on'):
                return True
            try:
                return float(v) != 0.0
            except Exception:
                return False
    return False


def _repr_certify_order(S: np.ndarray, *, remaining_weight: float, total_weight: float, top_n: int, want_high: bool) -> tuple[np.ndarray, np.ndarray, np.ndarray, bool]:
    """Return order/lower/upper and whether the top-N order is certified.

    Certification is order-level, not just membership-level.  The remaining
    unprocessed feature contribution is bounded conservatively by +/- the
    remaining feature-weight mass because each per-feature enrichment term
    pB(bin)-pA(bin) lies in [-1, 1].
    """
    S = np.asarray(S, dtype=np.float64)
    W = float(total_weight) if float(total_weight) > 0.0 else 1.0
    rem = max(0.0, float(remaining_weight))
    lower = (S - rem) / W
    upper = (S + rem) / W
    n = min(max(0, int(top_n)), int(S.size))
    if n <= 0 or S.size == 0:
        return np.zeros((0,), dtype=np.int64), lower, upper, True
    order_all = np.argsort(S)
    if want_high:
        order_all = order_all[::-1]
    order = np.asarray(order_all[:n], dtype=np.int64)
    if rem <= 0.0:
        return order, lower, upper, True
    # Adjacent ranks must be fixed in order, and rank N must be separated from
    # all non-selected frames.  This is stricter than membership certification.
    certified = True
    if want_high:
        for k in range(n - 1):
            if not (lower[int(order[k])] > upper[int(order[k + 1])]):
                certified = False
                break
        if certified and n < int(S.size):
            rest = np.asarray(order_all[n:], dtype=np.int64)
            if rest.size > 0 and not (lower[int(order[-1])] > float(np.max(upper[rest]))):
                certified = False
    else:
        for k in range(n - 1):
            if not (upper[int(order[k])] < lower[int(order[k + 1])]):
                certified = False
                break
        if certified and n < int(S.size):
            rest = np.asarray(order_all[n:], dtype=np.int64)
            if rest.size > 0 and not (upper[int(order[-1])] < float(np.min(lower[rest]))):
                certified = False
    return order, lower, upper, bool(certified)


def _build_representative_feature_source(outdir: Path, args, countsA, countsB, wA: np.ndarray, wB: np.ndarray) -> dict:
    stage1_scoring_dir = Path(outdir) / 'distil_cache' / 'stage1_scoring'
    scratch_dir = stage1_scoring_dir / 'ckpt' / 'scratch'
    io_feat_chunk = int(max(1, max(int(getattr(args, 'feat_chunk', 1) or 1), 2048)))
    fallback = None
    if scratch_dir.exists():
        fallback = {
            'kind': 'stage1_scratch',
            'scratch_dir': str(scratch_dir),
            'io_feat_chunk': int(io_feat_chunk),
            'nA': int(np.asarray(wA).size),
            'nB': int(np.asarray(wB).size),
        }
    direct_store = stage1_scoring_dir / 'stage3_direct_distances'
    if (direct_store / 'manifest.json').exists() and (direct_store / 'parts').exists():
        source = {
            'kind': 'stage1_direct_store',
            'store_dir': str(direct_store),
            'nA': int(np.asarray(wA).size),
            'nB': int(np.asarray(wB).size),
            'fallback_source': fallback,
        }
        log_info(f'[repr] selected-feature source: stage1_direct_store path={direct_store} fallback={"yes" if fallback is not None else "no"}')
        return source
    if fallback is not None:
        log_warn('[repr] using chunked Stage1 scratch source; representative extraction may be slower than direct-store mode.')
        return fallback
    raise SystemExit('[DISTIL] Missing Stage1 selected-feature distance source for representative extraction: no direct store or scratch artifacts found.')


def _extract_representatives_mode(*, args, outdir: Path, countsA, countsB, natomA_full: int, natomB_full: int,
                                  refA_path: Path, refB_path: Path, wA: np.ndarray, wB: np.ndarray,
                                  frame_keep_maskA: np.ndarray | None = None, frame_keep_maskB: np.ndarray | None = None) -> None:
    top_n = int(getattr(args, 'extract_representatives', 0) or 0)
    if top_n <= 0:
        return
    outdir = Path(outdir)
    pair_scores_csv = outdir / 'pair_scores.csv'
    pair_contrib_csv = outdir / 'pair_contrib.csv'
    top_pairs_csv = outdir / 'top_pairs_pool.csv'
    pair_index_path = outdir / 'pair_index.npy'
    feat_meta_path = outdir / FEATURES_META_JSON
    if not pair_scores_csv.exists():
        raise SystemExit('[DISTIL] Missing pair_scores.csv for representative extraction.')
    if not pair_contrib_csv.exists():
        raise SystemExit('[DISTIL] Missing pair_contrib.csv for representative extraction.')
    if not top_pairs_csv.exists() or not pair_index_path.exists():
        raise SystemExit('[DISTIL] Missing top_pairs_pool.csv/pair_index.npy for representative extraction.')

    meta_payload = _load_json(feat_meta_path) if feat_meta_path.exists() else {}
    try:
        selection_mode = _normalize_selection_mode(meta_payload.get('selection_mode', getattr(args, 'selection_mode', 'standard')))
    except Exception:
        selection_mode = _normalize_selection_mode(getattr(args, 'selection_mode', 'standard'))
    if selection_mode == 'standard':
        score_column = 'contribution_multi'
        mode_desc = 'features with contribution_multi > 0'
    elif selection_mode == 'sig':
        score_column = 'sig_strength'
        mode_desc = 'passed significant features with sig_strength > 0'
    elif selection_mode == 'ced':
        score_column = 'ced_effect_score'
        mode_desc = 'passed CED features with ced_effect_score > 0'
    else:
        raise SystemExit(f'[DISTIL] Unsupported selection mode for representative extraction: {selection_mode}')

    source = _build_representative_feature_source(outdir, args, countsA, countsB, np.asarray(wA), np.asarray(wB))
    score_rows = _read_csv_rows_by_fid(pair_scores_csv)
    contrib_rows = _read_csv_rows_by_fid(pair_contrib_csv)

    candidates: list[dict[str, object]] = []
    for fid, srow in score_rows.items():
        crow = contrib_rows.get(int(fid), {})
        if selection_mode == 'standard':
            weight = _repr_float(crow, 'contribution_multi', _repr_float(srow, 'contribution_multi', 0.0))
            passed = bool(np.isfinite(weight) and weight > 0.0)
        elif selection_mode == 'sig':
            weight = _repr_float(srow, 'sig_strength', _repr_float(crow, 'sig_strength', 0.0))
            passed = _repr_bool(srow, 'passed_significance', 'passed_sig') and np.isfinite(weight) and weight > 0.0
        else:
            weight = _repr_float(srow, 'ced_effect_score', _repr_float(crow, 'ced_effect_score', 0.0))
            passed = _repr_bool(srow, 'passed_ced') and np.isfinite(weight) and weight > 0.0
        if not passed:
            continue
        try:
            bins = int(float(srow.get('bins', '128') or 128))
        except Exception:
            bins = int(getattr(args, 'bins_max', 128) or 128)
        minv = _repr_float(srow, 'minv')
        maxv = _repr_float(srow, 'maxv')
        if not (np.isfinite(minv) and np.isfinite(maxv)):
            continue
        if not (maxv > minv):
            maxv = minv + 1e-6
        candidates.append({
            'fid': int(fid),
            'bins': int(max(1, bins)),
            'minv': float(minv),
            'maxv': float(maxv),
            'weight': float(weight),
            'score_column': str(score_column),
            'bundle_id': str(crow.get('bundle_id', srow.get('bundle_id', ''))),
            'pair_type': str(crow.get('pair_type', srow.get('pair_type', ''))),
            'tv': _repr_float(srow, 'tv', _repr_float(crow, 'tv', float('nan'))),
            'auc_single': _repr_float(srow, 'auc_single', _repr_float(crow, 'auc_single', float('nan'))),
        })

    if not candidates:
        raise SystemExit(f'[DISTIL] No representative candidate features found for mode={selection_mode}: {mode_desc}.')
    candidates.sort(key=lambda d: (-float(d['weight']), int(d['fid'])))
    raw_candidate_count = int(len(candidates))
    max_candidates = max(1, int(getattr(args, 'representative_max_candidate_features', 5000) or 5000))
    truncated = raw_candidate_count > max_candidates
    candidates = candidates[:max_candidates]
    W_total = float(sum(float(c['weight']) for c in candidates))
    if not (np.isfinite(W_total) and W_total > 0.0):
        raise SystemExit('[DISTIL] Representative candidate feature weights sum to zero.')

    nA = int(np.asarray(wA).size)
    nB = int(np.asarray(wB).size)
    scoresA = np.zeros((nA,), dtype=np.float64)
    scoresB = np.zeros((nB,), dtype=np.float64)
    processed_weight = 0.0
    block = max(1, int(getattr(args, 'representative_feature_block', 32) or 32))
    top_n_A = min(int(top_n), int(nA))
    top_n_B = min(int(top_n), int(nB))
    log_info(
        f'[repr] mode={selection_mode} score_column={score_column} raw_candidates={raw_candidate_count} '
        f'used_candidates={len(candidates)} truncated={int(truncated)} feature_block={block} topN={int(top_n)} source={source.get("kind")}'
    )
    progress = _progress_logger('representatives/scoring', total_units=max(1, len(candidates)), min_interval_sec=float(getattr(args, 'progress_interval_sec', 300.0) or 300.0), active_label='features_done')

    order_A = np.zeros((0,), dtype=np.int64)
    order_B = np.zeros((0,), dtype=np.int64)
    lowerA = upperA = np.zeros((nA,), dtype=np.float64)
    lowerB = upperB = np.zeros((nB,), dtype=np.float64)
    certified_A = False
    certified_B = False
    processed = 0
    for start in range(0, len(candidates), block):
        sub = candidates[start:start + block]
        fids = np.asarray([int(c['fid']) for c in sub], dtype=np.int64)
        XA = np.asarray(_selected_feature_block_any_source(source, 'A', fids, slice(0, int(fids.size))), dtype=np.float32)
        XB = np.asarray(_selected_feature_block_any_source(source, 'B', fids, slice(0, int(fids.size))), dtype=np.float32)
        if XA.shape[0] != nA or XB.shape[0] != nB:
            raise RuntimeError(f'[repr] feature/frame alignment mismatch: XA={XA.shape} XB={XB.shape} weights=({nA},{nB})')
        for j, c in enumerate(sub):
            weight = float(c['weight'])
            xA = np.asarray(XA[:, j], dtype=np.float64)
            xB = np.asarray(XB[:, j], dtype=np.float64)
            bins = int(c['bins']); minv = float(c['minv']); maxv = float(c['maxv'])
            pA = _hist_prob_uniform(xA, np.asarray(wA, dtype=np.float64), bins=bins, x_min=minv, x_max=maxv).astype(np.float64, copy=False)
            pB = _hist_prob_uniform(xB, np.asarray(wB, dtype=np.float64), bins=bins, x_min=minv, x_max=maxv).astype(np.float64, copy=False)
            pA = np.clip(pA, 0.0, None); pB = np.clip(pB, 0.0, None)
            sA = float(np.sum(pA)); sB = float(np.sum(pB))
            if sA > 0.0:
                pA /= sA
            if sB > 0.0:
                pB /= sB
            diff = pB - pA
            idxA = _uniform_bin_index_clip_vector(xA, bins=bins, x_min=minv, x_max=maxv)
            idxB = _uniform_bin_index_clip_vector(xB, bins=bins, x_min=minv, x_max=maxv)
            scoresA += weight * diff[idxA]
            scoresB += weight * diff[idxB]
            processed_weight += weight
            processed += 1
        remaining_weight = max(0.0, W_total - processed_weight)
        order_A, lowerA, upperA, certified_A = _repr_certify_order(scoresA, remaining_weight=remaining_weight, total_weight=W_total, top_n=top_n_A, want_high=False)
        order_B, lowerB, upperB, certified_B = _repr_certify_order(scoresB, remaining_weight=remaining_weight, total_weight=W_total, top_n=top_n_B, want_high=True)
        progress(min(processed, len(candidates)), active=processed, force=False)
        if certified_A and certified_B:
            break
    remaining_weight = max(0.0, W_total - processed_weight)
    order_A, lowerA, upperA, certified_A = _repr_certify_order(scoresA, remaining_weight=remaining_weight, total_weight=W_total, top_n=top_n_A, want_high=False)
    order_B, lowerB, upperB, certified_B = _repr_certify_order(scoresB, remaining_weight=remaining_weight, total_weight=W_total, top_n=top_n_B, want_high=True)
    progress(min(processed, len(candidates)), active=processed, force=True)
    early_stop = bool(processed < len(candidates) and certified_A and certified_B)
    log_info(
        f'[repr] scoring complete processed_features={processed}/{len(candidates)} early_stop={int(early_stop)} '
        f'A_order_certified={int(certified_A)} B_order_certified={int(certified_B)} remaining_weight_fraction={remaining_weight / max(W_total, 1e-300):.6g}'
    )

    refA_lines = Path(refA_path).read_text(encoding='utf-8', errors='ignore').splitlines(True)
    refB_lines = Path(refB_path).read_text(encoding='utf-8', errors='ignore').splitlines(True)
    srcA = _iter_source_frame_numbers_from_counts(list(countsA), frame_stride=int(getattr(args, 'frame_stride', 0) or 0))
    srcB = _iter_source_frame_numbers_from_counts(list(countsB), frame_stride=int(getattr(args, 'frame_stride', 0) or 0))
    if frame_keep_maskA is not None:
        mA = np.asarray(frame_keep_maskA, dtype=bool)
        if int(mA.size) != len(srcA):
            raise SystemExit(f'[DISTIL] Representative extraction frame_keep_maskA length mismatch: mask={int(mA.size)} mapped_from_list={len(srcA)}')
        srcA = [x for x, keep in zip(srcA, mA.tolist()) if bool(keep)]
    if frame_keep_maskB is not None:
        mB = np.asarray(frame_keep_maskB, dtype=bool)
        if int(mB.size) != len(srcB):
            raise SystemExit(f'[DISTIL] Representative extraction frame_keep_maskB length mismatch: mask={int(mB.size)} mapped_from_list={len(srcB)}')
        srcB = [x for x, keep in zip(srcB, mB.tolist()) if bool(keep)]
    if len(srcA) != int(scoresA.size):
        raise SystemExit(f'[DISTIL] Representative extraction source mapping mismatch for A: score_frames={scoresA.size}, mapped_frames={len(srcA)}. Check weight-zero filtering and Stage1 selected-feature source alignment.')
    if len(srcB) != int(scoresB.size):
        raise SystemExit(f'[DISTIL] Representative extraction source mapping mismatch for B: score_frames={scoresB.size}, mapped_frames={len(srcB)}. Check weight-zero filtering and Stage1 selected-feature source alignment.')

    rep_dir = outdir / 'representatives'
    dir_A = rep_dir / 'A_like'
    dir_B = rep_dir / 'B_like'
    dir_A.mkdir(parents=True, exist_ok=True)
    dir_B.mkdir(parents=True, exist_ok=True)

    rows_out: list[dict[str, object]] = []
    def _score_row(cls: str, rank: int, idx_frame: int, ensemble: str, cod_path: Path, src_frame_no: int, out_pdb: Path, lower: np.ndarray, upper: np.ndarray) -> dict[str, object]:
        lo = float(lower[int(idx_frame)]); hi = float(upper[int(idx_frame)])
        return {
            'class': cls,
            'rank': int(rank),
            'source_ensemble': ensemble,
            'frame_index': int(idx_frame),
            'source_file': str(cod_path),
            'source_frame_no': int(src_frame_no),
            'score_lower': lo,
            'score_upper': hi,
            'score_mid': 0.5 * (lo + hi),
            'pdb': str((Path(cls) / out_pdb.name).as_posix()),
        }

    for rank, idx_frame in enumerate(order_A.tolist(), start=1):
        cod_path, src_frame_no = srcA[int(idx_frame)]
        coords_full = _read_single_cod_frame(cod_path, natomA_full, source_frame_no=int(src_frame_no))
        out_pdb = dir_A / f'A_like_rank{rank:04d}.pdb'
        _write_fullframe_pdb_from_reference(ref_lines=refA_lines, coords_full=coords_full, out_pdb=out_pdb)
        rows_out.append(_score_row('A_like', rank, int(idx_frame), 'A', cod_path, int(src_frame_no), out_pdb, lowerA, upperA))

    for rank, idx_frame in enumerate(order_B.tolist(), start=1):
        cod_path, src_frame_no = srcB[int(idx_frame)]
