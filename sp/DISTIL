                        if sup_fids:
                            for fidp in sup_fids:
                                for line in _pair_summary_lines(fidp, "    "):
                                    fo.write(line + "\n")
                        else:
                            fo.write("    (none)\n")
                        for line in _region_lines("Region A", str(rowp.get("regionA_nodes", "") or ""), "  "):
                            fo.write(line + "\n")
                        fo.write("\n")
                        for line in _region_lines("Region B", str(rowp.get("regionB_nodes", "") or ""), "  "):
                            fo.write(line + "\n")
                        if idx != len(rows_all):
                            fo.write("\n\n")

            def _write_ranked_pairs_pretty(path: Path, rows_ranked: list[dict[str, object]]) -> None:
                with open(path, "w", encoding="utf-8") as fo:
                    fo.write("# DISTIL ranked region pairs (human-readable)\n")
                    fo.write(f"# source_csv: {ranked_pairs_csv.name}\n")
                    fo.write(f"# source_bundle_csv: {bundle_regions_csv.name}\n")
                    fo.write(f"# ranking_mode: {stage5_region_weight_mode}\n")
                    fo.write(f"# primary_score_column: {stage5_primary_score_col}\n")
                    fo.write(f"# primary_metric_column: {stage5_primary_metric_col}\n")
                    fo.write(f"# primary_metric_sum_column: {stage5_primary_sum_col}\n")
                    fo.write(f"# tie_breakers: {', '.join(stage5_tie_breakers)}\n")
                    fo.write(f"# feature_weight_formula: {stage5_weight_formula}\n")
                    fo.write(f"# displayed_region_pairs: {len(rows_ranked)} of {int(stage5_total_region_pairs)}\n")
                    fo.write(f"# supporting_features_limit_per_pair: {int(supporting_topK)}\n")
