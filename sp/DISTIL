    cache_dir.mkdir(parents=True, exist_ok=True)
    meta_path = cache_dir / 'direction_map_meta.json'
    done_path = cache_dir / 'direction_map.done.json'

    want = {
        'cache_version': int(STAGE5_DIRECTION_CACHE_VERSION),
        'cache_namespace': CACHE_NAMESPACE,
        'selection_mode': str(selection_mode),
