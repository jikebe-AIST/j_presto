                "TPL> BONDS\n; NUMBER OF BONDS : 3\nPEP\n"
                "         1         2      1.0      1.0 ; 1\n"
                "         2         3      1.0      1.0 ; 2\n"
                "         3         4      1.0      1.0 ; 3\n\n"
                "TPL> ANGLES\n; this numeric record must NOT be read as a bond\nPEP\n"
                "         1         4         2      1.0      1.0 ; fake if misread\n\n"
                "TPL> LINK\n"
                "B          4         7      1.0      1.0 ; real external link bond\n"
                "A          3         4         7      1.0      1.0 ; not a bond\n",
                encoding='utf-8',
            )
            parsed_tpl = _parse_jpresto_tpl_atoms_bonds(tpl_file)
            bset = set(tuple(x) for x in parsed_tpl.get('bonds', []))
            assert (1, 2) in bset and (2, 3) in bset and (3, 4) in bset
            assert (4, 7) in bset
            assert (1, 4) not in bset  # ANGLES record must not create a fake bond.
            assert (3, 7) not in bset  # LINK angle must not create a fake bond.
            assert parsed_tpl.get('tpl_parser') == 'jpresto_tpl_bonds_and_link_v1'
    except Exception as e:
        print(f"[SELF-CHECK][ERROR] topology full-graph exclusion smoke test failed: {e}", file=sys.stderr)
        raise SystemExit(2)

    # ------------------------------------------------------------------
    # (1e) Long-pair exclusion basis smoke test
    # ------------------------------------------------------------------
    try:
        # Three residues with one selected atom per residue.  Raw distance
        # contacts between residues 0-1 and 1-2 are imagined, but only 1-2
        # remains after topology filtering.  The long feature for 0-1 must
        # remain, because there is no final near analysis feature covering it.
        res_of_atom_sc = np.array([0, 1, 2], dtype=np.int32)
        raw_near = np.array([[0, 1], [1, 2]], dtype=np.int32)
        final_near = np.array([[1, 2]], dtype=np.int32)
        raw_block = _build_near_residue_block_from_final_near_pairs(raw_near, res_of_atom_sc)
        final_block = _build_near_residue_block_from_final_near_pairs(final_near, res_of_atom_sc)
        assert _pack_pair(0, 1) in raw_block
        assert _pack_pair(0, 1) not in final_block
        assert _pack_pair(1, 2) in final_block
    except Exception as e:
        print(f"[SELF-CHECK][ERROR] long-pair exclusion basis smoke test failed: {e}", file=sys.stderr)
        raise SystemExit(2)

    # ------------------------------------------------------------------
    # (1f) Atom mapping and reference geometry diagnostics smoke tests
    # ------------------------------------------------------------------
    try:
        atomsA_sc = [
            AtomRec(1,'N','ALA','',1,0,0,0,'N'), AtomRec(2,'CA','ALA','',1,1,0,0,'C'), AtomRec(3,'C','ALA','',1,2,0,0,'C'), AtomRec(4,'O','ALA','',1,2.5,0.5,0,'O'),
            AtomRec(5,'N','VAL','',2,3.2,0,0,'N'), AtomRec(6,'CA','VAL','',2,4.2,0.1,0,'C'), AtomRec(7,'C','VAL','',2,5.2,0,0,'C'), AtomRec(8,'O','VAL','',2,5.7,0.5,0,'O'),
        ]
        atomsB_sc = [AtomRec(a.idx1, a.name, ('GLY' if a.resid == 2 else a.resname), a.chain, a.resid, a.x, a.y, a.z, a.elem) for a in atomsA_sc]
        with tempfile.TemporaryDirectory(prefix='distil_map_selfcheck_') as ttd:
            diag = _write_atom_mapping_diagnostics(Path(ttd), atomsA_sc, np.arange(len(atomsA_sc)), atomsB_sc, np.arange(len(atomsB_sc)))
            assert diag['atom_name_mismatches'] == 0
            assert diag['resname_mismatches'] == 4
            geom = _write_reference_geometry_diagnostics(Path(ttd), 'A', atomsA_sc)
            assert geom['checked_pairs'] == 1
    except Exception as e:
        print(f"[SELF-CHECK][ERROR] mapping/reference-geometry smoke test failed: {e}", file=sys.stderr)
        raise SystemExit(2)

    # ------------------------------------------------------------------
    # (1g) Stage5 lexicographic ranking smoke tests
    # ------------------------------------------------------------------
    try:
        def _rank_key_for_test(stage5_vals, auc_vals):
            return (
                tuple(_rank_nonnegative_desc_values(stage5_vals, top_k=RANK_LEXICOGRAPHIC_TOP_K)),
                tuple(_rank_nonnegative_desc_values((_auc_excess_value(a) for a in auc_vals), top_k=RANK_LEXICOGRAPHIC_TOP_K)),
            )
        assert _rank_key_for_test([0.05], [0.60]) > _rank_key_for_test([0.049, 0.049, 0.049], [0.99, 0.99, 0.99])
        assert _rank_key_for_test([0.05, 0.02], [0.60]) > _rank_key_for_test([0.05, 0.01], [0.99])
        assert _rank_key_for_test([0.0, 0.0], [0.95]) > _rank_key_for_test([0.0, 0.0], [0.90])
        assert _rank_text_to_tuple(_rank_values_to_text([0.5, 0.4]), top_k=3) == (0.5, 0.4, 0.0)
    except Exception as e:
        print(f"[SELF-CHECK][ERROR] Stage5 lexicographic ranking smoke test failed: {e}", file=sys.stderr)
        raise SystemExit(2)

    # ------------------------------------------------------------------
    # (2) CSV/meta mini-smoke: top_pairs parser and row counter
    # ------------------------------------------------------------------
    with tempfile.TemporaryDirectory(prefix="distil_selfcheck_") as td:
        outdir = Path(td)
        csv_path = outdir / 'top_pairs_pool.csv'
        with open(csv_path, 'w', encoding='utf-8') as f:
            f.write('feature,kind,i,j,ai,aj,res_i,res_j,agroup_i,agroup_j\n')
            f.write('0,near,10,20,101,201,10,20,bb,sc\n')
            f.write('1,long,11,30,-1,-1,11,30,,\n')
        meta = _load_top_pairs_meta(csv_path)
        assert len(meta) == 2
        assert _count_csv_data_rows(csv_path) == 2
        assert _meta_kind_str(meta, 0) == 'near'
        assert _meta_kind_str(meta, 1) == 'long'
        assert _meta_idstr(meta, 1) == '11-30'

    # ------------------------------------------------------------------
    # (3) Single-pair AUC smoke on synthetic 1D distances
    # ------------------------------------------------------------------
    xA = rng.normal(loc=3.0, scale=0.30, size=48).astype(np.float32)
    xB = rng.normal(loc=4.2, scale=0.35, size=52).astype(np.float32)
    wA = np.full(xA.shape[0], 1.0 / xA.shape[0], dtype=np.float32)
    wB = np.full(xB.shape[0], 1.0 / xB.shape[0], dtype=np.float32)
    res = _compute_single_feature_auc_and_scores(
        xA, xB, wA, wB,
        bins=12,
        x_min=float(min(np.min(xA), np.min(xB)) - 0.2),
        x_max=float(max(np.max(xA), np.max(xB)) + 0.2),
        eps=1e-6,
        cv_folds=5,
        random_state=0,
    )
    assert isinstance(res, dict)
    auc_single = float(res.get('auc', 0.0) or 0.0)
    assert 0.60 <= auc_single <= 1.0
    scores = np.asarray(res.get('scores', []), dtype=np.float32)

    # ------------------------------------------------------------------
    # (5) Multivariate contribution smoke
    # ------------------------------------------------------------------
    nA_blk = xA.shape[0]
    nB_blk = xB.shape[0]
    y = np.concatenate([
        np.zeros((nA_blk,), dtype=np.int32),
        np.ones((nB_blk,), dtype=np.int32),
    ])
    feat1 = scores.astype(np.float32)
    feat2 = np.concatenate([
        rng.normal(loc=-0.4, scale=0.2, size=nA_blk),
        rng.normal(loc=+0.4, scale=0.2, size=nB_blk),
    ]).astype(np.float32)
    feat3 = rng.normal(loc=0.0, scale=1.0, size=y.shape[0]).astype(np.float32)
    X = np.column_stack([feat1, feat2, feat3]).astype(np.float32)
    mv = _fit_multivar_contrib(
        X, y,
        penalty='l1',
        C=1.0,
        max_iter=1000,
        cv_folds=5,
        standardize=True,
        random_state=0,
    )
    assert isinstance(mv, dict)
    auc_multi = float(mv.get('auc', 0.0) or 0.0)
    assert 0.60 <= auc_multi <= 1.0
    contrib = np.asarray(mv.get('contrib', []), dtype=np.float32)
    assert contrib.shape == (X.shape[1],)
    coef = np.asarray(mv.get('coef', []), dtype=np.float32)
    assert coef.shape == (X.shape[1],)

    print(
        f"[SELF-CHECK] OK: parser/meta/core helper smoke tests passed. "
        f"single_auc={auc_single:.3f} contribution_auc={auc_multi:.3f}",
        file=sys.stderr,
    )

def _remap_selected_feature_plan_atoms(plan: dict, perm: np.ndarray | None) -> dict:
    """Return a shallow-copied PASS build plan with near-pair atom indices remapped.

    ``top_pairs_pool.csv`` stores near-feature atom indices in the A-side selected-atom
    space. When rebuilding PASS features directly from ensemble B coordinates, those
    indices must be mapped into the B-side selected-atom order.
    """
    if perm is None:
        return {
            "sel_fids": np.asarray(plan["sel_fids"], dtype=np.int64),
            "near_cols": np.asarray(plan["near_cols"], dtype=np.int64),
            "long_cols": np.asarray(plan["long_cols"], dtype=np.int64),
            "near_pairs": np.asarray(plan["near_pairs"], dtype=np.int32),
            "long_pairs": np.asarray(plan["long_pairs"], dtype=np.int32),
        }
    perm = np.asarray(perm, dtype=np.int64)
    near_pairs = np.asarray(plan["near_pairs"], dtype=np.int32)
    if near_pairs.size == 0:
        near_pairs_mapped = np.empty((0, 2), dtype=np.int32)
    else:
        if int(np.min(near_pairs)) < 0 or int(np.max(near_pairs)) >= int(perm.size):
            raise ValueError('Near-pair atom indices exceed permutation size during direct selected-feature rebuild')
        near_pairs_mapped = np.empty_like(near_pairs)
        near_pairs_mapped[:, 0] = perm[near_pairs[:, 0]].astype(np.int32, copy=False)
        near_pairs_mapped[:, 1] = perm[near_pairs[:, 1]].astype(np.int32, copy=False)
    return {
        "sel_fids": np.asarray(plan["sel_fids"], dtype=np.int64),
        "near_cols": np.asarray(plan["near_cols"], dtype=np.int64),
        "long_cols": np.asarray(plan["long_cols"], dtype=np.int64),
        "near_pairs": near_pairs_mapped,
        "long_pairs": np.asarray(plan["long_pairs"], dtype=np.int32),
    }

def _parse_cpu_count_hint(v: Any) -> int | None:
    """Parse a scheduler/environment CPU-count hint.

    Accepts plain integers as well as compact scheduler formats such as
    ``124(x2)`` or ``62,62``. Returns the maximum positive integer found.
    """
    if v is None:
        return None
    s = str(v).strip()
    if not s:
        return None
    nums = [int(x) for x in re.findall(r"\d+", s)]
    nums = [x for x in nums if x > 0]
    return max(nums) if nums else None


def _available_cpu_hint() -> tuple[int, str]:
    """Return the best-effort visible CPU count and its source.

    Preference order is tuned for shared-node stability:
    affinity > NUMBA_NUM_THREADS > scheduler hints > os.cpu_count.
    """
    try:
        val = len(os.sched_getaffinity(0))
        if val > 0:
            return int(val), "sched_getaffinity"
    except Exception:
        pass
    val = _parse_cpu_count_hint(os.environ.get("NUMBA_NUM_THREADS"))
    if val is not None:
        return int(val), "NUMBA_NUM_THREADS"
    for key in ("SLURM_CPUS_PER_TASK", "SLURM_CPUS_ON_NODE", "SLURM_JOB_CPUS_PER_NODE", "PBS_NP", "NSLOTS"):
        val = _parse_cpu_count_hint(os.environ.get(key))
        if val is not None:
            return int(val), key
    n = os.cpu_count() or 1
    return int(max(1, n)), "os.cpu_count"


def _auto_workers_info(max_cap: int = 8) -> tuple[int, str]:
    """Conservative worker auto-tuning for shared-node stability."""
    avail, source = _available_cpu_hint()
    cap = max(1, int(max_cap))
    workers = max(1, min(cap, int(avail)))
    if workers != int(avail):
        detail = f"{source}={int(avail)}, capped_to_{workers}"
    else:
        detail = f"{source}={workers}"
    return workers, detail


def _auto_workers(max_cap: int = 8) -> int:
    return _auto_workers_info(max_cap=max_cap)[0]


def _cpu_visibility_report() -> dict[str, Any]:
    rep: dict[str, Any] = {}
    try:
        aff = sorted(int(x) for x in os.sched_getaffinity(0))
        rep['affinity_count'] = int(len(aff))
        if aff:
            ranges = []
            s = prev = aff[0]
            for x in aff[1:]:
                if x == prev + 1:
                    prev = x
                else:
                    ranges.append(f"{s}-{prev}" if s != prev else f"{s}")
                    s = prev = x
            ranges.append(f"{s}-{prev}" if s != prev else f"{s}")
            rep['affinity_list'] = ','.join(ranges)
    except Exception:
        rep['affinity_count'] = None
        rep['affinity_list'] = None
    for key in ('SLURM_CPUS_PER_TASK','SLURM_CPUS_ON_NODE','SLURM_JOB_CPUS_PER_NODE','NUMBA_NUM_THREADS','OMP_NUM_THREADS','OPENBLAS_NUM_THREADS','MKL_NUM_THREADS','NUMEXPR_NUM_THREADS'):
        rep[key] = os.environ.get(key)
    avail, source = _available_cpu_hint()
    rep['auto_cpu_hint'] = int(avail)
    rep['auto_cpu_hint_source'] = str(source)
    return rep


def _resolve_stage_workers(requested: int, *, stage: str, max_cap: int | None = None, item_count: int | None = None) -> tuple[int, str]:
    req = int(requested or 0)
    stage = str(stage or '').strip().lower()
    stage_caps = {
        'stage1_tv': 8,
        'stage1_auc': 8,
        'stage3': 4,
        'contrib_build': 4,
        'contrib_grad': 4,
        'contrib_stats': 4,
        'contrib_decision': 4,
        'contrib_sklearn_cv': 4,
        # Stage2 contribution callers use explicit stage names; keep their
        # auto caps identical to the generic contribution caps so auto worker
        # selection does not silently expand after the stage renaming.
        'stage2_contrib_build': 4,
        'stage2_contrib_grad': 4,
        'stage2_contrib_stats': 4,
        'stage5_regions': 8,
    }
    cap = int(max_cap if max_cap is not None else stage_caps.get(stage, 8))
    if req > 0:
        val = max(1, min(cap, req))
        return val, ('user_capped' if val != req else 'user')
    val, detail = _auto_workers_info(max_cap=cap)
    if item_count is not None:
        val = min(int(val), max(1, int(item_count)))
        detail = f"{detail}, items={int(item_count)}"
    return max(1, int(val)), detail


def _auto_tv_chunk_info(workers: int, n_features: int | None = None) -> tuple[int, str]:
    """Return a conservative Stage1 chunk size tuned to worker count/problem size."""
    w = max(1, int(workers))
    if w <= 2:
        chunk = 256
    elif w <= 4:
        chunk = 128
    elif w <= 8:
        chunk = 64
    else:
        chunk = 32
    if n_features is not None:
        nf = max(1, int(n_features))
        chunk = min(chunk, nf)
        if nf <= 4 * chunk:
            chunk = max(1, (nf + max(1, w) - 1) // max(1, w))
    return int(max(1, chunk)), f"workers={w}, n_features={int(n_features) if n_features is not None else 'NA'}"


def _cap_stage1_chunk_by_budget(chunk: int, *, n_frames_hint: int, bins_aux: int, bins_tv: int,
                                memory_budget_mib: float) -> tuple[int, str | None]:
    """Cap Stage1 feature chunk size by a rough transient-memory budget.

    The streaming Stage1 path avoids full feature matrices, but each feature chunk
    still materializes temporary ``(n_block_frames, chunk)`` arrays plus histogram
    state. Use a conservative upper bound so that very large COD/list ranges do not
    accidentally explode transient RAM usage.
    """
    chunk = max(1, int(chunk))
    budget_mib = float(memory_budget_mib)
    if not np.isfinite(budget_mib) or budget_mib <= 0.0:
        return chunk, None
    nblk = max(1, int(n_frames_hint))
    # Conservative per-feature byte estimate for Stage A/B/C temporaries.
    # - float32 materialized values      : 4 * nblk
    # - float64 working copy/stat ops    : 8 * nblk
    # - A/B/C histogram rows + x-range   : modest constant overhead
    hist_bytes = 8.0 * float(max(2, int(bins_aux)) * 2 + max(2, int(bins_tv)) + 8)
    bytes_per_feature = 12.0 * float(nblk) + hist_bytes
    budget_bytes = budget_mib * (1024.0 ** 2)
    cap = max(1, int(budget_bytes // max(bytes_per_feature, 1.0)))
    new_chunk = max(1, min(chunk, cap))
    if new_chunk >= chunk:
        return chunk, None
    detail = (
        f"memory_budget={budget_mib:.1f}MiB, n_frames_hint={nblk}, bins_aux={int(bins_aux)}, "
        f"bins_tv={int(bins_tv)}, capped_to_{new_chunk}"
    )
    return new_chunk, detail

def _accel_enabled(args) -> bool:
    """Return True if on-disk caches/acceleration are enabled."""
    return not bool(getattr(args, "no_accelerate", False))

def _cache_dir(outdir: str | Path) -> str:
    d = Path(outdir).expanduser().resolve() / "distil_cache"
    d.mkdir(parents=True, exist_ok=True)
    return str(d)

def _dir_size_bytes(path: Path) -> int:
    path = Path(path)
    if not path.exists():
        return 0
    total = 0
    for root, _dirs, files in os.walk(path):
        for name in files:
            fp = Path(root) / name
            try:
                if fp.is_symlink():
                    continue
                total += int(fp.stat().st_size)
            except OSError:
                pass
    return int(total)


def _format_bytes_gib(n_bytes: int) -> str:
    return f"{float(n_bytes) / (1024.0 ** 3):.2f} GiB"

def _sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for b in iter(lambda: f.read(1024 * 1024), b""):
            h.update(b)
    return h.hexdigest()

def _sha1_bytes(*parts: bytes) -> str:
    h = hashlib.sha1()
    for p in parts:
        h.update(p)
    return h.hexdigest()

def _load_json(path: Path) -> dict:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return {}

def _write_json_atomic(path: Path, obj: dict) -> None:
    path = Path(path)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(obj, indent=2, sort_keys=True), encoding="utf-8")
    tmp.replace(path)

def _write_text_atomic(path: Path, text: str) -> None:
    path = Path(path)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(text, encoding="utf-8")
    os.replace(str(tmp), str(path))

def _write_pickle_atomic(path: Path, obj) -> None:
    path = Path(path)
    tmp = path.with_suffix(path.suffix + ".tmp")
    with open(tmp, "wb") as f:
        pickle.dump(obj, f, protocol=pickle.HIGHEST_PROTOCOL)
    os.replace(str(tmp), str(path))

def _write_csv_atomic(path: Path, writer_fn) -> None:
    path = Path(path)
    tmp = path.with_suffix(path.suffix + ".tmp")
    with open(tmp, "w", newline="", encoding="utf-8") as f:
        writer_fn(f)
    os.replace(str(tmp), str(path))

def _csv_header_contains(path: Path, required_columns: list[str]) -> bool:
    """Return True if a CSV file exists and its header contains all required columns."""
    try:
        path = Path(path)
        if not path.exists() or path.stat().st_size <= 0:
            return False
        with open(path, "r", newline="", encoding="utf-8") as f:
            header = next(csv.reader(f), [])
        return set(map(str, required_columns)).issubset(set(map(str, header)))
    except Exception:
        return False

def _write_npz_atomic(path: Path, **arrays) -> None:
    path = Path(path)
    tmp = path.with_suffix(path.suffix + ".tmp")
    np.savez(tmp, **arrays)
    # np.savez appends .npz when the path does not already end with .npz.
    tmp_npz = Path(str(tmp) + ("" if str(tmp).endswith(".npz") else ".npz"))
    if tmp_npz.exists() and tmp_npz != tmp:
        os.replace(str(tmp_npz), str(path))
    else:
        os.replace(str(tmp), str(path))

def _write_stage_done_atomic(path: Path, *, stage_name: str, meta: dict, outputs: list[Path], counts: dict | None = None) -> None:
    payload = {
        "stage_name": str(stage_name),
        "cache_version": meta.get("cache_version", ""),
        "cache_namespace": CACHE_NAMESPACE,
        "meta_sig": _json_sha256(_json_normalize(meta)),
        "cache_meta_sig": _json_sha256(_cache_key_normalize(meta)),
        "outputs": [str(Path(x)) for x in outputs],
        "counts": dict(counts or {}),
        "completed_at": time.strftime("%Y-%m-%dT%H:%M:%S"),
    }
    _write_json_atomic(path, payload)

def _csv_row_count(path: Path) -> int:
    try:
        with open(path, "r", encoding="utf-8") as f:
            return sum(1 for _ in csv.DictReader(f))
    except Exception:
        return -1

def _validate_stage1_scoring_outputs(selected_feature_ids_path: Path, single_feature_metrics_csv: Path, selected_feature_positions_path: Path | None = None, single_feature_scores_path: Path | None = None) -> tuple[bool, str]:
    try:
        selected_final_fids = np.load(selected_feature_ids_path).astype(np.int64, copy=False)
    except Exception as e:
        return False, f"invalid_output: failed to load {selected_feature_ids_path.name}: {e}"
    if selected_feature_positions_path is not None:
        try:
            selected_final_pos = np.load(selected_feature_positions_path).astype(np.int64, copy=False)
        except Exception as e:
            return False, f"invalid_output: failed to load {selected_feature_positions_path.name}: {e}"
    else:
        selected_final_pos = np.zeros((int(selected_final_fids.shape[0]),), dtype=np.int64)
    try:
        passed_auc_fids: list[int] = []
        total_rows = 0
        with open(single_feature_metrics_csv, "r", encoding="utf-8") as f:
            for row in csv.DictReader(f):
                total_rows += 1
                fid = int(row['fid'])
                # selected_feature_ids contains downstream features only.
                # With --auc-scope all, AUC-passing but TV-failing features are
                # metrics-only rows and must not be treated as contribution-learning inputs.
                passed_final = int(row.get('used_for_downstream', row.get('passed_final', '0')) or 0) != 0
                if passed_final:
                    passed_auc_fids.append(fid)
    except Exception as e:
        return False, f"invalid_output: failed to read {single_feature_metrics_csv.name}: {e}"
    if total_rows <= 0:
        if selected_final_fids.shape[0] == 0 and selected_final_pos.shape[0] == 0:
            return True, f"ok: rows=0 passed_auc=0"
        return False, f"invalid_output: {single_feature_metrics_csv.name} rows={total_rows}"
    passed_auc_arr = np.asarray(passed_auc_fids, dtype=np.int64)
    if passed_auc_arr.shape[0] != selected_final_fids.shape[0]:
        return False, (
            f"invalid_output: selected_feature_ids/passed_auc count mismatch "
            f"fids={int(selected_final_fids.shape[0])} passed_auc_rows={int(passed_auc_arr.shape[0])}"
        )
    if selected_final_pos.shape[0] != selected_final_fids.shape[0]:
        return False, (
            f"invalid_output: selected_feature_positions/fids count mismatch "
            f"positions={int(selected_final_pos.shape[0])} fids={int(selected_final_fids.shape[0])}"
        )
    if passed_auc_arr.shape[0] > 0 and not np.array_equal(passed_auc_arr, selected_final_fids):
        return False, "invalid_output: selected_feature_ids do not match passed_auc rows order/content"
    if selected_final_pos.shape[0] > 1 and np.any(selected_final_pos[1:] < selected_final_pos[:-1]):
        return False, "invalid_output: selected_feature_positions are not sorted"
    if single_feature_scores_path is not None:
        try:
            score_arr = np.load(Path(single_feature_scores_path), mmap_mode='r')
        except Exception as e:
            return False, f"invalid_output: failed to load {Path(single_feature_scores_path).name}: {e}"
        if getattr(score_arr, 'ndim', 0) != 2:
            return False, f"invalid_output: {Path(single_feature_scores_path).name} is not a 2-D score matrix"
        if int(score_arr.shape[1]) != int(selected_final_fids.shape[0]):
            return False, (
                f"invalid_output: score matrix column mismatch scores={int(score_arr.shape[1])} "
                f"fids={int(selected_final_fids.shape[0])}"
            )
    return True, f"ok: rows={total_rows} downstream_features={int(passed_auc_arr.shape[0])}"




def _stage1_collect_chunk_score_specs(stage1_ckpt_dir: Path) -> tuple[list[tuple[np.ndarray, Path]], int]:
    specs: list[tuple[np.ndarray, Path]] = []
    total_survivors = 0
    for pos_path in sorted(Path(stage1_ckpt_dir).glob('chunk_*.positions.npy')):
        score_path = pos_path.with_name(pos_path.name.replace('.positions.npy', '.scores.npy'))
        if not score_path.exists():
            continue
        pos_arr = np.load(pos_path, mmap_mode='r')
        score_arr = np.load(score_path, mmap_mode='r')
        if int(pos_arr.size) != int(score_arr.shape[1]):
            raise RuntimeError(f'Stage1 scoring chunk cache mismatch: positions={int(pos_arr.size)} scores={int(score_arr.shape[1])} for {score_path.name}')
        specs.append((np.asarray(pos_arr, dtype=np.int64), score_path))
        total_survivors += int(pos_arr.size)
    return specs, int(total_survivors)


def _build_contrib_chunk_transfer_plan(stage1_ckpt_dir: Path, selected_feature_positions: np.ndarray) -> list[dict[str, object]]:
    """Build a compact shard-wise transfer plan for Stage2 contribution input assembly."""
    final_pos = np.asarray(selected_feature_positions, dtype=np.int64)
    if final_pos.ndim != 1:
        raise RuntimeError('selected_feature_positions must be 1-D')
    pos_to_dst = {int(v): i for i, v in enumerate(final_pos.tolist())}
    plan: list[dict[str, object]] = []
    covered = 0
    for pos_arr, score_path in _stage1_collect_chunk_score_specs(stage1_ckpt_dir)[0]:
        dst_cols = []
        src_cols = []
        for src_i, pos in enumerate(np.asarray(pos_arr, dtype=np.int64).tolist()):
            dst = pos_to_dst.get(int(pos))
            if dst is None:
                continue
            src_cols.append(int(src_i))
            dst_cols.append(int(dst))
        if not src_cols:
            continue
        src_cols_arr = np.asarray(src_cols, dtype=np.int64)
        dst_cols_arr = np.asarray(dst_cols, dtype=np.int64)
        order = np.argsort(dst_cols_arr, kind='mergesort')
        src_cols_arr = src_cols_arr[order]
        dst_cols_arr = dst_cols_arr[order]
        plan.append({
            'score_path': Path(score_path),
            'src_cols': src_cols_arr,
            'dst_cols': dst_cols_arr,
            'n_cols': int(src_cols_arr.size),
        })
        covered += int(src_cols_arr.size)
    if covered != int(final_pos.size):
        raise RuntimeError(f'Stage2 contribution score transfer-plan mismatch: covered={covered} expected={int(final_pos.size)}')
    return plan



def _contrib_validate_single_score_matrix(single_feature_scores_path: Path, *, n_rows: int, n_cols: int) -> bool:
    try:
        arr = np.load(Path(single_feature_scores_path), mmap_mode='r')
    except Exception:
        return False
    return bool(getattr(arr, 'ndim', 0) == 2 and int(arr.shape[0]) == int(n_rows) and int(arr.shape[1]) == int(n_cols))


def _link_or_copy_file(src: Path, dst: Path) -> None:
    src = Path(src)
    dst = Path(dst)
    dst.parent.mkdir(parents=True, exist_ok=True)
    if dst.exists() or dst.is_symlink():
        dst.unlink()
    try:
        os.link(str(src), str(dst))
        return
    except Exception:
        pass
    try:
        os.symlink(str(src.resolve()), str(dst))
        return
    except Exception:
        pass
    shutil.copy2(str(src), str(dst))


def _write_score_vectors_rowwise(out_path: Path, score_vectors: list[np.ndarray], *, n_rows: int, progress_cb=None, memory_budget_mib: float = 512.0) -> None:
    """Write per-feature score vectors as C-order (frames, features) using row blocks."""
    out_path = Path(out_path)
    n_cols = int(len(score_vectors))
    n_rows = int(n_rows)
    if n_cols <= 0:
        _save_npy_atomic(out_path, np.zeros((n_rows, 0), dtype=np.float32))
        return
    row_block = int(_contrib_choose_frame_block_size(max(1, n_rows), max(1, n_cols), memory_budget_mib=float(memory_budget_mib)))
    row_block = max(1024, min(max(1, n_rows), row_block))
    mm = open_memmap(str(out_path), mode='w+', dtype=np.float32, shape=(n_rows, n_cols))
    try:
        for r0 in range(0, n_rows, row_block):
            r1 = min(n_rows, r0 + row_block)
            block = np.empty((int(r1 - r0), n_cols), dtype=np.float32)
            for j, vec in enumerate(score_vectors):
                block[:, j] = np.asarray(vec, dtype=np.float32)[r0:r1]
            mm[r0:r1, :] = block
            if progress_cb is not None:
                progress_cb(int(r1), int(n_rows))
        if hasattr(mm, 'flush'):
            mm.flush()
    finally:
        del mm


def _build_single_feature_score_matrix(*, stage1_ckpt_dir: Path, selected_feature_positions_path: Path, single_feature_scores_path: Path, n_rows: int, progress_interval_sec: float = 300.0, memory_budget_mib: float = 512.0, selection_mode: str = 'standard') -> Path:
    """Create the canonical Stage1 single-feature score matrix after feature scoring.

    Layout is C-order (frames, selected_features), matching contribution-learning row-block access.
    Single-chunk exact-order results are hard-linked/symlinked to avoid duplicate I/O.
    """
    final_pos = np.load(Path(selected_feature_positions_path)).astype(np.int64, copy=False)
    n_cols = int(final_pos.size)
    out_path = Path(single_feature_scores_path)
    if n_cols <= 0:
        _save_npy_atomic(out_path, np.zeros((int(n_rows), 0), dtype=np.float32))
        return out_path
    plan = _build_contrib_chunk_transfer_plan(Path(stage1_ckpt_dir), final_pos)
    if len(plan) == 1:
        item = plan[0]
        src_cols = np.asarray(item['src_cols'], dtype=np.int64)
        dst_cols = np.asarray(item['dst_cols'], dtype=np.int64)
        src_path = Path(item['score_path'])
        if src_path.exists() and np.array_equal(src_cols, np.arange(n_cols, dtype=np.int64)) and np.array_equal(dst_cols, np.arange(n_cols, dtype=np.int64)):
            arr = np.load(src_path, mmap_mode='r')
            if getattr(arr, 'ndim', 0) == 2 and int(arr.shape[0]) == int(n_rows) and int(arr.shape[1]) == n_cols:
                _link_or_copy_file(src_path, out_path)
                if _log_enabled('info'):
                    log_info(f"Stage1 single-feature score matrix linked: {out_path} shape=({int(n_rows)},{n_cols}) selection={str(selection_mode)} columns=downstream_features")
                return out_path
    row_block = int(_contrib_choose_frame_block_size(max(1, int(n_rows)), max(1, n_cols), memory_budget_mib=float(memory_budget_mib)))
    row_block = max(1024, min(max(1, int(n_rows)), row_block))
    logger = _progress_logger('Stage1/write_scores', total_units=max(1, int(n_rows)), min_interval_sec=max(30.0, float(progress_interval_sec)))
    out_path.parent.mkdir(parents=True, exist_ok=True)
    _safe_unlink(out_path)
    mm = open_memmap(str(out_path), mode='w+', dtype=np.float32, shape=(int(n_rows), n_cols))
    try:
        for r0 in range(0, int(n_rows), row_block):
            r1 = min(int(n_rows), r0 + row_block)
            block = np.empty((int(r1 - r0), n_cols), dtype=np.float32)
            for item in plan:
                arr = np.load(Path(item['score_path']), mmap_mode='r')
                src_cols = np.asarray(item['src_cols'], dtype=np.int64)
                dst_cols = np.asarray(item['dst_cols'], dtype=np.int64)
                if int(src_cols.size) > 0:
                    block[:, dst_cols] = np.asarray(arr[r0:r1, src_cols], dtype=np.float32)
            mm[r0:r1, :] = block
            logger(int(r1), active=int(r1-r0), force=False)
        logger(int(n_rows), active=0, force=True)
        if hasattr(mm, 'flush'):
            mm.flush()
    finally:
        del mm
    return out_path


def _dir_file_count(path: Path) -> int:
    try:
        return sum(1 for p in Path(path).iterdir() if p.is_file())
    except Exception:
        return -1


def _stage5_owned_pdb_file_count(pdb_dir: Path) -> int:
    """Count only Stage5-ranking-owned PDB/PML outputs.

    The shared pdb/ directory also contains Stage1 metric PDBs.  Those files
    must not make a first Stage5 ranking pass look like an incomplete cache,
    and they must not affect Stage5 ranking cache validation.
    """
    try:
        patterns = (
            'pair_rank*_regions.pdb',
            'pair_rank*_view.pml',
            'all_ranked_bundles_regions.pdb',
            'all_ranked_bundles_view.pml',
            'all_ranked_bundles_metric_*.pdb',
        )
        seen = set()
        for pat in patterns:
            for q in Path(pdb_dir).glob(pat):
                if q.is_file():
                    seen.add(q.name)
        return len(seen)
    except Exception:
        return -1


def _validate_stage5_rank_outputs(ranked_pairs_csv: Path, region_contrib_csv: Path, plots_dir: Path, pdb_dir: Path, done_path: Path) -> tuple[bool, str]:
    ranked_rows = _csv_row_count(ranked_pairs_csv)
    if ranked_rows <= 0:
        return False, f"invalid_output: {ranked_pairs_csv.name} rows={ranked_rows}"
    region_rows = _csv_row_count(region_contrib_csv)
    if region_rows <= 0:
        return False, f"invalid_output: {region_contrib_csv.name} rows={region_rows}"
    plots_files = _dir_file_count(plots_dir)
    stage5_pdb_files = _stage5_owned_pdb_file_count(pdb_dir)
    # Individual Stage5 plots/PDBs are intentionally limited to the most
    # informative ranked regions by default. The complete ranking is stored in
    # CSV/text files; visual artifacts are a controlled subset plus combined PDBs.
    if plots_files < 0:
        return False, f"invalid_output: {plots_dir.name} unavailable"
    if stage5_pdb_files < 0:
        return False, f"invalid_output: stage5-owned PDB count unavailable"
    done = _load_json(done_path)
    if isinstance(done, dict):
        counts = done.get('counts', {}) or {}
        try:
            done_ranked = int(counts.get('ranked_pairs', -1))
        except Exception:
            done_ranked = -1
        try:
            done_plots = int(counts.get('plots_files', -1))
        except Exception:
            done_plots = -1
        try:
            done_pdb = int(counts.get('stage5_pdb_files', counts.get('pdb_files', -1)))
        except Exception:
            done_pdb = -1
        if done_ranked >= 0 and done_ranked != ranked_rows:
            return False, f"done mismatch: ranked_pairs expected={done_ranked} got={ranked_rows}"
        if done_plots >= 0 and done_plots != plots_files:
            return False, f"done mismatch: plots_files expected={done_plots} got={plots_files}"
        if done_pdb >= 0 and done_pdb != stage5_pdb_files:
            return False, f"done mismatch: stage5_pdb_files expected={done_pdb} got={stage5_pdb_files}"
    return True, f"ok: ranked_rows={ranked_rows} plots={plots_files} stage5_pdb={stage5_pdb_files}"

def _validate_done_payload(done_path: Path, *, stage_name: str, want_meta: dict | None, required_paths: list[tuple[Path, str]]) -> tuple[bool, list[str], dict | None]:
    reasons: list[str] = []
    done = _load_json(done_path)
    if not isinstance(done, dict):
        return False, [f"invalid JSON: {done_path.name}"], None
    got_stage = str(done.get('stage_name', '') or '')
    if got_stage != str(stage_name):
        reasons.append(f"done mismatch: stage_name expected={stage_name} got={got_stage}")
    if want_meta is not None:
        want_cache_version = want_meta.get("cache_version", "")
        got_cache_version = done.get('cache_version', '')
        if _json_normalize(got_cache_version) != _json_normalize(want_cache_version):
            reasons.append(f"done mismatch: cache_version expected={_json_normalize(want_cache_version)} got={_json_normalize(got_cache_version)}")
        want_meta_sig = _json_sha256(_json_normalize(want_meta))
        want_cache_meta_sig = _cache_sig(want_meta)
        got_cache_meta_sig = str(done.get('cache_meta_sig', '') or '')
        got_meta_sig = str(done.get('meta_sig', '') or '')
        if not got_cache_meta_sig:
            reasons.append('done mismatch: missing cache_meta_sig')
        elif got_cache_meta_sig != want_cache_meta_sig:
            reasons.append(f"done mismatch: cache_meta_sig expected={want_cache_meta_sig[:16]} got={got_cache_meta_sig[:16]}")
    want_outputs = [str(Path(p)) for p, _ in required_paths]
    got_outputs = [str(Path(x)) for x in (done.get('outputs', []) or [])]
    if got_outputs:
        got_set = set(got_outputs)
        missing_outputs = [x for x in want_outputs if x not in got_set]
        if missing_outputs:
            reasons.append(f"done mismatch: outputs missing_required={missing_outputs} got={got_outputs}")
    return (len(reasons) == 0), reasons, done


def _cache_check_with_reasons(*, required_paths: list[tuple[Path, str]], meta_path: Path, done_path: Path, want_meta: dict, validators: list[tuple[str, callable]] | None = None, stage_name: str | None = None):
    present = [p.exists() for p, _ in required_paths]
    if not any(present) and not done_path.exists() and not meta_path.exists():
        return False, "first_run", []
    reasons: list[str] = []
    for (p, label), exists in zip(required_paths, present):
        if not exists:
            reasons.append(f"missing: {label}")
    if not meta_path.exists():
        reasons.append(f"missing: {meta_path.name}")
    if not done_path.exists():
        reasons.append(f"missing: {done_path.name}")
    if reasons:
        return False, "incomplete", reasons
    meta = _load_json(meta_path)
    if not isinstance(meta, dict):
        return False, "miss", [f"invalid JSON: {meta_path.name}"]
    for k, v in want_meta.items():
        got = meta.get(k)
        if not _cache_equal(got, v):
            exp_short = _json_canonical_dumps(_json_normalize(_cache_key_normalize(v)))[:160]
            got_short = _json_canonical_dumps(_json_normalize(_cache_key_normalize(got)))[:160]
            reasons.append(f"meta mismatch at key={k}: expected={exp_short} got={got_short}")
    if stage_name:
        ok_done, done_reasons, _done = _validate_done_payload(done_path, stage_name=str(stage_name), want_meta=want_meta, required_paths=required_paths)
        if not ok_done:
            reasons.extend(done_reasons)
    if validators:
        for label, fn in validators:
            try:
                ok, msg = fn()
            except Exception as e:
                ok, msg = False, f"validator_error: {label}: {e}"
            if not ok:
                reasons.append(msg if isinstance(msg, str) else f"invalid_output: {label}")
    if reasons:
        return False, "miss", reasons
    return True, "hit", []

def _save_npy_atomic(path: Path, arr: np.ndarray) -> None:
    """Save numpy array to .npy atomically (write temp then replace)."""
    path = Path(path)
    tmp = path.with_suffix(path.suffix + ".tmp")
    np.save(tmp, arr)
    # np.save appends .npy if suffix not .npy; ensure we replace correct temp
    if tmp.suffix != ".npy" and (tmp.with_suffix(tmp.suffix + ".npy")).exists():
        tmp2 = tmp.with_suffix(tmp.suffix + ".npy")
        tmp = tmp2
    os.replace(str(tmp), str(path))

def _maybe_list_content_sha(list_path: str | Path | None) -> str | None:
    if not list_path:
        return None
    p = Path(list_path).expanduser().resolve()
    if not p.exists():
        return None
    # Content hash (not mtime) for reproducibility checks
    return hashlib.sha256(p.read_bytes()).hexdigest()


def _iter_ensemble_source_paths_from_arg(path_like: str | Path | None) -> list[Path]:
    """Return trajectory/source files referenced by an ensemble argument.

    For a .list input, each non-empty non-comment line is interpreted as a path
    (first whitespace-delimited field). Relative paths are resolved against the
    list file directory. For direct .cod/.cods inputs, the path itself is
    returned. Missing files are preserved in the returned list so cache
    signatures invalidate correctly.
    """
    if not path_like:
        return []
    p = Path(path_like).expanduser().resolve()
    if not p.exists():
        return [p]
    if p.suffix.lower() == '.list':
        out: list[Path] = []
        base = p.parent
        try:
            for raw in p.read_text(encoding='utf-8', errors='ignore').splitlines():
                line = raw.strip()
                if not line or line.startswith('#'):
                    continue
                q = line.split()[0]
                qp = Path(q).expanduser()
                if not qp.is_absolute():
                    qp = (base / qp).resolve()
                else:
                    qp = qp.resolve()
                out.append(qp)
        except Exception:
            return [p]
        return out
    return [p]


def _ensemble_source_bundle_sig(path_like: str | Path | None) -> dict:
    """Return a content signature for an ensemble input and all referenced files.

    This extends plain list-file hashing so that editing a referenced .cod/.cods
    file invalidates caches even when the .list file itself is unchanged.
    """
    if not path_like:
        return {'exists': False}
    root = Path(path_like).expanduser().resolve()
    if not root.exists():
        return {'exists': False, 'path': str(root)}
    items = _iter_ensemble_source_paths_from_arg(root)
    payload: list[dict[str, object]] = []
    for fp in items:
        sig = _content_sig(fp)
        payload.append({'path': str(fp), 'sig': sig})
    return {
        'exists': True,
        'root': str(root),
        'kind': 'list' if root.suffix.lower() == '.list' else 'single',
        'count': int(len(payload)),
        'sha256': _json_sha256(payload),
    }

def _merge_update_features_meta(outdir: Path, **kwargs) -> None:
    """Create/update features_meta.json in outdir with provided key/values."""
    outdir = Path(outdir)
    outdir.mkdir(parents=True, exist_ok=True)
    meta_path = outdir / "features_meta.json"
    meta = _load_json(meta_path) if meta_path.exists() else {}
    if not isinstance(meta, dict):
        raise RuntimeError(f"Invalid JSON object in {meta_path}")
    meta.update({k: v for k, v in kwargs.items() if v is not None})
    _write_json_atomic(meta_path, meta)


def _metadata_signature_payload(*, args: Any | None, refA_path: Path | None, refB_path: Path | None, extra: dict | None = None) -> dict:
    """Build a merged features_meta payload without duplicate keyword collisions."""
    payload = dict(_features_signature_for_cache(args, refA_path, refB_path)) if args is not None else {}
    if extra:
        payload.update(extra)
    return payload


def _require_features_meta_keys(meta: dict, required_keys: Sequence[str], *, context: str) -> None:
    missing = [str(k) for k in required_keys if meta.get(k) is None]
    if missing:
        raise RuntimeError(f"{context}: features_meta.json missing required keys: {', '.join(missing)}")


def _read_features_meta_checked(outdir: Path, *, required_keys: Sequence[str], context: str) -> dict:
    meta_path = Path(outdir) / FEATURES_META_JSON
    if not meta_path.exists():
        raise RuntimeError(f"{context}: missing {FEATURES_META_JSON}")
    meta = _load_json(meta_path)
    if not isinstance(meta, dict):
        raise RuntimeError(f"{context}: invalid JSON object in {FEATURES_META_JSON}")
    _require_features_meta_keys(meta, required_keys, context=context)
    return meta


def _atom_selection_mapping_signature(atomsA: Sequence['AtomRec'], atomsB: Sequence['AtomRec'], sel_idxA: np.ndarray, sel_idxB: np.ndarray, res_keysA: Sequence[tuple], res_keysB: Sequence[tuple]) -> dict:
    def _atom_blob(atoms: Sequence['AtomRec'], sel_idx: np.ndarray) -> bytes:
        parts = []
        for ii in sel_idx.tolist():
            a = atoms[int(ii)]
            parts.append(f"{a.chain}:{a.resid}:{a.resname}:{a.name}:{a.elem}:{a.idx1}")
        return "\n".join(parts).encode("utf-8")

    resA_blob = "\n".join(f"{c}:{r}" for (c, r) in res_keysA).encode("utf-8")
    resB_blob = "\n".join(f"{c}:{r}" for (c, r) in res_keysB).encode("utf-8")
    a_blob = _atom_blob(atomsA, np.asarray(sel_idxA, dtype=np.int32))
    b_blob = _atom_blob(atomsB, np.asarray(sel_idxB, dtype=np.int32))
    return {
        "selected_atomsA_sha256": hashlib.sha256(a_blob).hexdigest(),
        "selected_atomsB_sha256": hashlib.sha256(b_blob).hexdigest(),
        "res_keysA_sha256": hashlib.sha256(resA_blob).hexdigest(),
        "res_keysB_sha256": hashlib.sha256(resB_blob).hexdigest(),
        "selected_atoms_count": int(len(sel_idxA)),
    }


def _features_signature_for_cache(args: Any, refA_path: Path, refB_path: Path) -> dict:
    """Return a minimal but sufficient signature to validate feature caches.

    This signature is used for skip/reuse decisions. It must include all inputs and
    hyperparameters that can change the generated features / pair_index.
    """
    sig = {"cache_namespace": CACHE_NAMESPACE}
    # Do not include the DISTIL source-file hash in cache signatures.
    # The running file SHA is logged for reproducibility, but cache invalidation
    # must depend only on inputs, parameters, and stage-specific algorithm versions.
    sig["listA_sha256"] = _maybe_list_content_sha(getattr(args, "ensembleA", None))
    sig["listB_sha256"] = _maybe_list_content_sha(getattr(args, "ensembleB", None))
    sig["ensembleA_sources_sig"] = _ensemble_source_bundle_sig(getattr(args, "ensembleA", None))
    sig["ensembleB_sources_sig"] = _ensemble_source_bundle_sig(getattr(args, "ensembleB", None))
    # Reference PDBs define atom ordering / selection mapping.
    sig["refA_sha256"] = _sha256_file(refA_path) if refA_path else None
    sig["refB_sha256"] = _sha256_file(refB_path) if refB_path else None
    # Atom selection specs
    sig["atom_spec"]  = getattr(args, "atom_spec", None) or ""
    sig["atom_specA"] = getattr(args, "atom_specA", None) or ""
    sig["atom_specB"] = getattr(args, "atom_specB", None) or ""
    sig["frame_stride"] = int(getattr(args, "frame_stride", 0) or 0)
    # Contact definition (near pairs)
    sig["contact_distance"] = float(getattr(args, "contact_distance", 0.0))
    # Topology / bond exclusion settings (affect pair exclusions)
    sig["tpl_exclude_up_to"] = int(getattr(args, "tpl_exclude_up_to", 2))
    sig["topology_filter_version"] = int(TOPOLOGY_FILTER_VERSION)
    sig["topology_graph_source"] = "full_tpl"
    sig["tpl_exclude_semantics"] = "bond_shortest_path_distance"
    sig["long_exclusion_basis"] = "topology_filtered_final_near_pairs_v1"
    sig["default_tpl_exclude_up_to"] = 2
    sig["tpl_path"]  = str(getattr(args, "tpl",  None) or "")
    sig["tplA_path"] = str(getattr(args, "tplA", None) or "")
    sig["tplB_path"] = str(getattr(args, "tplB", None) or "")
    sig["equiv_atoms_mode"] = str(getattr(args, "equiv_atoms", "aggregate") or "aggregate")
    sig["equiv_atoms_version"] = int(EQUIV_ATOMS_VERSION)
    sig["equiv_expand_selection"] = bool(getattr(args, "equiv_expand_selection", True))
    sig["equiv_map_path"] = str(getattr(args, "equiv_map", None) or "")
    if sig["equiv_map_path"]:
        sig["equiv_map_sha256"] = _sha256_file(Path(sig["equiv_map_path"]))
    # Include tpl file digests when paths are provided
    if sig["tpl_path"]:
        sig["tpl_sha256"] = _sha256_file(Path(sig["tpl_path"]))
    if sig["tplA_path"]:
        sig["tplA_sha256"] = _sha256_file(Path(sig["tplA_path"]))
    if sig["tplB_path"]:
        sig["tplB_sha256"] = _sha256_file(Path(sig["tplB_path"]))
    sig["features_cache_version"] = int(FEATURES_CACHE_VERSION)
    sig["feature_definition_version"] = int(FEATURE_DEFINITION_VERSION)
    sig["pair_index_version"] = int(PAIR_INDEX_VERSION)
    return sig

def _features_cache_matches(meta: dict, want_sig: dict) -> bool:
    """Return True if cached meta matches the desired signature."""
    if not meta:
        return False
    for k, v in want_sig.items():
        if v is None:
            continue
        if not _cache_equal(meta.get(k), v):
            return False
    return True


def _json_canonical_dumps(obj: Any) -> str:
    return json.dumps(obj, ensure_ascii=False, sort_keys=True, separators=(",", ":"))


def _json_sha256(obj: Any) -> str:
    return hashlib.sha256(_json_canonical_dumps(obj).encode("utf-8")).hexdigest()


def _array_sig(arr: np.ndarray | list | tuple | None) -> dict:
    if arr is None:
        return {"exists": False}
    a = np.asarray(arr)
    a = np.ascontiguousarray(a)
    return {
        "exists": True,
        "dtype": str(a.dtype),
        "shape": [int(x) for x in a.shape],
        "sha256": hashlib.sha256(a.view(np.uint8).tobytes()).hexdigest(),
    }


def _json_normalize(obj: Any) -> Any:
    if isinstance(obj, str):
        s = obj.strip()
        if s and ((s[0], s[-1]) in {("{", "}"), ("[", "]"), ("(", ")")}):
            parsed = None
            try:
                parsed = json.loads(s)
            except Exception:
                try:
                    parsed = ast.literal_eval(s)
                except Exception:
                    parsed = None
            if parsed is not None and parsed is not obj:
                return _json_normalize(parsed)
        return obj
    if isinstance(obj, dict):
        return {str(k): _json_normalize(v) for k, v in obj.items()}
    if isinstance(obj, (list, tuple)):
        return [_json_normalize(v) for v in obj]
    return obj




def _cache_key_normalize(obj: Any) -> Any:
    """Normalize objects for cache comparison while ignoring audit-only fields."""
    ignored = {"distil_file_sha256", "completed_at"}
    if isinstance(obj, str):
        norm = _json_normalize(obj)
        if norm is not obj:
            return _cache_key_normalize(norm)
        return obj
    if isinstance(obj, dict):
        return {
            str(k): _cache_key_normalize(v)
            for k, v in sorted(obj.items(), key=lambda kv: str(kv[0]))
            if str(k) not in ignored
        }
    if isinstance(obj, (list, tuple)):
        return [_cache_key_normalize(v) for v in obj]
    if isinstance(obj, np.generic):
        return obj.item()
    if isinstance(obj, Path):
        return str(obj)
    return obj


def _cache_equal(a: Any, b: Any) -> bool:
    return _json_normalize(_cache_key_normalize(a)) == _json_normalize(_cache_key_normalize(b))


def _cache_sig(obj: Any) -> str:
    return _json_sha256(_cache_key_normalize(obj))


def _done_cache_sig(path: Path) -> str:
    payload = _load_json(Path(path))
    if not isinstance(payload, dict):
        return ""
    sig = payload.get("cache_meta_sig")
    if sig:
        return str(sig)
    return str(payload.get("meta_sig", "") or "")


def _streaming_direct_source_sig() -> dict:
    return {"exists": False, "mode": "streaming-direct"}


def _normalize_source_feature_sig(sig: Any) -> dict:
    """Canonicalize source_features_* signatures for skip comparisons.

    In the selected-feature-only pipeline the absence of original full feature matrices is an expected
    state and must be represented consistently as {"exists": False, "mode": "streaming-direct"}.
    This avoids cache misses caused only by metadata spelling differences.
    """
    if isinstance(sig, dict):
        out = dict(sig)
        if not bool(out.get("exists", False)):
            out.setdefault("mode", "streaming-direct")
            out["exists"] = False
        return _json_normalize(out)
    return _streaming_direct_source_sig()


def _hash_cache_path(path: Path) -> Path:
    path = Path(path)
    return path.parent / f".{path.name}.sha256.json"


def _content_sig(path: str | Path | None) -> dict:
    """Content-based file signature with a small sidecar digest cache."""
    if path is None:
        return {"exists": False}
    p = Path(path).expanduser().resolve()
    if not p.exists():
        return {"exists": False}
    st = p.stat()
    sidecar = _hash_cache_path(p)
    try:
        cached = _load_json(sidecar) if sidecar.exists() else {}
        if (cached.get("size") == int(st.st_size) and
                cached.get("mtime_ns") == int(st.st_mtime_ns) and
                isinstance(cached.get("sha256"), str) and cached.get("sha256")):
            sha = cached["sha256"]
        else:
            sha = _sha256_file(p)
            _write_json_atomic(sidecar, {
                "path": str(p),
                "size": int(st.st_size),
                "mtime_ns": int(st.st_mtime_ns),
                "sha256": sha,
            })
    except Exception:
        sha = _sha256_file(p)
    return {"exists": True, "size": int(st.st_size), "sha256": sha}


def _cache_version_sig(version: int | str) -> dict:
    return {"namespace": CACHE_NAMESPACE, "version": str(version)}


def _meta_sig(path: str | Path | None) -> dict:
    if path is None:
        return {"exists": False}
    p = Path(path)
    if not p.exists():
        return {"exists": False}
    try:
        return {"exists": True, "sha256": _json_sha256(_load_json(p))}
    except Exception:
        return _content_sig(p)


def _stored_content_sig(meta: dict | None, key: str) -> dict:
    """Return a stored content signature from metadata if present and well-formed."""
    if not isinstance(meta, dict):
        return _streaming_direct_source_sig() if key in ("source_features_A", "source_features_B") else {"exists": False}
    v = meta.get(key)
    if isinstance(v, dict) and "exists" in v:
        return _normalize_source_feature_sig(v) if key in ("source_features_A", "source_features_B") else v
    return _streaming_direct_source_sig() if key in ("source_features_A", "source_features_B") else {"exists": False}


def _select_stage1_auc_frame_indices(nA: int, nB: int, args, seed: int) -> tuple[np.ndarray, np.ndarray, str]:
    """Return Stage1 AUC frame indices and selection mode.

    Stage1 AUC always uses all available frames. Sampling caps were removed to keep
    the integrated Stage1 pipeline deterministic and to avoid stale cache
    """
    return np.arange(int(nA), dtype=np.int64), np.arange(int(nB), dtype=np.int64), "full"


def _standardized_weighted_block(
    XA: np.ndarray,
    XB: np.ndarray,
    cols: slice,
    mu: np.ndarray,
    inv_std: np.ndarray,
    wa_scale: np.ndarray,
    wb_scale: np.ndarray,
) -> tuple[np.ndarray, np.ndarray]:
    """Return weighted standardized A/B blocks for the given feature slice."""
    Ablk = np.asarray(XA[:, cols], dtype=np.float32)
    Bblk = np.asarray(XB[:, cols], dtype=np.float32)
    mu_blk = np.asarray(mu[cols], dtype=np.float32)
    inv_blk = np.asarray(inv_std[cols], dtype=np.float32)
    Ablk = (Ablk - mu_blk[None, :]) * inv_blk[None, :]
    Bblk = (Bblk - mu_blk[None, :]) * inv_blk[None, :]
    Ablk *= wa_scale[:, None]
    Bblk *= wb_scale[:, None]
    return Ablk, Bblk






def _stage1_scratch_chunk_memmap_path(*, scratch_dir: Path, ensemble_tag: str, chunk_id: int) -> Path:
    return Path(scratch_dir) / f"{str(ensemble_tag)}_chunk_{int(chunk_id):05d}.dist.npy"


def _stage1_scratch_chunk_memmap_done_path(*, scratch_dir: Path, ensemble_tag: str, chunk_id: int) -> Path:
    return Path(scratch_dir) / f"{str(ensemble_tag)}_chunk_{int(chunk_id):05d}.dist.done.json"


def _stage1_scratch_chunk_memmap_ok(*, scratch_dir: Path, ensemble_tag: str, chunk_id: int, run_signature_hash: str | None = None, n_rows: int | None = None, n_cols: int | None = None) -> bool:
    data_path = _stage1_scratch_chunk_memmap_path(scratch_dir=Path(scratch_dir), ensemble_tag=str(ensemble_tag), chunk_id=int(chunk_id))
    done_path = _stage1_scratch_chunk_memmap_done_path(scratch_dir=Path(scratch_dir), ensemble_tag=str(ensemble_tag), chunk_id=int(chunk_id))
    if not (data_path.exists() and done_path.exists()):
        return False
    payload = _load_json(done_path)
    if not isinstance(payload, dict):
        return False
    if run_signature_hash is not None and str(payload.get('run_signature_hash', '')) != str(run_signature_hash):
        return False
    try:
        arr = np.load(data_path, mmap_mode='r')
        if getattr(arr, 'ndim', 0) != 2:
            return False
        if n_rows is not None and int(arr.shape[0]) != int(n_rows):
            return False
        if n_cols is not None and int(arr.shape[1]) != int(n_cols):
            return False
    except Exception:
        return False
    return True


def _stage1_scratch_chunk_lookup(*, scratch_dir: Path, ensemble_tag: str, chunk_id: int) -> list[Path]:
    memmap_path = _stage1_scratch_chunk_memmap_path(scratch_dir=Path(scratch_dir), ensemble_tag=str(ensemble_tag), chunk_id=int(chunk_id))
    done_path = _stage1_scratch_chunk_memmap_done_path(scratch_dir=Path(scratch_dir), ensemble_tag=str(ensemble_tag), chunk_id=int(chunk_id))
    if memmap_path.exists() and done_path.exists():
        return [memmap_path]
    paths=[]
    bid=0
    while True:
        fp = Path(scratch_dir) / f"{ensemble_tag}_block_{int(bid):05d}_chunk_{int(chunk_id):05d}.npy"
        if fp.exists():
            paths.append(fp)
            bid += 1
            continue
        break
    return paths


def _selected_feature_block_from_stage1_scratch(
    *,
    scratch_dir: Path,
    ensemble_tag: str,
    io_feat_chunk: int,
    sel_fids: np.ndarray,
    cols: slice,
    row_idx: np.ndarray | None = None,
) -> np.ndarray:
    col_fids = np.asarray(sel_fids[cols], dtype=np.int64)
    if col_fids.size == 0:
        n_rows = 0 if row_idx is None else int(np.asarray(row_idx, dtype=np.int64).size)
        return np.zeros((n_rows, 0), dtype=np.float32)
    positions = []
    for out_j, fid in enumerate(col_fids.tolist()):
        cid = int(fid) // int(io_feat_chunk)
        loc = int(fid) - cid * int(io_feat_chunk)
        positions.append((out_j, cid, loc))
    by_chunk: dict[int, list[tuple[int,int]]] = {}
    for out_j, cid, loc in positions:
        by_chunk.setdefault(cid, []).append((out_j, loc))

    out: np.ndarray | None = None
    filled = np.zeros((int(col_fids.size),), dtype=bool)
    for cid, spec in by_chunk.items():
        fp = _stage1_scratch_chunk_memmap_path(scratch_dir=Path(scratch_dir), ensemble_tag=str(ensemble_tag), chunk_id=int(cid))
        done = _stage1_scratch_chunk_memmap_done_path(scratch_dir=Path(scratch_dir), ensemble_tag=str(ensemble_tag), chunk_id=int(cid))
        if not (fp.exists() and done.exists()):
            continue
        arr = np.load(fp, mmap_mode='r')
        if out is None:
            out = np.empty((int(arr.shape[0]), int(col_fids.size)), dtype=np.float32)
        elif int(out.shape[0]) != int(arr.shape[0]):
            raise RuntimeError(f"Stage1 chunk-memmap scratch row mismatch for {fp}: got={int(arr.shape[0])} expected={int(out.shape[0])}")
        for out_j, loc in spec:
            out[:, int(out_j)] = np.asarray(arr[:, int(loc)], dtype=np.float32)
            filled[int(out_j)] = True
    if out is not None and bool(np.all(filled)):
        if row_idx is None:
            return out
        ridx = np.asarray(row_idx, dtype=np.int64)
        return np.asarray(out[ridx, :], dtype=np.float32)

    parts = []
    bid = 0
    while True:
        chunk_frames = None
        any_found = False
        for cid, spec in by_chunk.items():
            fp = Path(scratch_dir) / f"{ensemble_tag}_block_{int(bid):05d}_chunk_{int(cid):05d}.npy"
            if not fp.exists():
                continue
            arr = np.load(fp, mmap_mode='r')
            if chunk_frames is None:
                chunk_frames = np.empty((int(arr.shape[0]), int(col_fids.size)), dtype=np.float32)
            for out_j, loc in spec:
                chunk_frames[:, int(out_j)] = np.asarray(arr[:, int(loc)], dtype=np.float32)
            any_found = True
        if not any_found:
            break
        if chunk_frames is None:
            break
        parts.append(chunk_frames)
        bid += 1
    if parts:
        X = np.concatenate(parts, axis=0)
    else:
        X = np.zeros((0, int(col_fids.size)), dtype=np.float32)
    if row_idx is None:
        return X
    ridx = np.asarray(row_idx, dtype=np.int64)
    return np.asarray(X[ridx, :], dtype=np.float32)


def _selected_feature_block_from_stage1_direct_store(
    *,
    store_dir: Path,
    ensemble_tag: str,
    sel_fids: np.ndarray,
    cols: slice,
    row_idx: np.ndarray | None = None,
) -> np.ndarray:
    """Return selected raw distance columns from the Stage1 direct store.

    The Stage1 direct store is written as part files with arrays shaped
    (stored_features, frames).  This helper returns the same layout as the
    other selected-feature sources: (frames, selected_columns).  It is used
    by downstream code paths that need raw distance distributions, such as
    Stage5 representative-pair plots.
    """
    col_fids = np.asarray(sel_fids[cols], dtype=np.int64)
    if col_fids.size == 0:
        n_rows = 0 if row_idx is None else int(np.asarray(row_idx, dtype=np.int64).size)
        return np.zeros((n_rows, 0), dtype=np.float32)

    store_dir = Path(store_dir)
    parts_dir = store_dir / 'parts'
    if not parts_dir.exists():
        raise FileNotFoundError(f"Stage1 direct store parts directory not found: {parts_dir}")

    requested = {int(fid): int(j) for j, fid in enumerate(col_fids.tolist())}
    out: np.ndarray | None = None
    filled = np.zeros((int(col_fids.size),), dtype=bool)

    for fids_file in sorted(parts_dir.glob('*_fids.npy')):
        if bool(np.all(filled)):
            break
        try:
            pfids = np.asarray(np.load(fids_file), dtype=np.int64)
        except Exception:
            continue
        matches: list[tuple[int, int]] = []
        for local_i, fid in enumerate(pfids.tolist()):
            out_j = requested.get(int(fid))
            if out_j is not None and not bool(filled[int(out_j)]):
                matches.append((int(local_i), int(out_j)))
        if not matches:
            continue

        prefix = fids_file.name[:-len('_fids.npy')]
        data_file = parts_dir / f'{prefix}_{str(ensemble_tag)}.npy'
        if not data_file.exists():
            raise FileNotFoundError(f"Stage1 direct store data file not found: {data_file}")
        data = np.load(data_file, mmap_mode='r')
        if data.ndim != 2:
            raise ValueError(f"Stage1 direct store data file must be 2D: {data_file} shape={getattr(data, 'shape', None)}")
        if out is None:
            out = np.empty((int(data.shape[1]), int(col_fids.size)), dtype=np.float32)
        elif int(out.shape[0]) != int(data.shape[1]):
            raise RuntimeError(
                f"Stage1 direct store frame-count mismatch for {data_file}: "
                f"got {int(data.shape[1])}, expected {int(out.shape[0])}"
            )
        local_idx = np.asarray([m[0] for m in matches], dtype=np.int64)
        out_cols = np.asarray([m[1] for m in matches], dtype=np.int64)
        # data is feature-major; transpose to frames x selected columns.
        out[:, out_cols] = np.asarray(data[local_idx, :], dtype=np.float32, order='C').T
        filled[out_cols] = True

    if out is None:
        n_rows = 0 if row_idx is None else int(np.asarray(row_idx, dtype=np.int64).size)
        missing = ','.join(str(int(x)) for x in col_fids[:10].tolist())
        raise KeyError(f"No requested selected features were found in Stage1 direct store: first_missing={missing}")
    if not bool(np.all(filled)):
        missing = col_fids[np.where(~filled)[0]]
        preview = ','.join(str(int(x)) for x in missing[:20].tolist())
        raise KeyError(
            f"Stage1 direct store does not contain all requested selected features: "
            f"missing_count={int(missing.size)} first_missing={preview}"
        )
    if row_idx is None:
        return out
    ridx = np.asarray(row_idx, dtype=np.int64)
    return np.asarray(out[ridx, :], dtype=np.float32)


def _selected_feature_block_any_source(
    source: dict,
    ensemble_tag: str,
    sel_fids: np.ndarray,
    cols: slice,
    row_idx: np.ndarray | None = None,
) -> np.ndarray:
    kind = str(source.get('kind', 'full'))
    if kind == 'full':
        X = source['XA'] if ensemble_tag == 'A' else source['XB']
        return _selected_feature_block(X, sel_fids, cols, row_idx=row_idx)
    if kind == 'local':
        X = source['A'] if ensemble_tag == 'A' else source['B']
        return _selected_feature_block(X, sel_fids, cols, row_idx=row_idx)
    if kind == 'stage1_scratch':
        return _selected_feature_block_from_stage1_scratch(
            scratch_dir=Path(source['scratch_dir']),
            ensemble_tag=str(ensemble_tag),
            io_feat_chunk=int(source['io_feat_chunk']),
            sel_fids=sel_fids,
            cols=cols,
            row_idx=row_idx,
        )
    if kind == 'stage1_direct_store':
        try:
            return _selected_feature_block_from_stage1_direct_store(
                store_dir=Path(source['store_dir']),
                ensemble_tag=str(ensemble_tag),
                sel_fids=sel_fids,
                cols=cols,
                row_idx=row_idx,
            )
        except (KeyError, FileNotFoundError) as e:
            fallback = source.get('fallback_source')
            if fallback is None:
                raise
            log_warn(
                f"Stage1 direct store incomplete for raw selected-feature read; "
                f"falling back to Stage1 scratch for requested block: {e}"
            )
            return _selected_feature_block_any_source(
                fallback, ensemble_tag, sel_fids, cols, row_idx=row_idx
            )
    raise ValueError(f"Unknown selected-feature source kind: {kind}")

def _selected_feature_block(X: np.ndarray, sel_fids: np.ndarray, cols: slice, row_idx: np.ndarray | None = None) -> np.ndarray:
    """Return selected feature columns from a full feature matrix.

    Parameters
    ----------
    X : np.ndarray
        Full feature matrix with shape (n_frames, n_features_full).
    sel_fids : np.ndarray
        Feature ids selected from the full matrix.
    cols : slice
        Slice in the selected-feature space.
    row_idx : np.ndarray | None
        Optional row indices to subselect frames.
    """
    col_idx = np.asarray(sel_fids[cols], dtype=np.int64)
    if row_idx is None:
        return np.asarray(X[:, col_idx], dtype=np.float32)
    return np.asarray(X[np.asarray(row_idx, dtype=np.int64)[:, None], col_idx[None, :]], dtype=np.float32)


def _weighted_feature_moments_from_any_selected(
    source: dict,
    sel_fids: np.ndarray,
    wA: np.ndarray,
    wB: np.ndarray,
    *,
    feature_block: int,
    row_idxA: np.ndarray | None = None,
    row_idxB: np.ndarray | None = None,
    progress_interval_sec: float = 300.0,
    workers: int = 1,
) -> tuple[np.ndarray, np.ndarray, float, np.ndarray, np.ndarray]:
    """Compute weighted mean/variance for selected features from full selected-feature source."""
    F = int(np.asarray(sel_fids).size)
    if isinstance(source, (np.ndarray, np.memmap)):
        n_rows = int(source.shape[0])
        if row_idxA is None or row_idxB is None:
            raise ValueError('row_idxA and row_idxB are required when source is an array-backed selected-feature matrix')
        nA = int(np.asarray(row_idxA).size)
        nB = int(np.asarray(row_idxB).size)
    elif str(source.get('kind','full')) == 'full':
        XA_full = source['XA']; XB_full = source['XB']
        nA = int(XA_full.shape[0] if row_idxA is None else np.asarray(row_idxA).size)
        nB = int(XB_full.shape[0] if row_idxB is None else np.asarray(row_idxB).size)
    else:
        nA = int(source.get('nA', 0) if row_idxA is None else np.asarray(row_idxA).size)
        nB = int(source.get('nB', 0) if row_idxB is None else np.asarray(row_idxB).size)
    sw = float(np.sum(wA) + np.sum(wB))
    if not (sw > 0.0):
        wA = np.ones((nA,), dtype=np.float64)
        wB = np.ones((nB,), dtype=np.float64)
        sw = float(np.sum(wA) + np.sum(wB))
    wA_norm = np.asarray(wA, dtype=np.float64) / sw
    wB_norm = np.asarray(wB, dtype=np.float64) / sw
    wa_scale = np.sqrt(wA_norm, dtype=np.float64).astype(np.float32, copy=False)
    wb_scale = np.sqrt(wB_norm, dtype=np.float64).astype(np.float32, copy=False)

    mu = np.empty((F,), dtype=np.float64)
    inv_std = np.empty((F,), dtype=np.float32)
    fb = max(1, int(feature_block))
    tasks = [(j0, min(F, j0 + fb)) for j0 in range(0, F, fb)]

    def one(task: tuple[int, int]):
        j0, j1 = task
        cols = slice(j0, j1)
        Ablk = _selected_feature_block_any_source(source, "A", sel_fids, cols, row_idx=row_idxA).astype(np.float64, copy=False)
        Bblk = _selected_feature_block_any_source(source, "B", sel_fids, cols, row_idx=row_idxB).astype(np.float64, copy=False)
        mu_blk = (wA_norm[:, None] * Ablk).sum(axis=0) + (wB_norm[:, None] * Bblk).sum(axis=0)
        Ac = Ablk - mu_blk[None, :]
        Bc = Bblk - mu_blk[None, :]
        var_blk = (wA_norm[:, None] * (Ac * Ac)).sum(axis=0) + (wB_norm[:, None] * (Bc * Bc)).sum(axis=0)
        var_blk[var_blk <= 0.0] = 1.0
        inv_blk = (1.0 / np.sqrt(var_blk)).astype(np.float32, copy=False)
        return j0, j1, mu_blk, inv_blk

    progress = _progress_logger('Stage3/exact moments', total_units=max(1, len(tasks)), min_interval_sec=progress_interval_sec, active_label='features_done')
    done = 0
    feat_done = 0
    if int(max(1, workers)) <= 1 or len(tasks) <= 1:
        for task in tasks:
            j0, j1, mu_blk, inv_blk = one(task)
            mu[j0:j1] = mu_blk
            inv_std[j0:j1] = inv_blk
            done += 1
            feat_done = j1
            progress(done, active=feat_done)
    else:
        with ThreadPoolExecutor(max_workers=int(max(1, workers))) as ex:
            futs = [ex.submit(one, t) for t in tasks]
            for fut in as_completed(futs):
                j0, j1, mu_blk, inv_blk = fut.result()
                mu[j0:j1] = mu_blk
                inv_std[j0:j1] = inv_blk
                done += 1
                feat_done += (j1 - j0)
                progress(done, active=min(feat_done, F))
    return mu, inv_std, sw, wa_scale, wb_scale


def _standardized_weighted_block_from_any_selected(
    source: dict,
    sel_fids: np.ndarray,
    cols: slice,
    mu: np.ndarray,
    inv_std: np.ndarray,
    wa_scale: np.ndarray,
    wb_scale: np.ndarray,
    *,
    row_idxA: np.ndarray | None = None,
    row_idxB: np.ndarray | None = None,
) -> tuple[np.ndarray, np.ndarray]:
    """Return weighted standardized selected-feature blocks from full matrices."""
    Ablk = _selected_feature_block_any_source(source, "A", sel_fids, cols, row_idx=row_idxA)
    Bblk = _selected_feature_block_any_source(source, "B", sel_fids, cols, row_idx=row_idxB)
    mu_blk = np.asarray(mu[cols], dtype=np.float32)
    inv_blk = np.asarray(inv_std[cols], dtype=np.float32)
    Ablk = (Ablk - mu_blk[None, :]) * inv_blk[None, :]
    Bblk = (Bblk - mu_blk[None, :]) * inv_blk[None, :]
    Ablk *= wa_scale[:, None]
    Bblk *= wb_scale[:, None]
    return Ablk, Bblk








def _stage3_exact_corr_edges_blockwise(
    source: dict,
    sel_fids: np.ndarray,
    mu: np.ndarray,
    inv_std: np.ndarray,
    wa_scale: np.ndarray,
    wb_scale: np.ndarray,
    *,
    tau_corr: float,
    block: int,
    row_idxA: np.ndarray | None,
    row_idxB: np.ndarray | None,
    progress_interval_sec: float = 300.0,
) -> list[tuple[int, int, float]]:
    """Enumerate all selected-feature pairs with exact weighted distance correlation >= tau_corr.

    This is the complete Stage3 correlation path: it does not use probabilistic
    probabilistic screening or bounded-neighbor pruning, so every edge above
    the requested threshold in the selected-feature set is retained.
    """
    F = int(np.asarray(sel_fids).size)
    if F <= 1:
        return []
    fb = max(1, int(block))
    block_spans = [(i0, min(F, i0 + fb)) for i0 in range(0, F, fb)]
    total_units = len(block_spans) * (len(block_spans) + 1) // 2
    progress = _progress_logger('Stage3/exact_corr', total_units=max(1, total_units), min_interval_sec=progress_interval_sec, active_label='kept_edges')
    edge_map: dict[tuple[int, int], float] = {}
    done = 0
    for bi, (i0, i1) in enumerate(block_spans):
        cols_i = slice(i0, i1)
        A_i, B_i = _standardized_weighted_block_from_any_selected(
            source, sel_fids, cols_i, mu, inv_std, wa_scale, wb_scale,
            row_idxA=row_idxA, row_idxB=row_idxB,
        )
        for j0, j1 in block_spans[bi:]:
            cols_j = slice(j0, j1)
            if j0 == i0:
                A_j, B_j = A_i, B_i
            else:
                A_j, B_j = _standardized_weighted_block_from_any_selected(
                    source, sel_fids, cols_j, mu, inv_std, wa_scale, wb_scale,
                    row_idxA=row_idxA, row_idxB=row_idxB,
                )
            C = (A_i.T @ A_j) + (B_i.T @ B_j)
            if j0 == i0:
                rr, cc = np.where(np.triu(C >= float(tau_corr), k=1))
            else:
                rr, cc = np.where(C >= float(tau_corr))
            for r, c in zip(rr.tolist(), cc.tolist()):
                pi = i0 + int(r)
                pj = j0 + int(c)
                if pj <= pi:
                    continue
                edge_map[(int(sel_fids[pi]), int(sel_fids[pj]))] = float(C[int(r), int(c)])
            done += 1
            progress(done, active=len(edge_map), force=False)
        try:
            del A_i, B_i
        except Exception:
            pass
    progress(max(1, total_units), active=len(edge_map), force=True)
    return [(fi, gj, edge_map[(fi, gj)]) for fi, gj in sorted(edge_map.keys())]


def _stage3_standardized_ensemble_chunk(
    source: dict,
    ensemble_tag: str,
    sel_fids: np.ndarray,
    cols: slice,
    mu: np.ndarray,
    inv_std: np.ndarray,
    scale_all: np.ndarray,
    local_rows: np.ndarray,
    base_row_idx: np.ndarray | None,
) -> np.ndarray:
    """Load a weighted standardized row chunk for Stage3 safe pruning."""
    local_rows = np.asarray(local_rows, dtype=np.int64)
    if base_row_idx is None:
        rows = local_rows
    else:
        rows = np.asarray(base_row_idx, dtype=np.int64)[local_rows]
    X = _selected_feature_block_any_source(source, ensemble_tag, sel_fids, cols, row_idx=rows)
    X = (X - np.asarray(mu[cols], dtype=np.float32)[None, :]) * np.asarray(inv_std[cols], dtype=np.float32)[None, :]
    X *= np.asarray(scale_all, dtype=np.float32)[local_rows, None]
    return np.asarray(X, dtype=np.float32, order='C')


def _stage3_safe_prune_corr_edges(
    source: dict,
    sel_fids: np.ndarray,
    mu: np.ndarray,
    inv_std: np.ndarray,
    wa_scale: np.ndarray,
    wb_scale: np.ndarray,
    *,
    tau_corr: float,
    block: int,
    sample_block: int,
    row_idxA: np.ndarray | None,
    row_idxB: np.ndarray | None,
    progress_interval_sec: float = 300.0,
) -> list[tuple[int, int, float]]:
    """Complete correlation search with safe Cauchy--Schwarz block pruning.

    The pruning is conservative: a pair is dropped only when the current partial
    dot product plus the maximum possible residual dot product is below tau_corr.
    Therefore no edge with final correlation >= tau_corr is discarded.
    """
    F = int(np.asarray(sel_fids).size)
    if F <= 1:
        return []
    fb = max(1, int(block))
    rb = max(1, int(sample_block))
    nA = int(wa_scale.size)
    nB = int(wb_scale.size)
    spans = [(i0, min(F, i0 + fb)) for i0 in range(0, F, fb)]
    row_spans = [('A', r0, min(nA, r0 + rb)) for r0 in range(0, nA, rb)] + [('B', r0, min(nB, r0 + rb)) for r0 in range(0, nB, rb)]
    total_units = len(spans) * (len(spans) + 1) // 2
    progress = _progress_logger('Stage3/safe_prune_corr', total_units=max(1, total_units), min_interval_sec=progress_interval_sec, active_label='kept_edges')
    edge_map: dict[tuple[int, int], float] = {}
    pruned_pairs = 0
    refined_pairs = 0
    done = 0
    for bi, (i0, i1) in enumerate(spans):
        mi = i1 - i0
        for j0, j1 in spans[bi:]:
            mj = j1 - j0
            C = np.zeros((mi, mj), dtype=np.float32)
            norm_i = np.zeros((mi,), dtype=np.float32)
            norm_j = np.zeros((mj,), dtype=np.float32)
            active = np.ones((mi, mj), dtype=bool)
            if i0 == j0:
                active &= np.triu(np.ones((mi, mj), dtype=bool), k=1)
            for ens, r0, r1 in row_spans:
                if not active.any():
                    break
                rows_local = np.arange(r0, r1, dtype=np.int64)
                if ens == 'A':
                    Xi = _stage3_standardized_ensemble_chunk(source, 'A', sel_fids, slice(i0, i1), mu, inv_std, wa_scale, rows_local, row_idxA)
                    Xj = Xi if i0 == j0 else _stage3_standardized_ensemble_chunk(source, 'A', sel_fids, slice(j0, j1), mu, inv_std, wa_scale, rows_local, row_idxA)
                else:
                    Xi = _stage3_standardized_ensemble_chunk(source, 'B', sel_fids, slice(i0, i1), mu, inv_std, wb_scale, rows_local, row_idxB)
                    Xj = Xi if i0 == j0 else _stage3_standardized_ensemble_chunk(source, 'B', sel_fids, slice(j0, j1), mu, inv_std, wb_scale, rows_local, row_idxB)
                C += Xi.T @ Xj
                norm_i += np.sum(Xi * Xi, axis=0, dtype=np.float32)
                if i0 == j0:
                    norm_j = norm_i.copy()
                else:
                    norm_j += np.sum(Xj * Xj, axis=0, dtype=np.float32)
                ri = np.sqrt(np.maximum(0.0, 1.0 - norm_i), dtype=np.float32)
                rj = np.sqrt(np.maximum(0.0, 1.0 - norm_j), dtype=np.float32)
                upper = C + np.outer(ri, rj).astype(np.float32, copy=False)
                new_active = active & (upper >= float(tau_corr))
                pruned_pairs += int(np.count_nonzero(active) - np.count_nonzero(new_active))
                active = new_active
            rr, cc = np.where(C >= float(tau_corr))
            refined_pairs += int(C.size)
            for r, c in zip(rr.tolist(), cc.tolist()):
                pi = i0 + int(r)
                pj = j0 + int(c)
                if pj <= pi:
                    continue
                edge_map[(int(sel_fids[pi]), int(sel_fids[pj]))] = float(C[int(r), int(c)])
            done += 1
            progress(done, active=len(edge_map), force=False)
    progress(max(1, total_units), active=len(edge_map), force=True)
    if _log_enabled('info'):
        log_info(f"Stage3 safe-prune summary: edges={len(edge_map)} pruned_pair_steps={int(pruned_pairs)} block_pair_elements={int(refined_pairs)}")
    return [(fi, gj, edge_map[(fi, gj)]) for fi, gj in sorted(edge_map.keys())]


def _stage3_materialize_weighted_standardized_matrix(
    source: dict,
    sel_fids: np.ndarray,
    wA: np.ndarray,
    wB: np.ndarray,
    *,
    z_path: Path,
    moments_path: Path,
    feature_block: int,
    row_idxA: np.ndarray | None = None,
    row_idxB: np.ndarray | None = None,
    progress_interval_sec: float = 300.0,
) -> tuple[np.ndarray, np.ndarray, float, np.ndarray, np.ndarray, tuple[int, int]]:
    """Materialize Stage3 selected distance features once as weighted standardized rows.

    The output matrix has shape (n_selected_features, n_selected_frames) and is
    stored as a .npy memmap.  Row-wise dot products of this matrix are exact
    weighted correlations for the selected distance features, so later Stage3
    correlation code never needs to reopen the fragmented Stage1 scratch files.

    For Stage1-scratch input, selected features are processed by original
    Stage1 feature chunk rather than by ranking order.  This avoids rereading
    the same scratch chunk in multiple materialization blocks, which was the
    main cause of very slow Stage3 materialization on large scratch trees.
    """
    F = int(np.asarray(sel_fids).size)
    if F <= 0:
        raise ValueError("Stage3 cannot materialize an empty selected-feature matrix")
    nA = int(np.asarray(wA).size)
    nB = int(np.asarray(wB).size)
    if nA <= 0 or nB <= 0:
        raise ValueError(f"Stage3 materialize requires non-empty filtered frame sets: nA={nA}, nB={nB}")
    sw = float(np.sum(wA) + np.sum(wB))
    if not (sw > 0.0):
        wA = np.ones((nA,), dtype=np.float64)
        wB = np.ones((nB,), dtype=np.float64)
        sw = float(np.sum(wA) + np.sum(wB))
    wA_norm = np.asarray(wA, dtype=np.float64) / sw
    wB_norm = np.asarray(wB, dtype=np.float64) / sw
    wa_scale = np.sqrt(wA_norm).astype(np.float32, copy=False)
    wb_scale = np.sqrt(wB_norm).astype(np.float32, copy=False)

    z_path = Path(z_path)
    moments_path = Path(moments_path)
    z_path.parent.mkdir(parents=True, exist_ok=True)
    moments_path.parent.mkdir(parents=True, exist_ok=True)
    tmp_z = z_path.with_suffix(z_path.suffix + f".tmp.{os.getpid()}")
    if tmp_z.exists():
        try:
            tmp_z.unlink()
        except Exception:
            pass
    Z = np.lib.format.open_memmap(tmp_z, mode="w+", dtype=np.float32, shape=(F, nA + nB))
    mu = np.empty((F,), dtype=np.float64)
    inv_std = np.empty((F,), dtype=np.float32)

    min_interval = max(1.0, float(progress_interval_sec or 300.0))
    last_read_log = [time.perf_counter()]

    def _emit_read_progress(*, ens: str, group_index: int, group_total: int, cid: int, bid: int, features_done: int, force: bool = False) -> None:
        now = time.perf_counter()
        if (not force) and (now - last_read_log[0] < min_interval):
            return
        last_read_log[0] = now
        print(_apply_log_prefix(
            f"[PROG ] Stage3/materialize-read: group={group_index}/{group_total} "
            f"ensemble={ens} chunk={int(cid)} frame_block={int(bid)} features_done={int(features_done)}"
        ), file=sys.stderr, flush=True)

    def _load_scratch_group(ensemble_tag: str, cid: int, locs: np.ndarray, row_idx: np.ndarray | None, *, group_index: int, group_total: int, features_done: int) -> np.ndarray:
        scratch_dir = Path(source['scratch_dir'])
        parts: list[np.ndarray] = []
        bid = 0
        while True:
            fp = scratch_dir / f"{ensemble_tag}_block_{int(bid):05d}_chunk_{int(cid):05d}.npy"
            if not fp.exists():
                break
            arr = np.load(fp, mmap_mode='r')
            # Using a single advanced-indexed read per frame block is much cheaper
            # than copying each selected column independently.
            parts.append(np.asarray(arr[:, locs], dtype=np.float32, order='C'))
            bid += 1
            _emit_read_progress(ens=ensemble_tag, group_index=group_index, group_total=group_total, cid=cid, bid=bid, features_done=features_done)
        if parts:
            X = np.concatenate(parts, axis=0)
        else:
            X = np.zeros((0, int(locs.size)), dtype=np.float32)
        if row_idx is None:
            return X
        ridx = np.asarray(row_idx, dtype=np.int64)
        return np.asarray(X[ridx, :], dtype=np.float32, order='C')

    if str(source.get('kind', 'full')) == 'stage1_direct_store':
        store_dir = Path(source['store_dir'])
        parts_dir = store_dir / 'parts'
        fid_to_row = {int(fid): int(i) for i, fid in enumerate(np.asarray(sel_fids, dtype=np.int64).tolist())}
        part_fids_files = sorted(parts_dir.glob('*_fids.npy'))
        task_label = 'Stage3/materialize selected distances'
        progress = _progress_logger(
            task_label,
            total_units=max(1, len(part_fids_files)),
            min_interval_sec=progress_interval_sec,
            active_label='features_done',
        )
        log_info(f"Stage3 materialize plan: source=stage1_direct_store parts={len(part_fids_files)} selected_features={F} matrix_shape=({F},{nA+nB})")
        progress(0, active=0, force=True)
        filled = np.zeros((F,), dtype=bool)
        features_done = 0
        for part_index, fids_file in enumerate(part_fids_files, start=1):
            prefix = fids_file.name[:-len('_fids.npy')]
            A_file = parts_dir / f'{prefix}_A.npy'
            B_file = parts_dir / f'{prefix}_B.npy'
            if not A_file.exists() or not B_file.exists():
                progress(part_index, active=features_done, force=False)
                continue
            pfids = np.load(fids_file).astype(np.int64, copy=False)
            targets = [(k, fid_to_row[int(fid)]) for k, fid in enumerate(pfids.tolist()) if int(fid) in fid_to_row]
            if not targets:
                progress(part_index, active=features_done, force=False)
                continue
            local_idx = np.asarray([t[0] for t in targets], dtype=np.int64)
            out_cols = np.asarray([t[1] for t in targets], dtype=np.int64)
            Araw = np.load(A_file, mmap_mode='r')
            Braw = np.load(B_file, mmap_mode='r')
            Ablk = np.asarray(Araw[local_idx, :], dtype=np.float32, order='C').T
            Bblk = np.asarray(Braw[local_idx, :], dtype=np.float32, order='C').T
            if Ablk.shape[0] != nA or Bblk.shape[0] != nB:
                raise RuntimeError(f"Stage3 direct-store row mismatch in {prefix}: A={Ablk.shape[0]} expected={nA}, B={Bblk.shape[0]} expected={nB}")
            mu_blk = (wA_norm[:, None] * Ablk.astype(np.float64, copy=False)).sum(axis=0) + (wB_norm[:, None] * Bblk.astype(np.float64, copy=False)).sum(axis=0)
            Ac = Ablk.astype(np.float64, copy=False) - mu_blk[None, :]
            Bc = Bblk.astype(np.float64, copy=False) - mu_blk[None, :]
            var_blk = (wA_norm[:, None] * (Ac * Ac)).sum(axis=0) + (wB_norm[:, None] * (Bc * Bc)).sum(axis=0)
            var_blk[var_blk <= 0.0] = 1.0
            inv_blk = (1.0 / np.sqrt(var_blk)).astype(np.float32, copy=False)
            rows_out = np.asarray(out_cols, dtype=np.int64)
            Z[rows_out, :nA] = ((Ablk - mu_blk[None, :]).astype(np.float32, copy=False) * inv_blk[None, :] * wa_scale[:, None]).T
            Z[rows_out, nA:] = ((Bblk - mu_blk[None, :]).astype(np.float32, copy=False) * inv_blk[None, :] * wb_scale[:, None]).T
            mu[rows_out] = mu_blk
            inv_std[rows_out] = inv_blk
            filled[rows_out] = True
            features_done += int(out_cols.size)
            progress(part_index, active=features_done, force=False)
        progress(max(1, len(part_fids_files)), active=features_done, force=True)
        if not bool(np.all(filled)):
            missing_rows_all = np.where(~filled)[0].astype(np.int64, copy=False)
            missing = np.asarray(sel_fids, dtype=np.int64)[missing_rows_all]
            fallback = source.get('fallback_source')
            if fallback is None:
                raise RuntimeError(f"Stage3 direct distance store missing {int(missing.size)} selected features; first_missing={missing[:10].tolist()}")
            log_warn(
                f"Stage3 direct distance store missing {int(missing.size)} selected features; "
                f"completing missing rows from Stage1 scratch. first_missing={missing[:10].tolist()}"
            )
            fb = max(1, int(feature_block))
            fallback_tasks = [(i0, min(int(missing.size), i0 + fb)) for i0 in range(0, int(missing.size), fb)]
            fallback_progress = _progress_logger(
                'Stage3/materialize direct-store fallback',
                total_units=max(1, len(fallback_tasks)),
                min_interval_sec=progress_interval_sec,
                active_label='features_done',
            )
            fallback_progress(0, active=features_done, force=True)
            for task_i, (m0, m1) in enumerate(fallback_tasks, start=1):
                miss_fids_blk = np.asarray(missing[m0:m1], dtype=np.int64)
                rows_out = np.asarray(missing_rows_all[m0:m1], dtype=np.int64)
                Ablk = _selected_feature_block_any_source(
                    fallback, 'A', miss_fids_blk, slice(0, int(miss_fids_blk.size)), row_idx=row_idxA
                ).astype(np.float32, copy=False)
                Bblk = _selected_feature_block_any_source(
                    fallback, 'B', miss_fids_blk, slice(0, int(miss_fids_blk.size)), row_idx=row_idxB
                ).astype(np.float32, copy=False)
                if Ablk.shape[0] != nA or Bblk.shape[0] != nB:
                    raise RuntimeError(
                        f"Stage3 fallback row mismatch while completing direct store: "
                        f"A={Ablk.shape[0]} expected={nA}, B={Bblk.shape[0]} expected={nB}"
                    )
                mu_blk = (wA_norm[:, None] * Ablk.astype(np.float64, copy=False)).sum(axis=0) + (wB_norm[:, None] * Bblk.astype(np.float64, copy=False)).sum(axis=0)
                Ac = Ablk.astype(np.float64, copy=False) - mu_blk[None, :]
                Bc = Bblk.astype(np.float64, copy=False) - mu_blk[None, :]
                var_blk = (wA_norm[:, None] * (Ac * Ac)).sum(axis=0) + (wB_norm[:, None] * (Bc * Bc)).sum(axis=0)
                var_blk[var_blk <= 0.0] = 1.0
                inv_blk = (1.0 / np.sqrt(var_blk)).astype(np.float32, copy=False)
                Z[rows_out, :nA] = ((Ablk - mu_blk[None, :]).astype(np.float32, copy=False) * inv_blk[None, :] * wa_scale[:, None]).T
                Z[rows_out, nA:] = ((Bblk - mu_blk[None, :]).astype(np.float32, copy=False) * inv_blk[None, :] * wb_scale[:, None]).T
                mu[rows_out] = mu_blk
                inv_std[rows_out] = inv_blk
                filled[rows_out] = True
                features_done += int(miss_fids_blk.size)
                fallback_progress(task_i, active=features_done, force=False)
            fallback_progress(max(1, len(fallback_tasks)), active=features_done, force=True)
            if not bool(np.all(filled)):
                still_missing = np.asarray(sel_fids, dtype=np.int64)[~filled]
                raise RuntimeError(
                    f"Stage3 selected-feature materialization still missing {int(still_missing.size)} features after fallback; "
                    f"first_missing={still_missing[:10].tolist()}"
                )
    elif str(source.get('kind', 'full')) == 'stage1_scratch':
        io_feat_chunk = int(source['io_feat_chunk'])
        groups: dict[int, list[tuple[int, int]]] = {}
        for out_col, fid in enumerate(np.asarray(sel_fids, dtype=np.int64).tolist()):
            cid = int(fid) // io_feat_chunk
            loc = int(fid) - cid * io_feat_chunk
            groups.setdefault(cid, []).append((int(out_col), int(loc)))
        tasks = [(cid, groups[cid]) for cid in sorted(groups.keys())]
        task_label = 'Stage3/materialize selected distances'
        progress = _progress_logger(
            task_label,
            total_units=max(1, len(tasks)),
            min_interval_sec=progress_interval_sec,
            active_label='features_done',
        )
        log_info(f"Stage3 materialize plan: source=stage1_scratch original_feature_chunks={len(tasks)} selected_features={F} matrix_shape=({F},{nA+nB})")
        done = 0
        features_done = 0
        progress(0, active=0, force=True)
        for group_index, (cid, spec) in enumerate(tasks, start=1):
            out_cols = np.asarray([p[0] for p in spec], dtype=np.int64)
            locs = np.asarray([p[1] for p in spec], dtype=np.int64)
            _emit_read_progress(ens='A', group_index=group_index, group_total=len(tasks), cid=cid, bid=0, features_done=features_done, force=True)
            Ablk = _load_scratch_group('A', int(cid), locs, row_idxA, group_index=group_index, group_total=len(tasks), features_done=features_done)
            _emit_read_progress(ens='B', group_index=group_index, group_total=len(tasks), cid=cid, bid=0, features_done=features_done, force=True)
            Bblk = _load_scratch_group('B', int(cid), locs, row_idxB, group_index=group_index, group_total=len(tasks), features_done=features_done)
            if Ablk.shape[0] != nA or Bblk.shape[0] != nB:
                raise RuntimeError(f"Stage3 materialize scratch row mismatch for chunk {cid}: A={Ablk.shape[0]} expected={nA}, B={Bblk.shape[0]} expected={nB}")
            mu_blk = (wA_norm[:, None] * Ablk.astype(np.float64, copy=False)).sum(axis=0) + (wB_norm[:, None] * Bblk.astype(np.float64, copy=False)).sum(axis=0)
            Ac = Ablk.astype(np.float64, copy=False) - mu_blk[None, :]
            Bc = Bblk.astype(np.float64, copy=False) - mu_blk[None, :]
            var_blk = (wA_norm[:, None] * (Ac * Ac)).sum(axis=0) + (wB_norm[:, None] * (Bc * Bc)).sum(axis=0)
            var_blk[var_blk <= 0.0] = 1.0
            inv_blk = (1.0 / np.sqrt(var_blk)).astype(np.float32, copy=False)
            mu[out_cols] = mu_blk
            inv_std[out_cols] = inv_blk
            Astd = ((Ablk - mu_blk[None, :]) * inv_blk[None, :]).astype(np.float32, copy=False)
            Bstd = ((Bblk - mu_blk[None, :]) * inv_blk[None, :]).astype(np.float32, copy=False)
            Astd *= wa_scale[:, None]
            Bstd *= wb_scale[:, None]
            Z[out_cols, :nA] = Astd.T
            Z[out_cols, nA:] = Bstd.T
            Z.flush()
            features_done += int(out_cols.size)
            done += 1
            progress(done, active=features_done, force=False)
        progress(max(1, len(tasks)), active=F, force=True)
    else:
        fb = max(1, int(feature_block))
        tasks = [(j0, min(F, j0 + fb)) for j0 in range(0, F, fb)]
        progress = _progress_logger(
            'Stage3/materialize selected distances',
            total_units=max(1, len(tasks)),
            min_interval_sec=progress_interval_sec,
            active_label='features_done',
        )
        done = 0
        progress(0, active=0, force=True)
        for j0, j1 in tasks:
            cols = slice(j0, j1)
            Ablk = _selected_feature_block_any_source(source, "A", sel_fids, cols, row_idx=row_idxA).astype(np.float64, copy=False)
            Bblk = _selected_feature_block_any_source(source, "B", sel_fids, cols, row_idx=row_idxB).astype(np.float64, copy=False)
            mu_blk = (wA_norm[:, None] * Ablk).sum(axis=0) + (wB_norm[:, None] * Bblk).sum(axis=0)
            Ac = Ablk - mu_blk[None, :]
            Bc = Bblk - mu_blk[None, :]
            var_blk = (wA_norm[:, None] * (Ac * Ac)).sum(axis=0) + (wB_norm[:, None] * (Bc * Bc)).sum(axis=0)
            var_blk[var_blk <= 0.0] = 1.0
            inv_blk = (1.0 / np.sqrt(var_blk)).astype(np.float32, copy=False)
            mu[j0:j1] = mu_blk
            inv_std[j0:j1] = inv_blk
            Astd = ((Ablk - mu_blk[None, :]) * inv_blk[None, :]).astype(np.float32, copy=False)
            Bstd = ((Bblk - mu_blk[None, :]) * inv_blk[None, :]).astype(np.float32, copy=False)
            Astd *= wa_scale[:, None]
            Bstd *= wb_scale[:, None]
            Z[j0:j1, :nA] = Astd.T
            Z[j0:j1, nA:] = Bstd.T
            Z.flush()
            done += 1
            progress(done, active=j1)
        progress(max(1, len(tasks)), active=F, force=True)
    del Z
    os.replace(str(tmp_z), str(z_path))
    _write_npz_atomic(
        moments_path,
        mu=np.asarray(mu, dtype=np.float64),
        inv_std=np.asarray(inv_std, dtype=np.float32),
        wa_scale=np.asarray(wa_scale, dtype=np.float32),
        wb_scale=np.asarray(wb_scale, dtype=np.float32),
    )
    return mu, inv_std, sw, wa_scale, wb_scale, (F, nA + nB)

def _stage3_load_z_memmap(z_path: Path, z_shape: tuple[int, int]) -> np.memmap:
    """Open the Stage3 feature-major weighted standardized matrix."""
    Z = np.load(Path(z_path), mmap_mode='r')
    if tuple(Z.shape) != tuple(z_shape):
        raise ValueError(f"Stage3 Z matrix shape mismatch: expected={z_shape} got={tuple(Z.shape)}")
    return Z


def _stage3_exact_corr_edges_from_z(
    z_path: Path,
    z_shape: tuple[int, int],
    sel_fids: np.ndarray,
    *,
    tau_corr: float,
    block: int,
    progress_interval_sec: float = 300.0,
) -> list[tuple[int, int, float]]:
    """Enumerate all selected-feature pairs with exact weighted correlation >= tau_corr from materialized Z."""
    F = int(np.asarray(sel_fids).size)
    if F <= 1:
        return []
    Z = _stage3_load_z_memmap(z_path, z_shape)
    fb = max(1, int(block))
    block_spans = [(i0, min(F, i0 + fb)) for i0 in range(0, F, fb)]
    total_units = len(block_spans) * (len(block_spans) + 1) // 2
    progress = _progress_logger('Stage3/exact_corr', total_units=max(1, total_units), min_interval_sec=progress_interval_sec, active_label='kept_edges')
    edge_map: dict[tuple[int, int], float] = {}
    done = 0
    for bi, (i0, i1) in enumerate(block_spans):
        Zi = np.asarray(Z[i0:i1, :], dtype=np.float32)
        for j0, j1 in block_spans[bi:]:
            Zj = Zi if j0 == i0 else np.asarray(Z[j0:j1, :], dtype=np.float32)
            C = Zi @ Zj.T
            if j0 == i0:
                rr, cc = np.where(np.triu(C >= float(tau_corr), k=1))
            else:
                rr, cc = np.where(C >= float(tau_corr))
            for r, c in zip(rr.tolist(), cc.tolist()):
                pi = i0 + int(r)
                pj = j0 + int(c)
                if pj <= pi:
                    continue
                edge_map[(int(sel_fids[pi]), int(sel_fids[pj]))] = float(C[int(r), int(c)])
            done += 1
            progress(done, active=len(edge_map), force=False)
    progress(max(1, total_units), active=len(edge_map), force=True)
    return [(fi, gj, edge_map[(fi, gj)]) for fi, gj in sorted(edge_map.keys())]


def _stage3_exact_safe_reject_corr_edges_from_z(
    z_path: Path,
    z_shape: tuple[int, int],
    sel_fids: np.ndarray,
    *,
    tau_corr: float,
    block: int,
    sample_block: int,
    active_pair_batch: int = 2048,
    active_switch_frac: float = 0.25,
    execution_profile: str = 'auto',
    dense_work_threshold: float = 1.0e11,
    probe_reject_threshold: float = 0.50,
    probe_units: int = 24,
    probe_frames: int = 65536,
    pruned_cost_ratio: float = 0.65,
    dense_cost_ratio: float = 0.85,
    probe_seed: int = 12345,
    matrix_bytes_est: int | None = None,
    safety_eps: float = 1.0e-5,
    progress_interval_sec: float = 300.0,
) -> list[tuple[int, int, float]]:
    """Complete thresholded correlation search with auto-profiled safe early rejection.

    Both dense_like and pruned_active are exact thresholded correlation searches.
    The auto planner only chooses the execution profile.  dense_like evaluates
    whole feature-block correlations directly.  pruned_active uses a safe
    partial-distance screen and refines only surviving pairs.
    """
    F = int(np.asarray(sel_fids).size)
    if F <= 1:
        return []
    Z = _stage3_load_z_memmap(z_path, z_shape)
    n_frames = int(z_shape[1])
    fb = max(1, int(block))
    rb = max(1, int(sample_block))
    pair_batch = max(1, int(active_pair_batch))
    switch_frac = float(active_switch_frac)
    if not np.isfinite(switch_frac):
        switch_frac = 0.25
    switch_frac = min(1.0, max(0.0, switch_frac))
    eps = float(safety_eps)
    if not np.isfinite(eps) or eps < 0:
        eps = 1.0e-5
    profile_req = str(execution_profile or 'auto')
    if profile_req not in {'auto', 'dense_like', 'pruned_active'}:
        profile_req = 'auto'
    dense_work = float(F) * float(max(0, F - 1)) * 0.5 * float(n_frames)
    avail_ram, ram_meta = _effective_available_ram_bytes()
    matrix_bytes = int(matrix_bytes_est) if matrix_bytes_est is not None else int(F) * int(n_frames) * 4
    ram_ok_for_dense = True
    if avail_ram is not None and avail_ram > 0:
        work_est = int((2 * fb * n_frames + fb * fb) * 4)
        ram_ok_for_dense = (matrix_bytes + work_est) <= int(0.60 * avail_ram)
    dense_work_thr = float(dense_work_threshold)
    if not np.isfinite(dense_work_thr) or dense_work_thr <= 0:
        dense_work_thr = 1.0e11
    reject_thr = float(probe_reject_threshold)
    if not np.isfinite(reject_thr):
        reject_thr = 0.50
    reject_thr = min(0.99, max(0.0, reject_thr))
    probe_units = max(1, int(probe_units))
    probe_frames = int(probe_frames or 0)
    if probe_frames <= 0:
        probe_frames = min(n_frames, max(rb, 65536))
    probe_frames = max(rb, min(n_frames, probe_frames))
    pruned_cost_ratio = float(pruned_cost_ratio)
    dense_cost_ratio = float(dense_cost_ratio)
    if not np.isfinite(pruned_cost_ratio) or pruned_cost_ratio <= 0:
        pruned_cost_ratio = 0.65
    if not np.isfinite(dense_cost_ratio) or dense_cost_ratio <= 0:
        dense_cost_ratio = 0.85
    if dense_cost_ratio < pruned_cost_ratio:
        dense_cost_ratio = pruned_cost_ratio

    spans = [(i0, min(F, i0 + fb)) for i0 in range(0, F, fb)]
    row_spans = [(r0, min(n_frames, r0 + rb)) for r0 in range(0, n_frames, rb)]
    total_units = len(spans) * (len(spans) + 1) // 2
    progress = _progress_logger('Stage3/safe_reject_corr', total_units=max(1, total_units), min_interval_sec=progress_interval_sec, active_label='kept_edges')
    screen_progress = _progress_logger('Stage3/safe_reject_screen', total_units=max(1, total_units), min_interval_sec=progress_interval_sec, active_label='active_pairs')
    refine_progress = _progress_logger('Stage3/safe_reject_refine', total_units=max(1, total_units), min_interval_sec=progress_interval_sec, active_label='refined_pairs')

    def _pair_initial_count(bi: int, bj: int) -> int:
        mi = spans[bi][1] - spans[bi][0]
        mj = spans[bj][1] - spans[bj][0]
        if bi == bj:
            return mi * max(0, mi - 1) // 2
        return mi * mj

    def _choose_probe_pairs() -> list[tuple[int, int]]:
        B = len(spans)
        if B <= 0:
            return []
        cand: list[tuple[int, int]] = []
        anchors = sorted(set([0, B // 4, B // 2, (3 * B) // 4, B - 1]))
        for a in anchors:
            cand.append((a, a))
            if a + 1 < B:
                cand.append((a, a + 1))
            if a + 2 < B:
                cand.append((a, a + 2))
        for a in anchors:
            for b in anchors:
                if b >= a:
                    cand.append((a, b))
        rng = np.random.default_rng(int(probe_seed))
        max_random = max(0, probe_units * 3)
        for _ in range(max_random):
            a = int(rng.integers(0, B))
            b = int(rng.integers(a, B))
            cand.append((a, b))
        seen = set()
        out: list[tuple[int, int]] = []
        for a, b in cand:
            if not (0 <= a <= b < B):
                continue
            if (a, b) in seen:
                continue
            if _pair_initial_count(a, b) <= 0:
                continue
            seen.add((a, b))
            out.append((a, b))
            if len(out) >= probe_units:
                break
        return out

    def _probe_unit_cost(bi: int, bj: int) -> dict:
        i0, i1 = spans[bi]
        j0, j1 = spans[bj]
        mi, mj = i1 - i0, j1 - j0
        Zi_all = np.asarray(Z[i0:i1, :], dtype=np.float32)
        norm_i_total = np.sum(Zi_all * Zi_all, axis=1, dtype=np.float64).astype(np.float32)
        del Zi_all
        if bi == bj:
            norm_j_total = norm_i_total
        else:
            Zj_all = np.asarray(Z[j0:j1, :], dtype=np.float32)
            norm_j_total = np.sum(Zj_all * Zj_all, axis=1, dtype=np.float64).astype(np.float32)
            del Zj_all
        r2_limit = (norm_i_total[:, None] + norm_j_total[None, :] - (2.0 * float(tau_corr))).astype(np.float32, copy=False)
        d2 = np.zeros((mi, mj), dtype=np.float32)
        active = np.ones((mi, mj), dtype=bool)
        if bi == bj:
            active &= np.triu(np.ones((mi, mj), dtype=bool), k=1)
        initial = int(np.count_nonzero(active))
        if initial <= 0:
            return {'initial': 0, 'cost_ratio': 1.0, 'final_active_frac': 0.0, 'active_curve': []}
        frames_seen = 0
        active_pair_frame_sum = 0.0
        curve = []
        for r0, r1 in row_spans:
            if frames_seen >= probe_frames:
                break
            if r0 >= probe_frames:
                break
            r1_eff = min(r1, probe_frames)
            active_count = int(np.count_nonzero(active))
            if active_count == 0:
                frames_seen += int(r1_eff - r0)
                curve.append((frames_seen, 0.0))
                break
            Zi = np.asarray(Z[i0:i1, r0:r1_eff], dtype=np.float32)
            Zj = Zi if bi == bj else np.asarray(Z[j0:j1, r0:r1_eff], dtype=np.float32)
            ni = np.sum(Zi * Zi, axis=1, dtype=np.float32)
            nj = ni if bi == bj else np.sum(Zj * Zj, axis=1, dtype=np.float32)
            cross = Zi @ Zj.T
            d2 += ni[:, None] + nj[None, :] - (2.0 * cross)
            active = active & (d2 <= (r2_limit + eps))
            frames_this = int(r1_eff - r0)
            frames_seen += frames_this
            active_pair_frame_sum += float(active_count) * float(frames_this)
            curve.append((int(frames_seen), float(np.count_nonzero(active)) / float(max(1, initial))))
        final_active = int(np.count_nonzero(active))
        probe_depth = max(1, int(frames_seen))
        # Estimate full pruned work: observed screen cost + survivors for remaining screen + survivor exact refine.
        screen_remaining = float(final_active) * float(max(0, n_frames - probe_depth))
        refine_cost = float(final_active) * float(n_frames)
        dense_cost = float(initial) * float(n_frames)
        # 1.10 is a conservative management overhead for masks / active bookkeeping.
        cost_ratio = 1.10 * ((active_pair_frame_sum + screen_remaining + refine_cost) / max(1.0, dense_cost))
        return {
            'initial': initial,
            'cost_ratio': float(cost_ratio),
            'final_active_frac': float(final_active) / float(max(1, initial)),
            'active_curve': curve,
        }

    edge_map: dict[tuple[int, int], float] = {}
    total_initial_pairs = 0
    total_rejected_pairs = 0
    total_refined_pairs = 0
    dense_updates = 0
    sparse_updates = 0
    done = 0
    r2_base_note = 2.0 * (1.0 - float(tau_corr))

    probe_summary = None
    if profile_req == 'dense_like':
        active_profile = 'dense_like'
        profile_reason = 'user_requested_dense_like'
    elif profile_req == 'pruned_active':
        active_profile = 'pruned_active'
        profile_reason = 'user_requested_pruned_active'
    else:
        if dense_work <= dense_work_thr and ram_ok_for_dense:
            active_profile = 'dense_like'
            profile_reason = 'dense_work_below_threshold_and_ram_ok'
        else:
            probe_pairs = _choose_probe_pairs()
            ratios = []
            active_fracs = []
            curve_by_depth: dict[int, list[float]] = {}
            tested_pairs = 0
            t0_probe = time.time()
            for bi, bj in probe_pairs:
                info = _probe_unit_cost(bi, bj)
                if int(info['initial']) <= 0:
                    continue
                tested_pairs += int(info['initial'])
                ratios.append(float(info['cost_ratio']))
                active_fracs.append(float(info['final_active_frac']))
                for depth, frac in info['active_curve']:
                    curve_by_depth.setdefault(int(depth), []).append(float(frac))
            probe_elapsed = time.time() - t0_probe
            if ratios:
                ratio_med = float(np.median(np.asarray(ratios, dtype=np.float64)))
                ratio_p25 = float(np.percentile(np.asarray(ratios, dtype=np.float64), 25))
                ratio_p75 = float(np.percentile(np.asarray(ratios, dtype=np.float64), 75))
                final_active_med = float(np.median(np.asarray(active_fracs, dtype=np.float64))) if active_fracs else 1.0
                if ratio_med < pruned_cost_ratio:
                    active_profile = 'pruned_active'
                    profile_reason = 'probe_estimated_pruned_cost_low'
                elif ratio_med > dense_cost_ratio:
                    active_profile = 'dense_like'
                    profile_reason = 'probe_estimated_pruned_cost_high'
                else:
                    active_profile = 'dense_like'
                    profile_reason = 'probe_estimated_cost_ambiguous_dense_default'
                depth_lines = []
                for depth in sorted(curve_by_depth):
                    vals = np.asarray(curve_by_depth[depth], dtype=np.float64)
                    depth_lines.append(f"{depth}:{float(np.median(vals)):.3f}")
                probe_summary = (
                    f"Stage3 profile probe: sampled_block_pairs={len(ratios)} tested_pairs={tested_pairs} "
                    f"probe_frames={probe_frames}/{n_frames} elapsed={probe_elapsed:.2f}s "
                    f"pruned_cost_ratio_median={ratio_med:.3f} p25={ratio_p25:.3f} p75={ratio_p75:.3f} "
                    f"final_active_fraction_median={final_active_med:.3f} active_fraction_by_frames=" + ','.join(depth_lines)
                )
            else:
                active_profile = 'dense_like'
                profile_reason = 'probe_no_valid_pairs_dense_default'

    final_profile_decision = active_profile
    if _log_enabled('info'):
        log_info(
            f"Stage3 exact correlation planner: requested_profile={profile_req} chosen_profile={active_profile} reason={profile_reason} "
            f"dense_work={dense_work:.3e} dense_work_threshold={dense_work_thr:.3e} ram_ok_for_dense={str(bool(ram_ok_for_dense)).lower()} "
            f"matrix_est={_format_bytes(matrix_bytes)} available_ram={_format_bytes(avail_ram)} tau={float(tau_corr):.4f} nominal_r2={r2_base_note:.6g} "
            f"feature_block={fb} sample_block={rb} active_pair_batch={pair_batch} active_switch_frac={switch_frac:.3f} "
            f"probe_units={probe_units} probe_frames={probe_frames} pruned_cost_ratio={pruned_cost_ratio:.3f} dense_cost_ratio={dense_cost_ratio:.3f} safety_eps={eps:g}"
        )
        if probe_summary:
            log_info(probe_summary)
        if active_profile == 'dense_like':
            log_info("Stage3 corr profile=dense_like: exact block correlations are computed; early-reject bookkeeping is disabled for speed.")
        else:
            log_info("Stage3 corr profile=pruned_active: exact safe-reject screening is used before survivor refinement.")

    for bi, (i0, i1) in enumerate(spans):
        mi = i1 - i0
        Zi_all = np.asarray(Z[i0:i1, :], dtype=np.float32)
        norm_i_total = np.sum(Zi_all * Zi_all, axis=1, dtype=np.float64).astype(np.float32)
        del Zi_all
        for bj, (j0, j1) in enumerate(spans[bi:], start=bi):
            mj = j1 - j0
            if i0 == j0:
                norm_j_total = norm_i_total
            else:
                Zj_all = np.asarray(Z[j0:j1, :], dtype=np.float32)
                norm_j_total = np.sum(Zj_all * Zj_all, axis=1, dtype=np.float64).astype(np.float32)
                del Zj_all
            r2_limit = (norm_i_total[:, None] + norm_j_total[None, :] - (2.0 * float(tau_corr))).astype(np.float32, copy=False)
            d2 = np.zeros((mi, mj), dtype=np.float32)
            active = np.ones((mi, mj), dtype=bool)
            if i0 == j0:
                active &= np.triu(np.ones((mi, mj), dtype=bool), k=1)
            initial_active = int(np.count_nonzero(active))
            total_initial_pairs += initial_active
            if initial_active == 0:
                done += 1
                progress(done, active=len(edge_map), force=False)
                continue

            if active_profile == 'dense_like':
                Zi = np.asarray(Z[i0:i1, :], dtype=np.float32)
                Zj = Zi if i0 == j0 else np.asarray(Z[j0:j1, :], dtype=np.float32)
                C = Zi @ Zj.T
                if i0 == j0:
                    rr_e, cc_e = np.where(np.triu(C >= float(tau_corr), k=1))
                else:
                    rr_e, cc_e = np.where(C >= float(tau_corr))
                for r, c in zip(rr_e.tolist(), cc_e.tolist()):
                    pi = i0 + int(r)
                    pj = j0 + int(c)
                    if pj <= pi:
                        continue
                    edge_map[(int(sel_fids[pi]), int(sel_fids[pj]))] = float(C[int(r), int(c)])
                total_refined_pairs += initial_active
                done += 1
                progress(done, active=len(edge_map), force=False)
                continue

            for r0, r1 in row_spans:
                active_count = int(np.count_nonzero(active))
                if active_count == 0:
                    break
                Zi = np.asarray(Z[i0:i1, r0:r1], dtype=np.float32)
                Zj = Zi if i0 == j0 else np.asarray(Z[j0:j1, r0:r1], dtype=np.float32)
                use_sparse = active_count < max(1, int(mi * mj * switch_frac))
                if not use_sparse:
                    ni = np.sum(Zi * Zi, axis=1, dtype=np.float32)
                    nj = ni if i0 == j0 else np.sum(Zj * Zj, axis=1, dtype=np.float32)
                    cross = Zi @ Zj.T
                    d2 += ni[:, None] + nj[None, :] - (2.0 * cross)
                    dense_updates += 1
                    new_active = active & (d2 <= (r2_limit + eps))
                else:
                    rr, cc = np.where(active)
                    keep = np.ones((rr.size,), dtype=bool)
                    for p0 in range(0, rr.size, pair_batch):
                        p1 = min(rr.size, p0 + pair_batch)
                        rsel = rr[p0:p1]
                        csel = cc[p0:p1]
                        diff = Zi[rsel, :] - Zj[csel, :]
                        inc = np.sum(diff * diff, axis=1, dtype=np.float32)
                        vals = d2[rsel, csel] + inc
                        d2[rsel, csel] = vals
                        keep[p0:p1] = vals <= (r2_limit[rsel, csel] + eps)
                    sparse_updates += 1
                    new_active = np.zeros_like(active)
                    if keep.size:
                        new_active[rr[keep], cc[keep]] = True
                rejected_now = int(np.count_nonzero(active) - np.count_nonzero(new_active))
                total_rejected_pairs += rejected_now
                active = new_active
                screen_progress(done, active=int(np.count_nonzero(active)), force=False)

            rr, cc = np.where(active)
            n_refine = int(rr.size)
            total_refined_pairs += n_refine
            if n_refine:
                corr_vals = np.zeros((n_refine,), dtype=np.float64)
                for r0, r1 in row_spans:
                    Zi = np.asarray(Z[i0:i1, r0:r1], dtype=np.float32)
                    Zj = Zi if i0 == j0 else np.asarray(Z[j0:j1, r0:r1], dtype=np.float32)
                    for p0 in range(0, n_refine, pair_batch):
                        p1 = min(n_refine, p0 + pair_batch)
                        rsel = rr[p0:p1]
                        csel = cc[p0:p1]
                        corr_vals[p0:p1] += np.einsum('ij,ij->i', Zi[rsel, :], Zj[csel, :], dtype=np.float64)
                    refine_progress(done, active=total_refined_pairs, force=False)
                keep_edges = np.where(corr_vals >= float(tau_corr))[0]
                for idx in keep_edges.tolist():
                    pi = i0 + int(rr[int(idx)])
                    pj = j0 + int(cc[int(idx)])
                    if pj <= pi:
                        continue
                    edge_map[(int(sel_fids[pi]), int(sel_fids[pj]))] = float(corr_vals[int(idx)])
            done += 1
            progress(done, active=len(edge_map), force=False)
    progress(max(1, total_units), active=len(edge_map), force=True)
    if _log_enabled('info'):
        log_info(
            "Stage3 safe-reject summary: "
            f"edges={len(edge_map)} initial_pairs={int(total_initial_pairs)} "
            f"rejected_pairs={int(total_rejected_pairs)} refined_pairs={int(total_refined_pairs)} "
            f"dense_updates={int(dense_updates)} sparse_updates={int(sparse_updates)} "
            f"final_profile={final_profile_decision}"
        )
    return [(fi, gj, edge_map[(fi, gj)]) for fi, gj in sorted(edge_map.keys())]


def _save_weights_cache(outdir: Path, wA: np.ndarray, wB: np.ndarray, args, weight_source: str | None = None) -> None:
    """Save normalized weights and record them in features_meta.json."""
    outdir = Path(outdir)
    outdir.mkdir(parents=True, exist_ok=True)
    wA_path = outdir / "weights_A.npy"
    wB_path = outdir / "weights_B.npy"
    np.save(wA_path, np.asarray(wA, dtype=np.float32))
    np.save(wB_path, np.asarray(wB, dtype=np.float32))
    # record in features_meta.json
    rec = {
        "weights_A": str(wA_path.resolve()),
        "weights_B": str(wB_path.resolve()),
        "weights_A_sig": _content_sig(wA_path),
        "weights_B_sig": _content_sig(wB_path),
        "weights_cache_version": int(WEIGHTS_CACHE_VERSION),
        "cache_namespace": CACHE_NAMESPACE,
        "nA": int(np.asarray(wA).shape[0]),
        "nB": int(np.asarray(wB).shape[0]),
        "has_weights": True,
        "weights_frame_mode": "raw_with_zero_weights",
        "zero_weight_filter_policy": "filter_after_loading_weights",
    }
    if weight_source is not None:
        rec["weight_source"] = str(weight_source)
    probA_path = getattr(args, "probA", None) if args is not None else None
    probB_path = getattr(args, "probB", None) if args is not None else None
    prob_common = getattr(args, "prob", None) if args is not None else None
    probA_eff = probA_path if probA_path is not None else prob_common
    probB_eff = probB_path if probB_path is not None else prob_common
    if probA_eff is not None:
        rec["probA_sha256"] = _sha256_file(Path(probA_eff))
    if probB_eff is not None:
        rec["probB_sha256"] = _sha256_file(Path(probB_eff))
    _merge_update_features_meta(outdir, **rec)

def _weighted_quantile(x: np.ndarray, w: np.ndarray, p: float) -> float:
    """Weighted quantile in [0,1]."""
    x = np.asarray(x, dtype=np.float64)
    w = np.asarray(w, dtype=np.float64)
    if x.size == 0:
        return float("nan")
    if w.size != x.size:
        raise ValueError("x and w must have same length")
    if p <= 0.0:
        return float(np.min(x))
    if p >= 1.0:
        return float(np.max(x))
    idx = np.argsort(x)
    xs = x[idx]
    ws = w[idx]
    c = np.cumsum(ws)
    if c[-1] <= 0:
        return float(np.median(xs))
    t = p * c[-1]
    j = int(np.searchsorted(c, t, side="left"))
    j = min(max(j, 0), xs.size - 1)
    return float(xs[j])

def _centroids_from_coords(coords: np.ndarray, res_of_atom: np.ndarray, n_res: int, out: np.ndarray) -> None:
    """Compute residue centroids (mean of atom coords) into out (n_res,3).

    Performance note:
      - np.add.at is convenient but slow for large atom counts.
      - Using bincount per-axis is typically much faster and avoids Python loops.
    """
    # Ensure float32 arithmetic (sufficient for coordinates/distances here)
    c = coords.astype(np.float32, copy=False)
    idx = res_of_atom.astype(np.int64, copy=False)
    counts = np.bincount(idx, minlength=n_res).astype(np.float32)
    counts[counts == 0] = 1.0  # avoid div0 for residues with no atoms in selection

    out[:, 0] = np.bincount(idx, weights=c[:, 0], minlength=n_res) / counts
    out[:, 1] = np.bincount(idx, weights=c[:, 1], minlength=n_res) / counts
    out[:, 2] = np.bincount(idx, weights=c[:, 2], minlength=n_res) / counts

def _pairwise_distances_into_j(coords: np.ndarray, pairs: np.ndarray, out: np.ndarray) -> None:
    """Compute distances for index pairs into out."""
    a = coords[pairs[:, 0]]
    b = coords[pairs[:, 1]]
    d = a - b
    out[:] = np.sqrt((d * d).sum(axis=1), dtype=np.float32)

def _parse_jpresto_tpl_atoms_bonds(tpl_path: Path) -> dict:
    """Parse a J_PRESTO *.tpl file for covalent-bond topology.

    DISTIL uses this topology only to exclude bonded-neighbor distance
    features.  Therefore it must reproduce the covalent graph read by
    j_presto, not infer bonds from arbitrary numeric records.

    Rules implemented here follow the j_presto ``inptpl.f90``/``prep``
    format:
      * Standard intramolecular bonds are read only from ``TPL> BOND(S)``.
        The first non-comment record in each such block is the molecule name;
        subsequent records contain local atom ids ``i j k r0``.  Local bonds
        are expanded over the copy counts listed in ``TPL> MOLECULES``.
      * Additional covalent links, including SSBOND-derived links, are read
        only from ``TPL> LINK`` records whose first field is ``B``.  These atom
        ids are already global atom ids in the generated topology.
      * ``TPL> ANGL``, ``TPL> TORS``, ``TPL> IMPR``, ``TPL> NONB`` and numeric
        continuation lines in ``TPL> ATOM(S)`` are never treated as bonds.
    """
    tpl_path = Path(tpl_path)
    raw_lines = tpl_path.read_text(encoding="utf-8", errors="ignore").splitlines()

    def _strip_comment(line: str) -> str:
        return line.split(';', 1)[0].strip()

    def _is_int_token(tok: str) -> bool:
        return bool(re.fullmatch(r"[+-]?\d+", str(tok)))

    def _norm_section(name: str) -> str:
        u = str(name).strip().upper()
        aliases = {
            'MOLE': 'MOLECULES', 'MOLECULE': 'MOLECULES', 'MOLECULES': 'MOLECULES',
            'ATOM': 'ATOMS', 'ATOMS': 'ATOMS',
            'BOND': 'BONDS', 'BONDS': 'BONDS',
            'ANGL': 'ANGLES', 'ANGLE': 'ANGLES', 'ANGLES': 'ANGLES',
            'TORS': 'TORSIONS', 'TORSION': 'TORSIONS', 'TORSIONS': 'TORSIONS',
            'IMPR': 'IMPROPER-TORSIONS', 'IMPROPER': 'IMPROPER-TORSIONS',
            'IMPROPER-TORSIONS': 'IMPROPER-TORSIONS',
            'FUNC': 'FUNCTIONS', 'FUNCTION': 'FUNCTIONS', 'FUNCTIONS': 'FUNCTIONS',
            'NONB': 'NONBONDS', 'NONBOND': 'NONBONDS', 'NONBONDS': 'NONBONDS',
            'LINK': 'LINK',
            'TITL': 'TITLE', 'TITLE': 'TITLE',
        }
        return aliases.get(u, u)

    sections: list[tuple[str, list[str]]] = []
    cur_name: str | None = None
    cur_lines: list[str] = []
    for line in raw_lines:
        s0 = line.strip()
        m = re.match(r"^TPL>\s*(\S+)", s0, flags=re.IGNORECASE)
        if m:
            if cur_name is not None:
                sections.append((_norm_section(cur_name), cur_lines))
            cur_name = m.group(1)
            cur_lines = []
        else:
            if cur_name is not None:
                cur_lines.append(line.rstrip('\n'))
    if cur_name is not None:
        sections.append((_norm_section(cur_name), cur_lines))

    molecule_order: list[tuple[str, int]] = []
    atom_counts: dict[str, int] = defaultdict(int)
    raw_bonds_by_mol: dict[str, list[tuple[int, int]]] = defaultdict(list)
    link_bonds: list[tuple[int, int]] = []

    for sec, lines in sections:
        clean = [_strip_comment(x) for x in lines]
        clean = [x for x in clean if x]
        if sec == 'MOLECULES':
            for sline in clean:
                parts = re.split(r"\s+", sline)
                if len(parts) >= 2 and _is_int_token(parts[-1]):
                    name = ' '.join(parts[:-1]).strip()
                    if name:
                        molecule_order.append((name, int(parts[-1])))
            continue

        if sec == 'ATOMS':
            mol_name: str | None = None
            for sline in clean:
                parts = re.split(r"\s+", sline)
                if mol_name is None:
                    # The molecule-name line follows the comment/header lines.
                    if not _is_int_token(parts[0]):
                        mol_name = sline.strip()
                    continue
                # ATOM records begin with an atom name. Numeric continuation
                # records carry bonded-neighbor lists or internal coordinates
                # and must not be counted as separate atoms.
                if parts and not _is_int_token(parts[0]) and not parts[0].startswith('<'):
                    atom_counts[mol_name] += 1
            continue

        if sec == 'BONDS':
            mol_name: str | None = None
            for sline in clean:
                parts = re.split(r"\s+", sline)
                if not parts:
                    continue
                if mol_name is None:
                    # j_presto BOND(S) block starts with the molecule name.
                    if not _is_int_token(parts[0]):
                        mol_name = sline.strip()
                    continue
                if len(parts) >= 2 and _is_int_token(parts[0]) and _is_int_token(parts[1]):
                    i = int(parts[0]); j = int(parts[1])
                    if i > 0 and j > 0 and i != j:
                        raw_bonds_by_mol[mol_name].append((i, j))
            continue

        if sec == 'LINK':
            for sline in clean:
                parts = re.split(r"\s+", sline)
                if len(parts) >= 3 and parts[0].upper().startswith('B') and _is_int_token(parts[1]) and _is_int_token(parts[2]):
                    i = int(parts[1]); j = int(parts[2])
                    if i > 0 and j > 0 and i != j:
                        link_bonds.append((i, j))
            continue

    # Expand local BOND(S) records over the molecule copy counts.  If a topology
    # omits a molecule from TPL> MOLECULES, fall back to one copy of any molecule
    # that has atom or bond data, preserving deterministic order by appearance.
    if not molecule_order:
        names = []
        for sec, lines in sections:
            if sec in ('ATOMS', 'BONDS'):
                for sline in [_strip_comment(x) for x in lines]:
                    if not sline:
                        continue
                    parts = re.split(r"\s+", sline)
                    if parts and not _is_int_token(parts[0]):
                        nm = sline.strip()
                        if nm not in names and nm.upper() not in ('NUMBER',):
                            names.append(nm)
                        break
        molecule_order = [(nm, 1) for nm in names]

    bonds: list[tuple[int, int]] = []
    global_base = 0
    for mol_name, ncopy in molecule_order:
        nat = int(atom_counts.get(mol_name, 0))
        local_bonds = raw_bonds_by_mol.get(mol_name, [])
        copies = max(int(ncopy), 0)
        if nat > 0 and copies > 0:
            for c in range(copies):
                off = global_base + c * nat
                for i, j in local_bonds:
                    # Local atom ids are expected.  If a malformed/custom TPL
                    # contains ids outside the molecule, skip expansion for that
                    # record rather than inventing a wrong topology edge.
                    if 1 <= i <= nat and 1 <= j <= nat:
                        bonds.append((off + i, off + j))
            global_base += nat * copies
        elif copies > 0:
            # Without atom counts we cannot safely expand local bonds.  Keep
            # records as-is only if they are already global-like positive ids.
            bonds.extend(local_bonds)

    bonds.extend(link_bonds)

    # Deduplicate undirected edges while preserving deterministic order.
    seen: set[tuple[int, int]] = set()
    dedup: list[tuple[int, int]] = []
    for i, j in bonds:
        a, b = (int(i), int(j)) if int(i) < int(j) else (int(j), int(i))
        if a <= 0 or b <= 0 or a == b:
            continue
        key = (a, b)
        if key not in seen:
            seen.add(key)
            dedup.append(key)

    return {
        "bonds": dedup,
        "n_bonds_standard": int(sum(len(v) for v in raw_bonds_by_mol.values())),
        "n_bonds_link": int(len(link_bonds)),
        "tpl_parser": "jpresto_tpl_bonds_and_link_v1",
        "molecule_order": molecule_order,
        "atom_counts_by_molecule": dict(atom_counts),
    }

