        tv_vals = np.asarray([float(fs.tv) for fs in feats], dtype=np.float64) if feats else np.zeros((0,), dtype=np.float64)
        max_tv_all = float(np.max(tv_vals)) if tv_vals.size else float('nan')
        max_tv_pass = float(np.max([float(fs.tv) for fs in feats if bool(fs.passed_tv)])) if n_pass_tv > 0 else float('nan')
        if str(getattr(args, 'selection_mode', 'standard')) == 'sig':
            n_pass_sig = sum(1 for fs in feats if bool(getattr(fs, 'passed_sig', False)))
            log_info(
                f"Stage1 metric summary: total_features={total} "
                f"passed_significance={n_pass_sig} max_TV_all={(f'{max_tv_all:.6f}' if np.isfinite(max_tv_all) else 'nan')} "
                f"alpha={float(getattr(args, 'sig_alpha', 0.05)):.3g} FDR={getattr(args, 'sig_fdr', 'off')}"
            )
        elif str(getattr(args, 'selection_mode', 'standard')) == 'ced':
            n_pass_ced = sum(1 for fs in feats if bool(getattr(fs, 'passed_ced', False)))
            max_ced_score = max((float(getattr(fs, 'ced_effect_score', 0.0)) for fs in feats), default=0.0)
