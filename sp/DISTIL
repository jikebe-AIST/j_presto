def _audit_validate_ref_context(*, refA_path, refB_path, natomA, natomB, atoms_ref, sel_idx, atoms_sel, res_keys, res_of_atom, atoms_by_res) -> None:
    _audit_require(refA_path is not None and refB_path is not None, "reference PDB paths were not resolved")
    _audit_require(natomA is not None and natomB is not None, "reference atom counts were not resolved")
    _audit_require(isinstance(atoms_ref, list) and len(atoms_ref) > 0, "reference atoms are empty")
    _audit_require(isinstance(sel_idx, np.ndarray) and sel_idx.ndim == 1, "sel_idx is missing or malformed")
    _audit_require(isinstance(atoms_sel, list) and len(atoms_sel) == int(sel_idx.shape[0]), "atoms_sel / sel_idx mismatch")
    _audit_require(isinstance(res_keys, list), "res_keys is missing")
    _audit_require(isinstance(res_of_atom, np.ndarray) and res_of_atom.ndim == 1, "res_of_atom is missing or malformed")
    _audit_require(int(res_of_atom.shape[0]) == len(atoms_sel), "res_of_atom length does not match atoms_sel")
    _audit_require(isinstance(atoms_by_res, list) and len(atoms_by_res) == len(res_keys), "atoms_by_res / res_keys mismatch")




def run_distil_pipeline(outdir: Path, args, meta: dict | None = None) -> None:
    """Run the reordered DISTIL pipeline.

Stages:

  Stage 1: Feature scoring
    - Build distance scratch, compute TV, G-test p/q, AUC, and the single-feature score matrix.
    - Output: pair_scores.csv, feature_metrics/*, distil_cache/stage1_scoring/*.

  Stage 2: Contribution learning
    - Fit the multivariate contribution model from the Stage1 single-feature score matrix.
    - Output: distil_cache/stage2_contribution/feature_contributions.*.

  Stage 3: Feature correlation graph
    - Build the positive correlation graph from original distance time series of Stage1-selected features.
    - Output: feature_corr_edges.csv.

  Stage 4: Bundle detection
    - Detect bundles by community detection and residue-connected-component splitting.
    - Output: bundles.csv.

  Stage 5: Region inference and ranking
    - Combine feature contributions and bundles, infer regions, rank region pairs, and write visual outputs.
    - Output: pair_contrib.csv, residue_contrib.csv, bundle_regions.csv, ranked_pairs.csv, plots/*, pdb/*.

  Stage 6: Stability analysis
    - Evaluate stability of the final results when requested.

Structural correlation is computed from original physical distance time series, not from ML scores.
Visualization requires a reference PDB (-r / -rA).
"""
    outdir = Path(outdir).resolve()
    outdir.mkdir(parents=True, exist_ok=True)
    force = bool(getattr(args, "force", False))

    # ---- resolve feature artifacts (selected-feature-only) ----
    # Stage1 (TV) prefers existing full feature matrices when available.
    # Otherwise it evaluates bounded feature chunks directly from coordinates.
    # After Stage1, selected-feature-only artifacts become the stable downstream contract.
    art = _resolve_feature_artifact_paths(outdir, meta)
    sel_fids_path = art.sel_fids
    pairs_csv = art.top_pairs_csv

    if not pairs_csv.exists():
        raise SystemExit('[DISTIL] Missing top_pairs_pool.csv. Run feature generation first.')

    nA, nB, _nF0, feature_mode = _load_feature_matrix_shapes(art)

    # weights (prefer cached)
    wA_path = outdir / "weights_A.npy"
    wB_path = outdir / "weights_B.npy"
    wA = None
    wB = None
    if wA_path.exists() and wB_path.exists():
        try:
            wA = np.load(wA_path)
            wB = np.load(wB_path)
        except Exception:
            wA = None
            wB = None
    if wA is None or wB is None:
        wA = np.ones((nA,), dtype=np.float64)
        wB = np.ones((nB,), dtype=np.float64)
    wA = np.asarray(wA, dtype=np.float64)
    wB = np.asarray(wB, dtype=np.float64)
    raw_nA_for_weight_filter = int(nA)
    raw_nB_for_weight_filter = int(nB)
    if wA.size != raw_nA_for_weight_filter or wB.size != raw_nB_for_weight_filter:
        raise RuntimeError(f"weight/frame count mismatch before zero-weight filter: A {wA.size}/{raw_nA_for_weight_filter}, B {wB.size}/{raw_nB_for_weight_filter}")
    frame_keep_maskA = np.asarray(wA > 0.0, dtype=bool)
    frame_keep_maskB = np.asarray(wB > 0.0, dtype=bool)
    dropped_zero_A = int(raw_nA_for_weight_filter - int(np.count_nonzero(frame_keep_maskA)))
    dropped_zero_B = int(raw_nB_for_weight_filter - int(np.count_nonzero(frame_keep_maskB)))
    if dropped_zero_A or dropped_zero_B:
        log_info(
            f"Weight-zero frame filter A: raw_frames={raw_nA_for_weight_filter} kept={int(np.count_nonzero(frame_keep_maskA))} "
            f"dropped_zero_weight={dropped_zero_A} weight_mass_dropped=0.000e+00"
        )
        log_info(
            f"Weight-zero frame filter B: raw_frames={raw_nB_for_weight_filter} kept={int(np.count_nonzero(frame_keep_maskB))} "
            f"dropped_zero_weight={dropped_zero_B} weight_mass_dropped=0.000e+00"
        )
    else:
        log_info(f"Weight-zero frame filter: no zero-weight frames detected A={raw_nA_for_weight_filter} B={raw_nB_for_weight_filter}")
    wA = np.asarray(wA[frame_keep_maskA], dtype=np.float64)
    wB = np.asarray(wB[frame_keep_maskB], dtype=np.float64)
    nA = int(wA.size)
    nB = int(wB.size)

    # Stage1 exact-TV configuration
    seed = int(getattr(args, "seed", 0))
    auc_random_state = int(getattr(args, "auc_random_state", seed) if getattr(args, "auc_random_state", None) is not None else seed)
    contrib_random_state = int(getattr(args, "contrib_random_state", auc_random_state) if getattr(args, "contrib_random_state", None) is not None else auc_random_state)
    stability_runs = max(0, int(getattr(args, "stability_runs", 0) or 0))
    stability_topk = max(1, int(getattr(args, "stability_topk", 100) or 100))
    stability_topm_regions = max(1, int(getattr(args, "stability_topm_regions", 100) or 100))
    total_stages = 6 if stability_runs > 0 else 5
    rng = np.random.default_rng(seed)

    # Reference-PDB context is shared by Stage5/pretty-writer/cache signature logic.
    # Build it once here, before any downstream stage can reference these names.
    _limit_blas_threads(getattr(args, "blas_threads", 1), force=True)
    with SectionTimer("Resolve reference PDBs", enabled=True):
        refA_path, refB_path = _resolve_refs(args)
    natomA = natom_from_pdb(refA_path) if refA_path else None
    natomB = natom_from_pdb(refB_path) if refB_path else None
    atoms_ref = load_pdb_atoms_one(refA_path)
    spec_ref = str(getattr(args, "atom_specA", None) or getattr(args, "atom_spec", "") or "")
    if spec_ref.strip():
        sel_mask = eval_atom_specifier(spec_ref, atoms_ref)
    else:
        sel_mask = np.ones((len(atoms_ref),), dtype=bool)
    sel_idx = np.flatnonzero(sel_mask).astype(np.int32)
    atoms_sel = [atoms_ref[int(ai)] for ai in sel_idx.tolist()]
    res_keys, res_of_atom = _build_residue_keys_and_map(atoms_ref, sel_idx)
    atoms_by_res: list[list[int]] = [[] for _ in range(int(len(res_keys)))]
    for a_k, r_k in enumerate(np.asarray(res_of_atom, dtype=np.int32).tolist()):
        if 0 <= int(r_k) < len(atoms_by_res):
            atoms_by_res[int(r_k)].append(int(a_k))
    _audit_validate_ref_context(
        refA_path=refA_path, refB_path=refB_path,
        natomA=natomA, natomB=natomB,
        atoms_ref=atoms_ref, sel_idx=sel_idx, atoms_sel=atoms_sel,
        res_keys=res_keys, res_of_atom=res_of_atom, atoms_by_res=atoms_by_res,
    )
    idxA_bins = np.arange(nA, dtype=np.int64)
    idxB_bins = np.arange(nB, dtype=np.int64)
    stage1_auc_idxA, stage1_auc_idxB, stage1_auc_frame_mode = _select_stage1_auc_frame_indices(nA, nB, args, seed)
    auc_eps = float(getattr(args, 'auc_eps', 1e-8) or 1e-8)
    auc_cv_folds = max(2, int(getattr(args, 'auc_cv_folds', 5) or 5))
    progress_interval_sec = float(getattr(args, 'progress_interval_sec', 300.0) or 300.0)
    cache_dir = outdir / 'distil_cache'
    feature_metrics_dir = outdir / 'feature_metrics'
    cache_dir.mkdir(parents=True, exist_ok=True)
    feature_metrics_dir.mkdir(parents=True, exist_ok=True)
    stage1_scoring_dir = cache_dir / 'stage1_scoring'
    stage1_ckpt_dir = (stage1_scoring_dir / 'ckpt')
    selected_feature_ids_path = stage1_scoring_dir / 'selected_feature_ids.npy'
    selected_feature_positions_path = stage1_scoring_dir / 'selected_feature_positions.npy'
    single_feature_scores_path = stage1_scoring_dir / 'single_feature_scores.npy'
    single_feature_metrics_csv = stage1_scoring_dir / 'single_feature_metrics.csv'
    scoring_meta_path = stage1_scoring_dir / 'scoring_meta.json'
    scoring_done_path = stage1_scoring_dir / 'scoring.done.json'
    stage2_contrib_dir = cache_dir / 'stage2_contribution'
    feature_contrib_csv = stage2_contrib_dir / 'feature_contributions.csv'
    feature_contrib_npy = stage2_contrib_dir / 'feature_contributions.npy'
    feature_contrib_meta = stage2_contrib_dir / 'contribution_model_meta.json'
    feature_contrib_done = stage2_contrib_dir / 'contribution.done.json'
    stage1_scoring_dir.mkdir(parents=True, exist_ok=True)
    stage1_ckpt_dir.mkdir(parents=True, exist_ok=True)
    stage2_contrib_dir.mkdir(parents=True, exist_ok=True)
    auc_workers, auc_workers_detail = _resolve_stage_workers(int(getattr(args, 'auc_workers', 0) or 0), stage='stage1_auc')
    stage1_auc_idxA_use = np.arange(nA, dtype=np.int64) if stage1_auc_frame_mode == 'full' else np.asarray(stage1_auc_idxA, dtype=np.int64)
    stage1_auc_idxB_use = np.arange(nB, dtype=np.int64) if stage1_auc_frame_mode == 'full' else np.asarray(stage1_auc_idxB, dtype=np.int64)
    stage1_auc_wA = np.asarray(wA if stage1_auc_frame_mode == 'full' else wA[stage1_auc_idxA_use], dtype=np.float64)
    stage1_auc_wB = np.asarray(wB if stage1_auc_frame_mode == 'full' else wB[stage1_auc_idxB_use], dtype=np.float64)
    stage1_scoring_built = False

    pair_meta = _load_top_pairs_meta(pairs_csv)
    refA_sig_path, refB_sig_path = _resolve_refs(args)
    stage_input_sig = _features_signature_for_cache(args, refA_sig_path, refB_sig_path)
    pipeline_t0 = time.perf_counter()
    _pipeline_progress_emit(0, total_stages, "start", t0=pipeline_t0, extra=f"feature_mode={feature_mode} nA={nA} nB={nB} F={len(pair_meta)}")
    log_info('Pipeline schema: distil_pipeline_v1')
    log_info('Stage1 = feature scoring')
    log_info('Stage2 = contribution learning (standard mode only; neutral contribution table for sig/ced)')
    log_info('Stage3 = feature correlation graph')
    log_info('Stage4 = bundle detection')
    log_info('Stage5 = region inference and ranking')
    log_info('Stage6 = stability analysis')
    log_info(f"Cache directory: {cache_dir}")
    log_info(f"Feature metrics: {feature_metrics_dir}")
    log_info(f"Stage1 checkpoint: {stage1_ckpt_dir}")

    # local helpers: stage signatures for skip

    # ============================================================
    # Stage 1: feature scoring
    # ============================================================
    stage1_cache = stage1_scoring_dir / "feature_stats.pkl"
    stage1_meta_path = stage1_scoring_dir / "feature_stats_meta.json"
    stage1_done_path = stage1_scoring_dir / "feature_stats.done.json"
    pair_scores_csv = outdir / "pair_scores.csv"
    feats: list[FeatureStat] | None = None

    features_meta_for_stage1 = _load_json(outdir / FEATURES_META_JSON) if (outdir / FEATURES_META_JSON).exists() else {}
    stage1_source_featA_sig = _normalize_source_feature_sig(_stored_content_sig(features_meta_for_stage1, "source_features_A"))
    stage1_source_featB_sig = _normalize_source_feature_sig(_stored_content_sig(features_meta_for_stage1, "source_features_B"))
    tv_mode = "tv_then_auc"
    auc_threshold = float(getattr(args, 'auc_threshold', 0.8) or 0.8)

    want = {
            "cache_version": _cache_version_sig(STAGE1_CACHE_VERSION),
            "features_A": stage1_source_featA_sig,
            "features_B": stage1_source_featB_sig,
            "weights_A": _content_sig(wA_path),
            "weights_B": _content_sig(wB_path),
            "zero_weight_filter": {
                "raw_nA": int(raw_nA_for_weight_filter), "raw_nB": int(raw_nB_for_weight_filter),
                "kept_nA": int(nA), "kept_nB": int(nB),
                "maskA_sig": hashlib.sha256(np.asarray(frame_keep_maskA, dtype=np.bool_).tobytes()).hexdigest()[:16],
                "maskB_sig": hashlib.sha256(np.asarray(frame_keep_maskB, dtype=np.bool_).tobytes()).hexdigest()[:16],
            },
            "top_pairs_pool": _content_sig(pairs_csv),
            "bins_max": int(getattr(args, "bins_max", 128)),
            "bins_min_neff_per_bin": float(getattr(args, "bins_min_neff_per_bin", 30.0) or 0.0),
            "stage1_mode": "feature_scoring_v1",
            **_stage1_selection_cache_fields(args, selection_mode=getattr(args, 'selection_mode', 'standard'), auc_threshold=auc_threshold),
            "auc_eps": float(auc_eps),
            "auc_cv_folds": int(auc_cv_folds),
            "auc_random_state": int(auc_random_state),
            "score_matrix_layout": "frames_by_features_c_order_v1",
            "stage1_scratch_layout": "chunk_memmap_v1",
            "stage_inputs": stage_input_sig,
            "tv_winsor_q": float(_TV_WINSOR_Q),
            "seed": int(seed),
            "idxA_bins_sig": _array_sig(idxA_bins),
            "idxB_bins_sig": _array_sig(idxB_bins),
        }

    def _stage1_scoring_outputs_ok() -> tuple[bool, list[str]]:
        reasons = []
        # The resumable chunk checkpoint is not a required final Stage1 artifact.
        # It may be deleted after a successful zero-survivor run; scoring_meta.json
        # and the done payload retain the run signature needed for cache reuse.
        if not scoring_meta_path.exists():
            reasons.append(f'missing: {scoring_meta_path.name}')
        if not scoring_done_path.exists():
            reasons.append(f'missing: {scoring_done_path.name}')
        required = [
            (selected_feature_ids_path, selected_feature_ids_path.name),
            (selected_feature_positions_path, selected_feature_positions_path.name),
            (single_feature_scores_path, single_feature_scores_path.name),
            (single_feature_metrics_csv, single_feature_metrics_csv.name),
        ]
        missing = [label for p,label in required if not Path(p).exists()]
        reasons.extend([f'missing: {m}' for m in missing])
        if not reasons:
            ok, msg = _validate_stage1_scoring_outputs(selected_feature_ids_path, single_feature_metrics_csv, selected_feature_positions_path, single_feature_scores_path)
            if not ok:
                reasons.append(msg)
            meta_payload = _load_json(scoring_meta_path) if scoring_meta_path.exists() else None
            if not isinstance(meta_payload, dict):
                reasons.append(f'invalid JSON: {scoring_meta_path.name}')
            else:
                rs = meta_payload.get('run_signature_hash')
                if not rs:
                    reasons.append(f'missing key run_signature_hash in {scoring_meta_path.name}')
            ok_done, done_reasons, _done = _validate_done_payload(scoring_done_path, stage_name='Stage1_feature_scoring', want_meta=None, required_paths=required + [(scoring_meta_path, scoring_meta_path.name)])
            if not ok_done:
                reasons.extend(done_reasons)
        return (len(reasons) == 0), reasons

    if not force:
        _stage1_meta = _load_json(stage1_meta_path) if stage1_meta_path.exists() else None
        stage1_ok, stage1_state, stage1_reasons = _stage1_cache_check(
            _stage1_meta, want,
            cache_path=stage1_cache,
            meta_path=stage1_meta_path,
            done_path=stage1_done_path,
            pair_scores_path=pair_scores_csv,
        )
        if stage1_ok:
            stage1_ok, stage1_reasons = _stage1_scoring_outputs_ok()
            if not stage1_ok:
                feats = None
                stage1_state = 'miss'
                stage1_reasons = [f'stage1 cache cannot be reused because feature-scoring outputs are invalid'] + stage1_reasons
            else:
                try:
                    with open(stage1_cache, "rb") as f:
                        feats = pickle.load(f)
                    stage1_scoring_built = True
                    log_skip("Stage1: feature scoring", f"using cached FeatureStat list ({stage1_cache.name})")
                except Exception as e:
                    feats = None
                    stage1_state = "miss"
                    stage1_reasons = [f"failed to load {stage1_cache.name}: {e}"]
        if feats is None and stage1_state != "first_run":
            kind = "incomplete cache" if stage1_state == "incomplete" else "cache miss"
            log_recalc("Stage1: feature scoring", kind)
            for msg in stage1_reasons:
                log_why(msg)

    with SectionTimer("Stage1: feature scoring", enabled=True):
        if feats is None:
            bins_max = int(getattr(args, "bins_max", 128))
            bins_min_neff_per_bin = float(getattr(args, "bins_min_neff_per_bin", 30.0) or 0.0)
            tv_threshold = float(getattr(args, "tv_threshold", 0.35))

            tv_workers = int(getattr(args, "tv_workers", 0))
            tv_chunk = int(getattr(args, "tv_chunk", 0))
            auto_workers_detail = None
            auto_chunk_detail = None
            if tv_workers <= 0:
                tv_workers, auto_workers_detail = _resolve_stage_workers(tv_workers, stage='stage1_tv')
            if tv_chunk <= 0:
                tv_chunk, auto_chunk_detail = _auto_tv_chunk_info(tv_workers, len(pair_meta))
            if auto_workers_detail is not None or auto_chunk_detail is not None:
                parts = []
                if auto_workers_detail is not None:
                    parts.append(f"tv_workers={tv_workers} ({auto_workers_detail})")
                else:
                    parts.append(f"tv_workers={tv_workers} (user)")
                if auto_chunk_detail is not None:
                    parts.append(f"tv_chunk={tv_chunk} ({auto_chunk_detail})")
                else:
                    parts.append(f"tv_chunk={tv_chunk} (user)")
                log_info("[AUTO ] Stage1 strict-TV settings: " + "; ".join(parts))

            direct_ctx = _prepare_direct_pass_runtime(args)
            totalA = count_ensemble_frames(Path(args.ensembleA), int(direct_ctx['natomA']),
                                           sel_idx=direct_ctx['sel_idxA'],
                                           frame_stride=int(getattr(args, 'frame_stride', 0) or 0))
            totalB = count_ensemble_frames(Path(args.ensembleB), int(direct_ctx['natomB']),
                                           sel_idx=direct_ctx['sel_idxB'],
                                           frame_stride=int(getattr(args, 'frame_stride', 0) or 0))
            if int(totalA) != int(raw_nA_for_weight_filter) or int(totalB) != int(raw_nB_for_weight_filter):
                raise SystemExit(
                    f"[DISTIL] Stage1 direct frame-count mismatch: weights_A/B must be raw-length normalized vectors including zero-weight frames, "
                    f"but current weights have A={raw_nA_for_weight_filter}, B={raw_nB_for_weight_filter} while direct counting found A={totalA}, B={totalB}. "
                    f"This usually means weights_A.npy/weights_B.npy were produced by an older post-filtered-weight version; remove the output directory or rerun with this fixed version so weights are regenerated."
                )
            if _log_enabled('info'):
                log_info(f"Stage1 full-feature mode: streaming-strict-TV (raw_A={totalA}, raw_B={totalB}, kept_A={nA}, kept_B={nB}, F={len(pair_meta)})")
            run_ids_A, n_runs_A, run_hash_A, run_summary_A = _ensemble_run_ids(Path(args.ensembleA), int(direct_ctx['natomA']), sel_idx=direct_ctx['sel_idxA'], frame_stride=int(getattr(args, 'frame_stride', 0) or 0))
            run_ids_B, n_runs_B, run_hash_B, run_summary_B = _ensemble_run_ids(Path(args.ensembleB), int(direct_ctx['natomB']), sel_idx=direct_ctx['sel_idxB'], frame_stride=int(getattr(args, 'frame_stride', 0) or 0))
            def _filter_remap_run_ids(_ids: np.ndarray, _mask: np.ndarray, _label: str):
                ids0 = np.asarray(_ids, dtype=np.int32)
                if ids0.size != np.asarray(_mask).size:
                    raise RuntimeError(f"run-id length mismatch before zero-weight filter for {_label}: {ids0.size}/{np.asarray(_mask).size}")
                ids = ids0[np.asarray(_mask, dtype=bool)]
                if ids.size == 0:
                    raise RuntimeError(f"zero-weight filtering removed all frames in ensemble {_label}")
                uniq = sorted(int(x) for x in np.unique(ids).tolist())
                remap = {old: new for new, old in enumerate(uniq)}
                out_ids = np.asarray([remap[int(x)] for x in ids.tolist()], dtype=np.int32)
                h = hashlib.sha256(out_ids.tobytes()).hexdigest()[:16]
                return out_ids, int(len(uniq)), h
            run_ids_A, n_runs_A, run_hash_A = _filter_remap_run_ids(run_ids_A, frame_keep_maskA, 'A')
            run_ids_B, n_runs_B, run_hash_B = _filter_remap_run_ids(run_ids_B, frame_keep_maskB, 'B')
            if str(getattr(args, 'selection_mode', 'standard')) in ('sig', 'ced') and (int(n_runs_A) < 2 or int(n_runs_B) < 2):
                raise SystemExit(f"[ERROR] {getattr(args, 'selection_mode', 'standard')} mode requires at least 2 independent runs in each ensemble; got n_runs_A={n_runs_A}, n_runs_B={n_runs_B}. Use list entries connected by '->' to define independent runs, or use --selection-mode standard.")
            if str(getattr(args, 'selection_mode', 'standard')) == 'ced' and (int(n_runs_A) < 4 or int(n_runs_B) < 4):
                raise SystemExit(f"[ERROR] ced mode requires at least 4 independent runs in each ensemble for internal within-condition split probes; got n_runs_A={n_runs_A}, n_runs_B={n_runs_B}.")
            log_info(f"Stage1 run groups: A n_runs={int(n_runs_A)} hash={run_hash_A}; B n_runs={int(n_runs_B)} hash={run_hash_B}; selection_mode={getattr(args, 'selection_mode', 'standard')}")
            feats = _run_stage1_feature_scoring(
                ensembleA=Path(args.ensembleA),
                ensembleB=Path(args.ensembleB),
                natomA=int(direct_ctx['natomA']),
                natomB=int(direct_ctx['natomB']),
                sel_idxA=direct_ctx['sel_idxA'],
                sel_idxB=direct_ctx['sel_idxB'],
                frame_stride=int(getattr(args, 'frame_stride', 0) or 0),
