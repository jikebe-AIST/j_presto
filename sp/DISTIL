                        _primary_score_v = _f(rowp.get(stage5_primary_metric_col, rowp.get(stage5_primary_score_col, rowp.get('rank_score', '0'))))
                        _primary_sum_v = _f(rowp.get(stage5_primary_sum_col, rowp.get('stage5_weight_sum', '0')))
                        fo.write(f"  {stage5_primary_score_col}: {_primary_score_v:.6f}\n")
