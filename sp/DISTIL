    # Directional 1-D transport diagnostics on the same probability
    # distributions used by Stage1. For equivalent-atom features these are
    # computed from the equivalent-group mixture distribution, not from an
    # arbitrarily named raw member pair.
    transport_w1: float = 0.0
    transport_signed: float = 0.0
    transport_ratio: float = 0.0


def _directional_transport_from_prob(pA: np.ndarray, pB: np.ndarray, *, x_min: float, x_max: float, eps: float = 1e-12) -> tuple[float, float, float]:
    """Return histogram W1, signed transport, and normalized direction.

    For a common uniform 1-D histogram, let C(x)=F_A(x)-F_B(x). The
    positive and negative transport works are the integrals of max(C,0)
    and max(-C,0), respectively. Hence W1=W+ + W-, signed=W+ - W-, and
    ratio=signed/(W1+eps). Positive values mean that B is shifted toward
    longer distances; negative values mean shorter distances.
    """
    a = np.asarray(pA, dtype=np.float64).reshape(-1)
    b = np.asarray(pB, dtype=np.float64).reshape(-1)
    if a.size == 0 or b.size == 0 or a.size != b.size:
        return 0.0, 0.0, 0.0
    sa = float(np.sum(a)); sb = float(np.sum(b))
    if sa <= 0.0 or sb <= 0.0 or (not np.isfinite(sa)) or (not np.isfinite(sb)):
        return 0.0, 0.0, 0.0
    a = a / sa; b = b / sb
    width = float(x_max - x_min) / float(max(1, a.size))
    if (not np.isfinite(width)) or width <= 0.0:
        return 0.0, 0.0, 0.0
    # The last CDF difference is exactly zero after normalization and has no
    # interval to its right, so it is excluded.
    cdf_diff = np.cumsum(a - b)[:-1]
    if cdf_diff.size == 0:
        return 0.0, 0.0, 0.0
    w_plus = width * float(np.sum(np.maximum(cdf_diff, 0.0)))
    w_minus = width * float(np.sum(np.maximum(-cdf_diff, 0.0)))
    w1 = max(0.0, w_plus + w_minus)
    signed = float(w_plus - w_minus)
    ratio = float(signed / (w1 + float(eps))) if w1 > 0.0 else 0.0
    return float(w1), float(signed), float(np.clip(ratio, -1.0, 1.0))


def _weighted_mean_std(x: np.ndarray, w: np.ndarray) -> tuple[float, float]:
    x = np.asarray(x, dtype=np.float64)
    w = np.asarray(w, dtype=np.float64)
    sw = float(np.sum(w))
    if sw <= 0.0 or x.size == 0:
        return 0.0, 0.0
    mu = float(np.sum(w * x) / sw)
    var = float(np.sum(w * (x - mu) ** 2) / sw)
    return mu, math.sqrt(max(0.0, var))


def _winsor_limits_from_sample(xs: np.ndarray, *, q: float) -> tuple[float, float]:
    """Return winsorization limits (lo, hi) from a sample xs.

    We estimate (q, 1-q) quantiles using ``np.partition`` on the provided
    sample to stay fast and deterministic. ``q=0`` falls back to ``(min, max)``.
    """
    xs = np.asarray(xs, dtype=np.float64)
    if xs.size == 0:
        return (0.0, 0.0)
    q = float(q)
    if (not np.isfinite(q)) or q <= 0.0:
        lo = float(np.min(xs))
        hi = float(np.max(xs))
        return (lo, hi)
    if q >= 0.499:
        q = 0.499
    n = int(xs.size)
    if n < 8:
        lo = float(np.min(xs))
        hi = float(np.max(xs))
        return (lo, hi)
    k_lo = int(np.floor(q * (n - 1)))
    k_hi = int(np.ceil((1.0 - q) * (n - 1)))
    if k_hi <= k_lo:
        lo = float(np.min(xs))
        hi = float(np.max(xs))
        return (lo, hi)
    a = np.array(xs, dtype=np.float64, copy=True)
    a = np.where(np.isfinite(a), a, np.nan)
    if np.all(np.isnan(a)):
        return (0.0, 0.0)
    nan_mask = np.isnan(a)
    if np.any(nan_mask):
        finite = a[~nan_mask]
        if finite.size == 0:
            return (0.0, 0.0)
        fmax = float(np.max(finite))
        a[nan_mask] = fmax
    a = np.partition(a, (k_lo, k_hi))
    lo = float(a[k_lo])
    hi = float(a[k_hi])
    if not np.isfinite(lo) or not np.isfinite(hi):
        lo = float(np.nanmin(xs))
        hi = float(np.nanmax(xs))
    if hi <= lo:
        hi = lo + 1e-6
    return (lo, hi)


def _hist_prob_uniform_clip(x: np.ndarray, w: np.ndarray, *, bins: int, x_min: float, x_max: float) -> np.ndarray:
    """Histogram probability for uniform bins with winsor-style clipping.

    Values outside ``[x_min, x_max]`` are clipped into the edge bins instead of
    being dropped, so probability mass is preserved when the range is estimated
    from a subsample.
    """
    bins = int(bins)
    if bins <= 0 or not (x_max > x_min):
        return np.zeros((max(1, bins),), dtype=np.float64)
    x = np.asarray(x, dtype=np.float64)
    w = np.asarray(w, dtype=np.float64)
    if x.size == 0:
        return np.zeros((bins,), dtype=np.float64)
    if int(w.size) != int(x.size):
        raise ValueError(f"histogram frame/weight length mismatch: x={int(x.size)} weights={int(w.size)} bins={int(bins)} x_min={float(x_min)} x_max={float(x_max)}")
    bw = (float(x_max) - float(x_min)) / float(bins)
    if not (bw > 0.0):
        return np.zeros((bins,), dtype=np.float64)
    idx = np.floor((x - float(x_min)) / bw).astype(np.int64, copy=False)
    idx = np.clip(idx, 0, bins - 1)
    ww = np.where(np.isfinite(w), w, 0.0)
    hist = np.bincount(idx, weights=ww, minlength=bins).astype(np.float64, copy=False)
    s = float(hist.sum())
    if s <= 0.0:
        return np.zeros((bins,), dtype=np.float64)
    return (hist / s).astype(np.float64, copy=False)


def _tv_from_uniform_hist(
    xA: np.ndarray, wA: np.ndarray,
    xB: np.ndarray, wB: np.ndarray,
    *, bins: int, x_min: float, x_max: float
) -> float:
    bins = int(bins)
    if bins < 2 or x_max <= x_min:
        return 0.0
    pA = _hist_prob_uniform_clip(xA, wA, bins=bins, x_min=x_min, x_max=x_max)
    pB = _hist_prob_uniform_clip(xB, wB, bins=bins, x_min=x_min, x_max=x_max)
    ovl = float(np.minimum(pA, pB).sum())
    tv = 1.0 - ovl
    if tv < 0.0:
        tv = 0.0
    if tv > 1.0:
        tv = 1.0
    return tv



def _chi2_sf_approx(x: float, df: int) -> float:
    """Survival function for chi-square(df), with scipy when available."""
    x = float(x)
    df = int(df)
    if (not np.isfinite(x)) or x < 0.0 or df <= 0:
        return float('nan')
    try:
        from scipy.stats import chi2 as _scipy_chi2  # type: ignore
        return float(_scipy_chi2.sf(x, df))
    except Exception:
        if x <= 0.0:
            return 1.0
        k = float(df)
        z = ((x / k) ** (1.0 / 3.0) - (1.0 - 2.0 / (9.0 * k))) / math.sqrt(2.0 / (9.0 * k))
        return float(0.5 * math.erfc(z / math.sqrt(2.0)))


def _bh_fdr(pvals: np.ndarray) -> np.ndarray:
    """Benjamini-Hochberg q-values, preserving NaNs."""
    pvals = np.asarray(pvals, dtype=np.float64)
    q = np.full(pvals.shape, np.nan, dtype=np.float64)
    mask = np.isfinite(pvals)
    m = int(np.count_nonzero(mask))
    if m <= 0:
        return q
    pv = np.clip(pvals[mask], 0.0, 1.0)
    order = np.argsort(pv)
    ranked = pv[order]
    adj = ranked * (float(m) / np.arange(1, m + 1, dtype=np.float64))
    adj = np.minimum.accumulate(adj[::-1])[::-1]
    adj = np.clip(adj, 0.0, 1.0)
    out = np.empty_like(pv)
    out[order] = adj
    q[mask] = out
    return q


def _format_float_csv(x: object, precision: int = 6) -> str:
    try:
        v = float(x)
    except Exception:
        return 'nan'
    if not np.isfinite(v):
        return 'nan'
    if v != 0.0 and (abs(v) < 1e-4 or abs(v) >= 1e6):
        return f"{v:.6e}"
    return f"{v:.{int(precision)}f}"


def _metric_threshold_curve_ge(values: np.ndarray, thresholds: list[float]) -> list[tuple[float, int, float]]:
    vals = np.asarray(values, dtype=np.float64)
    vals = vals[np.isfinite(vals)]
    n = int(vals.size)
    rows = []
    for th in thresholds:
        c = int(np.count_nonzero(vals >= float(th))) if n else 0
        rows.append((float(th), c, float(c / n) if n else float('nan')))
    return rows


def _metric_threshold_curve_le(values: np.ndarray, thresholds: list[float]) -> list[tuple[float, int, float]]:
    vals = np.asarray(values, dtype=np.float64)
    vals = vals[np.isfinite(vals)]
    n = int(vals.size)
    rows = []
    for th in thresholds:
        c = int(np.count_nonzero(vals <= float(th))) if n else 0
        rows.append((float(th), c, float(c / n) if n else float('nan')))
    return rows


def _plot_threshold_curve_png(path: Path, x: list[float], y: list[float], *, xlabel: str, ylabel: str, title: str, xscale: str = 'linear') -> None:
