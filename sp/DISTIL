def _contrib_choose_frame_block_size(n_rows: int, n_features: int, *, memory_budget_mib: float = 2048.0) -> int:
    budget = max(128.0, float(memory_budget_mib)) * (1024.0 ** 2)
    # Keep one dense row-block in RAM as float32 plus float64 work buffers.
    bytes_per_row = max(1, int(n_features)) * (4.0 + 8.0 + 8.0)
    block = int(max(256, min(int(n_rows), budget // max(1.0, bytes_per_row))))
    return int(max(256, block))


