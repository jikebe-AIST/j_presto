                auc_scope=str(getattr(args, 'auc_scope', 'pass') or 'pass'),
                selection_mode=str(getattr(args, 'selection_mode', 'standard')),
                run_idsA=run_ids_A,
                run_idsB=run_ids_B,
                n_runs_A=int(n_runs_A),
                n_runs_B=int(n_runs_B),
                run_group_hash_A=str(run_hash_A),
                run_group_hash_B=str(run_hash_B),
                sig_test=str(getattr(args, 'sig_test', 'weighted_z')),
                sig_alpha=float(getattr(args, 'sig_alpha', 0.05)),
                sig_fdr=(str(getattr(args, 'sig_fdr', 'off')).lower() == 'on'),
                sig_bin_peak_frac=float(getattr(args, 'sig_bin_peak_frac', 0.03)),
                sig_bin_min_count=int(getattr(args, 'sig_bin_min_count', 3)),
                sig_area_threshold=float(getattr(args, 'sig_area_threshold', 0.0)),
                ced_within_splits=int(getattr(args, 'ced_within_splits', CED_WITHIN_SPLITS_DEFAULT)),
                ced_null_splits=int(getattr(args, 'ced_null_splits', CED_NULL_SPLITS_DEFAULT)),
                ced_q_threshold=float(getattr(args, 'ced_q_threshold', 1.0)),
                ced_r_threshold=float(getattr(args, 'ced_r_threshold', 1.5)),
                ced_z_threshold=float(getattr(args, 'ced_z_threshold', 2.0)),
                ced_null_r_threshold=float(getattr(args, 'ced_null_r_threshold', 1.2)),
                ced_null_z_threshold=float(getattr(args, 'ced_null_z_threshold', 1.0)),
                ced_null_p_threshold=float(getattr(args, 'ced_null_p_threshold', 0.10)),
                ced_null_q_threshold=float(getattr(args, 'ced_null_q_threshold', 0.05)),
                ced_min_tv=float(getattr(args, 'ced_min_tv', 0.02)),
                ced_eps=float(getattr(args, 'ced_eps', 1e-6)),
                ced_random_state=int(getattr(args, 'ced_random_state', getattr(args, 'seed', 0)) if getattr(args, 'ced_random_state', None) is not None else getattr(args, 'seed', 0)),
                ced_pattern_batch_size=int(getattr(args, 'ced_pattern_batch_size', CED_PATTERN_BATCH_SIZE_DEFAULT)),
                run_hist_dir=(cache_dir / 'run_bin_hists'),
                feat_chunk=tv_chunk,
                pair_block=int(getattr(args, 'feat_pair_block', 100_000)),
                workers=max(1, int(tv_workers)),
                progress_interval_sec=float(getattr(args, 'progress_interval_sec', 300.0)),
                memory_budget_mib=float(getattr(args, 'stage1_memory_budget_mib', 2048.0)),
                frame_keep_maskA=frame_keep_maskA,
                frame_keep_maskB=frame_keep_maskB,
                stage1_ckpt_dir=stage1_ckpt_dir,
                selected_feature_ids_path=selected_feature_ids_path,
                selected_feature_positions_path=selected_feature_positions_path,
                single_feature_scores_path=single_feature_scores_path,
                single_feature_metrics_csv=single_feature_metrics_csv,
                feature_metrics_dir=feature_metrics_dir,
