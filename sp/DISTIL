                    _agroup_label(int(pair_meta.agroup_j[fid])) if fid < len(pair_meta) else "unk",
                    int(pair_meta.equiv_group_id[fid]) if (hasattr(pair_meta, 'equiv_group_id') and fid < len(pair_meta)) else -1,
                    (f"equiv_pair_group_{int(pair_meta.equiv_group_id[fid])}" if (hasattr(pair_meta, 'equiv_group_id') and fid < len(pair_meta) and int(pair_meta.equiv_group_id[fid]) >= 0) else ''),
                    ('mixture' if (hasattr(pair_meta, 'equiv_group_id') and fid < len(pair_meta) and int(pair_meta.equiv_group_id[fid]) >= 0) else 'raw'),
                ])

    def _write_empty_downstream_outputs(reason: str) -> None:
        """Write an explicit empty downstream result set and remove stale Stage5 outputs.

        This is especially important for CED: Stage1 may have pre-FDR candidates,
        but after q_null FDR the final feature set can be empty.  In that case,
        stale plots/rankings from an older run or from an earlier pre-FDR run must
        not remain in the main output directory.
        """
        log_info(reason)

        def _write_text_atomic_local(path: Path, text: str) -> None:
            path = Path(path)
            path.parent.mkdir(parents=True, exist_ok=True)
            tmp = path.with_suffix(path.suffix + '.tmp')
            tmp.write_text(text, encoding='utf-8')
            os.replace(tmp, path)

        # Remove visual and ranking artifacts that would otherwise look like final results.
        stale_files = [
            'pair_contrib_ranked.csv',
            'pair_contrib_ranked_pretty.txt',
            'ranked_pairs_pretty.txt',
            'bundle_regions_pretty.txt',
            'stage5_pair_meta.json',
            'stage5_pair.done.json',
            'stage5_regions_meta.json',
            'stage5_regions.done.json',
            'stage5_rank_meta.json',
            'stage5_rank.done.json',
            'ensemble_direction_map.bild',
            'ensemble_direction_map.cmd',
            'ensemble_direction_map.tsv',
        ]
        for _name in stale_files:
            _pp = outdir / _name
            try:
                if _pp.exists() or _pp.is_symlink():
                    _pp.unlink()
            except Exception as e:
                log_warn(f"empty downstream cleanup: could not remove {_pp}: {e}")

        # Persist an explicit empty final-selection artifact so a previous
        # successful run cannot leave stale selected feature IDs behind.
        try:
            _save_npy_atomic(sel_fids_path, np.zeros((0,), dtype=np.int64))
        except Exception as e:
            log_warn(f"empty downstream cleanup: could not write empty {sel_fids_path}: {e}")

        # Remove resumable/intermediate caches that are no longer useful after
        # a successful final selection of zero features.  Final Stage1 metrics,
        # score diagnostics, metadata and done payloads remain available, so an
        # identical rerun can still hit the completed Stage1 cache.
        zero_survivor_cache_dirs = [
            Path(stage1_ckpt_dir),
            Path(stage1_scoring_dir) / 'stage3_direct_distances',
            Path(cache_dir) / 'stage2_contribution',
            Path(cache_dir) / 'stage3_correlation',
            Path(cache_dir) / 'stage4_bundles',
            Path(cache_dir) / 'stage5_regions',
            Path(cache_dir) / 'stage5_direction_map',
            Path(cache_dir) / 'stage6_stability',
        ]
        reclaimed_bytes = 0
        removed_cache_dirs = 0
        for cache_path_i in zero_survivor_cache_dirs:
            try:
                if cache_path_i.exists():
                    reclaimed_bytes += int(_dir_size_bytes(cache_path_i))
                    shutil.rmtree(cache_path_i)
                    removed_cache_dirs += 1
            except Exception as e:
                log_warn(f"empty downstream cleanup: could not remove {cache_path_i}: {e}")

        plots_path = outdir / 'plots'
        if plots_path.exists():
            try:
                shutil.rmtree(plots_path)
            except Exception as e:
                log_warn(f"empty downstream cleanup: could not remove {plots_path}: {e}")
        plots_path.mkdir(parents=True, exist_ok=True)

        # Preserve Stage1 metric PDBs, but remove Stage5-owned PDB/PML files.
        pdb_path = outdir / 'pdb'
        pdb_path.mkdir(parents=True, exist_ok=True)
        stage5_pdb_patterns = [
            'pair_rank*_regions.pdb',
            'pair_rank*_view.pml',
            'all_ranked_bundles_regions.pdb',
            'all_ranked_bundles_view.pml',
            'all_ranked_bundles_metric_*.pdb',
        ]
        removed_stage5_pdbs = 0
        for _pat in stage5_pdb_patterns:
            for _pp in pdb_path.glob(_pat):
                try:
                    if _pp.is_file() or _pp.is_symlink():
                        _pp.unlink()
                        removed_stage5_pdbs += 1
                except Exception as e:
                    log_warn(f"empty downstream cleanup: could not remove {_pp}: {e}")
        metric_json = pdb_path / 'metric_pdbs.json'
        if metric_json.exists():
            try:
                _mj = _load_json(metric_json)
                if isinstance(_mj, dict):
                    for _key in list(_mj.keys()):
                        _ks = str(_key)
                        if _ks.startswith('pair_rank') or _ks.startswith('all_ranked_bundles'):
                            _mj.pop(_key, None)
                    _write_json_atomic(metric_json, _mj)
            except Exception as e:
                log_warn(f"empty downstream cleanup: could not update {metric_json}: {e}")

        _write_text_atomic_local(outdir / 'feature_corr_edges.csv', 'f_id,g_id,corr\n')
        _write_text_atomic_local(outdir / 'bundles.csv', 'bundle_id,member_fids,bundle_score,bundle_size\n')
        _write_text_atomic_local(
            outdir / 'bundle_regions.csv',
            'bundle_id,regionA_nodes,regionB_nodes,nA,nB,cut_weight,max_tv_cross,argmax_pair_id,argmax_pair_type,supporting_pairs_topK\n',
        )
        _write_text_atomic_local(
            outdir / 'region_contrib.csv',
            'bundle_id,region_id,contribution_sum,contribution_mean,contribution_density,pair_count,near_pair_count,long_pair_count,mean_auc_single,max_auc_single,multivar_auc\n',
        )
        _write_text_atomic_local(
            outdir / 'ranked_pairs.csv',
            'rank,bundle_id,score,regionA_nodes,regionB_nodes,nA,nB,cut_weight,argmax_pair_id,argmax_pair_type,supporting_pairs_topK\n',
        )
        _write_text_atomic_local(
            outdir / 'pair_contrib.csv',
            'fid,pair_type,atom_i,atom_j,res_i,res_j,tv,auc_single,coef_multi,feature_std,contribution_multi,multivar_selected,condition_effect_score,sig_strength,ced_p_null,ced_q_null,transport_w1,transport_signed,transport_ratio,stage5_score,stage5_score_name,bundle_id,multivar_auc\n',
        )
        _write_text_atomic_local(
            outdir / 'pair_contrib_ranked.csv',
            'rank,fid,pair_type,atom_i,atom_j,res_i,res_j,tv,auc_single,coef_multi,feature_std,contribution_multi,multivar_selected,condition_effect_score,sig_strength,ced_p_null,ced_q_null,transport_w1,transport_signed,transport_ratio,stage5_score,stage5_score_name,bundle_id,multivar_auc\n',
        )
        _write_text_atomic_local(outdir / 'pair_contrib_ranked_pretty.txt', f'# Empty downstream result\n# reason: {reason}\n')
        _write_text_atomic_local(
            outdir / 'residue_contrib.csv',
            'res_idx,chain,resid,resname,contribution,supporting_pair_count,near_contribution,long_contribution\n',
        )
        _write_text_atomic_local(outdir / 'ranked_pairs_pretty.txt', f'# Empty downstream result\n# reason: {reason}\n')
        _write_text_atomic_local(outdir / 'bundle_regions_pretty.txt', f'# Empty downstream result\n# reason: {reason}\n')
        log_info(
            f"Empty downstream cleanup: plots cleared; Stage5-owned PDB files removed={removed_stage5_pdbs}; "
            f"intermediate_cache_dirs_removed={removed_cache_dirs}; reclaimed={_format_bytes_gib(reclaimed_bytes)}; "
            f"Stage1 final metrics/scoring metadata preserved"
        )

    # Stage1 feature scoring first applies the primary selector, then computes AUC/scores for
    # --auc-scope pass features (or all features when --auc-scope all is used).
    selection_mode_main = str(getattr(args, 'selection_mode', 'standard') or 'standard')
    if selection_mode_main == 'sig':
        passed_primary = [fs for fs in feats if bool(getattr(fs, 'passed_sig', False))]
        primary_label = 'sig'
        no_primary_msg = 'No features passed sig selection. Skipping downstream stages.'
        no_primary_extra = 'no sig survivors'
    elif selection_mode_main == 'ced':
        passed_primary = [fs for fs in feats if bool(getattr(fs, 'passed_ced', False))]
        primary_label = 'ced'
        no_primary_msg = 'No features passed CED selection. Skipping downstream stages.'
        no_primary_extra = 'no ced survivors'
    else:
        passed_primary = [fs for fs in feats if fs.passed_tv]
        primary_label = "TV_prefilter"
        no_primary_msg = "No features passed strict TV prefilter. Skipping downstream stages."
        no_primary_extra = "no TV prefilter survivors"
    if not passed_primary:
        _write_pair_scores_augmented({})
        _write_empty_downstream_outputs(no_primary_msg)
        _pipeline_progress_emit(total_stages, total_stages, "finished", t0=pipeline_t0, extra=no_primary_extra)
        return

    sel_fids_prefilter = np.array([int(fs.fid) for fs in passed_primary], dtype=np.int64)

    stage1_ok, stage1_reasons = _stage1_scoring_outputs_ok()
    if not stage1_scoring_built or not stage1_ok:
        raise RuntimeError('Stage1 feature scoring did not produce valid scoring artifacts: ' + '; '.join(stage1_reasons[:6]))

    pair_auc_rows: dict[int, dict[str, object]] = {}
    with open(single_feature_metrics_csv, 'r', encoding='utf-8') as f:
        for row in csv.DictReader(f):
            try:
                fid = int(row.get('fid', '-1') or -1)
            except Exception:
                continue
            metrics = {
                'pair_type': row.get('pair_type', ''),
                'auc_single': float(row.get('auc_single', 'nan') or 'nan'),
                'passed_auc': bool(int(row.get('passed_auc', '0') or 0)),
                'used_for_downstream': bool(int(row.get('used_for_downstream', row.get('passed_final', '0')) or 0)),
                'n_samples_A': int(row.get('n_samples_A', '0') or 0),
                'n_samples_B': int(row.get('n_samples_B', '0') or 0),
                'score_mean_A': float(row.get('score_mean_A', 'nan') or 'nan'),
                'score_mean_B': float(row.get('score_mean_B', 'nan') or 'nan'),
                'neff_A': float(row.get('neff_A', 'nan') or 'nan'),
                'neff_B': float(row.get('neff_B', 'nan') or 'nan'),
            }
            pair_auc_rows[int(fid)] = metrics

    stage2_pass = [fs for fs in passed_primary if bool(pair_auc_rows.get(int(fs.fid), {}).get('used_for_downstream', False))]
    _write_pair_scores_augmented(pair_auc_rows)
    if selection_mode_main == 'sig':
        log_info(
            f"Stage1 summary: selection=sig primary_pass={len(passed_primary)} downstream={len(stage2_pass)} "
            f"alpha={float(getattr(args, 'sig_alpha', 0.05)):.3g} peak_frac={float(getattr(args, 'sig_bin_peak_frac', 0.03)):.3g} "
            f"auc_scope={getattr(args, 'auc_scope', 'pass')} TV/AUC diagnostic-only for selection"
        )
    elif selection_mode_main == 'ced':
        log_info(
            f"Stage1 summary: selection=ced final_passed_ced={len(passed_primary)} downstream={len(stage2_pass)} "
            f"R>={float(getattr(args, 'ced_r_threshold', 1.5)):.3g} Z>={float(getattr(args, 'ced_z_threshold', 2.0)):.3g} "
            f"minTV={float(getattr(args, 'ced_min_tv', 0.02)):.3g} within_splits={int(getattr(args, 'ced_within_splits', CED_WITHIN_SPLITS_DEFAULT))} null_splits={int(getattr(args, 'ced_null_splits', CED_NULL_SPLITS_DEFAULT))} "
            f"q_null<={float(getattr(args, 'ced_null_q_threshold', 0.05)):.3g} auc_scope={getattr(args, 'auc_scope', 'pass')} TV/AUC diagnostic-only for selection"
        )
    else:
        log_info(
            f"Stage1 summary: selection=standard TV_prefilter={len(passed_primary)} passed_AUC={len(stage2_pass)} "
            f"(dropped={int(len(passed_primary) - len(stage2_pass))}) auc_threshold={float(getattr(args, 'auc_threshold', 0.8) or 0.8):.3f}"
        )
    _pipeline_progress_emit(1, total_stages, 'Stage1 complete', t0=pipeline_t0, extra=(f"final_ced={len(stage2_pass)}/{len(passed_primary)}" if selection_mode_main == 'ced' else f"passed={len(stage2_pass)}/{len(passed_primary)}"))


    passed = stage2_pass
    if not passed:
        reason = ("No features passed sig selection. Skipping downstream stages." if selection_mode_main == 'sig' else ("No features passed CED selection. Skipping downstream stages." if selection_mode_main == 'ced' else "No features passed AUC threshold. Skipping downstream stages."))
        extra = ("no sig survivors" if selection_mode_main == 'sig' else ("no ced survivors" if selection_mode_main == 'ced' else "no AUC survivors"))
        _write_empty_downstream_outputs(reason)
        _pipeline_progress_emit(total_stages, total_stages, "finished", t0=pipeline_t0, extra=extra)
        return

    sel_fids = np.array([int(fs.fid) for fs in passed], dtype=np.int64)
    corr_max_features = max(0, int(getattr(args, "corr_max_features", 0) or 0))
    corr_cap_active = False
    if corr_max_features > 0 and len(passed) > corr_max_features:
        passed = sorted(passed, key=lambda x: float(pair_auc_rows.get(int(x.fid), {}).get('auc_single', float('-inf'))), reverse=True)[:corr_max_features]
        sel_fids = np.array([int(fs.fid) for fs in passed], dtype=np.int64)
        corr_cap_active = True
        log_info(f"Correlation feature cap: keeping top {len(passed)} AUC-final features for downstream analysis (corr_max_features={corr_max_features}).")

    _save_npy_atomic(sel_fids_path, np.asarray(sel_fids, dtype=np.int64))

    # Stage2 contribution learning must use the exact downstream feature set.
    # Only build a Stage2-local subset when corr_max_features actually removed
    # features. If the cap is set but not active, reusing Stage1 scoring artifacts
    # avoids an unnecessary full score-matrix copy.
    contrib_selected_feature_ids_path = selected_feature_ids_path
    contrib_selected_feature_positions_path = selected_feature_positions_path
    contrib_single_feature_scores_path = single_feature_scores_path
    contrib_single_feature_metrics_csv = single_feature_metrics_csv
    if corr_cap_active:
        contrib_selected_feature_ids_path = stage2_contrib_dir / 'contribution_feature_ids.npy'
        contrib_selected_feature_positions_path = stage2_contrib_dir / 'contribution_feature_positions.npy'
        contrib_single_feature_scores_path = stage2_contrib_dir / 'contribution_feature_scores.npy'
        contrib_single_feature_metrics_csv = stage2_contrib_dir / 'contribution_feature_metrics.csv'
        old_ids = np.load(selected_feature_ids_path).astype(np.int64, copy=False)
        old_pos = np.load(selected_feature_positions_path).astype(np.int64, copy=False)
        old_index = {int(fid): int(i) for i, fid in enumerate(old_ids.tolist())}
        keep_cols = np.asarray([old_index[int(fid)] for fid in sel_fids.tolist() if int(fid) in old_index], dtype=np.int64)
        if int(keep_cols.size) != int(sel_fids.size):
            raise RuntimeError('Stage2 contribution subset could not map all capped selected features to Stage1 scoring columns')
        _save_npy_atomic(contrib_selected_feature_ids_path, np.asarray(sel_fids, dtype=np.int64))
        _save_npy_atomic(contrib_selected_feature_positions_path, old_pos[keep_cols])
        Xsrc = np.load(single_feature_scores_path, mmap_mode='r')
        tmp_scores = contrib_single_feature_scores_path.with_suffix(contrib_single_feature_scores_path.suffix + '.tmp')
        _safe_unlink(tmp_scores)
        Xdst = open_memmap(str(tmp_scores), mode='w+', dtype=np.float32, shape=(int(Xsrc.shape[0]), int(keep_cols.size)))
        row_block = max(1024, min(int(Xsrc.shape[0]), _contrib_choose_frame_block_size(int(Xsrc.shape[0]), max(1, int(keep_cols.size)), memory_budget_mib=512.0)))
        subset_logger = _progress_logger('Stage2/subset_scores', total_units=max(1, int(Xsrc.shape[0])), min_interval_sec=float(getattr(args, 'progress_interval_sec', 300.0) or 300.0), active_label='rows')
        for r0 in range(0, int(Xsrc.shape[0]), int(row_block)):
            r1 = min(int(Xsrc.shape[0]), r0 + int(row_block))
            Xdst[r0:r1, :] = np.asarray(Xsrc[r0:r1, :][:, keep_cols], dtype=np.float32)
            subset_logger(int(r1), active=int(r1-r0), force=False)
        subset_logger(int(Xsrc.shape[0]), active=0, force=True)
        if hasattr(Xdst, 'flush'):
            Xdst.flush()
        del Xdst
        os.replace(tmp_scores, contrib_single_feature_scores_path)
        keep_set = {int(fid) for fid in sel_fids.tolist()}
        with open(single_feature_metrics_csv, 'r', encoding='utf-8') as _fin:
            rows = list(csv.DictReader(_fin))
            fieldnames = list(rows[0].keys()) if rows else []
        def _write_contrib_metrics(_fh, _rows=rows, _fieldnames=fieldnames, _keep=keep_set):
            w = csv.DictWriter(_fh, fieldnames=_fieldnames)
            w.writeheader()
            for _row in _rows:
                try:
                    _fid = int(_row.get('fid', -1))
                except Exception:
                    continue
                if _fid in _keep:
                    w.writerow(_row)
        _write_csv_atomic(contrib_single_feature_metrics_csv, _write_contrib_metrics)


    # ============================================================
    # Stage 3 preparation (performed immediately after Stage1 selection)
    # ============================================================
    # The selected-feature distance matrix is needed later for complete
    # correlation graph construction. It is always materialized here, as soon
    # as the final downstream feature set is known, rather than waiting until
    # after Stage2. This makes the heavy Stage1-scratch retrieval an explicit
    # cached Stage1-dependent artifact and prevents a long silent I/O phase at
    # the beginning of Stage3.
    scratch_dir_stage3_pre = Path(stage1_ckpt_dir) / "scratch" if stage1_ckpt_dir is not None else None
    if scratch_dir_stage3_pre is None or not scratch_dir_stage3_pre.exists():
        raise RuntimeError('Stage3 preparation requires Stage1 scratch artifacts, but the scratch directory is unavailable.')
    stage3_corr_dir_pre = cache_dir / 'stage3_correlation'
    stage3_corr_dir_pre.mkdir(parents=True, exist_ok=True)
    stage3_z_npy_pre = stage3_corr_dir_pre / 'selected_weighted_standardized.npy'
    stage3_moments_npz_pre = stage3_corr_dir_pre / 'moments.npz'
    stage3_matrix_meta_pre = stage3_corr_dir_pre / 'selected_matrix_meta.json'
    stage3_matrix_done_pre = stage3_corr_dir_pre / 'selected_matrix.done.json'
    row_idxA_stage3_pre = None if stage1_auc_frame_mode == "full" else np.asarray(stage1_auc_idxA, dtype=np.int64)
    row_idxB_stage3_pre = None if stage1_auc_frame_mode == "full" else np.asarray(stage1_auc_idxB, dtype=np.int64)
    wA_s_pre = np.asarray(wA if row_idxA_stage3_pre is None else wA[row_idxA_stage3_pre], dtype=np.float64)
    wB_s_pre = np.asarray(wB if row_idxB_stage3_pre is None else wB[row_idxB_stage3_pre], dtype=np.float64)
    F_stage3_pre = int(sel_fids.size)
    n_frames_stage3_pre = int(wA_s_pre.size + wB_s_pre.size)
    corr_block_requested_pre = int(getattr(args, "corr_block", 0) or 0)
    if corr_block_requested_pre > 0:
        block_stage3_pre = max(1, int(corr_block_requested_pre))
    else:
        if F_stage3_pre <= 2000:
            block_stage3_pre = min(max(1, F_stage3_pre), 1024)
        elif F_stage3_pre <= 10000:
            block_stage3_pre = 512
        else:
            block_stage3_pre = 256
    stage3_z_shape_pre = (int(F_stage3_pre), int(n_frames_stage3_pre))
    io_feat_chunk_stage3_pre = int(max(1, max(int(getattr(args, "feat_chunk", 1) or 1), 2048)))
    io_feat_chunk_stage3_pre = min(io_feat_chunk_stage3_pre, max(1, int(len(pair_meta))))
    stage3_direct_store_pre = stage1_scoring_dir / 'stage3_direct_distances'
    stage3_scratch_source_pre = {
        'kind': 'stage1_scratch',
        'scratch_dir': str(scratch_dir_stage3_pre),
        'io_feat_chunk': int(io_feat_chunk_stage3_pre),
        'nA': int(nA),
        'nB': int(nB),
    }
    if (stage3_direct_store_pre / 'manifest.json').exists() and (stage3_direct_store_pre / 'parts').exists():
        stage3_source_pre = {
            'kind': 'stage1_direct_store',
            'store_dir': str(stage3_direct_store_pre),
            'nA': int(wA_s_pre.size),
            'nB': int(wB_s_pre.size),
            'fallback_source': stage3_scratch_source_pre,
        }
        stage3_source_pre_sig = {
            'direct_store': _content_sig(stage3_direct_store_pre / 'manifest.json'),
            'fallback': 'stage1_scratch',
        }
    else:
        stage3_source_pre = stage3_scratch_source_pre
        stage3_source_pre_sig = {'source': 'stage1_scratch'}
    want3_matrix_pre = {
        'cache_version': _cache_version_sig(STAGE3_CACHE_VERSION),
        'stage': 'selected_weighted_standardized_matrix_v1',
        'stage1_scoring_meta': _content_sig(scoring_meta_path),
        'selected_feature_ids_final': _content_sig(sel_fids_path),
        'stage1_selected_feature_ids_all_auc': _content_sig(selected_feature_ids_path),
        'stage1_auc_frame_mode': str(stage1_auc_frame_mode),
        'stage1_auc_idxA_sig': _array_sig(stage1_auc_idxA),
        'stage1_auc_idxB_sig': _array_sig(stage1_auc_idxB),
        'stage3_materialize_source_kind': str(stage3_source_pre.get('kind')),
        'stage3_materialize_source_sig': stage3_source_pre_sig,
        'weights_A_sig': _array_sig(wA_s_pre),
        'weights_B_sig': _array_sig(wB_s_pre),
        'z_dtype': 'float32',
        'z_shape': [int(stage3_z_shape_pre[0]), int(stage3_z_shape_pre[1])],
        'corr_block_requested': int(corr_block_requested_pre),
        'corr_block_effective': int(block_stage3_pre),
        'corr_dense_max_pairs': int(max(1, int(getattr(args, 'corr_dense_max_pairs', 20000000) or 20000000))),
        'selected_features': int(F_stage3_pre),
        'n_frames': int(n_frames_stage3_pre),
        'seed': int(seed),
    }
    stage3matrix_pre_ok, stage3matrix_pre_state, stage3matrix_pre_reasons = _cache_check_with_reasons(
        required_paths=[(stage3_z_npy_pre, stage3_z_npy_pre.name), (stage3_moments_npz_pre, stage3_moments_npz_pre.name)],
        meta_path=stage3_matrix_meta_pre,
        done_path=stage3_matrix_done_pre,
        want_meta=want3_matrix_pre,
        stage_name='Stage3_selected_matrix',
        validators=[
            ('selected_matrix_npy', lambda: ((stage3_z_npy_pre.exists() and tuple(np.load(stage3_z_npy_pre, mmap_mode='r').shape) == tuple(stage3_z_shape_pre)), f"ok: {stage3_z_npy_pre.name}")),
            ('moments_npz', lambda: ((stage3_moments_npz_pre.exists() and {'mu','inv_std','wa_scale','wb_scale'}.issubset(set(np.load(stage3_moments_npz_pre, mmap_mode='r').files))), f"ok: {stage3_moments_npz_pre.name}")),
        ],
    ) if not force else (False, 'miss', ['forced recompute'])
    if stage3matrix_pre_ok:
        log_skip('Stage3 preparation: selected weighted standardized matrix', f'using cached {stage3_z_npy_pre.name}')
