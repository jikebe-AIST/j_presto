    # ===== 早期スキップ判定（features/weights キャッシュが揃っていれば ensemble I/O 完全回避） =====
    def _features_check(outdir: Path):
        """Validate the reusable feature-definition cache only.

        ``sel_fids.npy`` is deliberately excluded here.  It is a downstream
        Stage1 selection artifact, not part of the candidate-feature definition,
        and may legitimately be absent when no feature survives selection.
        """
        tp, pi = outdir / "top_pairs_pool.csv", outdir / "pair_index.npy"
        meta_path = outdir / FEATURES_META_JSON
        required = [
            (tp, "top_pairs_pool.csv"),
            (pi, "pair_index.npy"),
            (meta_path, FEATURES_META_JSON),
        ]
        present = [p.exists() for p, _ in required]
        if not any(present):
            return None, "first_run", []
        reasons: list[str] = []
        for (path_i, label), exists in zip(required, present):
            if not exists:
                reasons.append(f"missing: {label}")
        if reasons:
            return None, "incomplete", reasons
        try:
            fm = _load_json(meta_path)
            if not isinstance(fm, dict):
                reasons.append(f"invalid JSON: {FEATURES_META_JSON}")
                return None, "miss", reasons

            F_csv = int(_count_csv_data_rows(tp))
            pair_idx = np.load(pi, mmap_mode="r")
            if pair_idx.ndim < 1:
                reasons.append("invalid pair_index.npy: expected at least one dimension")
                return None, "miss", reasons
            F_idx = int(pair_idx.shape[0])
            if F_csv != F_idx:
                reasons.append(f"feature count mismatch: top_pairs_pool.csv={F_csv} pair_index.npy={F_idx}")

            stored_M = fm.get("M")
            if stored_M is not None and int(stored_M) != F_csv:
                reasons.append(f"feature count mismatch: {FEATURES_META_JSON}.M={int(stored_M)} current={F_csv}")

            _refA_cache, _refB_cache = _resolve_refs(args)
            want_sig = dict(_features_signature_for_cache(args, _refA_cache, _refB_cache))
            for k, v in want_sig.items():
                if v is None:
                    continue
                got = fm.get(k)
                if not _cache_equal(got, v):
                    exp_short = _json_canonical_dumps(_json_normalize(_cache_key_normalize(v)))[:160]
                    got_short = _json_canonical_dumps(_json_normalize(_cache_key_normalize(got)))[:160]
                    reasons.append(f"feature signature mismatch at key={k}: expected={exp_short} got={got_short}")

            tp_sig = fm.get("top_pairs_csv_sig")
            if tp_sig is not None and _json_normalize(tp_sig) != _json_normalize(_content_sig(tp)):
                reasons.append("digest mismatch: top_pairs_pool.csv")
            pi_sig = fm.get("pair_index_sig")
            if pi_sig is not None and _json_normalize(pi_sig) != _json_normalize(_content_sig(pi)):
                reasons.append("digest mismatch: pair_index.npy")
            if reasons:
                return None, "miss", reasons
            nA = fm.get("nA")
            nB = fm.get("nB")
            return {
                "top_pairs_csv": str(tp),
                "pair_index": str(pi),
                "nA": int(nA) if nA is not None else None,
                "nB": int(nB) if nB is not None else None,
                "F": int(F_csv),
                "features_meta": fm,
            }, "hit", []
        except Exception as e:
            return None, "miss", [f"exception while validating feature cache: {e}"]

    def _weights_ok(outdir: Path, want_probA: Optional[Path], want_probB: Optional[Path], nA: int, nB: int):
        # weights の整合は weights_A/B.npy + features_meta.json で判定（weights_meta.json は廃止）
        wA, wB = outdir/"weights_A.npy", outdir/"weights_B.npy"
        meta_path = outdir/FEATURES_META_JSON
        if not (wA.exists() and wB.exists() and meta_path.exists()):
            return False
        try:
            meta = _load_json(meta_path)
            if not meta.get("has_weights", False):
                return False
            if int(meta.get("weights_cache_version", -1)) != int(WEIGHTS_CACHE_VERSION):
                return False
            if str(meta.get("cache_namespace", "")) != CACHE_NAMESPACE:
                return False
            if int(meta.get("nA", -1)) != int(nA) or int(meta.get("nB", -1)) != int(nB):
                return False
            if meta.get("weights_A_sig") != _content_sig(wA):
                return False
            if meta.get("weights_B_sig") != _content_sig(wB):
                return False
            src = str(meta.get("weight_source", meta.get("source", "uniform")))
            if src == "uniform":
                return True
            curA = _sha256_file(want_probA) if want_probA else (_sha256_file(want_probB) if want_probB else None)
            curB = _sha256_file(want_probB) if want_probB else (_sha256_file(want_probA) if want_probA else None)
            if curA is not None and meta.get("probA_sha256") != curA:
                return False
            if curB is not None and meta.get("probB_sha256") != curB:
                return False
            return True
        except Exception:
            return False
    # --- 実行開始時点で features が既に存在していたかを記録（ログ制御用） ---
    _had_features_before_run = (_features_check(outdirP)[0] is not None)

    fmeta, _fstate_pre, _freasons_pre = _features_check(outdirP)
    if (fmeta is not None):
        # weights が揃っていれば .prob を読まずに学習へ直行（高速パス）
        want_probA = args.probA if args.probA else args.prob
        want_probB = args.probB if args.probB else args.prob
        if (_weights_ok(outdirP, want_probA, want_probB, fmeta["nA"], fmeta["nB"])):
            log_skip("Assign weights", "using cached weights_A.npy/weights_B.npy (prob unchanged)")
            log_skip("Read PROB", "skipped (weights cache hit)")
        else:
            # weights が無い/不一致: ヘッダだけ読んで .prob → 重み作成 → 保存（以後は .prob を読まずに済む）
            # （coords は一切読まず、I/O コスト最小化）
            with SectionTimer("Precompute weights cache from PROB headers-only", enabled=True):
                try:
                    nA = int(fmeta["nA"])
                    nB = int(fmeta["nB"])
                    wA = np.ones(nA, dtype=np.float64); wB = np.ones(nB, dtype=np.float64)
                    probA_path = args.probA if args.probA is not None else args.prob
                    probB_path = args.probB if args.probB is not None else args.prob
                    # This early weights-cache path runs before the main atom-selection setup.
                    # Resolve reference atom counts locally so cached-feature runs with
                    # missing/stale weights do not fail with undefined natomA/natomB.
                    if 'natomA' not in locals() or 'natomB' not in locals():
                        _refA_pre, _refB_pre = _resolve_refs(args)
                        natomA = natom_from_pdb(_refA_pre) if _refA_pre else None
                        natomB = natom_from_pdb(_refB_pre) if _refB_pre else None
                    if probA_path:
                        headersA = load_ensemble_with_headers(args.ensembleA, natomA, sel_idx=np.empty((0,),dtype=np.int32), frame_stride=int(getattr(args,'frame_stride',0) or 0), cache_base=Path(args.outdir))[2]
                        probA = read_prob_file(Path(probA_path).resolve())
                        wA = assign_weights_from_prob(headersA, probA)
                    if probB_path:
                        headersB = load_ensemble_with_headers(args.ensembleB, natomB, sel_idx=np.empty((0,),dtype=np.int32), frame_stride=int(getattr(args,'frame_stride',0) or 0), cache_base=Path(args.outdir))[2]
                        probB = read_prob_file(Path(probB_path).resolve())
                        wB = assign_weights_from_prob(headersB, probB)
                    # 正規化して保存 + features_meta.json に統合
                    weight_src = "uniform" if not (probA_path or probB_path) else "prob"
                    _save_weights_cache(outdirP, wA, wB, args, weight_source=weight_src)
                    # 既存の features_meta を補完（存在していなければ作成）
                    _merge_update_features_meta(
                        outdirP,
                        top_pairs_csv=str(Path(fmeta["top_pairs_csv"]).resolve()),
                        pair_index=str(Path(fmeta["pair_index"]).resolve()),
                    )
                    log_stage("Saved weights after headers-only pass -> train now (skip PROB next time).")
                except Exception as e:
                    print(f"[WARN] Failed to precompute weights cache from PROB headers-only path: {e}", file=sys.stderr)
                    return

    # ---- atom_spec の必須チェック ----
    if not (args.atom_spec or (args.atom_specA and args.atom_specB)):
        raise SystemExit("Error: Please provide --atom-spec (common) OR both --atom-specA and --atom-specB.")

    specA = args.atom_specA if args.atom_specA else args.atom_spec
    specB = args.atom_specB if args.atom_specB else args.atom_spec

    # 参照PDBは -rA/-rB/-r でのみ与える（.list は参照に使わない）
    # main() 内の後続経路（features cache / headers-only weights / full I/O）で
    # natomA/natomB, atomsA/atomsB, refA_path/refB_path を共通に使うため、
    # ここで先に必ず解決しておく。
    refA_path, refB_path = _resolve_refs(args)
    _audit_require(refA_path is not None and refB_path is not None, "main() failed to resolve reference PDB paths")
    pdbA0 = refA_path.resolve()
    pdbB0 = refB_path.resolve()
    atomsA = load_pdb_atoms_one(pdbA0)
    atomsB = load_pdb_atoms_one(pdbB0)
    natomA = int(len(atomsA))
    natomB = int(len(atomsB))

    # Equivalent atoms are detected before atom_specifier is finalized.  In
    # aggregate mode, atom selection is then expanded so that partially selected
    # equivalent groups do not create asymmetric feature definitions.
    equiv_mode = _equiv_mode(args)
    tpl_common_for_equiv = getattr(args, 'tpl', None)
    tplA_for_equiv = getattr(args, 'tplA', None) or tpl_common_for_equiv
    tplB_for_equiv = getattr(args, 'tplB', None) or tpl_common_for_equiv
    equiv_debug_specs = _equiv_parse_debug_residue_specs(getattr(args, 'equiv_debug_residue', []))
    equiv_debug_outdir = Path(args.outdir).resolve() if equiv_debug_specs else None
    equivA = _build_equiv_context_for_side(atomsA, tpl_path=Path(tplA_for_equiv).resolve() if tplA_for_equiv is not None else None, equiv_map=getattr(args, 'equiv_map', None), mode=equiv_mode, verbose=_is_verbose(args), debug_residue_specs=equiv_debug_specs, debug_outdir=equiv_debug_outdir, debug_side_label='A')
    equivB = _build_equiv_context_for_side(atomsB, tpl_path=Path(tplB_for_equiv).resolve() if tplB_for_equiv is not None else None, equiv_map=getattr(args, 'equiv_map', None), mode=equiv_mode, verbose=_is_verbose(args), debug_residue_specs=equiv_debug_specs, debug_outdir=equiv_debug_outdir, debug_side_label='B')
    if _is_verbose(args) or equiv_mode == 'aggregate':
        log_info(f"Equivalent atom detection: mode={equiv_mode} A_groups_total={len(equivA.members_by_group)} B_groups_total={len(equivB.members_by_group)} details will be written after atom selection")

    maskA = eval_atom_specifier(specA, atomsA)
    maskB = eval_atom_specifier(specB, atomsB)
    if equiv_mode == 'aggregate' and bool(getattr(args, 'equiv_expand_selection', True)):
        maskA = _expand_selection_for_equiv(maskA, equivA, atomsA, label='A', enabled=True)
        maskB = _expand_selection_for_equiv(maskB, equivB, atomsB, label='B', enabled=True)
    sel_idxA = np.where(maskA)[0]
    sel_idxB = np.where(maskB)[0]
    if sel_idxA.size == 0 or sel_idxB.size == 0:
        raise SystemExit(f"[atom-spec] Selection is empty (A:{sel_idxA.size}, B:{sel_idxB.size})")
    if sel_idxA.size != sel_idxB.size:
        raise SystemExit(f"[atom-spec] Selected atom counts differ: A={sel_idxA.size}, B={sel_idxB.size}")
    elemA = [atomsA[i].elem for i in sel_idxA]
    elemB = [atomsB[i].elem for i in sel_idxB]
    mism = [k for k,(ea,eb) in enumerate(zip(elemA, elemB)) if ea != eb]
    if mism:
        print("[ERROR] atom_spec element sequence mismatch between A and B:", file=sys.stderr)
        for k in mism[:50]:
            ia = sel_idxA[k]; ib = sel_idxB[k]
            a = atomsA[ia]; b = atomsB[ib]
            print(f"  i={k+1}: A(idx1={a.idx1}, name={a.name}, res={a.resname}{a.resid}, elem={a.elem})"
                  f"  vs  B(idx1={b.idx1}, name={b.name}, res={b.resname}{b.resid}, elem={b.elem})", file=sys.stderr)
        raise SystemExit(f"[atom-spec] Element mismatch at {len(mism)} positions (first shown above).")
    natom_sel = sel_idxA.size
    _name_or_res_mism = [k for k, (ia, ib) in enumerate(zip(sel_idxA, sel_idxB))
                         if (atomsA[int(ia)].name != atomsB[int(ib)].name) or
                            (atomsA[int(ia)].resname != atomsB[int(ib)].resname)]

    # Order-based A/B mapping is intentional for mutation/insertion/deletion comparisons.
    # Always write diagnostics so the actual correspondence can be audited later.
    try:
        _map_diag = _write_atom_mapping_diagnostics(outdirP, atomsA, sel_idxA, atomsB, sel_idxB)
        log_info(
            "A/B atom mapping diagnostics: "
            f"mapping_mode=order selected_atoms={_map_diag.get('selected_atoms')} "
            f"element_mismatches={_map_diag.get('element_mismatches')} "
            f"atom_name_mismatches={_map_diag.get('atom_name_mismatches')} "
            f"residue_name_mismatches={_map_diag.get('resname_mismatches')} "
            f"residue_id_mismatches={_map_diag.get('resid_mismatches')} "
            f"chain_id_mismatches={_map_diag.get('chain_mismatches')} "
            f"mapping_table={_map_diag.get('mapping_table')}"
        )
    except Exception as e:
        log_warn(f"A/B atom mapping diagnostics failed; continuing without mapping CSV/PDB: {e}")
    try:
        for _lbl, _atoms in [('A', atomsA), ('B', atomsB)]:
            _geom = _write_reference_geometry_diagnostics(outdirP, _lbl, _atoms)
            log_info(
                f"Reference geometry sanity [{_lbl}]: checked_pairs={_geom.get('checked_pairs')} "
                f"trans={_geom.get('trans')} cis={_geom.get('cis')} twisted={_geom.get('twisted')} "
                f"chain_break={_geom.get('chain_break')} csv={_geom.get('csv')}"
            )
            if int(_geom.get('n_anomalies', 0)) > 0:
                for _a in _geom.get('anomalies', [])[:5]:
                    log_warn(
                        f"Reference geometry anomaly [{_lbl}]: chain={_a.get('chain')} residues={_a.get('res1')}-{_a.get('res2')} "
                        f"{_a.get('resname1')}-{_a.get('resname2')} omega={_a.get('omega_deg')} CA-CA={_a.get('ca_ca_distance')} class={_a.get('class')} note={_a.get('note')}"
                    )
    except Exception as e:
        log_warn(f"Reference geometry sanity check failed; continuing: {e}")

    # Equivalence detection uses the complete PDB/TPL mapping before atom_specifier
    # so that chemical connectivity is not truncated.  User-facing diagnostics
    # are written only after atom selection and equivalence-based selection
    # expansion, so water, ions, excluded ligands/peptides, and omitted hydrogens
    # do not flood the output.
    _write_equiv_atom_groups(outdirP, equivA, equivB, selected_idxA=sel_idxA, selected_idxB=sel_idxB)
    if _is_verbose(args) or equiv_mode == 'aggregate':
        _selA_groups = len({int(equivA.group_by_global[int(i)]) for i in sel_idxA.tolist() if 0 <= int(i) < equivA.group_by_global.size and int(equivA.group_by_global[int(i)]) >= 0})
        _selB_groups = len({int(equivB.group_by_global[int(i)]) for i in sel_idxB.tolist() if 0 <= int(i) < equivB.group_by_global.size and int(equivB.group_by_global[int(i)]) >= 0})
        log_info(f"Equivalent atom selected diagnostics: A_selected_groups={_selA_groups} B_selected_groups={_selB_groups} details={(outdirP/'equiv_atom_groups.csv').name}")
    if bool(getattr(args, 'equiv_debug_exit', False)):
        log_info("Equivalent atom debug exit requested; stopping after equivalence, atom-mapping, and reference diagnostics")
        return

    # ---------- EARLY fast-path when features/meta are consistent ----------
    # If all feature artifacts exist & match, skip heavy A/B I/O entirely.
    def _features_consistent(outdir: Path, want_K: int | None = None):
        if args is not None and getattr(args, 'force_recompute_features', False):
            return None, 'miss', ['force_recompute_features=True']
        cached, state, reasons = _features_check(outdir)
        if cached is None:
            return None, state, reasons
        if want_K is not None and int(cached.get('F', -1)) != int(want_K):
            return None, 'miss', [f"cached feature count mismatch: expected K={int(want_K)} got {int(cached.get('F', -1))}"]
        return cached, 'hit', []

    # 早期スキップ判定：features が整合していれば重いI/Oを完全回避
    SKIP_HEAVY_IO = False
    _early_meta, _early_state, _early_reasons = _features_consistent(outdirP, want_K=None)
    if _early_meta is not None and not dist_plot_requested and not repr_requested:
        log_skip("features", "Features detected & consistent; use existing for training")
        log_skip("Load ensembles", "skipped (features cache hit)")
        log_skip("Collect contact pairs (near/long)", "skipped (features cache hit)")
        log_skip("Build features arrays", "skipped (features cache hit)")
        SKIP_HEAVY_IO = True
    elif _early_meta is not None and (dist_plot_requested or repr_requested):
        log_info("dist-plot/representative extraction requested: features-cache fast path is disabled; loading ensembles for direct plotting or PDB extraction.")
    elif _early_state != 'first_run':
        kind = 'incomplete cache' if _early_state == 'incomplete' else 'cache miss'
        log_recalc('features', kind)
        for msg in _early_reasons:
            log_why(msg)

    if not SKIP_HEAVY_IO:
        # --- Residue mapping (atom -> residue) ---
        # Needed for long-pair exclusion by near contacts; must exist regardless of caching paths.
        res_keysA, res_of_atomA = _build_residue_keys_and_map(atomsA, sel_idxA)
        res_keysB, res_of_atomB = _build_residue_keys_and_map(atomsB, sel_idxB)
        _assert_residue_alignment(res_keysA, res_keysB, verbose=_is_verbose(args))
        n_res = int(len(res_keysA))

        # 対応表（A/Bの原子対応）の出力制御
        log_info(f"atom-spec selection: A={sel_idxA.size} atoms, B={sel_idxB.size} atoms (elements match; order-based A↔B mapping).")
        if _is_verbose(args):
            log_info(f"Mapping (i: A -> B):")
            for i,(ia,ib) in enumerate(zip(sel_idxA, sel_idxB), start=1):
                a = atomsA[ia]; b = atomsB[ib]
                print(f"  {i:4d}: A[{a.idx1}:{a.name}:{a.resname}{a.resid}:{a.elem}]"
                      f"  <->  B[{b.idx1}:{b.name}:{b.resname}{b.resid}:{b.elem}]", file=sys.stderr)
        natom_sel = sel_idxA.size

        def show(label: str, natom: int, frames: np.ndarray, counts: list[tuple[Path,int,tuple[int,int]]]):
            print(f"[{label}] natom(selected)={natom}, frames={frames.shape[0]}")
            for p, used, (ist, ien) in counts:
                print(f"  {p} : used {used} frames (range {ist}-{ien})")
            mn, mx = quick_bbox(frames)
            print(f"  quick bbox over first {min(3, frames.shape[0])} frames: min={mn}, max={mx}\n")

        # === near-pair union (true streaming; before full trajectory materialization) ===
        perm_B_of_A = build_perm_B_of_A(atomsA, sel_idxA, atomsB, sel_idxB)
        if len(np.unique(perm_B_of_A)) != perm_B_of_A.size:
            raise RuntimeError("[MAPPING] A->B mapping has duplicates (non-bijective).")
        pairs_seen = None
        # ---- effective prob paths (side-specific overrides common) ----
        probA_path = args.probA if args.probA is not None else args.prob
        probB_path = args.probB if args.probB is not None else args.prob
        if args.prob and (args.probA or args.probB):
            # 片側にだけ個別指定があっても動作はしますが、意図の明確化のため情報表示
            log_info("--prob is provided; side-specific --probA/--probB override on the given side(s).")

        # Positive-weight masks are needed only when the near-pair candidates
        # themselves must be generated.  The cache key is derived from the
        # ensemble/probability inputs, so a valid cache can be checked before
        # rereading PROB headers and constructing the masks.
        near_keep_maskA = None
        near_keep_maskB = None
        near_wA_raw_norm = None
        near_wB_raw_norm = None

        if not (repr_requested or dist_plot_requested):
            _info(f"Extracting contact pairs (dc={args.contact_distance:.3g} Å) over positive-weight frames of A and B ...")
            cache_d = _cache_dir(args.outdir) if _accel_enabled(args) else None
            cache_key_parts_v1 = [
                b'near_pairs_positive_weight_only_v1_input_signature',
                str(args.ensembleA).encode(), str(args.ensembleB).encode(),
                _json_canonical_dumps(_json_normalize(_ensemble_source_bundle_sig(getattr(args, 'ensembleA', None)))).encode(),
                _json_canonical_dumps(_json_normalize(_ensemble_source_bundle_sig(getattr(args, 'ensembleB', None)))).encode(),
                str(args.atom_spec).encode(), str(args.atom_specA or '').encode(), str(args.atom_specB or '').encode(),
                str(args.contact_distance).encode(),
                sel_idxA.tobytes(), sel_idxB.tobytes(),
                perm_B_of_A.tobytes(),
                str(int(getattr(args, 'frame_stride', 0) or 0)).encode(),
                (str(Path(probA_path).resolve()).encode() if probA_path is not None else b'none'),
                (str(Path(probB_path).resolve()).encode() if probB_path is not None else b'none'),
                (_sha256_file(Path(probA_path)).encode() if probA_path is not None else b'none'),
                (_sha256_file(Path(probB_path)).encode() if probB_path is not None else b'none'),
            ]
            pairs_cache_key_v1 = _sha1_bytes(*cache_key_parts_v1) if _accel_enabled(args) else None
            pairs_cache_path_v1 = os.path.join(cache_d, f"near_pairs_{pairs_cache_key_v1}.npy") if _accel_enabled(args) else None
            if _accel_enabled(args) and pairs_cache_path_v1 and os.path.exists(pairs_cache_path_v1):
                try:
                    arr = np.load(pairs_cache_path_v1, allow_pickle=False)
                    pairs_seen = set(int(v) for v in arr.tolist())
                    _info(f"[cache] near_pairs: hit {pairs_cache_path_v1} (positive-weight mask construction skipped)")
                except Exception:
                    pairs_seen = None

            if pairs_seen is None:
                if (probA_path is not None) or (probB_path is not None):
                    with SectionTimer("Precompute positive-weight masks for near-pair candidates", enabled=True):
                        if probA_path is not None:
                            near_wA_raw_norm, near_keep_maskA, _headersA_near = _weights_and_keep_mask_from_prob_headers(
                                Path(args.ensembleA), natomA, Path(probA_path), frame_stride=int(getattr(args, 'frame_stride', 0) or 0), label='A'
                            )
                            log_info(f"Near-pair candidate mask [A]: raw_frames={int(near_keep_maskA.size)} positive_weight={int(np.count_nonzero(near_keep_maskA))} zero_weight={int(near_keep_maskA.size - np.count_nonzero(near_keep_maskA))}")
                        if probB_path is not None:
                            near_wB_raw_norm, near_keep_maskB, _headersB_near = _weights_and_keep_mask_from_prob_headers(
                                Path(args.ensembleB), natomB, Path(probB_path), frame_stride=int(getattr(args, 'frame_stride', 0) or 0), label='B'
                            )
                            log_info(f"Near-pair candidate mask [B]: raw_frames={int(near_keep_maskB.size)} positive_weight={int(np.count_nonzero(near_keep_maskB))} zero_weight={int(near_keep_maskB.size - np.count_nonzero(near_keep_maskB))}")


            if pairs_seen is None:
                with SectionTimer("Collect contact pairs (near)", enabled=True):
                    pairs_seen = collect_contact_pairs_union_streaming(
                        Path(args.ensembleA), Path(args.ensembleB), natomA, natomB,
                        sel_idxA=sel_idxA, sel_idxB=sel_idxB,
                        perm_B_of_A=perm_B_of_A,
                        dc=args.contact_distance,
                        frame_stride=int(getattr(args, 'frame_stride', 0) or 0),
                        frame_keep_maskA=near_keep_maskA,
                        frame_keep_maskB=near_keep_maskB,
                        progress_interval_sec=float(getattr(args, 'progress_interval_sec', 300.0) or 300.0),
                    )
                    if _accel_enabled(args) and pairs_cache_path_v1:
                        np.save(pairs_cache_path_v1, np.asarray(sorted(pairs_seen), dtype=np.int64))
            print(f"[CONTACT] pairs_total={len(pairs_seen)} (A∪B; indices are 0-based within selected atoms of A)", file=sys.stderr)

        # === 読み込み（進行表示つき） ===
        _info(f"Now reading A (selected atoms only): {args.ensembleA}")
        if probA_path:
            # 重み付与に ep/lambda が必要 → ヘッダ付きで読む（保持は選択原子のみ）
            with SectionTimer("Read Ensemble A", enabled=True):
                framesA, countsA, headersA = load_ensemble_with_headers(args.ensembleA, natomA, sel_idx=sel_idxA, frame_stride=int(getattr(args,'frame_stride',0) or 0), cache_base=Path(args.outdir))
        else:
            with SectionTimer("Read Ensemble A", enabled=True):
                framesA, countsA = load_ensemble(args.ensembleA, natomA, sel_idx=sel_idxA, frame_stride=int(getattr(args,'frame_stride',0) or 0), cache_base=Path(args.outdir))
            headersA = None  # 等重み

        _info(f"Now reading B (selected atoms only): {args.ensembleB}")
        if probB_path:
            with SectionTimer("Read Ensemble B", enabled=True):
                framesB, countsB, headersB = load_ensemble_with_headers(args.ensembleB, natomB, sel_idx=sel_idxB, frame_stride=int(getattr(args,'frame_stride',0) or 0), cache_base=Path(args.outdir))
        else:
            with SectionTimer("Read Ensemble B", enabled=True):
                framesB, countsB = load_ensemble(args.ensembleB, natomB, sel_idx=sel_idxB, frame_stride=int(getattr(args,'frame_stride',0) or 0), cache_base=Path(args.outdir))
            headersB = None

        # === 表示 ===
        show('A', natom_sel, framesA, countsA)
        show('B', natom_sel, framesB, countsB)
        # ensure contiguous float32 arrays for faster kernels (no value change)
        framesA = _ensure_fast_frame_array(framesA, label='A')
        framesB = _ensure_fast_frame_array(framesB, label='B')

        # === 重み割当 ===
        with SectionTimer("Assign weights [A]", enabled=True):
            if probA_path:
                probA = read_prob_file(probA_path.resolve())
                wA = assign_weights_from_prob(headersA, probA)
            else:
                _info("PROB for A not specified: all weights = 1")
                wA = np.ones(framesA.shape[0], dtype=np.float64)
        with SectionTimer("Assign weights [B]", enabled=True):
            if probB_path:
                probB = read_prob_file(probB_path.resolve())
                wB = assign_weights_from_prob(headersB, probB)
            else:
                _info("PROB for B not specified: all weights = 1")
                wB = np.ones(framesB.shape[0], dtype=np.float64)

        # --- normalize weights per side (probability measures) ---
        # Keep a raw-length, normalized weight vector on disk.  Stage1 direct
        # streaming must compare these weights against the unfiltered trajectory
        # frame count, then apply the zero-weight mask while streaming.  Older
        # versions saved the post-filtered weights here, which made reruns fail
        # with a raw frame-count mismatch for ALSD/CED data with many zero-weight
        # frames.
        wA = np.asarray(np.where(wA > 0.0, wA, 0.0), dtype=np.float64)
        wB = np.asarray(np.where(wB > 0.0, wB, 0.0), dtype=np.float64)
        if near_keep_maskA is not None and int(near_keep_maskA.size) != int(wA.size):
            raise RuntimeError(f"near-pair precomputed mask length mismatch for A: mask={int(near_keep_maskA.size)} weights={int(wA.size)}")
        if near_keep_maskB is not None and int(near_keep_maskB.size) != int(wB.size):
            raise RuntimeError(f"near-pair precomputed mask length mismatch for B: mask={int(near_keep_maskB.size)} weights={int(wB.size)}")
        if int(wA.size) != int(framesA.shape[0]) or int(wB.size) != int(framesB.shape[0]):
            raise RuntimeError(f"weight/frame count mismatch in auxiliary mode: A {wA.size}/{framesA.shape[0]}, B {wB.size}/{framesB.shape[0]}")
        sA_raw = float(wA.sum()); sB_raw = float(wB.sum())
        if sA_raw <= 0.0 or sB_raw <= 0.0:
            raise ValueError(f"Non-positive raw weight sum(s): sumA={sA_raw}, sumB={sB_raw}")
        wA_raw_norm = (wA / sA_raw).astype(np.float64, copy=False)
        wB_raw_norm = (wB / sB_raw).astype(np.float64, copy=False)
        aux_keep_A = np.asarray(wA_raw_norm > 0.0, dtype=bool)
        aux_keep_B = np.asarray(wB_raw_norm > 0.0, dtype=bool)
        aux_drop_A = int(wA_raw_norm.size - int(np.count_nonzero(aux_keep_A)))
        aux_drop_B = int(wB_raw_norm.size - int(np.count_nonzero(aux_keep_B)))
        if aux_drop_A or aux_drop_B:
            _info(f"Weight-zero frame filter [aux] A: raw_frames={int(wA_raw_norm.size)} kept={int(np.count_nonzero(aux_keep_A))} dropped_zero_weight={aux_drop_A}")
            _info(f"Weight-zero frame filter [aux] B: raw_frames={int(wB_raw_norm.size)} kept={int(np.count_nonzero(aux_keep_B))} dropped_zero_weight={aux_drop_B}")
            framesA = np.asarray(framesA[aux_keep_A, :, :], dtype=framesA.dtype)
            framesB = np.asarray(framesB[aux_keep_B, :, :], dtype=framesB.dtype)
            wA = np.asarray(wA_raw_norm[aux_keep_A], dtype=np.float64)
            wB = np.asarray(wB_raw_norm[aux_keep_B], dtype=np.float64)
        else:
            _info(f"Weight-zero frame filter [aux]: no zero-weight frames detected A={int(wA_raw_norm.size)} B={int(wB_raw_norm.size)}")
            wA = np.asarray(wA_raw_norm, dtype=np.float64)
            wB = np.asarray(wB_raw_norm, dtype=np.float64)
        _info(f"A frames = {framesA.shape[0]}, sum(weights) = {wA.sum():.6g}")
        _info(f"B frames = {framesB.shape[0]}, sum(weights) = {wB.sum():.6g}")

        # Stage1 TV bins decision (bins by N_eff=min(N_eff,A,N_eff,B))
        try:
            _bins_max = int(getattr(args, "bins_max", 128))
            _bins_min_neff_per_bin = float(getattr(args, "bins_min_neff_per_bin", 30.0) or 0.0)
            bins_tv, neffA, neffB, neff = _stagec_bins_from_weights(wA, wB, _bins_max, _bins_min_neff_per_bin)
            _info(f"Stage1 TV bins: bins={bins_tv} (bins_max={_bins_max}, N_eff_A={neffA:.1f}, N_eff_B={neffB:.1f}, N_eff=min={neff:.1f})")
        except Exception:
            pass

        if repr_requested:
            with SectionTimer("Representative extraction mode", enabled=True):
                _extract_representatives_mode(args=args, outdir=outdirP, countsA=countsA, countsB=countsB, natomA_full=natomA, natomB_full=natomB, refA_path=refA_path, refB_path=refB_path, wA=wA, wB=wB, frame_keep_maskA=aux_keep_A, frame_keep_maskB=aux_keep_B)
            return

        if dist_plot_requested:
            atomsA_sel = [atomsA[i] for i in sel_idxA]
            atomsB_sel = [atomsB[i] for i in sel_idxB]
            with SectionTimer("Dist-plot mode", enabled=True):
                _run_dist_plot_mode(args=args, outdir=outdirP, atomsA_sel=atomsA_sel, atomsB_sel=atomsB_sel, framesA=framesA, framesB=framesB, wA=wA, wB=wB)
            return

        # === 重みキャッシュの保存（仕様準拠：features_meta.json に統合） ===
        # Save RAW-LENGTH normalized weights, including zero-weight frames.
        # Downstream Stage1 applies the zero-weight mask after direct frame counting.
        try:
            _save_weights_cache(outdirP, wA_raw_norm, wB_raw_norm, args)
        except Exception as e:
            print(f"[WARN] failed to save weight cache: {e}", file=sys.stderr)

        # Save normalized raw-length weights for early-skip fast path
        try:
            np.save(os.path.join(args.outdir, "weights_A.npy"), wA_raw_norm.astype(np.float32))
            np.save(os.path.join(args.outdir, "weights_B.npy"), wB_raw_norm.astype(np.float32))
        except Exception:
            pass

        # === 遠距離（残基セントロイド）ペア列挙 ===
        with SectionTimer("Enumerate long-range residue-centroid pairs", enabled=True):
            long_pairs = _enumerate_all_pairs(n_res)
        print(f"[LONG] residues: n={n_res} -> total pairs={len(long_pairs)} (= n*(n-1)/2)", file=sys.stderr)
        if _is_verbose(args) and n_res >= 2:
            # 先頭数組（残基空間のインデックス）を表示
            print("[LONG] first 10 pairs (residue space; A-side labels):", file=sys.stderr)
            for key in long_pairs[:10]:
                i, j = _unpack_pair(key)
                print(f"  ({i},{j}) : A[{res_keysA[i]}] - A[{res_keysA[j]}]", file=sys.stderr)

        okA = np.isfinite(framesA).all()
        okB = np.isfinite(framesB).all()
        if not (okA and okB):
            print('[SELF-CHECK] FAIL: detected NaN/Inf in frames', file=sys.stderr)
            sys.exit(2)
        mna, mxa = quick_bbox(framesA)
        mnb, mxb = quick_bbox(framesB)
        spanA = (mxa - mna).sum()
        spanB = (mxb - mnb).sum()
        if spanA <= 0 or spanB <= 0:
            print('[SELF-CHECK] WARN: zero bbox span (check coordinates)', file=sys.stderr)
        else:
            print('[SELF-CHECK] OK: frames finite and bbox spans look non-zero')

        # ===== features =====
        # ===== features =====
        # 近距離はA基準→Bへ置換して距離を引く（従来通り）
        # NOTE: pairs_seen is already in A selected-atom index space.
        # 近接：packed keys → (i,j) へ（A側基準の“選択インデックス空間”）
        near_pairs_A = np.array([_unpack_pair(k) for k in sorted(pairs_seen)], dtype=np.int32)

        # In aggregate equivalent-atom mode, close the near-feature set over the
        # Cartesian product of selected equivalent endpoint groups before
        # topology filtering.  The raw 1-feature=1-atom-pair representation is
        # kept, but members of the same equivalent atom-pair group are made
        # adjacent and tagged by equiv_group_id for Stage1 mixture distributions.
        equiv_group_id_by_near = np.full((int(near_pairs_A.shape[0]),), -1, dtype=np.int32)
        if _equiv_mode(args) == 'aggregate':
            sel_equiv_groupA, sel_equiv_membersA = _selected_equiv_groups(sel_idxA, equivA)
            near_pairs_A, equiv_group_id_by_near, _eq_near_info = _close_and_sort_near_pairs_by_equiv(
                near_pairs_A, sel_equiv_groupA, sel_equiv_membersA, verbose=True
            )
        # B側用に、A→B対応で写像
        near_pairs_B = np.empty_like(near_pairs_A)
        near_pairs_B[:,0] = perm_B_of_A[near_pairs_A[:,0]]
        near_pairs_B[:,1] = perm_B_of_A[near_pairs_A[:,1]]

        # Near pairs are first collected from selected atoms by distance, then
        # optionally topology-filtered. Long residue-pair exclusion below must
        # use the final topology-filtered near features, not these raw contact
        # candidates, so that contacts removed as 1-2/1-3 bonded relations do
        # not erase the corresponding long feature as well.

        # === Topology-aware filtering of near pairs (optional *.tpl) ===
        if (getattr(args, 'tpl', None) is not None) or (getattr(args, 'tplA', None) is not None) or (getattr(args, 'tplB', None) is not None):
            # Determine tpl for A/B. If only --tpl is given, use it for both.
            tpl_common = getattr(args, 'tpl', None)
            tplA_path = getattr(args, 'tplA', None) or tpl_common
            tplB_path = getattr(args, 'tplB', None) or tpl_common

            # If refA/refB differ and only one side is provided without a common --tpl, warn/abort.
            refA_used = getattr(args, 'refA', None) or getattr(args, 'ref', None)
            refB_used = getattr(args, 'refB', None) or getattr(args, 'ref', None)
            if (refA_used is not None) and (refB_used is not None) and (str(refA_used) != str(refB_used)):
                if (tplA_path is None) and (tplB_path is None):
                    raise SystemExit('[TPL] refA and refB differ, but no --tpl/--tplA/--tplB provided.')
                if (tplA_path is None) or (tplB_path is None):
                    # common case: user should pass both; keep explicit to avoid silent mismatch
                    raise SystemExit('[TPL] refA and refB differ: please provide both --tplA and --tplB (or provide a common --tpl used for both).')

            atoms_selA = [atomsA[i] for i in sel_idxA.tolist()]
            atoms_selB = [atomsB[i] for i in sel_idxB.tolist()]

            keep_masks = []
            desc = []
            ex_up_to = int(getattr(args, 'tpl_exclude_up_to', 2))

            if tplA_path is not None:
                tplA_path = Path(tplA_path).resolve()
                tplA_data = _parse_jpresto_tpl_atoms_bonds(tplA_path)
                keepA = _filter_near_pairs_with_tpl_system(near_pairs_A, atoms_selA, tplA_data, ex_up_to)
                keep_masks.append(keepA)
                desc.append(f"A:{tplA_path.name}")
            if tplB_path is not None:
                tplB_path = Path(tplB_path).resolve()
                tplB_data = _parse_jpresto_tpl_atoms_bonds(tplB_path)
                keepB = _filter_near_pairs_with_tpl_system(near_pairs_B, atoms_selB, tplB_data, ex_up_to)
                keep_masks.append(keepB)
                desc.append(f"B:{tplB_path.name}")

            if keep_masks:
                keep_mask = keep_masks[0]
                for km in keep_masks[1:]:
                    keep_mask = keep_mask & km  # keep only if topology-allowed in BOTH
                n_before = int(near_pairs_A.shape[0])
                near_pairs_A = near_pairs_A[keep_mask]
                near_pairs_B = near_pairs_B[keep_mask]
                if 'equiv_group_id_by_near' in locals() and np.asarray(equiv_group_id_by_near).shape[0] == int(n_before):
                    equiv_group_id_by_near = np.asarray(equiv_group_id_by_near, dtype=np.int32)[keep_mask]
                n_after = int(near_pairs_A.shape[0])
                print(
                    f"[TPL] topology exclusion: graph_source=full_tpl "
                    f"exclude_up_to_bonds={ex_up_to} "
                    f"excluded_relations={_topology_excluded_relations_label(ex_up_to)} "
                    f"near_pairs={n_before}->{n_after} ({', '.join(desc)})",
                    file=sys.stderr,
                    flush=True,
                )

        # === long pairs (residue-centroid): exclude residue pairs covered by final near features ===
        # Use topology-filtered near pairs, not raw 6 Å contact candidates.
        # Raw contacts removed by 1-2/1-3 topology exclusion are not analysis
        # features, so they must not suppress the corresponding long
        # residue-centroid feature.
        near_res_block = _build_near_residue_block_from_final_near_pairs(near_pairs_A, res_of_atomA)

        # cache residue-pair index now depends on near_res_block
        res_keyA_blob = "\n".join(f"{c}:{r}" for (c,r) in res_keysA).encode('utf-8')
        res_keyB_blob = "\n".join(f"{c}:{r}" for (c,r) in res_keysB).encode('utf-8')
        nr_blob = np.array(sorted(near_res_block), dtype=np.int64).tobytes()
        res_key = _sha1_bytes(b'res2', res_keyA_blob, res_keyB_blob, nr_blob) if _accel_enabled(args) else None
        res_cache_path = os.path.join(_cache_dir(args.outdir), f"res_pairs2_{res_key}.npy") if _accel_enabled(args) else None
        res_pairs_idx = None
        if _accel_enabled(args) and res_cache_path and os.path.exists(res_cache_path):
            try:
                res_pairs_idx = np.load(res_cache_path, allow_pickle=False)
            except Exception:
                res_pairs_idx = None
        if res_pairs_idx is None:
            tmp = []
            for k in _enumerate_all_pairs(n_res):
                if k in near_res_block:
                    continue
                tmp.append(_unpack_pair(k))
            res_pairs_idx = np.array(tmp, dtype=np.int32)
            if _accel_enabled(args) and res_cache_path:
                try:
                    np.save(res_cache_path, res_pairs_idx)
                except Exception:
                    pass
        print(f"[LONG] residue pairs after near-exclusion: {int(res_pairs_idx.shape[0])} (blocked_by_near={len(near_res_block)})", file=sys.stderr)
        # --- If pair metadata exists and cache signatures match, skip regenerating feature definitions ---
        meta = None
        outdir = Path(args.outdir)
        featA = None
        featB = None
        pairs_csv = outdir / 'top_pairs_pool.csv'
        pair_idx_path = outdir / 'pair_index.npy'
        meta_path = outdir / FEATURES_META_JSON
        ok = pairs_csv.exists() and pair_idx_path.exists() and meta_path.exists()
        M_cached = None
        if ok:
            try:
                M_cached = int(_count_csv_data_rows(pairs_csv))
                pair_idx = np.load(pair_idx_path, mmap_mode='r')
                ok = int(pair_idx.shape[0]) == int(M_cached)
            except Exception:
                ok = False

        if ok:
            mapping_sig = _atom_selection_mapping_signature(atomsA, atomsB, sel_idxA, sel_idxB, res_keysA, res_keysB)
            try:
                fm = _load_json(meta_path)
                want_sig = _metadata_signature_payload(
                    args=args,
                    refA_path=refA_path,
                    refB_path=refB_path,
                    extra={
                        **mapping_sig,
                        "K_near": int(near_pairs_A.shape[0]),
                        "L_long": int(res_pairs_idx.shape[0]),
                        "feature_generation_mode": "metadata-only",
                    },
                )
                for k, v in want_sig.items():
                    if v is None:
                        continue
                    if _json_normalize(fm.get(k)) != _json_normalize(v):
                        ok = False
                        break
            except Exception:
                ok = False
        if ok:
            meta = {
                "top_pairs_csv": str(pairs_csv.resolve()),
                "pair_index": str(pair_idx_path.resolve()),
            }
            if _had_features_before_run:
                log_skip("Feature definition", "using existing cached top_pairs_pool.csv/pair_index.npy (signature match)")

            mapping_sig = _atom_selection_mapping_signature(atomsA, atomsB, sel_idxA, sel_idxB, res_keysA, res_keysB)
            update = _metadata_signature_payload(
                args=args,
                refA_path=refA_path,
                refB_path=refB_path,
                extra={
                    "M": int(M_cached),
                    "top_pairs_csv_sig": _content_sig(pairs_csv),
                    "pair_index_sig": _content_sig(pair_idx_path),
                    "source_features_A": _streaming_direct_source_sig(),
                    "source_features_B": _streaming_direct_source_sig(),
                    **mapping_sig,
                    "K_near": int(near_pairs_A.shape[0]),
                    "L_long": int(res_pairs_idx.shape[0]),
                    "feature_generation_mode": "metadata-only",
                },
            )
            _merge_update_features_meta(outdirP, **update)
            _read_features_meta_checked(
                outdirP,
                required_keys=(
                    "top_pairs_csv", "pair_index", "source_features_A", "source_features_B",
                    "listA_sha256", "listB_sha256", "ensembleA_sources_sig", "ensembleB_sources_sig",
                    "refA_sha256", "refB_sha256", "atom_spec", "contact_distance",
                    "features_cache_version", "feature_definition_version", "pair_index_version",
                ),
                context="reuse_feature_definition",
            )
        if meta is None:
            meta = write_feature_metadata_only_v1(
                near_pairs_A,
                res_pairs_idx,
                res_of_atomA,
                # Store RAW frame counts in features_meta.  The selected-feature
                # artifacts are defined over the raw trajectory index space; zero-weight
                # frames are removed later through weights_A/B masks.  Using filtered
                # frame counts here makes features_meta disagree with raw-length
                # weights_A/B.npy on reruns.
                nA=int(wA_raw_norm.size),
                nB=int(wB_raw_norm.size),
                atoms_selA=atoms_selA,
                outdir=str(outdirP),
                args=args,
                equiv_group_id_by_near=(equiv_group_id_by_near if 'equiv_group_id_by_near' in locals() else None),
            )
            _merge_update_features_meta(
                outdirP,
                **_atom_selection_mapping_signature(atomsA, atomsB, sel_idxA, sel_idxB, res_keysA, res_keysB),
                K_near=int(near_pairs_A.shape[0]),
                L_long=int(res_pairs_idx.shape[0]),
                raw_nA=int(wA_raw_norm.size),
                raw_nB=int(wB_raw_norm.size),
                kept_nA=int(framesA.shape[0]),
                kept_nB=int(framesB.shape[0]),
                feature_generation_mode="metadata-only",
            )

        log_info(f"Pairs CSV: {meta['top_pairs_csv']}")
        log_info("Features  : not materialized (full features are disabled; selected features are streamed from scratch)")
        log_info(f"PairIndex : {meta['pair_index']}")


    # =========================
    # DISTIL public v1 pipeline
    # =========================
    # Ensure `meta` exists even when the early fast-path skipped heavy I/O.
    if 'meta' not in locals() or meta is None:
        if '_early_meta' in locals() and _early_meta is not None:
            meta = _early_meta
        else:
            base = Path(args.outdir)
            meta = {
                'top_pairs_csv': str((base / 'top_pairs_pool.csv').resolve()),
                'pair_index': str((base / 'pair_index.npy').resolve()),
                'sel_fids': str((base / SEL_FIDS_NPY).resolve()),
            }

    run_distil_pipeline(Path(args.outdir), args, meta=meta)
    _elapsed_run = time.perf_counter() - _t0_run
    _write_analysis_summary(Path(args.outdir), args, elapsed_seconds=_elapsed_run)
    _write_run_provenance(Path(args.outdir), args, requested_args=_requested_args_dict, status='completed', elapsed_seconds=_elapsed_run)
    return
if __name__ == '__main__':
    _t0_total = time.perf_counter()
    _ok = False
    _show_footer = True
    try:
        main()
        _ok = True
    except SystemExit as e:
        code = e.code
        if code in (0, None):
            _ok = True
            _show_footer = False
        raise
    finally:
        if _show_footer:
            _dt = time.perf_counter() - _t0_total
            try:
                secs = float(_dt)
                msg = f"[SUMMARY] Total elapsed {secs:.2f} s"
            except Exception:
                msg = f"[SUMMARY] Total elapsed { _dt } s"
            print(_apply_log_prefix(msg), file=sys.stderr, flush=True)
            if _ok:
                print("\n+++ Program j_presto DISTIL normally ended +++")
            else:
                print("\n!!! Program j_presto DISTIL ended with error !!!", file=sys.stderr, flush=True)
