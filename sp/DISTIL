            def _metric_value_for_atom_pdb(pm: dict, fs_m, metric: str) -> float:
                """Return the per-feature value embedded into PDB B-factor fields.

                Stage5 metric PDBs are limited to Stage5-defined metrics. Stage1 p/q/TV/AUC maps are written by Stage1 metric PDBs.
                """
                metric = str(metric)
                if metric in ('bfactor', 'contribution', 'contribution_multi'):
                    val = float(pm.get('contribution_multi', float(getattr(fs_m, 'tv', 0.0))))
                elif metric in ('occupancy', 'auc', 'auc_single'):
                    val = float(pm.get('auc_single', float('nan')))
                elif metric in ('tv', 'tv_c'):
                    val = float(pm.get('tv_c', float(getattr(fs_m, 'tv', float('nan')))))
                elif metric == 'coef_abs':
                    val = abs(float(pm.get('coef_multi', 0.0)))
                elif metric == 'feature_std':
                    val = float(pm.get('feature_std', 0.0))
                elif metric == 'selected_by_model':
                    val = float(int(pm.get('multivar_selected', 0) or 0))
                elif metric == 'sig_strength':
                    val = float(getattr(fs_m, 'sig_strength', 0.0))
                elif metric == 'sig_area':
                    val = float(getattr(fs_m, 'sig_area', 0.0))
                elif metric in ('sig_logpmax', 'sig_logp_max'):
                    val = float(getattr(fs_m, 'sig_logpmax', 0.0))
                elif metric in ('ced_effect_score', 'condition_effect_score'):
                    val = float(getattr(fs_m, 'ced_effect_score', 0.0))
                elif metric == 'ced_between_tv':
                    val = float(getattr(fs_m, 'ced_between_tv', 0.0))
                elif metric == 'ced_r_effect':
                    val = float(getattr(fs_m, 'ced_r_effect', 0.0))
                elif metric == 'ced_z_effect':
                    val = float(getattr(fs_m, 'ced_z_effect', 0.0))
                elif metric == 'ced_r_null':
                    val = float(getattr(fs_m, 'ced_r_null', 0.0))
                elif metric == 'ced_z_null':
                    val = float(getattr(fs_m, 'ced_z_null', 0.0))
                else:
                    raise ValueError(f"Unknown atom metric: {metric}")
                if not np.isfinite(val):
                    return 0.0
                return float(max(0.0, val))

            def _accumulate_bundle_atom_values(mem_fids: Sequence[int], metric: str) -> np.ndarray:
                score_atoms = np.zeros((len(atoms_sel),), dtype=np.float64)
                for fid_m in mem_fids:
                    fid_m = int(fid_m)
                    fs_m = feats_by_fid.get(fid_m)
                    if fs_m is None:
                        continue
                    pm = pair_metrics_by_fid.get(fid_m, {})
                    w = _metric_value_for_atom_pdb(pm, fs_m, metric)
                    if not (w > 0.0 and np.isfinite(w)):
                        continue
                    try:
                        kind_m = int(pair_meta.kind[fid_m])
                    except Exception:
                        kind_m = 1
                    if kind_m == 0:
                        ai = int(pair_meta.atom_i[fid_m])
                        aj = int(pair_meta.atom_j[fid_m])
                        if 0 <= ai < len(atoms_sel) and w > score_atoms[ai]:
                            score_atoms[ai] = w
                        if 0 <= aj < len(atoms_sel) and w > score_atoms[aj]:
                            score_atoms[aj] = w
                    else:
                        ri = int(_meta_res(pair_meta, fid_m, "i"))
                        rj = int(_meta_res(pair_meta, fid_m, "j"))
                        if 0 <= ri < len(atoms_by_res):
                            for ak in atoms_by_res[ri]:
                                if w > score_atoms[ak]:
                                    score_atoms[ak] = w
                        if 0 <= rj < len(atoms_by_res):
                            for ak in atoms_by_res[rj]:
                                if w > score_atoms[ak]:
                                    score_atoms[ak] = w
                return score_atoms

            # Stage5 metric PDBs are intentionally limited to metrics that are
            # only defined after the multivariate contribution/ranking stage.
            # Stage1 metrics (TV) and Stage1-available
            # AUC maps are written once by _write_stage1_metric_pdbs() using
            # all features whenever available.  Re-emitting them here over only
            # ranked-bundle members would create confusing subset maps.
            pdb_metric_specs = [
                ('contribution', 'contribution_multi'),
                ('coef_abs', 'abs_coef_multi'),
                ('feature_std', 'single_pair_score_std'),
            ]
            if str(stage5_region_weight_mode) == 'sig_strength':
                pdb_metric_specs.extend([
                    ('sig_strength', 'run_bin_significance_strength'),
                    ('sig_area', 'run_bin_significant_area'),
                    ('sig_logpmax', 'max_minus_log10_p_on_significant_bins'),
                ])
            elif str(stage5_region_weight_mode) == 'ced_effect_score':
                pdb_metric_specs.extend([
                    ('ced_effect_score', 'condition_effect_score_for_CED_ranking'),
                    ('ced_between_tv', 'CED_observed_between_condition_TV'),
                    ('ced_r_effect', 'CED_observed_over_within_run_split_ratio'),
                    ('ced_z_effect', 'CED_observed_over_within_run_split_z_score'),
                    ('ced_r_null', 'CED_observed_over_pooled_label_null_ratio'),
                    ('ced_z_null', 'CED_observed_over_pooled_label_null_z_score'),
                ])

            def _write_metric_specific_pdbs(prefix: str, mem_fids: Sequence[int]) -> None:
                meta_update = {}
                for metric_key, metric_desc in pdb_metric_specs:
                    metric_atoms = _accumulate_bundle_atom_values(mem_fids, metric_key)
                    out_metric_pdb = pdb_dir / f"{prefix}_metric_{metric_key}.pdb"
                    _write_scored_pdb(out_metric_pdb, metric_atoms, np.zeros_like(metric_atoms, dtype=np.float64))
                    meta_update[out_metric_pdb.name] = {
                        'stage': 'Stage5',
                        'source': 'ranked bundle member features',
                        'source_features': 'ranked_bundle_member_features',
                        'field': metric_desc,
                        'bfactor': metric_desc,
                        'direction': 'larger_is_stronger',
                        'aggregation_to_atom': 'max',
                        'missing_bfactor': 0.0,
                        'n_features_used': int(len(mem_fids)),
                        'occupancy': 0.0,
                    }
                try:
                    metric_json = pdb_dir / 'metric_pdbs.json'
                    old_meta = _load_json(metric_json) if metric_json.exists() else {}
                    if not isinstance(old_meta, dict):
                        old_meta = {}
                    old_meta.update(meta_update)
                    _write_json_atomic(metric_json, old_meta)
                except Exception as e:
                    log_warn(f"Stage5 metric PDB: could not update metric_pdbs.json: {e}")
                if _log_enabled('info'):
                    log_info(
                        f"[Stage5] ranked-bundle metric PDBs: source=ranked_bundle_member_features "
                        f"metrics={','.join(k for k, _d in pdb_metric_specs)}; "
                        f"Stage1 metrics tv and auc are not re-emitted here"
                    )

            def _normalize_score_atoms(score_atoms_raw: np.ndarray) -> np.ndarray:
                score_atoms = np.asarray(score_atoms_raw, dtype=np.float64)
                mmax = float(np.max(score_atoms)) if score_atoms.size else 0.0
                if mmax > 0.0 and np.isfinite(mmax):
                    return score_atoms / mmax
                return np.zeros_like(score_atoms)

            def _write_scored_pdb(out_pdb: Path, score_atoms_bfactor: np.ndarray, score_atoms_occupancy: np.ndarray) -> None:
                atom_counter = -1
                with open(out_pdb, "w", encoding="utf-8") as fo:
                    for line in ref_lines:
                        sline = line.lstrip(" 	")
                        rec = _pdb_rec_name(sline)
                        if not (rec == "ATOM" or rec == "HETATM"):
                            fo.write(line)
                            continue
                        atom_counter += 1
                        val_b = 0.0
                        val_o = 0.0
                        if 0 <= atom_counter < len(full_to_sel):
                            k = int(full_to_sel[atom_counter])
                            if 0 <= k < len(score_atoms_bfactor):
                                val_b = float(score_atoms_bfactor[k])
                            if 0 <= k < len(score_atoms_occupancy):
                                val_o = float(score_atoms_occupancy[k])
                        line2 = line.rstrip("\n")
                        if len(line2) < 80:
                            line2 = line2.ljust(80)
                        if not np.isfinite(val_o):
                            val_o = 0.0
                        if not np.isfinite(val_b):
                            val_b = 0.0
                        val_o = min(max(float(val_o), 0.0), 999.99)
                        val_b = min(max(float(val_b), 0.0), 999.99)
                        line2 = line2[:54] + f"{val_o:6.2f}" + line2[60:]
                        line2 = line2[:60] + f"{val_b:6.2f}" + line2[66:]
                        fo.write(line2 + "\n")
            # Histogram vectors (delta/pA) are no longer cached in FeatureStat.
            # For the (user-limited) top-N plot output, compute histograms directly
            # from Stage1 scratch selected-feature source with weights.
            # Stage5 representative-distance plots must use the same frame set
            # as Stage1/Stage3.  weights_A/B.npy may be the raw pre-filter cache
            # when zero-weight frames were removed at runtime, so do not reload it
            # here.  Use the already filtered in-memory weights instead.
            wA_m = np.asarray(wA, dtype=np.float64)
            wB_m = np.asarray(wB, dtype=np.float64)

            _plot_run_ids_cache = {'ready': False, 'A': None, 'B': None, 'nA': 1, 'nB': 1}

            def _get_plot_run_ids_for_errorbars() -> tuple[np.ndarray | None, np.ndarray | None, int, int]:
                """Return frame-level run ids for optional Stage5 plot error bands.

                This is intentionally computed lazily so standard mode keeps its previous
                lightweight plotting behavior unless -pre/--plot-run-errorbars is used.
                Sig mode normally reads precomputed run-bin histograms from Stage1; this
                helper is only a fallback if those files are absent.
                """
                if bool(_plot_run_ids_cache.get('ready')):
                    return (_plot_run_ids_cache.get('A'), _plot_run_ids_cache.get('B'), int(_plot_run_ids_cache.get('nA', 1)), int(_plot_run_ids_cache.get('nB', 1)))
                _plot_run_ids_cache['ready'] = True
                try:
                    ctx = _prepare_direct_pass_runtime(args)
                    rA, nrA, _hA, _sA = _ensemble_run_ids(Path(args.ensembleA), int(ctx['natomA']), sel_idx=ctx['sel_idxA'], frame_stride=int(getattr(args, 'frame_stride', 0) or 0))
                    rB, nrB, _hB, _sB = _ensemble_run_ids(Path(args.ensembleB), int(ctx['natomB']), sel_idx=ctx['sel_idxB'], frame_stride=int(getattr(args, 'frame_stride', 0) or 0))
                    rA = np.asarray(rA, dtype=np.int32)
                    rB = np.asarray(rB, dtype=np.int32)
                    # Keep run IDs aligned with the zero-weight-filtered frame set
                    # used by Stage1/Stage3 and the Stage5 plot histograms.
                    try:
                        if 'frame_keep_maskA' in locals() and int(rA.size) == int(np.asarray(frame_keep_maskA).size):
                            rA = rA[np.asarray(frame_keep_maskA, dtype=bool)]
                        if 'frame_keep_maskB' in locals() and int(rB.size) == int(np.asarray(frame_keep_maskB).size):
                            rB = rB[np.asarray(frame_keep_maskB, dtype=bool)]
                    except Exception:
                        pass
                    if rA.size != wA_m.size or rB.size != wB_m.size:
                        log_info(f"[WARN ] plot run-errorbars unavailable: run_id length mismatch A={rA.size}/{wA_m.size} B={rB.size}/{wB_m.size}; falling back to ordinary plots")
                        return None, None, 1, 1
                    _plot_run_ids_cache.update({'A': rA, 'B': rB, 'nA': int(nrA), 'nB': int(nrB)})
                    return rA, rB, int(nrA), int(nrB)
                except Exception as e:
                    log_info(f"[WARN ] plot run-errorbars unavailable: {e}; falling back to ordinary plots")
                    return None, None, 1, 1

            stage5_rank_logger = _progress_logger('Stage5/ranking', total_units=max(1, len(rows)), min_interval_sec=stage5_rank_progress_interval_sec)
            individual_visual_written = 0

            def _stage5_should_write_individual_visual(rank: int, row: dict) -> bool:
                nonlocal individual_visual_written
                if stage5_write_all_individual_visuals or int(rank) <= int(stage5_output_top_regions):
                    individual_visual_written += 1
                    return True
                return False

            for rank, row in enumerate(rows, start=1):
                if not _stage5_should_write_individual_visual(int(rank), row):
                    stage5_rank_logger(int(rank), active=max(0, len(rows) - int(rank)), force=False)
                    continue
                fid_s = row.get("argmax_pair_id", "")
                if fid_s == "":
                    continue
                try:
                    fid = int(fid_s)
                except Exception:
                    continue
                fs = feats_by_fid.get(fid)
                if fs is None:
                    continue

                bins_used = int(getattr(fs, "bins", int(getattr(args, "bins_max", 128))))
                x_min = float(getattr(fs, "minv", 0.0))
                x_max = float(getattr(fs, "maxv", 1.0))
                if x_max <= x_min:
                    x_max = x_min + 1e-6

                # Compute pA/pB directly from Stage1 scratch selected-feature source.
                xA = np.asarray(_selected_feature_block_any_source(stage3_source, 'A', np.asarray([int(fid)], dtype=np.int64), slice(0, 1))[:, 0], dtype=np.float64)
                xB = np.asarray(_selected_feature_block_any_source(stage3_source, 'B', np.asarray([int(fid)], dtype=np.int64), slice(0, 1))[:, 0], dtype=np.float64)
                if int(xA.size) != int(wA_m.size) or int(xB.size) != int(wB_m.size):
                    raise RuntimeError(
                        f"Stage5 representative histogram frame alignment mismatch for fid={int(fid)}: "
                        f"xA={int(xA.size)} wA={int(wA_m.size)} xB={int(xB.size)} wB={int(wB_m.size)} "
                        f"source={stage3_source.get('kind')}"
                    )
                pA = _hist_prob_uniform(xA, wA_m, bins=bins_used, x_min=x_min, x_max=x_max).astype(np.float64, copy=False)
                pB = _hist_prob_uniform(xB, wB_m, bins=bins_used, x_min=x_min, x_max=x_max).astype(np.float64, copy=False)

                # Numerical hygiene: clip tiny negatives and renormalize
                pA = np.clip(pA, 0.0, None)
                pB = np.clip(pB, 0.0, None)
                sA = float(np.sum(pA)); sB = float(np.sum(pB))
                if sA > 0.0:
                    pA = pA / sA
                if sB > 0.0:
                    pB = pB / sB

    # Plot
                xs = np.linspace(x_min, x_max, num=bins_used, endpoint=False, dtype=np.float64)
                fig = plt.figure()
                show_run_errorbars = (str(selection_mode_main) in ('sig', 'ced')) or bool(plot_run_errorbars)
                plotted_run_errorbars = False
                sig_bin_xs_for_plot = None
                run_hist_npz = (cache_dir / 'run_bin_hists' / f'fid_{int(fid):08d}_runbins.npz')

                # Sig mode always prefers Stage1's precomputed run-bin distributions
                # because they also carry significant-bin masks. Standard mode only
                # shows run-level error bands when explicitly requested by -pre.
                if show_run_errorbars and str(selection_mode_main) == 'sig' and run_hist_npz.exists():
                    try:
                        rh = np.load(run_hist_npz)
                        mA = np.asarray(rh['meanA'], dtype=np.float64); mB = np.asarray(rh['meanB'], dtype=np.float64)
                        seA = np.asarray(rh['seA'], dtype=np.float64); seB = np.asarray(rh['seB'], dtype=np.float64)
                        if 'run_se_weighting' not in rh.files:
                            raise RuntimeError('stale run-bin histogram: missing run_se_weighting')
                        weighting = str(np.asarray(rh['run_se_weighting']).reshape(-1)[0])
                        if weighting != 'distrib_swei':
                            raise RuntimeError(f"stale run-bin histogram weighting={weighting!r}")
                        if mA.shape == xs.shape and mB.shape == xs.shape:
                            plt.plot(xs, mA, label="A")
                            plt.fill_between(xs, np.maximum(0.0, mA - seA), mA + seA, alpha=0.20)
                            plt.plot(xs, mB, label="B")
                            plt.fill_between(xs, np.maximum(0.0, mB - seB), mB + seB, alpha=0.20)
                            plotted_run_errorbars = True
                            try:
                                sigmask = np.asarray(rh['sig'], dtype=bool)
                                if sigmask.shape == xs.shape and np.any(sigmask):
                                    sig_bin_xs_for_plot = np.asarray(xs[sigmask], dtype=np.float64)
                            except Exception:
                                pass
                    except Exception:
                        plotted_run_errorbars = False

                # Standard mode with -pre, or sig-mode fallback when precomputed
                # histograms are absent: compute run-level histograms for the plotted
                # top-ranked feature only, avoiding a full-feature materialization.
                if show_run_errorbars and not plotted_run_errorbars:
                    rA_plot, rB_plot, nrA_plot, nrB_plot = _get_plot_run_ids_for_errorbars()
                    if rA_plot is not None and rB_plot is not None and int(nrA_plot) >= 2 and int(nrB_plot) >= 2:
                        try:
                            HA, WA = _run_bin_hist_matrix(xA, wA_m, rA_plot, bins=bins_used, x_min=x_min, x_max=x_max, n_runs=int(nrA_plot))
                            HB, WB = _run_bin_hist_matrix(xB, wB_m, rB_plot, bins=bins_used, x_min=x_min, x_max=x_max, n_runs=int(nrB_plot))
                            mA, seA, _n_active_A_plot = _run_bin_mean_se(HA, WA)
                            mB, seB, _n_active_B_plot = _run_bin_mean_se(HB, WB)
                            if _n_active_A_plot < 2 or _n_active_B_plot < 2:
                                raise RuntimeError(f"not enough active weighted runs for error bars: A={_n_active_A_plot}, B={_n_active_B_plot}")
                            plt.plot(xs, mA, label="A")
                            plt.fill_between(xs, np.maximum(0.0, mA - seA), mA + seA, alpha=0.20)
                            plt.plot(xs, mB, label="B")
                            plt.fill_between(xs, np.maximum(0.0, mB - seB), mB + seB, alpha=0.20)
                            plotted_run_errorbars = True
                        except Exception as e:
                            log_info(f"[WARN ] plot run-errorbars failed for fid={int(fid)}: {e}; falling back to ordinary plot")
                            plotted_run_errorbars = False

                if not plotted_run_errorbars:
                    plt.plot(xs, pA, label="A")
                    plt.plot(xs, pB, label="B")
                plt.xlabel("distance")
                plt.ylabel("probability")
                pm_plot = pair_metrics_by_fid.get(int(fid), {})
                auc_plot = float(pm_plot.get('auc_single', float('nan')) )
                contrib_plot = float(pm_plot.get('contribution_multi', float('nan')) )
                ptype_plot = str(pm_plot.get('pair_type', 'near' if int(getattr(fs, 'kind', 1)) == 0 else 'long'))
                sig_bins_plot = int(getattr(fs, 'n_sig_bins', 0))
                sig_area_plot = float(getattr(fs, 'sig_area', 0.0))
                sig_logpmax_plot = float(getattr(fs, 'sig_logpmax', 0.0))
                sig_strength_plot = float(getattr(fs, 'sig_strength', 0.0))
                ced_score_plot = float(getattr(fs, 'ced_effect_score', 0.0))
                ced_between_plot = float(getattr(fs, 'ced_between_tv', 0.0))
                ced_within_plot = float(getattr(fs, 'ced_within_median', 0.0))
                ced_r_plot = float(getattr(fs, 'ced_r_effect', 0.0))
                ced_z_plot = float(getattr(fs, 'ced_z_effect', 0.0))
                ced_q_plot = float(getattr(fs, 'ced_q_effect', 1.0))
                ced_null_plot = float(getattr(fs, 'ced_null_median', 0.0))
                ced_rnull_plot = float(getattr(fs, 'ced_r_null', 0.0))
                ced_pnull_plot = float(getattr(fs, 'ced_p_null', 1.0))
                ced_n_plot = int(getattr(fs, 'ced_n_within', 0))
                if sig_bin_xs_for_plot is not None and np.asarray(sig_bin_xs_for_plot).size > 0:
                    try:
                        y0, y1 = plt.ylim()
                        yr = max(1e-12, float(y1 - y0))
                        plt.vlines(np.asarray(sig_bin_xs_for_plot, dtype=np.float64), y0, y0 + 0.045 * yr,
                                   colors="0.55", alpha=0.35, linewidth=0.8, label="_nolegend_")
                        plt.ylim(y0, y1)
                    except Exception:
                        pass
                title_main = f"rank {rank} {ptype_plot}: {_fid_label(fid)}"
                title_main = textwrap.fill(title_main, width=72)
                # Keep the visual title compact and mode-stable.  TV/AUC/C are
                # always shown so standard, sig, and CED plots can be compared at a
                # glance.  Mode-specific diagnostics are appended only as the
                # minimum set needed for interpretation; detailed values remain in
                # CSV outputs.
                title_base_metrics = f"TV={float(fs.tv):.3f}, AUC={auc_plot:.3f}, C={contrib_plot:.3f}"
                if str(selection_mode_main) == 'ced':
                    title_metrics = (
                        f"{title_base_metrics}; "
                        f"CED: D_between={ced_between_plot:.3f}, D_within={ced_within_plot:.3f}, "
                        f"R={ced_r_plot:.3g}, Z={ced_z_plot:.3g}; "
                        f"NULL: D_null={ced_null_plot:.3f}, R_null={ced_rnull_plot:.3g}, p_null={ced_pnull_plot:.3g}, q_null={float(getattr(fs, 'ced_q_null', 1.0)):.3g}"
                    )
                elif sig_bins_plot > 0:
                    title_metrics = (
                        f"{title_base_metrics}; "
                        f"SIG: strength={sig_strength_plot:.3g}, area={sig_area_plot:.3g}, "
                        f"maxlogp={sig_logpmax_plot:.3g}, bins={sig_bins_plot}"
                    )
                else:
                    title_metrics = title_base_metrics
                plt.title(title_main)
                plt.legend(loc="best", frameon=True)
                fig.subplots_adjust(bottom=0.24, top=0.86)
                fig.text(0.5, 0.025, textwrap.fill(title_metrics, width=76),
                         ha="center", va="bottom", fontsize=8)

                plot_path = plots_dir / f"pair_rank{rank:04d}_dist.{plot_format}"
                if plot_format == "png":
                    plt.savefig(plot_path, dpi=int(plot_dpi), bbox_inches="tight")
                else:
                    plt.savefig(plot_path, bbox_inches="tight")
                plt.close(fig)

                # PDB embedding + PyMOL view script
                # - Region selections: near at atom-level, long at residue-level (restricted to atom-spec selection)
                # - Per-atom contribution scores: raw max TV over ALL bundle member pairs touching each atom
                regA_atom: set[int] = set()
                regA_res: set[int] = set()
                regB_atom: set[int] = set()
                regB_res: set[int] = set()

                for key in (row.get("regionA_nodes", "") or "").split(";"):
                    key = key.strip()
                    if not key:
                        continue
                    parts = key.split(":")
                    if parts[0] == "atom":
                        if len(parts) >= 3 and parts[2].lstrip("-").isdigit():
                            regA_atom.add(int(parts[2]))
                    elif parts[0] == "res":
                        if len(parts) >= 2 and parts[1].lstrip("-").isdigit():
                            regA_res.add(int(parts[1]))
                for key in (row.get("regionB_nodes", "") or "").split(";"):
                    key = key.strip()
                    if not key:
                        continue
                    parts = key.split(":")
                    if parts[0] == "atom":
                        if len(parts) >= 3 and parts[2].lstrip("-").isdigit():
                            regB_atom.add(int(parts[2]))
                    elif parts[0] == "res":
                        if len(parts) >= 2 and parts[1].lstrip("-").isdigit():
                            regB_res.add(int(parts[1]))

                bid = int(row.get("bundle_id", "0") or 0)
                mem_fids = bundle_members.get(bid, [])
                stage5_bfactor_metric = ("sig_strength" if str(stage5_region_weight_mode) == "sig_strength" else ("ced_effect_score" if str(stage5_region_weight_mode) == "ced_effect_score" else "bfactor"))
                score_atoms_b = _accumulate_bundle_atom_values(mem_fids, stage5_bfactor_metric)
                score_atoms_o = _accumulate_bundle_atom_values(mem_fids, "occupancy")
                score_atoms = _normalize_score_atoms(score_atoms_b)

                out_pdb = pdb_dir / f"pair_rank{rank:04d}_regions.pdb"
                out_pml = pdb_dir / f"pair_rank{rank:04d}_view.pml"
                _write_scored_pdb(out_pdb, score_atoms, np.clip(np.asarray(score_atoms_o, dtype=np.float64), 0.0, 1.0))
                # PyMOL selections (atom-spec aware)
                def _atom_sel_expr(atom_indices: set[int]) -> str:
                    terms = []
                    for ai in sorted(atom_indices):
                        if 0 <= ai < len(atoms_sel):
                            a = atoms_sel[ai]
                            chain = a.chain.strip()
                            base = f"resi {int(a.resid)} and name {a.name.strip()}"
                            if chain:
                                base = f"chain {chain} and " + base
                            terms.append(f"({base})")
                    if not terms:
                        return "none"
                    return " or ".join(terms)

                def _res_sel_expr(res_indices: set[int]) -> str:
                    terms = []
                    for ri in sorted(res_indices):
                        if 0 <= ri < len(res_keys):
                            chain, resid = res_keys[ri]
                            chain = str(chain).strip()
                            # Restrict to selected atoms within the residue (avoid assigning to excluded atoms like hydrogens)
                            names = sorted({atoms_sel[ak].name.strip() for ak in atoms_by_res[ri] if 0 <= ak < len(atoms_sel)})
                            if not names:
                                continue
                            name_expr = "+".join(names)
                            base = f"resi {int(resid)} and name {name_expr}"
                            if chain:
                                base = f"chain {chain} and " + base
                            terms.append(f"({base})")
                    if not terms:
                        return "none"
                    return " or ".join(terms)

                selA_atoms = _atom_sel_expr(regA_atom)
                selB_atoms = _atom_sel_expr(regB_atom)
                selA_res   = _res_sel_expr(regA_res)
                selB_res   = _res_sel_expr(regB_res)
                selA = f"({selA_atoms}) or ({selA_res})"
                selB = f"({selB_atoms}) or ({selB_res})"

                # Log region summary
                _score_nonzero_atoms_rank = int(np.count_nonzero(score_atoms))
                _score_atom_label = f"{stage5_region_weight_mode}_nonzero_atoms"
                log_info(f"[Stage5] rank={rank} bundle={bid} regions: A(atoms={len(regA_atom)}, res={len(regA_res)}), B(atoms={len(regB_atom)}, res={len(regB_res)}), {_score_atom_label}={_score_nonzero_atoms_rank}")

                with open(out_pml, "w", encoding="utf-8") as fo:
                    fo.write(f"reinitialize\n")
                    fo.write(f'load "{out_pdb.name}", pair{rank:04d}\n')
                    fo.write("hide everything, all\n")
                    fo.write("show cartoon, pair%04d\n" % rank)
                    fo.write(f"select regionA, ({selA}) and pair{rank:04d}\n")
                    fo.write(f"select regionB, ({selB}) and pair{rank:04d}\n")
                    fo.write("show sticks, regionA or regionB\n")
                    fo.write("set stick_radius, 0.15\n")
                    fo.write("color grey70, pair%04d\n" % rank)
                    fo.write("color red, regionA\n")
                    fo.write("color blue, regionB\n")
                    # Use b/occ field as continuous score; build ramps per region to emphasize important parts
                    fo.write("ramp_new rampA, regionA, [0,1], [white,red]\n")
                    fo.write("ramp_new rampB, regionB, [0,1], [white,blue]\n")
                    fo.write("color rampA, regionA\n")
                    fo.write("color rampB, regionB\n")
                    fo.write("set transparency, 0.2, pair%04d\n" % rank)
                    fo.write("zoom regionA or regionB, 12\n")
                stage5_rank_logger(int(rank), active=max(0, len(rows) - int(rank)), force=False)
            stage5_rank_logger(len(rows), active=0, force=True)
            log_info(f"[Stage5] individual visuals written={individual_visual_written}/{len(rows)} top_regions={stage5_output_top_regions} write_all={str(stage5_write_all_individual_visuals).lower()}")
            # Combined Stage5 visualization over all ranked bundles (normalized multivariate contribution + AUC occupancy)
            all_ranked_bundle_ids = [int(row.get("bundle_id", "0") or 0) for row in rows]
            all_ranked_mem_fids: list[int] = []
            seen_ranked_fids: set[int] = set()
            for bid in all_ranked_bundle_ids:
                for fid_m in bundle_members.get(int(bid), []):
                    fid_m = int(fid_m)
                    if fid_m not in seen_ranked_fids:
                        seen_ranked_fids.add(fid_m)
                        all_ranked_mem_fids.append(fid_m)

            stage5_bfactor_metric = ("sig_strength" if str(stage5_region_weight_mode) == "sig_strength" else ("ced_effect_score" if str(stage5_region_weight_mode) == "ced_effect_score" else "bfactor"))
            all_score_atoms_b = _accumulate_bundle_atom_values(all_ranked_mem_fids, stage5_bfactor_metric)
            all_score_atoms_o = _accumulate_bundle_atom_values(all_ranked_mem_fids, "occupancy")
            all_score_atoms = _normalize_score_atoms(all_score_atoms_b)
            all_out_pdb = pdb_dir / "all_ranked_bundles_regions.pdb"
            all_out_pml = pdb_dir / "all_ranked_bundles_view.pml"
            _write_scored_pdb(all_out_pdb, all_score_atoms, np.clip(np.asarray(all_score_atoms_o, dtype=np.float64), 0.0, 1.0))
            _write_metric_specific_pdbs("all_ranked_bundles", all_ranked_mem_fids)
            log_info(
                f"[Stage5] all_ranked_bundles: bundles={len(all_ranked_bundle_ids)}, unique_member_fids={len(all_ranked_mem_fids)}, bfactor_metric={stage5_bfactor_metric}, {stage5_region_weight_mode}_nonzero_atoms={int(np.count_nonzero(all_score_atoms))}"
            )
            with open(all_out_pml, "w", encoding="utf-8") as fo:
                fo.write("reinitialize\n")
                fo.write(f'load "{all_out_pdb.name}", all_ranked_bundles\n')
                fo.write("hide everything, all\n")
                fo.write("show cartoon, all_ranked_bundles\n")
                fo.write("spectrum b, white_red, all_ranked_bundles\n")
                fo.write("set cartoon_transparency, 0.15, all_ranked_bundles\n")
                fo.write("zoom all_ranked_bundles, 12\n")
            stage5_ranked_count = int(len(rows))
            _save_stage_meta(stage5_rank_meta, want5)
            _write_stage_done_atomic(stage5_rank_done, stage_name='Stage5_ranking', meta=want5, outputs=[ranked_pairs_csv, ranked_pairs_pretty, bundle_regions_pretty, region_contrib_csv, plots_dir, stage5_rank_meta], counts={'ranked_pairs': int(stage5_ranked_count), 'plots_files': int(_dir_file_count(plots_dir)), 'stage5_pdb_files': int(_stage5_owned_pdb_file_count(pdb_dir))})
    if not stage5_rank_cache_ok:
        stage5_ranked_count = int(len(rows))
    _pipeline_progress_emit(5, total_stages, "Stage5 complete", t0=pipeline_t0, extra=f"ranked={int(stage5_ranked_count)}")

    # ============================================================
    # Stage 5.5: ensemble direction map
    # ============================================================
    _generate_ensemble_direction_map(
        outdir=outdir,
        pair_meta=pair_meta,
        feats=feats,
        pair_metrics_by_fid=pair_metrics_by_fid,
        stage5_weight_by_fid=(stage5_weight_by_fid or {}),
        atoms_sel=atoms_sel,
        atoms_by_res=atoms_by_res,
        selection_mode=str(selection_mode_for_stage5),
        stage1_done_path=stage1_done_path,
        stage5_rank_done=stage5_rank_done,
        pair_scores_csv=pair_scores_csv,
        pair_contrib_csv=pair_contrib_csv,
        bundle_regions_csv=bundle_regions_csv,
        ranked_pairs_csv=ranked_pairs_csv,
    )

    # ============================================================
    # Stage 6: Stability analysis (evaluation only; baseline result is unchanged)
    # ============================================================
    if stability_runs > 0:
        stability_dir = outdir / "stability"
        stage6_stability_cache_dir = cache_dir / "stage6_stability"
        stage6_stability_cache_dir.mkdir(parents=True, exist_ok=True)
        stage6_stability_meta = stage6_stability_cache_dir / "stability_meta.json"
        stage6_stability_done = stage6_stability_cache_dir / "stability.done.json"
        pair_stability_csv = stability_dir / "pair_stability.csv"
        bundle_stability_csv = stability_dir / "bundle_stability.csv"
        region_stability_csv = stability_dir / "region_stability.csv"
        run_stability_csv = stability_dir / "run_stability.csv"
        summary_txt = stability_dir / "summary.txt"
        pair_levels = _stability_levels(stability_topk)
        bundle_levels = _stability_levels(stability_topm_regions)
        max_pair_level = max(pair_levels) if pair_levels else 100
        max_bundle_level = max(bundle_levels) if bundle_levels else 100
        want6 = {
            'cache_version': int(STAGE6_STABILITY_CACHE_VERSION),
        'cache_namespace': CACHE_NAMESPACE,
            'ranked_pairs_csv': _content_sig(ranked_pairs_csv),
            'bundle_regions_csv': _content_sig(bundle_regions_csv),
            'pair_contrib_csv': _content_sig(pair_contrib_csv),
            'stage1_feature_stats_meta': _content_sig(stage1_meta_path),
            'stage1_feature_stats_done': _done_cache_sig(stage1_done_path),
            'stage1_feature_stats': _content_sig(stage1_cache),
            'stage1_scoring_meta': _content_sig(scoring_meta_path),
            'stage1_scoring_done': _done_cache_sig(scoring_done_path),
            'stage1_selected_feature_positions': _content_sig(selected_feature_positions_path),
            'stage1_selected_feature_ids_all_auc': _content_sig(selected_feature_ids_path),
            'selected_feature_ids_final': _content_sig(sel_fids_path),
            'stage1_single_feature_metrics': _content_sig(single_feature_metrics_csv),
            'stage1_single_feature_scores': _content_sig(single_feature_scores_path),
            'stage1_scoring_ckpt_signature': _content_sig(stage1_ckpt_dir / 'run_signature.json'),
            'stage2_contribution_csv': _content_sig(feature_contrib_csv),
            'stage2_contribution_done': _done_cache_sig(feature_contrib_done),
            'stage3_corr_meta': _content_sig(stage3_corr_meta),
            'stage3_corr_done': _done_cache_sig(stage3_corr_done),
            'stage4_bundles_meta': _content_sig(stage4_meta),
            'stage4_bundles_done': _done_cache_sig(stage4_done),
            'bundles_csv': _content_sig(bundles_csv),
            'feature_corr_edges_csv': _content_sig(corr_csv),
            'stability_runs': int(stability_runs),
            'pair_levels': [int(x) for x in pair_levels],
            'bundle_levels': [int(x) for x in bundle_levels],
            'auc_cv_folds': int(getattr(args, 'auc_cv_folds', 5)),
            'auc_random_state': int(auc_random_state),
            'contrib_penalty': str(getattr(args, 'contrib_penalty', 'l1')),
            'contrib_C': float(getattr(args, 'contrib_C', 1.0)),
            'contrib_solver': str(getattr(args, 'contrib_solver', 'auto')),
            'contrib_sample_block_size': int(getattr(args, 'contrib_sample_block_size', 32768) or 32768),
            'contrib_max_iter': int(getattr(args, 'contrib_max_iter', 1000)),
            'contrib_standardize': bool(getattr(args, 'contrib_standardize', False)),
            'seed': int(seed),
        }
        stage6_stability_cache_ok, stage6_stability_state, stage6_stability_reasons = _cache_check_with_reasons(
            required_paths=[
                (pair_stability_csv, pair_stability_csv.name),
                (bundle_stability_csv, bundle_stability_csv.name),
                (region_stability_csv, region_stability_csv.name),
                (run_stability_csv, run_stability_csv.name),
                (summary_txt, summary_txt.name),
            ],
            meta_path=stage6_stability_meta,
            done_path=stage6_stability_done,
            want_meta=want6,
            validators=[
                ('pair_stability_csv', lambda: ((_csv_row_count(pair_stability_csv) > 0), f"invalid_output: {pair_stability_csv.name} rows={_csv_row_count(pair_stability_csv)}")),
                ('bundle_stability_csv', lambda: ((_csv_row_count(bundle_stability_csv) > 0), f"invalid_output: {bundle_stability_csv.name} rows={_csv_row_count(bundle_stability_csv)}")),
                ('region_stability_csv', lambda: ((_csv_row_count(region_stability_csv) > 0), f"invalid_output: {region_stability_csv.name} rows={_csv_row_count(region_stability_csv)}")),
                ('run_stability_csv', lambda: ((_csv_row_count(run_stability_csv) == int(stability_runs)), f"invalid_output: {run_stability_csv.name} rows={_csv_row_count(run_stability_csv)} expected={int(stability_runs)}")),
            ],
        ) if not force else (False, 'miss', ['forced recompute'])
        if stage6_stability_cache_ok:
            log_skip('Stage6: stability', 'using cached stability/*.csv')
        else:
            if not force and stage6_stability_state != 'first_run':
                kind = 'incomplete cache' if stage6_stability_state == 'incomplete' else 'cache miss'
                log_recalc('Stage6: stability', kind)
                for msg in stage6_stability_reasons:
                    log_why(msg)
            with SectionTimer('Stage6: stability analysis', enabled=True):
                if stability_dir.exists():
                    shutil.rmtree(stability_dir)
                stability_dir.mkdir(parents=True, exist_ok=True)

                baseline_pair_ranking = _read_pair_ranking(pair_contrib_csv)
                baseline_pair_rank_map_all, baseline_pair_score_map_all = _ranking_map_from_pairs(baseline_pair_ranking)
                baseline_pair_ids_by_k = {int(k): [int(fid) for fid, _score in baseline_pair_ranking[:max(1, int(k))]] for k in pair_levels}
                baseline_pair_set_by_k = {int(k): set(v) for k, v in baseline_pair_ids_by_k.items()}
                baseline_pair_rank_map_by_k = {int(k): {int(fid): idx + 1 for idx, fid in enumerate(v)} for k, v in baseline_pair_ids_by_k.items()}
                baseline_pair_track_ids = baseline_pair_ids_by_k[max_pair_level]

                baseline_ranked_regions_all = _read_ranked_region_rows(ranked_pairs_csv, None)
                baseline_bundle_rank_map_all, baseline_bundle_score_map_all = _ranking_map_from_bundles(baseline_ranked_regions_all)
                baseline_bundle_ids_by_m = {int(m): [int(r['bundle_id']) for r in baseline_ranked_regions_all[:max(1, int(m))] if int(r['bundle_id']) >= 0] for m in bundle_levels}
                baseline_bundle_set_by_m = {int(m): set(v) for m, v in baseline_bundle_ids_by_m.items()}
                baseline_bundle_rank_map_by_m = {int(m): {int(bid): idx + 1 for idx, bid in enumerate(v)} for k, v in baseline_bundle_ids_by_m.items() for m in [k]}
                baseline_bundle_track_ids = baseline_bundle_ids_by_m[max_bundle_level]
                baseline_region_map_by_m: dict[int, dict[int, tuple[set[str], set[str], int]]] = {}
                for m in bundle_levels:
                    rows_m = baseline_ranked_regions_all[:max(1, int(m))]
                    baseline_region_map_by_m[int(m)] = {
                        int(r['bundle_id']): (set(r['regionA_nodes']), set(r['regionB_nodes']), int(r['rank']))
                        for r in rows_m if int(r['bundle_id']) >= 0
                    }

                pair_counts_by_k = {int(k): {int(fid): 0 for fid in baseline_pair_ids_by_k[int(k)]} for k in pair_levels}
                pair_rank_samples = {int(fid): [] for fid in baseline_pair_track_ids}
                pair_score_samples = {int(fid): [] for fid in baseline_pair_track_ids}
                bundle_counts_by_m = {int(m): {int(bid): 0 for bid in baseline_bundle_ids_by_m[int(m)]} for m in bundle_levels}
                bundle_rank_samples = {int(bid): [] for bid in baseline_bundle_track_ids}
                bundle_score_samples = {int(bid): [] for bid in baseline_bundle_track_ids}
                region_scores_by_m = {int(m): {int(bid): [] for bid in baseline_bundle_ids_by_m[int(m)]} for m in bundle_levels}
                run_rows: list[dict[str, object]] = []

                parent_features_meta = _load_json(outdir / FEATURES_META_JSON) if (outdir / FEATURES_META_JSON).exists() else {}
                stage6_stability_logger = _progress_logger('Stage6/replicas', total_units=max(1, int(stability_runs)), min_interval_sec=float(getattr(args, 'progress_interval_sec', 300.0) or 300.0))
                for rr in range(1, int(stability_runs) + 1):
                    rep_label = f'run_{rr:03d}'
                    rep_outdir = (stability_dir / rep_label).resolve()
                    rep_outdir.mkdir(parents=True, exist_ok=True)
                    rep_cache_dir = rep_outdir / 'distil_cache'
                    rep_cache_dir.mkdir(parents=True, exist_ok=True)

                    _link_or_copy(pair_scores_csv, rep_outdir / 'pair_scores.csv')
                    _link_or_copy(corr_csv, rep_outdir / 'feature_corr_edges.csv')
                    # Reuse Stage1 feature-scoring outputs in replicas, but do not copy
                    # Stage2 contribution outputs: each replica must refit contribution weights
                    # with its own contribution random seed.
                    try:
                        target_scoring = rep_cache_dir / 'stage1_scoring'
                        if target_scoring.exists() or target_scoring.is_symlink():
                            if target_scoring.is_symlink() or target_scoring.is_file():
                                target_scoring.unlink()
                            else:
                                shutil.rmtree(target_scoring)
                        os.symlink(stage1_scoring_dir.resolve(), target_scoring, target_is_directory=True)
                    except Exception:
                        shutil.copytree(stage1_scoring_dir, rep_cache_dir / 'stage1_scoring', dirs_exist_ok=True)
                    _link_or_copy(bundles_csv, rep_outdir / 'bundles.csv')
                    try:
                        target_stage3 = rep_cache_dir / 'stage3_correlation'
                        if target_stage3.exists() or target_stage3.is_symlink():
                            if target_stage3.is_symlink() or target_stage3.is_file():
                                target_stage3.unlink()
                            else:
                                shutil.rmtree(target_stage3)
                        os.symlink(stage3_corr_dir.resolve(), target_stage3, target_is_directory=True)
                    except Exception:
                        shutil.copytree(stage3_corr_dir, rep_cache_dir / 'stage3_correlation', dirs_exist_ok=True)
                    try:
                        target_stage4 = rep_cache_dir / 'stage4_bundles'
                        if target_stage4.exists() or target_stage4.is_symlink():
                            if target_stage4.is_symlink() or target_stage4.is_file():
                                target_stage4.unlink()
                            else:
                                shutil.rmtree(target_stage4)
                        os.symlink(stage4_bundles_dir.resolve(), target_stage4, target_is_directory=True)
                    except Exception:
                        shutil.copytree(stage4_bundles_dir, rep_cache_dir / 'stage4_bundles', dirs_exist_ok=True)
                    sel_fids_stage6_stability_src = sel_fids_path if sel_fids_path.exists() else selected_feature_ids_path
                    if not sel_fids_stage6_stability_src.exists():
                        raise RuntimeError(f'Stage6 requires selected-feature ids, but neither {sel_fids_path.name} nor {selected_feature_ids_path.name} exists in {stage1_scoring_dir}')
                    _link_or_copy(sel_fids_stage6_stability_src, rep_outdir / SEL_FIDS_NPY)
                    _link_or_copy(art.top_pairs_csv, rep_outdir / 'top_pairs_pool.csv')
                    _link_or_copy(art.pair_index, rep_outdir / 'pair_index.npy')
                    if wA_path.exists():
                        _link_or_copy(wA_path, rep_outdir / 'weights_A.npy')
                    if wB_path.exists():
                        _link_or_copy(wB_path, rep_outdir / 'weights_B.npy')
                    _write_replica_features_meta(rep_outdir, art, parent_features_meta)

                    rep_args = argparse.Namespace(**vars(args).copy())
                    rep_args.outdir = str(rep_outdir)
                    rep_args.force = False
                    rep_args.force_recompute_features = False
                    rep_args.stability_runs = 0
                    rep_args.topN_pairs = max_bundle_level
                    rep_args.auc_random_state = int(auc_random_state)
                    rep_args.contrib_random_state = int(auc_random_state + rr * 1009)

                    replica_log_prefix = f'[Stage6 {rep_label}] '
                    log_info(
                        f'[Stage6] replica {rep_label}: Stage1 auc_random_state(fixed)={int(rep_args.auc_random_state)} '
                        f'Stage2 contribution_random_state={int(getattr(rep_args, "contrib_random_state", rep_args.auc_random_state))} '
                        f'topN_pairs={int(rep_args.topN_pairs)} log_prefix={replica_log_prefix.strip()}'
                    )
                    with _LogPrefixScope(replica_log_prefix):
                        run_distil_pipeline(rep_outdir, rep_args, meta=None)

                    rep_pair_ranking = _read_pair_ranking(rep_outdir / 'pair_contrib.csv')
                    rep_pair_rank_map_all, rep_pair_score_map_all = _ranking_map_from_pairs(rep_pair_ranking)
                    rep_pair_ids_by_k = {int(k): [int(fid) for fid, _score in rep_pair_ranking[:max(1, int(k))]] for k in pair_levels}
                    rep_pair_set_by_k = {int(k): set(v) for k, v in rep_pair_ids_by_k.items()}
                    rep_pair_rank_map_by_k = {int(k): {int(fid): idx + 1 for idx, fid in enumerate(v)} for k, v in rep_pair_ids_by_k.items()}
                    for k in pair_levels:
                        for fid in baseline_pair_ids_by_k[int(k)]:
                            if int(fid) in rep_pair_set_by_k[int(k)]:
                                pair_counts_by_k[int(k)][int(fid)] += 1
                    for fid in baseline_pair_track_ids:
                        rank_v = rep_pair_rank_map_all.get(int(fid))
                        if rank_v is not None:
                            pair_rank_samples[int(fid)].append(float(rank_v))
                        score_v = rep_pair_score_map_all.get(int(fid))
                        if score_v is not None and np.isfinite(float(score_v)):
                            pair_score_samples[int(fid)].append(float(score_v))

                    rep_ranked_regions_all = _read_ranked_region_rows(rep_outdir / 'ranked_pairs.csv', None)
                    rep_bundle_rank_map_all, rep_bundle_score_map_all = _ranking_map_from_bundles(rep_ranked_regions_all)
                    rep_bundle_ids_by_m = {int(m): [int(r['bundle_id']) for r in rep_ranked_regions_all[:max(1, int(m))] if int(r['bundle_id']) >= 0] for m in bundle_levels}
                    rep_bundle_set_by_m = {int(m): set(v) for m, v in rep_bundle_ids_by_m.items()}
                    rep_bundle_rank_map_by_m = {int(m): {int(bid): idx + 1 for idx, bid in enumerate(v)} for m, v in rep_bundle_ids_by_m.items()}
                    for m in bundle_levels:
                        for bid in baseline_bundle_ids_by_m[int(m)]:
                            if int(bid) in rep_bundle_set_by_m[int(m)]:
                                bundle_counts_by_m[int(m)][int(bid)] += 1
                    for bid in baseline_bundle_track_ids:
                        rank_v = rep_bundle_rank_map_all.get(int(bid))
                        if rank_v is not None:
                            bundle_rank_samples[int(bid)].append(float(rank_v))
                        score_v = rep_bundle_score_map_all.get(int(bid))
                        if score_v is not None and np.isfinite(float(score_v)):
                            bundle_score_samples[int(bid)].append(float(score_v))

                    rep_region_map = _read_bundle_region_map(rep_outdir / 'bundle_regions.csv')
                    row_out: dict[str, object] = {
                        'run': rep_label,
                        'auc_random_state': int(rep_args.auc_random_state),
                    }
                    for k in pair_levels:
                        pair_overlap = _jaccard_from_sets(baseline_pair_set_by_k[int(k)], rep_pair_set_by_k[int(k)])
                        pair_spear = _spearman_from_rank_maps(baseline_pair_rank_map_by_k[int(k)], rep_pair_rank_map_by_k[int(k)], int(k))
                        row_out[f'pair_top{k}_jaccard'] = float(pair_overlap)
                        row_out[f'pair_top{k}_spearman'] = float(pair_spear)
                    for m in bundle_levels:
                        bundle_overlap = _jaccard_from_sets(baseline_bundle_set_by_m[int(m)], rep_bundle_set_by_m[int(m)])
                        bundle_spear = _spearman_from_rank_maps(baseline_bundle_rank_map_by_m[int(m)], rep_bundle_rank_map_by_m[int(m)], int(m))
                        row_out[f'bundle_top{m}_jaccard'] = float(bundle_overlap)
                        row_out[f'bundle_top{m}_spearman'] = float(bundle_spear)
                        region_vals = []
                        for bid, (baseA, baseB, _rank) in baseline_region_map_by_m[int(m)].items():
                            repAB = rep_region_map.get(int(bid))
                            if repAB is None:
                                continue
                            ov = _region_overlap_pair(baseA, baseB, set(repAB[0]), set(repAB[1]))
                            region_scores_by_m[int(m)][int(bid)].append(float(ov))
                            region_vals.append(float(ov))
                        row_out[f'region_top{m}_overlap_mean'] = float(np.mean(region_vals)) if region_vals else float('nan')
                    run_rows.append(row_out)
                    if _log_enabled('info'):
                        stage6_stability_logger(rr, active=len(run_rows), force=False)
                if _log_enabled('info'):
                    stage6_stability_logger(int(stability_runs), active=len(run_rows), force=True)

                def _stats_text(vals: list[float]) -> tuple[str, str, str, str]:
                    arr = np.asarray([float(v) for v in vals if np.isfinite(float(v))], dtype=np.float64)
                    if arr.size <= 0:
                        return ('nan', 'nan', 'nan', 'nan')
                    return (f'{float(np.mean(arr)):.6f}', f'{float(np.std(arr)):.6f}', f'{float(np.min(arr)):.6f}', f'{float(np.max(arr)):.6f}')

                def _write_stage6_stability_pair(_fh):
                    wcsv = csv.writer(_fh)
                    header = ['fid', 'baseline_rank']
                    for k in pair_levels:
                        header.extend([f'selected_count_top{k}', f'selection_freq_top{k}'])
                    header.extend(['replicated_rank_mean', 'replicated_rank_sd', 'replicated_score_mean', 'replicated_score_sd'])
                    wcsv.writerow(header)
                    for rank, fid in enumerate(baseline_pair_track_ids, start=1):
                        row = [int(fid), int(rank)]
                        for k in pair_levels:
                            cnt = int(pair_counts_by_k[int(k)].get(int(fid), 0)) if int(rank) <= int(k) else 0
                            freq = float(cnt / max(1, int(stability_runs))) if int(rank) <= int(k) else 0.0
                            row.extend([cnt, f'{freq:.6f}'])
                        rank_mean, rank_sd, _rank_min, _rank_max = _stats_text(pair_rank_samples.get(int(fid), []))
                        score_mean, score_sd, _score_min, _score_max = _stats_text(pair_score_samples.get(int(fid), []))
                        row.extend([rank_mean, rank_sd, score_mean, score_sd])
                        wcsv.writerow(row)

                _write_csv_atomic(pair_stability_csv, _write_stage6_stability_pair)

                def _write_stage6_stability_bundle(_fh):
                    wcsv = csv.writer(_fh)
                    header = ['bundle_id', 'baseline_rank']
                    for m in bundle_levels:
                        header.extend([f'selected_count_top{m}', f'selection_freq_top{m}'])
                    header.extend(['replicated_rank_mean', 'replicated_rank_sd', 'replicated_score_mean', 'replicated_score_sd'])
                    wcsv.writerow(header)
                    for rank, bid in enumerate(baseline_bundle_track_ids, start=1):
                        row = [int(bid), int(rank)]
                        for m in bundle_levels:
                            cnt = int(bundle_counts_by_m[int(m)].get(int(bid), 0)) if int(rank) <= int(m) else 0
                            freq = float(cnt / max(1, int(stability_runs))) if int(rank) <= int(m) else 0.0
                            row.extend([cnt, f'{freq:.6f}'])
                        rank_mean, rank_sd, _rank_min, _rank_max = _stats_text(bundle_rank_samples.get(int(bid), []))
                        score_mean, score_sd, _score_min, _score_max = _stats_text(bundle_score_samples.get(int(bid), []))
                        row.extend([rank_mean, rank_sd, score_mean, score_sd])
                        wcsv.writerow(row)

                _write_csv_atomic(bundle_stability_csv, _write_stage6_stability_bundle)

                def _write_stage6_stability_region(_fh):
                    wcsv = csv.writer(_fh)
                    header = ['bundle_id', 'baseline_rank']
                    for m in bundle_levels:
                        header.extend([f'mean_overlap_top{m}', f'min_overlap_top{m}', f'max_overlap_top{m}', f'compared_runs_top{m}'])
                    wcsv.writerow(header)
                    for rank, bid in enumerate(baseline_bundle_track_ids, start=1):
                        row = [int(bid), int(rank)]
                        for m in bundle_levels:
                            vals = [float(v) for v in region_scores_by_m[int(m)].get(int(bid), []) if np.isfinite(float(v))] if int(rank) <= int(m) else []
                            mean_v = float(np.mean(vals)) if vals else float('nan')
                            min_v = float(np.min(vals)) if vals else float('nan')
                            max_v = float(np.max(vals)) if vals else float('nan')
                            row.extend([
                                (f'{mean_v:.6f}' if np.isfinite(mean_v) else 'nan'),
                                (f'{min_v:.6f}' if np.isfinite(min_v) else 'nan'),
                                (f'{max_v:.6f}' if np.isfinite(max_v) else 'nan'),
                                int(len(vals)),
                            ])
                        wcsv.writerow(row)

                _write_csv_atomic(region_stability_csv, _write_stage6_stability_region)

                def _write_stage6_stability_run(_fh):
                    wcsv = csv.writer(_fh)
                    header = ['run', 'auc_random_state']
                    for k in pair_levels:
                        header.extend([f'pair_top{k}_jaccard', f'pair_top{k}_spearman'])
                    for m in bundle_levels:
                        header.extend([f'bundle_top{m}_jaccard', f'bundle_top{m}_spearman', f'region_top{m}_overlap_mean'])
                    wcsv.writerow(header)
                    for row in run_rows:
                        out = [row['run'], int(row['auc_random_state'])]
                        for k in pair_levels:
                            out.extend([
                                f"{float(row[f'pair_top{k}_jaccard']):.6f}",
                                f"{float(row[f'pair_top{k}_spearman']):.6f}" if np.isfinite(float(row[f'pair_top{k}_spearman'])) else 'nan',
                            ])
                        for m in bundle_levels:
                            out.extend([
                                f"{float(row[f'bundle_top{m}_jaccard']):.6f}",
                                f"{float(row[f'bundle_top{m}_spearman']):.6f}" if np.isfinite(float(row[f'bundle_top{m}_spearman'])) else 'nan',
                                f"{float(row[f'region_top{m}_overlap_mean']):.6f}" if np.isfinite(float(row[f'region_top{m}_overlap_mean'])) else 'nan',
                            ])
                        wcsv.writerow(out)

                _write_csv_atomic(run_stability_csv, _write_stage6_stability_run)

                summary_lines = [
                    f'stability_runs: {int(stability_runs)}',
                    'stability_mode: cv',
                    'pair_top_levels: ' + ','.join(str(int(k)) for k in pair_levels),
                    'bundle_region_top_levels: ' + ','.join(str(int(m)) for m in bundle_levels),
                ]
                for k in pair_levels:
                    vals_j = np.asarray([float(r[f'pair_top{k}_jaccard']) for r in run_rows], dtype=np.float64) if run_rows else np.zeros((0,), dtype=np.float64)
                    vals_s = np.asarray([float(r[f'pair_top{k}_spearman']) for r in run_rows if np.isfinite(float(r[f'pair_top{k}_spearman']))], dtype=np.float64)
                    summary_lines.append((f'Top-{int(k)} pair Jaccard: {float(np.mean(vals_j)):.4f} ± {float(np.std(vals_j)):.4f}' if vals_j.size else f'Top-{int(k)} pair Jaccard: nan'))
                    summary_lines.append((f'Top-{int(k)} pair Spearman: {float(np.mean(vals_s)):.4f} ± {float(np.std(vals_s)):.4f}' if vals_s.size else f'Top-{int(k)} pair Spearman: nan'))
                for m in bundle_levels:
                    vals_j = np.asarray([float(r[f'bundle_top{m}_jaccard']) for r in run_rows], dtype=np.float64) if run_rows else np.zeros((0,), dtype=np.float64)
                    vals_s = np.asarray([float(r[f'bundle_top{m}_spearman']) for r in run_rows if np.isfinite(float(r[f'bundle_top{m}_spearman']))], dtype=np.float64)
                    vals_r = np.asarray([float(r[f'region_top{m}_overlap_mean']) for r in run_rows if np.isfinite(float(r[f'region_top{m}_overlap_mean']))], dtype=np.float64)
