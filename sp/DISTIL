def _limit_blas_threads(n: int = 1, force: bool = False):
    """
    並列実行（multiprocessing / joblib / numba parallel 等）と併用時の
    過剰スレッド化を防ぐため、BLAS系のスレッド数を既定で1に抑制。
    事前に環境変数が設定されていれば setdefault によりそちらを優先。
    force=True の場合は環境変数を強制上書きする（--blas-threads 指定時）。
    """
    keys = ("OMP_NUM_THREADS","MKL_NUM_THREADS","OPENBLAS_NUM_THREADS","NUMEXPR_NUM_THREADS")
    if force:
        for k in keys:
            os.environ[k] = str(n)
    else:
        for k in keys:
            os.environ.setdefault(k, str(n))

# ---- Logging (STRICT policy) ----
# log_level: quiet < info < debug
_LOG_LEVEL = "info"
_LOG_LEVEL_RANK = {"quiet": 0, "info": 1, "debug": 2}

def _set_log_level(level: str | None) -> None:
    """Set global log level. None keeps current."""
    global _LOG_LEVEL
    if level is None:
        return
    lvl = str(level).lower().strip()
    if lvl not in _LOG_LEVEL_RANK:
        lvl = "info"
    _LOG_LEVEL = lvl

def _log_enabled(min_level: str) -> bool:
    return _LOG_LEVEL_RANK.get(_LOG_LEVEL, 1) >= _LOG_LEVEL_RANK.get(str(min_level), 1)

def log_info(msg: str) -> None:
    if _log_enabled("info"):
        print(_apply_log_prefix(f"[INFO] {msg}"), file=sys.stderr, flush=True)

def log_debug(msg: str) -> None:
    if _log_enabled("debug"):
        print(_apply_log_prefix(f"[DEBUG] {msg}"), file=sys.stderr, flush=True)

def _info(msg: str) -> None:
    # Backward-compatible alias used across the file.
    log_info(msg)

def _is_verbose(args) -> bool:
    """Return True if info/debug logging is enabled."""
    if args is None:
        return _log_enabled("info")
    ll = getattr(args, "log_level", _LOG_LEVEL)
    return str(ll).lower() in ("info", "debug") or bool(getattr(args, "verbose", False)) or bool(getattr(args, "debug", False))


def log_warn(msg: str) -> None:
    if _log_enabled("info"):
        print(_apply_log_prefix(f"[WARN] {msg}"), file=sys.stderr, flush=True)

def _load_feature_chunk_orig_with_progress(path: Path, sel_fids: np.ndarray, *, progress_label: str = 'feature_chunk', progress_interval_sec: float = 60.0, col_block: int = 128, verbose: bool = True) -> np.ndarray:
    """Load selected columns from an existing full feature matrix with heartbeat logs."""
    X = np.load(path, mmap_mode='r')
    sel = np.asarray(sel_fids, dtype=np.int64)
    if sel.size == 0:
        return np.zeros((int(X.shape[0]), 0), dtype=np.float32)
    out = np.empty((int(X.shape[0]), int(sel.size)), dtype=np.float32)
    if bool(verbose):
        logger = _progress_logger(
            progress_label,
            total_units=int(sel.size),
            min_interval_sec=max(1.0, float(progress_interval_sec)),
            active_label='cols',
        )
    else:
        logger = lambda *_args, **_kwargs: None
    step = max(1, int(col_block))
    for s in range(0, int(sel.size), step):
        e = min(int(sel.size), s + step)
        out[:, s:e] = np.array(X[:, sel[s:e]], dtype=np.float32, copy=False)
        logger(e, active=int(e - s), force=False)
    logger(int(sel.size), active=0, force=True)
    return out

def _write_replica_features_meta(rep_outdir: Path, src_paths: FeatureArtifactPaths, src_meta: dict | None = None) -> None:
    """Create replica-local features_meta.json pointing at replica-local links.

    Stage6 replica runs should reuse the parent selected-feature artifacts through files that
    live in the replica outdir. Relying on parent absolute paths in ``meta`` can
    leave ``art`` stale after a direct selected-feature rebuild and make later shape checks
    read the wrong files. This helper rewrites only the path-bearing keys while
    preserving signatures and other metadata.
    """
    rep_outdir = Path(rep_outdir).resolve()
    data = dict(src_meta or {})
    data['sel_fids'] = str((rep_outdir / SEL_FIDS_NPY).resolve())
    data['top_pairs_csv'] = str((rep_outdir / 'top_pairs_pool.csv').resolve())
    data['pair_index'] = str((rep_outdir / 'pair_index.npy').resolve())
    _write_json_atomic(rep_outdir / FEATURES_META_JSON, data)

def _prepare_direct_pass_runtime(args) -> dict:
    """Resolve the minimal runtime context required for direct selected-feature rebuilding.

    This intentionally re-derives atom selection and A→B atom mapping from the
    reference PDBs so that PASS matrices can be rebuilt even after the original
    full feature matrices have been pruned.
    """
    refA_path, refB_path = _resolve_refs(args)
    atomsA = load_pdb_atoms_one(refA_path)
    atomsB = load_pdb_atoms_one(refB_path)
    natomA = int(len(atomsA))
    natomB = int(len(atomsB))
    specA = args.atom_specA if getattr(args, 'atom_specA', None) else args.atom_spec
    specB = args.atom_specB if getattr(args, 'atom_specB', None) else args.atom_spec
    maskA = eval_atom_specifier(specA, atomsA)
    maskB = eval_atom_specifier(specB, atomsB)
    if _equiv_mode(args) == 'aggregate' and bool(getattr(args, 'equiv_expand_selection', True)):
        tpl_common = getattr(args, 'tpl', None)
        tplA = getattr(args, 'tplA', None) or tpl_common
        tplB = getattr(args, 'tplB', None) or tpl_common
        eqA = _build_equiv_context_for_side(atomsA, tpl_path=Path(tplA).resolve() if tplA is not None else None, equiv_map=getattr(args, 'equiv_map', None), mode='aggregate', verbose=False)
        eqB = _build_equiv_context_for_side(atomsB, tpl_path=Path(tplB).resolve() if tplB is not None else None, equiv_map=getattr(args, 'equiv_map', None), mode='aggregate', verbose=False)
        maskA = _expand_selection_for_equiv(maskA, eqA, atomsA, label='A/direct', enabled=True)
        maskB = _expand_selection_for_equiv(maskB, eqB, atomsB, label='B/direct', enabled=True)
    sel_idxA = np.where(maskA)[0]
    sel_idxB = np.where(maskB)[0]
    if sel_idxA.size == 0 or sel_idxB.size == 0:
        raise SystemExit(f'[DISTIL] direct selected-feature rebuild failed: atom selection is empty (A:{sel_idxA.size}, B:{sel_idxB.size}).')
    if sel_idxA.size != sel_idxB.size:
        raise SystemExit(f'[DISTIL] direct selected-feature rebuild failed: selected atom counts differ: A={sel_idxA.size} B={sel_idxB.size}.')
    elemA = [atomsA[i].elem for i in sel_idxA]
    elemB = [atomsB[i].elem for i in sel_idxB]
    mism = [k for k, (ea, eb) in enumerate(zip(elemA, elemB)) if ea != eb]
    if mism:
        raise SystemExit(f'[DISTIL] direct selected-feature rebuild failed: atom-spec element mismatch at {len(mism)} positions between A and B.')
    res_keysA, res_of_atomA = _build_residue_keys_and_map(atomsA, sel_idxA)
    res_keysB, res_of_atomB = _build_residue_keys_and_map(atomsB, sel_idxB)
    _assert_residue_alignment(res_keysA, res_keysB, verbose=False)
    perm_B_of_A = build_perm_B_of_A(atomsA, sel_idxA, atomsB, sel_idxB)
    return {
        'refA_path': refA_path,
        'refB_path': refB_path,
        'natomA': natomA,
        'natomB': natomB,
        'sel_idxA': sel_idxA,
        'sel_idxB': sel_idxB,
        'res_of_atomA': np.asarray(res_of_atomA, dtype=np.int32),
        'res_of_atomB': np.asarray(res_of_atomB, dtype=np.int32),
        'n_res': int(len(res_keysA)),
        'perm_B_of_A': np.asarray(perm_B_of_A, dtype=np.int32),
    }

def read_prob_file(path: Path) -> ProbSpec:
    """Ens_Ana inweight.f90 準拠の .prob を読み込む"""
    _info(f"Now reading PROB: {path}")
    with path.open('r', encoding='utf-8', errors='ignore') as f:
        lines = [l.strip() for l in f.readlines()]
    it = iter(lines)

    method = next(it).split()[0].upper()
    if method not in ("MULT", "ALSD"):
        raise ValueError(f"GE_method must be MULT or ALSD, got: {method}")

    # nBIN, EbinSZ, minEc の行
    nbin = tuple(map(int, next(it).split()))
    ebinsz = tuple(map(float, next(it).split()))
    minec = tuple(map(float, next(it).split()))

    if method == "MULT":
        if len(nbin) != 1 or len(ebinsz) != 1 or len(minec) != 1:
            raise ValueError("MULT expects 1 value for nBIN/EbinSZ/minEc")
        # 空行1つを許容
        _ = next(it, "")
        arr = []
        for _i in range(nbin[0]):
            arr.append(float(next(it)))
        wei = np.asarray(arr, dtype=np.float64)  # shape (n1,)
    else:  # ALSD
        if len(nbin) != 2 or len(ebinsz) != 2 or len(minec) != 2:
            raise ValueError("ALSD expects 2 values for nBIN/EbinSZ/minEc")
        w = np.zeros((nbin[0], nbin[1]), dtype=np.float64)
        for j in range(nbin[1]):
            _ = next(it, "")  # ブロック前の空行を許容
            for i in range(nbin[0]):
                w[i, j] = float(next(it))
        wei = w

    _info(f"PROB loaded: method={method}, nBIN={nbin}, EbinSZ={ebinsz}, minEc={minec}")
    return ProbSpec(method=method, nbin=nbin, ebinsz=ebinsz, minec=minec, wei=wei)

def assign_weights_from_prob(headers: list[dict], prob: ProbSpec) -> np.ndarray:
    """
    Ens_Anaの重み割当と同じ規則で、各フレームの重みを返す。
    MULT  : ep を使用
    ALSD  : t1,t2 (ttepotcc(1), ttepotcc(2)) を使用
    """
    F = len(headers)
    w = np.zeros(F, dtype=np.float64)

    def col(name: str, alts: tuple[str, ...] = ()) -> np.ndarray | None:
        # ヘッダ列を numpy 配列で取得（全フレーム存在するキーを優先）
        keys = (name,) + alts
        for k in keys:
            vals = [h.get(k, None) for h in headers]
            if all(v is not None for v in vals):
                return np.asarray(vals, dtype=np.float64)
        return None

    if prob.method == "MULT":
        ep = col("ep")
        if ep is None:
            raise KeyError("Header 'ep' not found; cannot assign MULT weights")
        n1 = prob.nbin[0]; dz1 = prob.ebinsz[0]; mn1 = prob.minec[0]
        k = np.floor((ep - mn1) / dz1 + 1.0).astype(np.int64)
        m = (k >= 1) & (k <= n1)
        w[m] = prob.wei[k[m] - 1]
        _info(f"[weight] MULT hits={int(m.sum())}/{F}, out_of_range={int((~m).sum())}")
    else:  # ALSD
        # t1,t2 は DISTIL のヘッダキー（ttepotcc(1:3) が t1,t2,t3 に対応）
        t1 = col("t1", ("ttepotcc1", "ttepot1"))
        t2 = col("t2", ("ttepotcc2", "ttepot2"))
        if t1 is None or t2 is None:
            raise KeyError("Headers 't1'/'t2' not found; cannot assign ALSD weights")
        n1, n2 = prob.nbin
        dz1, dz2 = prob.ebinsz
        mn1, mn2 = prob.minec
        k  = np.floor((t1 - mn1) / dz1 + 1.0).astype(np.int64)
        k2 = np.floor((t2 - mn2) / dz2 + 1.0).astype(np.int64)
        m = (k >= 1) & (k <= n1) & (k2 >= 1) & (k2 <= n2)
        if m.any():
            w[m] = prob.wei[k[m] - 1, k2[m] - 1]
        _info(f"[weight] ALSD hits={int(m.sum())}/{F}, out_of_range={int((~m).sum())}")

    # 参考: 代表値のレンジを一度だけ表示（デバッグ用）
    try:
        if prob.method == "MULT":
            _info(f"[weight] ep min/max = {float(np.nanmin(ep)):.1f} / {float(np.nanmax(ep)):.1f}")
        else:
            _info(f"[weight] t1 min/max = {float(np.nanmin(t1)):.1f} / {float(np.nanmax(t1)):.1f} ; "
                  f"t2 min/max = {float(np.nanmin(t2)):.1f} / {float(np.nanmax(t2)):.1f}")
    except Exception:
        pass

    return w

class P2Quantile:
    __slots__ = ("p","n","q","m","np_","dn","_init_x","_init_w","_init_sum","_init_done")
    def __init__(self, p: float):
        if not (0.0 < p < 1.0):
            raise ValueError("p must be in (0,1)")
        self.p   = float(p)
        if not (0.0 <= self.p <= 1.0):
            raise ValueError(f"p must be in (0,1), got {self.p}")
        self.n   = 0.0                 # 合計重み（以後も“位置”の単位は重み）
        self.q   = [0.0]*5             # マーカー高さ
        self.m   = [0.0]*5             # マーカー位置（重み単位の連続量）
        self.np_ = [0.0]*5             # 望ましい位置
        self.dn  = [0.0, self.p/2.0, self.p, (1.0+self.p)/2.0, 1.0]
        # 重み付き初期化用バッファ
        self._init_x: list[float] = []
        self._init_w: list[float] = []
        self._init_sum: float = 0.0
        self._init_done: bool = False
    def _finish_init(self):
        """重み合計が閾値に達したら、重み付き分位で q を初期化し、m/np_ を重みスケールで配置。"""
        W = self._init_sum
        # 分位は 0, 0.25, 0.5, 0.75, 1.0
        ps = (0.0, 0.25, 0.5, 0.75, 1.0)
        self.q = [
            _weighted_quantile(self._init_x, self._init_w, p_) for p_ in ps
        ]
        # 位置は重みスケールで等間隔（元のP²の 1..5 を重み合計Wにスケール）
        s = W / 5.0
        self.m = [s*1.0, s*2.0, s*3.0, s*4.0, s*5.0]
        self.np_ = [s*1.0,
                    s*(1.0 + 2.0*self.p),
                    s*(1.0 + 4.0*self.p),
                    s*(3.0 + 2.0*self.p),
                    s*5.0]
        self.n = W
        self._init_done = True
        # バッファは以後使わない
        self._init_x.clear(); self._init_w.clear()
    def update(self, x: float, w: float = 1.0):
        if w <= 0.0:
            return
        # --- 重み付き初期化（合計重みが閾値WBOOTに到達するまで貯める） ---
        WBOOT = 5.0  # 目安（P²の初期5点に対応）。必要なら将来オプション化可。
        if not self._init_done:
            self._init_x.append(float(x))
            self._init_w.append(float(w))
            self._init_sum += float(w)
            if self._init_sum >= WBOOT:
                self._finish_init()
            return
        # どのセルに入るか
        if x < self.q[0]:
            self.q[0] = x
            k = 0
        elif x >= self.q[4]:
            self.q[4] = x
            k = 3
        else:
            k = 0
            while k < 4 and x >= self.q[k+1]:
                k += 1
        # 右側マーカー位置を w だけ進める（連続重み）
        for i in range(k+1, 5):
            self.m[i] += w
        # 望ましい位置も w*dn だけ進める
        for i in range(5):
            self.np_[i] += w * self.dn[i]
        # 内側3本の調整：|np - m| >= 1 の間、±1 ステップずつ進める
        for i in (1, 2, 3):
            # 連続重みでも「±1以上ずれたら1ステップ修正」を繰り返す
            while True:
                d = self.np_[i] - self.m[i]
                cond_pos = (d >= 1.0) and (self.m[i+1] - self.m[i] > 1.0)
                cond_neg = (d <= -1.0) and (self.m[i-1] - self.m[i] < -1.0)
                if not (cond_pos or cond_neg):
                    break
                d_ = 1.0 if d > 0.0 else -1.0
                denom = (self.m[i+1] - self.m[i-1])
                # 放物線補間
                if denom != 0.0:
                    qip = self.q[i] + d_ * (
                        (self.m[i]-self.m[i-1]+d_)*(self.q[i+1]-self.q[i])/(self.m[i+1]-self.m[i]) +
                        (self.m[i+1]-self.m[i]-d_)*(self.q[i]-self.q[i-1])/(self.m[i]-self.m[i-1])
                    ) / denom
                else:
                    qip = self.q[i]
                # バウンド外なら線形補間
                if not (self.q[i-1] < qip < self.q[i+1]):
                    qip = self.q[i] + d_ * (self.q[i + int(d_)] - self.q[i]) / (self.m[i + int(d_)] - self.m[i])
                self.q[i] = qip
                self.m[i] += d_  # 位置は1ステップだけ進める
        # 合計重みの更新
        self.n += w
    def value(self) -> float:
        if (not self._init_done) and self._init_sum == 0.0:
            return float("nan")
        if not self._init_done:
            # ブート中は簡易に重み付き中央値で返す（p=0.5想定の近似）
            return _weighted_quantile(self._init_x, self._init_w, self.p)
        # P²は「目標分位p」を追跡しており、その推定値は常に q[2]（中央マーカー）に格納される
        return float(self.q[2])
if 'numba' in globals():
    @numba.njit(cache=True)
    def _p2_internal_adjust(qi, mi, npi):
        # 内側3本（j=1..3）の調整。|np - m| >= 1 の間、±1だけ進める。
        for j in (1,2,3):
            while True:
                d = npi[j] - mi[j]
                cond_pos = (d >= 1.0) and (mi[j+1] - mi[j] > 1.0)
                cond_neg = (d <= -1.0) and (mi[j-1] - mi[j] < -1.0)
                if not (cond_pos or cond_neg):
                    break
                dj = 1.0 if d > 0.0 else -1.0
                denom = (mi[j+1] - mi[j-1])
                if denom != 0.0 and (mi[j+1]-mi[j]) != 0.0 and (mi[j]-mi[j-1]) != 0.0:
                    qip = qi[j] + dj * (
                        (mi[j]   - mi[j-1] + dj)*(qi[j+1]-qi[j])   /(mi[j+1]-mi[j]) +
                        (mi[j+1] - mi[j]   - dj)*(qi[j]  -qi[j-1]) /(mi[j]  -mi[j-1])
                    ) / denom
                else:
                    qip = qi[j]
                if not (qi[j-1] < qip < qi[j+1]):
                    # 単調性が崩れる場合は線形補間にフォールバック
                    step = 1 if dj > 0.0 else -1
                    qip = qi[j] + dj * (qi[j+step] - qi[j]) / (mi[j+step] - mi[j])
                qi[j] = qip
                mi[j] += dj

    @numba.njit(cache=True, parallel=False)
    def _p2_update_batch_once_j(x_vec, w, q, m, np_, n, p):
        """
        x_vec: (K,)   そのフレームの観測値（距離や|x-med|やz）
        w    : float  重み
        q,m,np_,n,p はそれぞれ (K,5),(K,5),(K,5),(K,),(K,)
        既存の update(x,w) と等価な1サンプル更新を K 本に並列で適用
        """
        K = x_vec.shape[0]
        for i in numba.prange(K):
            x = float(x_vec[i])
            if w <= 0.0:
                continue
            # セル特定と端の処理
            if x < q[i,0]:
                q[i,0] = x
                k = 0
            elif x >= q[i,4]:
                q[i,4] = x
                k = 3
            else:
                k = 0
                while k < 4 and x >= q[i,k+1]:
                    k += 1
            # 実位置 m（kより右を w だけ増やす）
            for j in range(k+1,5):
                m[i,j] += w
            # 望ましい位置 np_（dn に w を掛ける）
            np_[i,0] += w * 0.0
            np_[i,1] += w * (p[i]/2.0)
            np_[i,2] += w * p[i]
            np_[i,3] += w * ((1.0+p[i])/2.0)
            np_[i,4] += w * 1.0
            # マーカー高調整
            _p2_internal_adjust(q[i,:], m[i,:], np_[i,:])
            # 合計重み
            n[i] += w

def _ensure_pdb_path(p: str | Path) -> Path:
    """Return an existing PDB file path (expanded/resolved).

    Accepts strings/Path. Raises SystemExit if the path does not exist or does not look like a PDB.
    """
    pp = Path(p).expanduser()
    # allow relative paths; resolve() without strict to keep nicer errors on missing files
    pp = pp.resolve()
    if not pp.exists():
        raise SystemExit(f"Error: reference PDB not found: {pp}")
    # Basic extension check (keep permissive for .pdb/.ent/.pdb.gz)
    name = pp.name.lower()
    if not (name.endswith('.pdb') or name.endswith('.ent') or name.endswith('.pdb.gz') or name.endswith('.ent.gz')):
        # We still allow if content seems PDB-like (first non-empty line starts with ATOM/HETATM/HEADER)
        try:
            opener = open
            if name.endswith('.gz'):
                import gzip
                opener = lambda x,mode='rt': gzip.open(x, mode)  # type: ignore
            with opener(pp, 'rt') as f:
                for _ in range(50):
                    line = f.readline()
                    if not line:
                        break
                    s=line.strip()
                    if not s:
                        continue
                    if s.startswith(('ATOM', 'HETATM', 'HEADER')):
                        return pp
                    break
        except Exception:
            pass
        raise SystemExit(f"Error: reference must be a PDB file (.pdb/.ent[.gz]): {pp}")
    return pp


