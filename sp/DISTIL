            )
        log_info(f"Cache size: distil_cache/stage1_scoring/ckpt={_format_bytes_gib(_dir_size_bytes(stage1_ckpt_dir))} distil_cache_total={_format_bytes_gib(_dir_size_bytes(cache_dir))}")

    fs_by_fid = {int(fs.fid): fs for fs in feats}

