def _write_feature_metric_pdb(
    out_pdb: Path,
    *,
    ref_lines: list[str],
    full_to_sel: np.ndarray,
    atoms_sel: list,
    atoms_by_res: list[list[int]],
    pair_meta: TopPairsMeta,
    fids: Sequence[int],
    metric_by_fid: Mapping[int, float],
    aggregation: str = 'max',
    missing_value: float = 0.0,
) -> None:
    """Write a PDB with one feature-level metric embedded in the B-factor column.

    near features are mapped to their two endpoint atoms; long features are mapped
    to all selected atoms in the two endpoint residues.  aggregation='max' is used
    for metrics where larger means stronger signal (TV/AUC/G-stat), while
    aggregation='min' is used for raw p/q values where smaller means stronger
    significance.
    """
    aggregation = str(aggregation or 'max').lower()
    if aggregation not in ('max', 'min'):
        raise ValueError(f"invalid aggregation={aggregation!r}; expected max or min")
    n_atoms = int(len(atoms_sel))
    if aggregation == 'min':
        score_atoms = np.full((n_atoms,), np.inf, dtype=np.float64)
    else:
        score_atoms = np.full((n_atoms,), float(missing_value), dtype=np.float64)

    def _assign_atom(sel_atom_idx: int, value: float) -> None:
        if not (0 <= int(sel_atom_idx) < n_atoms):
            return
        if not np.isfinite(value):
            return
        if aggregation == 'min':
            if float(value) < score_atoms[int(sel_atom_idx)]:
                score_atoms[int(sel_atom_idx)] = float(value)
        else:
            if float(value) > score_atoms[int(sel_atom_idx)]:
                score_atoms[int(sel_atom_idx)] = float(value)

    for fid0 in fids:
        try:
            fid = int(fid0)
        except Exception:
            continue
        if not (0 <= fid < len(pair_meta)):
            continue
        val = metric_by_fid.get(fid, float('nan'))
        try:
            val = float(val)
        except Exception:
            val = float('nan')
        if not np.isfinite(val):
            continue
        try:
            kind = int(pair_meta.kind[fid])
        except Exception:
            kind = 1
        if kind == 0:
            _assign_atom(int(pair_meta.atom_i[fid]), val)
            _assign_atom(int(pair_meta.atom_j[fid]), val)
        else:
            ri = int(_meta_res(pair_meta, fid, 'i'))
            rj = int(_meta_res(pair_meta, fid, 'j'))
            if 0 <= ri < len(atoms_by_res):
                for ak in atoms_by_res[ri]:
                    _assign_atom(int(ak), val)
            if 0 <= rj < len(atoms_by_res):
                for ak in atoms_by_res[rj]:
                    _assign_atom(int(ak), val)

    if aggregation == 'min':
        score_atoms[~np.isfinite(score_atoms)] = float(missing_value)

    out_pdb = Path(out_pdb)
    out_pdb.parent.mkdir(parents=True, exist_ok=True)
    atom_counter = -1
    with open(out_pdb, 'w', encoding='utf-8') as fo:
        for line in ref_lines:
            sline = line.lstrip(' 	')
            rec = _pdb_rec_name(sline)
            if not (rec == 'ATOM' or rec == 'HETATM'):
                fo.write(line)
                continue
            atom_counter += 1
            val_b = float(missing_value)
            if 0 <= atom_counter < len(full_to_sel):
                k = int(full_to_sel[atom_counter])
                if 0 <= k < len(score_atoms):
                    val_b = float(score_atoms[k])
            if not np.isfinite(val_b):
                val_b = float(missing_value)
            val_b = min(max(float(val_b), 0.0), 999.99)
            line2 = line.rstrip('\n')
            if len(line2) < 80:
                line2 = line2.ljust(80)
            # occupancy is not used for Stage1 metric PDBs.
            line2 = line2[:54] + f"{0.0:6.2f}" + line2[60:]
            line2 = line2[:60] + f"{val_b:6.2f}" + line2[66:]
            fo.write(line2 + '\n')


