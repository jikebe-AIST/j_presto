def _make_logistic_regression(*, penalty: str, C: float, solver: str, max_iter: int, random_state: int):
    """Construct LogisticRegression across supported scikit-learn APIs."""
    if LogisticRegression is None:
        raise RuntimeError('scikit-learn is unavailable')
    p = str(penalty or 'l2').lower()
    kwargs = {
        'C': float(C), 'solver': str(solver), 'max_iter': int(max_iter),
        'random_state': int(random_state),
    }
    try:
        penalty_default = inspect.signature(LogisticRegression).parameters['penalty'].default
    except Exception:
        penalty_default = None
    if penalty_default == 'deprecated':
        if p == 'l1':
            kwargs['l1_ratio'] = 1.0
        elif p == 'l2':
            kwargs['l1_ratio'] = 0.0
        elif p in ('none', 'null'):
            kwargs['C'] = float('inf')
            kwargs['l1_ratio'] = 0.0
        else:
            raise ValueError(f'unsupported logistic-regression penalty: {penalty!r}')
    else:
        kwargs['penalty'] = p
    return LogisticRegression(**kwargs)


