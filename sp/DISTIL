def _contrib_resolve_workers(requested: int, *, default_auto: int = 4, max_auto: int = 8) -> int:
    req = int(requested or 0)
    if req > 0:
        return max(1, req)
    preferred = int(os.environ.get('NUMBA_NUM_THREADS', '0') or 0)
    if preferred <= 0:
        preferred = int(os.environ.get('SLURM_CPUS_PER_TASK', '0') or 0)
    avail = None
    try:
        avail = len(os.sched_getaffinity(0))
    except Exception:
        avail = None
    if avail is None or avail <= 0:
        avail = int(os.environ.get('SLURM_CPUS_PER_TASK', '0') or 0) or (os.cpu_count() or 1)
    base = int(preferred or default_auto or 1)
    return max(1, min(int(max_auto), int(base), int(avail)))

