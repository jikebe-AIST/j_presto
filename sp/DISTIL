    ced_rnull_by_fid = {fid: float(getattr(fs, 'ced_r_null', 0.0)) for fid, fs in feats_by_fid.items() if bool(getattr(fs, 'passed_ced', False)) and float(getattr(fs, 'ced_r_null', 0.0)) > 0.0}
    passed_ced_by_fid = {fid: 1.0 for fid, fs in feats_by_fid.items() if bool(getattr(fs, 'passed_ced', False))}
