        old.update(meta)
        _write_json_atomic(pdb_dir / 'metric_pdbs.json', old)
    except Exception as e:
        log_warn(f"Stage1 metric PDB: could not write metric_pdbs.json: {e}")


_TV_WINSOR_Q = 0.01


def _hist_prob_uniform(x: np.ndarray, w: np.ndarray, *, bins: int, x_min: float, x_max: float) -> np.ndarray:
    """Backward-compatible wrapper for histogram probability.

    The implementation uses winsor-style clipping (see _hist_prob_uniform_clip)
    to avoid dropping mass when the bin range is estimated from a subsample.
    """
    return _hist_prob_uniform_clip(x, w, bins=int(bins), x_min=float(x_min), x_max=float(x_max))





def _make_contiguous_blocks_by_len(n_frames: int, block_len: int, min_block_len: int = 1) -> list[tuple[int, int]]:
    n_frames = int(n_frames)
    block_len = max(1, int(block_len))
    min_block_len = max(1, int(min_block_len))
    if n_frames <= 0:
        return []
    if n_frames <= block_len:
        return [(0, n_frames)]
    blocks: list[tuple[int, int]] = []
    s = 0
    while s < n_frames:
        e = min(n_frames, s + block_len)
        if n_frames - e < min_block_len:
            e = n_frames
        blocks.append((s, e))
        s = e
    return blocks


def _autocorr_time_positive_iact(x: np.ndarray, max_lag: int = 0) -> float:
    x = np.asarray(x, dtype=np.float64).ravel()
    n = int(x.size)
    if n <= 2:
        return 1.0
    x = x[np.isfinite(x)]
    n = int(x.size)
    if n <= 2:
        return 1.0
    x = x - float(np.mean(x))
    var = float(np.dot(x, x) / n)
    if not np.isfinite(var) or var <= 1e-18:
        return 1.0
    if int(max_lag) <= 0:
        max_lag = min(n - 1, max(16, int(math.ceil(n / 4))))
    else:
        max_lag = min(n - 1, int(max_lag))
    nfft = 1 << int(math.ceil(math.log2(max(2, 2 * n - 1))))
    fx = np.fft.rfft(x, n=nfft)
    ac = np.fft.irfft(fx * np.conjugate(fx), n=nfft)[: n]
    denom = np.arange(n, 0, -1, dtype=np.float64)
    ac = ac / denom
    rho = ac / var
    if not np.isfinite(rho[0]) or rho[0] <= 0.0:
        return 1.0
    tau = 1.0
    for lag in range(1, max_lag + 1):
        r = float(rho[lag])
        if (not np.isfinite(r)) or r <= 0.0:
            break
        tau += 2.0 * r
    if not np.isfinite(tau) or tau < 1.0:
        return 1.0
    return float(tau)



def _build_block_hist_matrix(x: np.ndarray, w: np.ndarray, blocks: list[tuple[int, int]], *, bins: int, x_min: float, x_max: float, eps: float) -> np.ndarray:
    mats = []
    for s, e in blocks:
        h = _hist_prob_uniform(np.asarray(x[s:e], dtype=np.float64), np.asarray(w[s:e], dtype=np.float64), bins=int(bins), x_min=float(x_min), x_max=float(x_max)).astype(np.float64, copy=False)
        h = np.clip(h, 0.0, None)
        h = h + float(eps)
        hs = float(np.sum(h))
        if hs > 0.0:
            h = h / hs
        mats.append(h)
    if mats:
        return np.vstack(mats).astype(np.float64, copy=False)
    return np.zeros((0, int(bins)), dtype=np.float64)


def _weighted_effective_sample_size(w: np.ndarray) -> float:
    w = np.asarray(w, dtype=np.float64)
    w = w[np.isfinite(w) & (w > 0.0)]
    if w.size == 0:
        return 0.0
    den = float(np.sum(w ** 2))
    if den <= 0.0:
        return 0.0
    return float((np.sum(w) ** 2) / den)


def _llr_scores_from_hist_probs(x: np.ndarray, pA: np.ndarray, pB: np.ndarray, *, bins: int, x_min: float, x_max: float, eps: float) -> np.ndarray:
    x = np.asarray(x, dtype=np.float64)
    bins = int(max(2, bins))
    if not np.isfinite(x_min) or not np.isfinite(x_max) or x_max <= x_min:
        if x.size:
            x_min = float(np.nanmin(x)); x_max = float(np.nanmax(x))
        else:
            x_min, x_max = 0.0, 1.0
        if not np.isfinite(x_min) or not np.isfinite(x_max) or x_max <= x_min:
            x_max = x_min + 1e-6
    t = (x - float(x_min)) / float(x_max - x_min)
    idx = np.floor(t * bins).astype(np.int64)
    idx = np.clip(idx, 0, bins - 1)
    llr = np.log(np.asarray(pB, dtype=np.float64) + float(eps)) - np.log(np.asarray(pA, dtype=np.float64) + float(eps))
    return llr[idx].astype(np.float64, copy=False)


def _cv_llr_holdout_auc(xA: np.ndarray, xB: np.ndarray, wA: np.ndarray, wB: np.ndarray, *, bins: int, x_min: float, x_max: float, eps: float, cv_folds: int = 5, random_state: int = 0, progress_label: str | None = None, progress_interval_sec: float = 300.0) -> tuple[float, np.ndarray, np.ndarray]:
    if roc_auc_score is None or StratifiedKFold is None:
        return float('nan'), np.zeros((np.asarray(xA).shape[0] + np.asarray(xB).shape[0],), dtype=np.float64), np.zeros((0,), dtype=np.float64)
    xA = np.asarray(xA, dtype=np.float64)
    xB = np.asarray(xB, dtype=np.float64)
    wA = np.asarray(wA, dtype=np.float64)
    wB = np.asarray(wB, dtype=np.float64)
    nA = int(xA.shape[0]); nB = int(xB.shape[0])
    y = np.concatenate([np.zeros((nA,), dtype=np.int32), np.ones((nB,), dtype=np.int32)])
    sw = np.concatenate([wA, wB]).astype(np.float64, copy=False)
    if nA < 2 or nB < 2:
        pA = _hist_prob_uniform(xA, wA, bins=int(bins), x_min=float(x_min), x_max=float(x_max)).astype(np.float64, copy=False)
        pB = _hist_prob_uniform(xB, wB, bins=int(bins), x_min=float(x_min), x_max=float(x_max)).astype(np.float64, copy=False)
        scores = np.concatenate([
            _llr_scores_from_hist_probs(xA, pA, pB, bins=int(bins), x_min=float(x_min), x_max=float(x_max), eps=float(eps)),
            _llr_scores_from_hist_probs(xB, pA, pB, bins=int(bins), x_min=float(x_min), x_max=float(x_max), eps=float(eps)),
        ]).astype(np.float64, copy=False)
        return float('nan'), scores, np.asarray([], dtype=np.float64)
    n_splits = min(int(cv_folds), nA, nB)
    if n_splits < 2:
        pA = _hist_prob_uniform(xA, wA, bins=int(bins), x_min=float(x_min), x_max=float(x_max)).astype(np.float64, copy=False)
        pB = _hist_prob_uniform(xB, wB, bins=int(bins), x_min=float(x_min), x_max=float(x_max)).astype(np.float64, copy=False)
        scores = np.concatenate([
            _llr_scores_from_hist_probs(xA, pA, pB, bins=int(bins), x_min=float(x_min), x_max=float(x_max), eps=float(eps)),
            _llr_scores_from_hist_probs(xB, pA, pB, bins=int(bins), x_min=float(x_min), x_max=float(x_max), eps=float(eps)),
        ]).astype(np.float64, copy=False)
        return float('nan'), scores, np.asarray([], dtype=np.float64)
    preds = np.zeros((nA + nB,), dtype=np.float64)
    idxA = np.arange(nA, dtype=np.int64)
    idxB = np.arange(nB, dtype=np.int64)
    dummyA = np.zeros((nA,), dtype=np.int32)
    dummyB = np.zeros((nB,), dtype=np.int32)
    skfA = StratifiedKFold(n_splits=n_splits, shuffle=True, random_state=int(random_state))
    skfB = StratifiedKFold(n_splits=n_splits, shuffle=True, random_state=int(random_state) ^ 0x9E3779B9)
    splitsA = list(skfA.split(idxA, dummyA))
    splitsB = list(skfB.split(idxB, dummyB))
    fold_logger = _progress_logger(progress_label, total_units=n_splits, min_interval_sec=progress_interval_sec) if progress_label else None
    for fold_idx, ((trA, teA), (trB, teB)) in enumerate(zip(splitsA, splitsB), start=1):
        if fold_logger is not None and _log_enabled('info'):
            fold_logger(fold_idx - 1, active=fold_idx, force=False)
        pA_tr = _hist_prob_uniform(xA[trA], wA[trA], bins=int(bins), x_min=float(x_min), x_max=float(x_max)).astype(np.float64, copy=False)
        pB_tr = _hist_prob_uniform(xB[trB], wB[trB], bins=int(bins), x_min=float(x_min), x_max=float(x_max)).astype(np.float64, copy=False)
        preds[teA] = _llr_scores_from_hist_probs(xA[teA], pA_tr, pB_tr, bins=int(bins), x_min=float(x_min), x_max=float(x_max), eps=float(eps))
        preds[nA + teB] = _llr_scores_from_hist_probs(xB[teB], pA_tr, pB_tr, bins=int(bins), x_min=float(x_min), x_max=float(x_max), eps=float(eps))
    if fold_logger is not None and _log_enabled('info'):
        fold_logger(n_splits, active=0, force=True)
    auc_kwargs = {}
    if sw.shape[0] == preds.shape[0]:
        auc_kwargs['sample_weight'] = sw
    try:
        auc = float(roc_auc_score(y, preds, **auc_kwargs))
    except Exception:
        auc = float('nan')
    pA_full = _hist_prob_uniform(xA, wA, bins=int(bins), x_min=float(x_min), x_max=float(x_max)).astype(np.float64, copy=False)
    pB_full = _hist_prob_uniform(xB, wB, bins=int(bins), x_min=float(x_min), x_max=float(x_max)).astype(np.float64, copy=False)
    final_scores = np.concatenate([
        _llr_scores_from_hist_probs(xA, pA_full, pB_full, bins=int(bins), x_min=float(x_min), x_max=float(x_max), eps=float(eps)),
        _llr_scores_from_hist_probs(xB, pA_full, pB_full, bins=int(bins), x_min=float(x_min), x_max=float(x_max), eps=float(eps)),
    ]).astype(np.float64, copy=False)
    return auc, final_scores, preds


def _compute_single_feature_auc_and_scores(xA: np.ndarray, xB: np.ndarray, wA: np.ndarray, wB: np.ndarray, *, bins: int, x_min: float, x_max: float, eps: float, cv_folds: int, random_state: int, progress_label: str | None = None, progress_interval_sec: float = 300.0) -> dict[str, object]:
    auc, scores, holdout_scores = _cv_llr_holdout_auc(
        np.asarray(xA, dtype=np.float64), np.asarray(xB, dtype=np.float64),
        np.asarray(wA, dtype=np.float64), np.asarray(wB, dtype=np.float64),
        bins=int(bins), x_min=float(x_min), x_max=float(x_max), eps=float(eps),
        cv_folds=int(cv_folds), random_state=int(random_state), progress_label=progress_label, progress_interval_sec=float(progress_interval_sec),
    )
    neffA = _weighted_effective_sample_size(np.asarray(wA, dtype=np.float64))
    neffB = _weighted_effective_sample_size(np.asarray(wB, dtype=np.float64))
    nA = int(np.asarray(xA).shape[0]); nB = int(np.asarray(xB).shape[0])
    meanA = float(np.average(scores[:nA], weights=np.asarray(wA, dtype=np.float64))) if nA > 0 and float(np.sum(wA)) > 0.0 else float('nan')
    meanB = float(np.average(scores[nA:], weights=np.asarray(wB, dtype=np.float64))) if nB > 0 and float(np.sum(wB)) > 0.0 else float('nan')
    return {'auc': float(auc), 'scores': np.asarray(scores, dtype=np.float64), 'holdout_scores': np.asarray(holdout_scores, dtype=np.float64), 'neff_A': neffA, 'neff_B': neffB, 'score_mean_A': meanA, 'score_mean_B': meanB}


def _compute_single_feature_auc_and_scores_equiv_distribution(
    xA_raw: np.ndarray, xB_raw: np.ndarray,
    XA_group: np.ndarray, XB_group: np.ndarray,
    wA: np.ndarray, wB: np.ndarray,
    *, bins: int, x_min: float, x_max: float, eps: float, cv_folds: int, random_state: int,
    progress_label: str | None = None, progress_interval_sec: float = 300.0,
) -> dict[str, object]:
    """AUC/scores for a raw member feature using shared equivalent-group distributions.

    The training histograms are built from the mixture of all member columns, with
    each member contributing weight w/member_count.  Scores are evaluated on the
    raw member's own distance values so Stage2 still receives member-specific
    score columns.
    """
    if roc_auc_score is None or StratifiedKFold is None:
        nA = int(np.asarray(xA_raw).shape[0]); nB = int(np.asarray(xB_raw).shape[0])
        return {'auc': float('nan'), 'scores': np.zeros((nA+nB,), dtype=np.float64), 'holdout_scores': np.zeros((0,), dtype=np.float64), 'neff_A': 0.0, 'neff_B': 0.0, 'score_mean_A': float('nan'), 'score_mean_B': float('nan')}
    xA_raw=np.asarray(xA_raw,dtype=np.float64); xB_raw=np.asarray(xB_raw,dtype=np.float64)
    XA_group=np.asarray(XA_group,dtype=np.float64); XB_group=np.asarray(XB_group,dtype=np.float64)
    wA=np.asarray(wA,dtype=np.float64); wB=np.asarray(wB,dtype=np.float64)
    nA=xA_raw.size; nB=xB_raw.size
    mA = max(1, int(XA_group.shape[1]) if XA_group.ndim == 2 else 1)
    mB = max(1, int(XB_group.shape[1]) if XB_group.ndim == 2 else 1)
    XA_flat = XA_group.reshape(-1) if XA_group.ndim == 2 else XA_group.reshape(-1)
    XB_flat = XB_group.reshape(-1) if XB_group.ndim == 2 else XB_group.reshape(-1)
    wA_flat = np.repeat(wA / float(mA), mA)
    wB_flat = np.repeat(wB / float(mB), mB)
    y=np.concatenate([np.zeros((nA,),dtype=np.int32), np.ones((nB,),dtype=np.int32)])
    sw=np.concatenate([wA,wB]).astype(np.float64, copy=False)
    n_splits=min(int(cv_folds), nA, nB)
    preds=np.zeros((nA+nB,), dtype=np.float64)
    if n_splits >= 2:
        idxA=np.arange(nA,dtype=np.int64); idxB=np.arange(nB,dtype=np.int64)
        dummyA=np.zeros((nA,),dtype=np.int32); dummyB=np.zeros((nB,),dtype=np.int32)
        skfA=StratifiedKFold(n_splits=n_splits, shuffle=True, random_state=int(random_state))
        skfB=StratifiedKFold(n_splits=n_splits, shuffle=True, random_state=int(random_state)^0x9E3779B9)
        splitsA=list(skfA.split(idxA,dummyA)); splitsB=list(skfB.split(idxB,dummyB))
        for (trA,teA),(trB,teB) in zip(splitsA,splitsB):
            # Flatten training mixture rows for selected frames.
            XA_tr = XA_group[trA,:].reshape(-1) if XA_group.ndim == 2 else XA_group[trA]
            XB_tr = XB_group[trB,:].reshape(-1) if XB_group.ndim == 2 else XB_group[trB]
            wA_tr = np.repeat(wA[trA] / float(mA), mA)
            wB_tr = np.repeat(wB[trB] / float(mB), mB)
            pA=_hist_prob_uniform(XA_tr, wA_tr, bins=int(bins), x_min=float(x_min), x_max=float(x_max)).astype(np.float64, copy=False)
            pB=_hist_prob_uniform(XB_tr, wB_tr, bins=int(bins), x_min=float(x_min), x_max=float(x_max)).astype(np.float64, copy=False)
            preds[teA]=_llr_scores_from_hist_probs(xA_raw[teA], pA, pB, bins=int(bins), x_min=float(x_min), x_max=float(x_max), eps=float(eps))
            preds[nA+teB]=_llr_scores_from_hist_probs(xB_raw[teB], pA, pB, bins=int(bins), x_min=float(x_min), x_max=float(x_max), eps=float(eps))
    else:
        preds[:] = 0.0
    try:
        auc=float(roc_auc_score(y, preds, sample_weight=sw)) if n_splits >= 2 else float('nan')
    except Exception:
        auc=float('nan')
    pA_full=_hist_prob_uniform(XA_flat, wA_flat, bins=int(bins), x_min=float(x_min), x_max=float(x_max)).astype(np.float64, copy=False)
    pB_full=_hist_prob_uniform(XB_flat, wB_flat, bins=int(bins), x_min=float(x_min), x_max=float(x_max)).astype(np.float64, copy=False)
    scores=np.concatenate([
        _llr_scores_from_hist_probs(xA_raw, pA_full, pB_full, bins=int(bins), x_min=float(x_min), x_max=float(x_max), eps=float(eps)),
        _llr_scores_from_hist_probs(xB_raw, pA_full, pB_full, bins=int(bins), x_min=float(x_min), x_max=float(x_max), eps=float(eps)),
    ]).astype(np.float64, copy=False)
    meanA=float(np.average(scores[:nA], weights=wA)) if nA>0 and float(np.sum(wA))>0 else float('nan')
    meanB=float(np.average(scores[nA:], weights=wB)) if nB>0 and float(np.sum(wB))>0 else float('nan')
    return {'auc': float(auc), 'scores': scores, 'holdout_scores': preds, 'neff_A': _weighted_effective_sample_size(wA), 'neff_B': _weighted_effective_sample_size(wB), 'score_mean_A': meanA, 'score_mean_B': meanB}

def _weighted_sample_idx_global(w: np.ndarray, n: int, rng: np.random.Generator) -> np.ndarray:
    n = int(n)
    w = np.asarray(w, dtype=np.float64)
    if w.size == 0:
        return np.zeros((0,), dtype=np.int64)
    if n <= 0 or n >= w.size:
        return np.arange(w.size, dtype=np.int64)
    ww = np.where(np.isfinite(w) & (w > 0.0), w, 0.0)
    s = float(np.sum(ww))
    if s <= 0.0:
        return np.sort(rng.choice(w.size, size=n, replace=False)).astype(np.int64, copy=False)
    p = ww / s
    p = p / max(1e-300, float(np.sum(p)))
    return np.sort(rng.choice(w.size, size=n, replace=False, p=p)).astype(np.int64, copy=False)



def _cv_decision_auc(X: np.ndarray, y: np.ndarray, *, sample_weight: np.ndarray | None = None, penalty: str = 'l2', C: float = 1.0, max_iter: int = 1000, cv_folds: int = 5, random_state: int = 0, progress_label: str | None = None, progress_interval_sec: float = 300.0, cv_workers: int = 0):
    if LogisticRegression is None or roc_auc_score is None or StratifiedKFold is None:
        return float('nan'), None
    X = np.array(X, dtype=np.float64, copy=False)
    y = np.asarray(y, dtype=np.int32)
    sw = None if sample_weight is None else np.asarray(sample_weight, dtype=np.float64)
    if sw is not None:
        if sw.shape[0] != X.shape[0]:
            return float('nan'), None
        sw = np.where(np.isfinite(sw) & (sw > 0.0), sw, 0.0)
    cls, cnt = np.unique(y, return_counts=True)
    if cls.size < 2 or int(np.min(cnt)) < 2 or X.shape[0] < 4:
        return float('nan'), None
    n_splits = min(int(cv_folds), int(np.min(cnt)))
    if n_splits < 2:
        return float('nan'), None
    solver = 'liblinear' if str(penalty).lower() in ('l1','l2') else 'saga'
    preds = np.zeros((X.shape[0],), dtype=np.float64)
    skf = StratifiedKFold(n_splits=n_splits, shuffle=True, random_state=int(random_state))
    splits = list(skf.split(X, y))
    fold_logger = _progress_logger(progress_label, total_units=n_splits, min_interval_sec=progress_interval_sec) if progress_label else None
    resolved_cv_workers, _cv_detail = _resolve_stage_workers(int(cv_workers or 0), stage='contrib_sklearn_cv')
    use_parallel = bool(X.shape[1] >= 64 and n_splits >= 3 and max(1, resolved_cv_workers) >= 2)
    if use_parallel:
        def _fit_one(item):
            fold_idx, (tr, te) = item
            clf = _make_logistic_regression(penalty=penalty, C=float(C), solver=solver, max_iter=int(max_iter), random_state=int(random_state))
            fit_kwargs = {}
            if sw is not None:
                fit_kwargs['sample_weight'] = sw[tr]
            clf.fit(X[tr], y[tr], **fit_kwargs)
            pred = clf.decision_function(X[te]) if hasattr(clf, 'decision_function') else clf.predict_proba(X[te])[:, 1]
            return fold_idx, te, np.asarray(pred, dtype=np.float64)
        workers = min(max(1, resolved_cv_workers), n_splits)
        with ThreadPoolExecutor(max_workers=workers) as ex:
            futs = [ex.submit(_fit_one, item) for item in enumerate(splits, start=1)]
            done = 0
            for fut in as_completed(futs):
                fold_idx, te, pred = fut.result()
                preds[te] = pred
                done += 1
                if fold_logger is not None and _log_enabled('info'):
                    fold_logger(done, active=workers, force=False)
        if fold_logger is not None and _log_enabled('info'):
            fold_logger(n_splits, active=0, force=True)
    else:
        fold_idx = 0
        for tr, te in splits:
            fold_idx += 1
            if fold_logger is not None and _log_enabled('info'):
                fold_logger(fold_idx - 1, active=fold_idx, force=False)
            clf = _make_logistic_regression(penalty=penalty, C=float(C), solver=solver, max_iter=int(max_iter), random_state=int(random_state))
            fit_kwargs = {}
            if sw is not None:
                fit_kwargs['sample_weight'] = sw[tr]
            clf.fit(X[tr], y[tr], **fit_kwargs)
            preds[te] = clf.decision_function(X[te]) if hasattr(clf, 'decision_function') else clf.predict_proba(X[te])[:, 1]
        if fold_logger is not None and _log_enabled('info'):
            fold_logger(n_splits, active=0, force=True)
    auc_kwargs = {}
    if sw is not None:
        auc_kwargs['sample_weight'] = sw
    auc = float(roc_auc_score(y, preds, **auc_kwargs))
    clf = _make_logistic_regression(penalty=penalty, C=float(C), solver=solver, max_iter=int(max_iter), random_state=int(random_state))
    fit_kwargs = {}
    if sw is not None:
        fit_kwargs['sample_weight'] = sw
    clf.fit(X, y, **fit_kwargs)
    return auc, clf


def _fit_multivar_contrib(X: np.ndarray, y: np.ndarray, *, sample_weight: np.ndarray | None = None, penalty: str = 'l1', C: float = 1.0, max_iter: int = 1000, cv_folds: int = 5, standardize: bool = True, random_state: int = 0, progress_label: str | None = None, progress_interval_sec: float = 300.0, cv_workers: int = 0, pruning_mode: str = 'off', keep_top_auc: int = 256, min_active_features: int = 0, single_feature_auc: np.ndarray | None = None) -> dict[str, object]:
    X = np.asarray(X, dtype=np.float64)
    y = np.asarray(y, dtype=np.int32)
    if X.ndim != 2 or X.shape[0] == 0 or X.shape[1] == 0:
        return {'auc': float('nan'), 'coef': np.zeros((0,), dtype=np.float64), 'feature_std': np.zeros((0,), dtype=np.float64), 'nonzero': 0}
    mu = np.mean(X, axis=0)
    sd = np.std(X, axis=0)
    keep = np.isfinite(mu) & np.isfinite(sd) & (sd > 1e-12)
    Xk = X[:, keep]
    mu = mu[keep]; sd = sd[keep]
    if Xk.shape[1] == 0:
        return {'auc': float('nan'), 'coef': np.zeros((0,), dtype=np.float64), 'feature_std': np.zeros((0,), dtype=np.float64), 'keep_mask': keep, 'nonzero': 0}
    Xuse = ((Xk - mu) / sd) if bool(standardize) else Xk
    sw_use = None if sample_weight is None else np.asarray(sample_weight, dtype=np.float64)
    keep2 = np.ones((Xk.shape[1],), dtype=bool)
    if str(pruning_mode).lower() == 'conservative' and Xk.shape[1] > 0:
        auc_vec = np.asarray(single_feature_auc, dtype=np.float64) if single_feature_auc is not None else np.full((X.shape[1],), 0.5, dtype=np.float64)
        auc_keep = auc_vec[keep] if auc_vec.size == X.shape[1] else np.full((Xk.shape[1],), 0.5, dtype=np.float64)
        min_act = int(min_active_features) if int(min_active_features or 0) > 0 else max(512, int(math.ceil(0.1 * Xk.shape[1])))
        min_act = max(1, min(int(Xk.shape[1]), int(min_act)))
        k_auc = max(min_act, min(int(Xk.shape[1]), int(keep_top_auc or 0)))
        if k_auc < Xk.shape[1]:
            order = np.argsort(-np.abs(np.nan_to_num(auc_keep, nan=0.5) - 0.5))
            keep_idx = np.sort(order[:k_auc])
            keep2[:] = False
            keep2[keep_idx] = True
            Xk = Xk[:, keep2]
            Xuse = Xuse[:, keep2]
            mu = mu[keep2]; sd = sd[keep2]
    auc, clf = _cv_decision_auc(Xuse, y, sample_weight=sw_use, penalty=penalty, C=float(C), max_iter=int(max_iter), cv_folds=int(cv_folds), random_state=int(random_state), progress_label=progress_label, progress_interval_sec=progress_interval_sec, cv_workers=int(cv_workers))
    if clf is None:
        coef_k = np.zeros((Xk.shape[1],), dtype=np.float64)
    else:
        coef_k = np.asarray(clf.coef_[0], dtype=np.float64) if getattr(clf, 'coef_', None) is not None else np.zeros((Xk.shape[1],), dtype=np.float64)
    coef_full = np.zeros((X.shape[1],), dtype=np.float64)
    full_keep = np.zeros((X.shape[1],), dtype=bool)
    keep_idx0 = np.flatnonzero(keep)
    if keep2.size == keep_idx0.size:
        keep_idx = keep_idx0[np.flatnonzero(keep2)]
    else:
        keep_idx = keep_idx0
    coef_full[keep_idx] = coef_k
    full_keep[keep_idx] = True
    feat_std = np.std(X, axis=0).astype(np.float64, copy=False)
    contrib = np.abs(coef_full) * feat_std
    intercept = float(clf.intercept_[0]) if clf is not None and getattr(clf, 'intercept_', None) is not None else 0.0
    return {'auc': float(auc), 'auc_fitted': float(auc), 'coef': coef_full, 'feature_std': feat_std, 'contrib': contrib, 'keep_mask': full_keep, 'nonzero': int(np.count_nonzero(np.abs(coef_k) > 1e-12)), 'intercept': intercept}


def _read_scoring_frame_counts(single_feature_metrics_csv: Path) -> tuple[int, int]:
