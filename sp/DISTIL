            with _open_text_maybe_gz(refA_path) as _fpdb_stage1:
                ref_lines_stage1 = _fpdb_stage1.readlines()
            _write_stage1_metric_pdbs(
                pdb_dir=outdir / 'pdb',
                ref_lines=ref_lines_stage1,
                full_to_sel=full_to_sel_stage1,
                atoms_sel=atoms_sel,
                atoms_by_res=atoms_by_res,
                pair_meta=pair_meta,
                feats=feats,
                single_feature_metrics_csv=single_feature_metrics_csv,
            )
        except Exception as e:
            log_warn(f"Stage1 metric PDB generation failed; continuing without Stage1 metric PDBs: {e}")

        # write unified pair_scores.csv (type preserved)
        def _write_stage1_pair_scores(_fh):
            w = csv.writer(_fh)
            w.writerow([
                "fid","kind","id_str",
                "tv","passed_tv",
                "bins","n_eff",
                "meanA","stdA","meanB","stdB","minv","maxv",
                "transport_w1","transport_signed","transport_ratio",
                "res_i","res_j","atom_i","atom_j","agroup_i","agroup_j",
                "equiv_group_id","equiv_group_label","equiv_distribution_mode","score_source",
            ])
            for fs in feats:
                fid = int(fs.fid)
                w.writerow([
                    fid,
                    "near" if int(fs.kind)==0 else "long",
                    fs.id_str,
                    float(fs.tv), int(bool(fs.passed_tv)),
                    int(fs.bins), int(fs.n_eff),
                    float(fs.meanA), float(fs.stdA), float(fs.meanB), float(fs.stdB), float(fs.minv), float(fs.maxv),
                    float(getattr(fs, 'transport_w1', 0.0)), float(getattr(fs, 'transport_signed', 0.0)), float(getattr(fs, 'transport_ratio', 0.0)),
                    int(pair_meta.res_i[fid]) if fid < len(pair_meta) else -1,
