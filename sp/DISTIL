def _make_contrib_block_holdout_splits(nA: int, nB: int, holdout_splits: int) -> list[tuple[np.ndarray, np.ndarray]]:
    """Return list of (holdA_idx, holdB_idx) block splits within A and B.

    Samples are split contiguously and independently within A and B so that each
    holdout contains one block from A and one block from B. Returned indices are
    local within each class; callers concatenate with the B offset as needed.
    """
    k = max(1, int(holdout_splits))
    idxA = np.arange(int(nA), dtype=np.int64)
    idxB = np.arange(int(nB), dtype=np.int64)
    a_blocks = np.array_split(idxA, k)
    b_blocks = np.array_split(idxB, k)
    splits: list[tuple[np.ndarray, np.ndarray]] = []
    for i in range(k):
        holdA = np.asarray(a_blocks[i], dtype=np.int64)
        holdB = np.asarray(b_blocks[i], dtype=np.int64)
        if holdA.size + holdB.size == 0:
            continue
        if holdA.size >= int(nA) or holdB.size >= int(nB):
            continue
        splits.append((holdA, holdB))
    return splits

def _compute_contrib_block_holdout_auc(*, contrib_solver: str, X_multi: np.ndarray | None, x_memmap_path: Path | None, y: np.ndarray, sample_weight: np.ndarray | None, nA: int, nB: int, penalty: str, C: float, max_iter: int, standardize: bool, random_state: int, progress_interval_sec: float, sample_block_size: int, holdout_splits: int, pruning_mode: str = 'off', prune_warmup_epochs: int = 1, prune_every: int = 1, reactivate_every: int = 3, min_active_features: int = 0, keep_top_beta: int = 256, keep_top_grad: int = 256, keep_top_auc: int = 256, contrib_initial_active_features: object = 'auto', contrib_reactivate_top: int = 256, single_feature_auc: np.ndarray | None = None) -> float:
