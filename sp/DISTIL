                f"max_ced_effect_score={max_ced_score:.6f} within_splits={int(getattr(args, 'ced_within_splits', CED_WITHIN_SPLITS_DEFAULT))} null_splits={int(getattr(args, 'ced_null_splits', CED_NULL_SPLITS_DEFAULT))} "
                f"R_within>={float(getattr(args, 'ced_r_threshold', 1.5)):.3g} Z_within>={float(getattr(args, 'ced_z_threshold', 2.0)):.3g} "
                f"R_null>={float(getattr(args, 'ced_null_r_threshold', 1.2)):.3g} Z_null>={float(getattr(args, 'ced_null_z_threshold', 1.0)):.3g} q_null<={float(getattr(args, 'ced_null_q_threshold', 0.05)):.3g} p_null_diag<={float(getattr(args, 'ced_null_p_threshold', 0.10)):.3g} minTV={float(getattr(args, 'ced_min_tv', 0.02)):.3g}"
            )
