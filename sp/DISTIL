    row_idxB_stage3 = None if stage1_auc_frame_mode == "full" else np.asarray(stage1_auc_idxB, dtype=np.int64)
    nA_stage3 = int(stage3_nA_total if row_idxA_stage3 is None else row_idxA_stage3.size)
    nB_stage3 = int(stage3_nB_total if row_idxB_stage3 is None else row_idxB_stage3.size)
    wA_s = np.asarray(wA if row_idxA_stage3 is None else wA[row_idxA_stage3], dtype=np.float64)
    wB_s = np.asarray(wB if row_idxB_stage3 is None else wB[row_idxB_stage3], dtype=np.float64)
    stage3_direct_store = stage1_scoring_dir / 'stage3_direct_distances'
    if scratch_dir_stage3 is None or not scratch_dir_stage3.exists():
        stage3_scratch_source = None
    else:
        stage3_scratch_source = {
            'kind': 'stage1_scratch',
            'scratch_dir': str(scratch_dir_stage3),
            'io_feat_chunk': int(io_feat_chunk_stage3),
            'nA': int(stage3_nA_total),
            'nB': int(stage3_nB_total),
        }
    if (stage3_direct_store / 'manifest.json').exists() and (stage3_direct_store / 'parts').exists():
        stage3_source = {
            'kind': 'stage1_direct_store',
            'store_dir': str(stage3_direct_store),
            'nA': int(nA_stage3),
            'nB': int(nB_stage3),
            'fallback_source': stage3_scratch_source,
        }
        stage3_source_sig = {
            'direct_store': _content_sig(stage3_direct_store / 'manifest.json'),
            'fallback': 'stage1_scratch' if stage3_scratch_source is not None else 'none',
        }
    else:
        if stage3_scratch_source is None:
            raise RuntimeError('Stage3 requires either Stage1 direct distance store or Stage1 scratch artifacts, but neither is available.')
        stage3_source = stage3_scratch_source
        stage3_source_sig = {'source': 'stage1_scratch'}
    if str(stage3_source.get('kind')) == 'stage1_direct_store':
        log_info(f"Stage3 input source: direct Stage1 distance store selected_features={int(sel_fids.size)} store_dir={stage3_direct_store}")
    else:
        log_info(f"Stage3 input source: stage1 scratch selected_features={int(sel_fids.size)} scratch_dir={scratch_dir_stage3}")
    F = int(sel_fids.size)
    n_frames_stage2 = int(nA_stage3 + nB_stage3)

    matrix_bytes_est = int(max(0, n_frames_stage2) * max(0, F) * 4)
    pair_count_est = int(F * max(0, F - 1) // 2)
    if corr_block_requested > 0:
        block = max(1, int(corr_block_requested))
        corr_block_mode = 'user'
    else:
        if F <= 2000:
            block = min(max(1, F), 1024)
        elif F <= 10000:
            block = 512
        else:
            block = 256
        corr_block_mode = 'auto'
    if corr_method_requested == 'auto':
        corr_method_effective = 'exact_safe_reject'
    elif corr_method_requested == 'safe_prune':
        corr_method_effective = 'exact_safe_reject'
    else:
        corr_method_effective = corr_method_requested
    log_info(
        f"Stage3 correlation config: method_requested={corr_method_requested} method_effective={corr_method_effective} "
        f"edge_complete_for_threshold=yes corr_tau={tau_corr:.4f} selected_features={F} frames={n_frames_stage2} "
        f"pair_count={pair_count_est} corr_block={block} corr_block_mode={corr_block_mode} dense_max_pairs={corr_dense_max_pairs} "
        f"execution_profile={corr_execution_profile} dense_work_threshold={corr_dense_work_threshold:.3e} "
        f"probe_units={corr_profile_probe_units} probe_frames={corr_profile_probe_frames} "
        f"probe_cost_ratios(pruned/dense)={corr_profile_pruned_cost_ratio:.3f}/{corr_profile_dense_cost_ratio:.3f} "
        f"safe_reject_sample_block={corr_sample_block} active_pair_batch={corr_active_pair_batch} active_switch_frac={corr_active_switch_frac:.3f} matrix_est={_format_bytes(matrix_bytes_est)}"
    )

    stage3_z_npy = stage3_corr_dir / 'selected_weighted_standardized.npy'
    stage3_matrix_meta = stage3_corr_dir / 'selected_matrix_meta.json'
    stage3_matrix_done = stage3_corr_dir / 'selected_matrix.done.json'
    stage3_z_shape = (int(F), int(n_frames_stage2))

    want3_matrix = {
        'cache_version': _cache_version_sig(STAGE3_CACHE_VERSION),
        'stage': 'selected_weighted_standardized_matrix_v1',
        'stage1_scoring_meta': _content_sig(scoring_meta_path),
        'selected_feature_ids_final': _content_sig(sel_fids_path),
        'stage1_selected_feature_ids_all_auc': _content_sig(selected_feature_ids_path),
