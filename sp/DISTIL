                res_of_atomB=direct_ctx['res_of_atomB'],
                n_res=int(direct_ctx['n_res']),
                perm_B_of_A=direct_ctx['perm_B_of_A'],
                wA=wA.astype(np.float64),
                wB=wB.astype(np.float64),
                idxA_bins=idxA_bins,
                idxB_bins=idxB_bins,
                stage1_auc_idxA_use=stage1_auc_idxA_use,
