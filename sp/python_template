#!/usr/bin/env python3
"""Template for new Python subprograms distributed with j_presto.

Before using this file as a new program, edit the PROGRAM_* constants,
argument definitions in build_parser(), and the processing in run().

The template supports both invocation styles:
    j_presto PROGRAM [arguments]
    ./PROGRAM [arguments]
"""

from __future__ import annotations

import argparse
import hashlib
import os
import platform
import sys
import time
from pathlib import Path
from typing import Sequence


PROGRAM_NAME = "python_template"
PROGRAM_LONG_NAME = "Template for j_presto Python subprograms"
PROGRAM_VERSION = "1.0.0"
AUTHOR = "Jinzen Ikebe"
FIRST_RELEASE = "2025-01-01"
CURRENT_VERSION_DATE = "2026-07-27"
ACCESS_KEY = "j_presto"


class ProgramError(RuntimeError):
    """Error that should be reported to the user without a traceback."""


def sha256_8(path: Path) -> str:
    """Return the first eight hexadecimal characters of a file SHA-256."""
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()[:8]


def strip_j_presto_access_key(
    argv: Sequence[str] | None = None,
) -> tuple[bool, list[str]]:
    """Remove the hidden access key inserted by the j_presto launcher."""
    raw = list(sys.argv if argv is None else argv)
    if len(raw) > 1 and raw[1] == ACCESS_KEY:
        return True, [raw[0], *raw[2:]]
    return False, raw


def display_credits() -> None:
    print("*" * 60)
    print("*")
    print(f"*    {PROGRAM_NAME} (Version {PROGRAM_VERSION})")
    print(f"*    {PROGRAM_LONG_NAME}")
    print("*")
    print(f"*        Author : {AUTHOR}")
    print(f"* First Release : {FIRST_RELEASE}")
    print(f"*  Current ver. : {CURRENT_VERSION_DATE}")
    print("*")
    print("*" * 60)
    print()

    j_presto_path = os.environ.get("J_PRESTO_PATH")
    if j_presto_path:
        license_path = Path(j_presto_path) / "LICENSE.md"
        if not license_path.is_file():
            print(f"[WARN] License file not found: {license_path}", file=sys.stderr)


def print_runtime_header() -> None:
    """Print information useful for identifying the executed program."""
    try:
        program_sha = sha256_8(Path(__file__).resolve())
    except OSError as exc:
        program_sha = f"unavailable ({exc})"

    print(f'{"Program SHA256_8 : ".rjust(20)}{program_sha}')
    print(f'{"Python : ".rjust(20)}{platform.python_version()} ({sys.executable})')
    print(f'{"Working dir : ".rjust(20)}{Path.cwd()}')
    print()


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog=f"j_presto {PROGRAM_NAME}",
        formatter_class=argparse.RawTextHelpFormatter,
        description=PROGRAM_LONG_NAME,
        epilog=(
            "Example:\n"
            f"  j_presto {PROGRAM_NAME} input.dat -o output.txt"
        ),
    )
    parser.add_argument("input", type=Path, help="Input file.")
    parser.add_argument(
        "-o",
        "--output",
        type=Path,
        default=Path("output.txt"),
        help="Output file (default: output.txt).",
    )
    parser.add_argument(
        "--version",
        action="version",
        version=f"{PROGRAM_NAME} {PROGRAM_VERSION}",
    )
    return parser


def run(args: argparse.Namespace) -> int:
    """Implement the program-specific processing here."""
    if not args.input.is_file():
        raise ProgramError(f"Input file not found: {args.input}")

    print(f'{"Input : ".rjust(20)}{args.input}')
    print(f'{"Output : ".rjust(20)}{args.output}')
    print()

    # ------------------------------------------------------------------
    # Add the program-specific processing here.
    # ------------------------------------------------------------------

    return 0


def main(argv: Sequence[str] | None = None) -> int:
    start_time = time.perf_counter()
    _, stripped_argv = strip_j_presto_access_key(argv)
    parser = build_parser()
    args = parser.parse_args(stripped_argv[1:])

    display_credits()
    print_runtime_header()

    status = 0
    try:
        status = run(args)
    except ProgramError as exc:
        print(f"[ERROR] {exc}", file=sys.stderr)
        status = 1
    except KeyboardInterrupt:
        print("[ERROR] Interrupted by user.", file=sys.stderr)
        status = 130

    elapsed = time.perf_counter() - start_time
    print(f"\nExecution time : {elapsed:.3f} (S)")
    if status == 0:
        print(f"\n+++ Program j_presto {PROGRAM_NAME} normally ended +++")
    else:
        print(
            f"\n!!! Program j_presto {PROGRAM_NAME} ended with error !!!",
            file=sys.stderr,
        )
    return status


if __name__ == "__main__":
    raise SystemExit(main())
