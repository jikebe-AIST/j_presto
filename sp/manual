#!/usr/bin/env python3
"""Interactive multilingual manual reader for the j_presto program suite."""

import argparse
import difflib
import hashlib
import os
import re
import readline
import sys
from pathlib import Path


PROGRAM_NAME = "manual"
PROGRAM_VERSION = "1.1.0"
CURRENT_VERSION_DATE = "2026-07-27"
SUPPORTED_LANGUAGES = ("en", "ja")
LANGUAGE_NAMES = {
    "en": {"en": "English", "ja": "Japanese"},
    "ja": {"en": "英語", "ja": "日本語"},
}

UI = {
    "en": {
        "error_prefix": "Error",
        "warning_prefix": "Warning",
        "duplicate": "Duplicate manual entry {key!r} detected {where}.",
        "home_missing": "The manual home entry ('>') is missing.",
        "broken_links": "Broken manual navigation links:\n  {links}",
        "file_not_found": "File {filename!r} not found.",
        "load_failed": "Could not load the manual: {error}",
        "license_path_missing": "J_PRESTO_PATH is not set.",
        "license_missing": "License file not found: {path}",
        "search_empty": "Search term is empty.",
        "not_found_search": "{term!r} was not found in the manual.",
        "match_singular": "matching entry",
        "match_plural": "matching entries",
