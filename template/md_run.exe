#!/bin/bash

# Please adjust the values as necessary
export OMP_NUM_THREADS=8
ulimit -s 16384
export OMP_STACKSIZE=16M
export KMP_AFFINITY=disabled

#For energy minimization calculation
j_presto md_run min.inp > min.log
